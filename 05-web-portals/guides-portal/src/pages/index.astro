---
import GuidesLayout from '../layouts/GuidesLayout.astro';

const categories = ['Research & ISEF', 'Olympiads', 'Global Admissions', 'Engineering'] as const;
---
<GuidesLayout title="TF Guides — Academic & Research Workbooks">
  <main class="max-w-[1160px] mx-auto px-4 sm:px-6 mt-7 mb-16 grid grid-cols-1 lg:grid-cols-[310px_1fr] gap-6 items-start">
    <aside class="bg-tf-surface border border-tf-border rounded-tf-card p-6 lg:sticky lg:top-8 shadow-[0_1px_2px_rgb(22_26_34/0.04)]">
      <div data-tf-copy="guides.eyebrow" class="pl-2.5 border-l-2 border-tf-accent text-[12.5px] text-tf-muted font-medium">
        Curatorial STEM syllabus
      </div>
      <h1 data-tf-copy="guides.headline" class="font-display text-[27px] leading-[1.1] mt-2.5 text-tf-ink">Research and Olympiad roadmaps</h1>
      <p data-tf-copy="guides.subtitle" class="text-[13.5px] leading-[1.6] text-tf-muted mt-2.5">
        Structured playbooks authored by mentors and alumni. Check off milestones locally as you advance.
      </p>

      <input
        id="guide-search"
        data-tf-copy="guides.search_placeholder"
        type="search"
        placeholder="Search topic or skill..."
        aria-label="Search guides"
        class="w-full h-10 px-3 rounded-tf-input mt-4 bg-tf-sunken/60 border border-tf-border text-tf-ink placeholder-tf-subtle text-[14px] focus:bg-tf-surface focus:border-tf-brand focus:outline-none"
      />

      <div class="mt-3.5 flex flex-col gap-1 p-1 bg-tf-sunken border border-tf-border-strong rounded-tf-card" id="cat-tabs">
        <button type="button" class="tab-btn active w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-semibold bg-tf-surface text-tf-ink border border-tf-border" data-cat="All">
          All workbooks
        </button>
        {categories.map((cat) => (
          <button type="button" class="tab-btn w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-medium text-tf-muted hover:text-tf-ink" data-cat={cat}>
            {cat}
          </button>
        ))}
      </div>

      <div class="mt-4 pt-4 border-t border-tf-border text-[12.5px] text-tf-muted">
        <div class="flex justify-between items-center">
          <span>Workbook completion</span>
          <strong id="overall-count" class="font-mono text-tf-accent-text">0 / 0 steps</strong>
        </div>
        <div class="h-2 bg-tf-sunken rounded-full overflow-hidden mt-2 border border-tf-border-strong">
          <div id="overall-fill" class="h-full bg-tf-accent transition-all duration-200" style="width: 0%;"></div>
        </div>
      </div>
    </aside>

    <section class="bg-tf-surface border border-tf-border rounded-tf-card overflow-hidden shadow-[0_1px_2px_rgb(22_26_34/0.04)]">
      <div class="px-6 py-4 bg-tf-sunken border-b border-tf-border flex items-center justify-between gap-3">
        <strong data-tf-copy="guides.list_heading" class="font-display text-[18px] text-tf-ink">Active roadmaps &amp; checklists</strong>
        <span class="font-mono text-[12px] text-tf-muted" id="guide-visible-count">0 workbooks</span>
      </div>

      <div id="guides-grid" class="divide-y divide-tf-sunken">
        <div class="p-10 text-center text-tf-muted">Loading study guides...</div>
      </div>
    </section>
  </main>

  <!-- Inline Interactive Workbook Reader Modal -->
  <div id="guide-modal" class="hidden fixed inset-0 bg-black/45 z-50 items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="gm-title">
    <div class="w-full max-w-[640px] max-h-[85vh] flex flex-col bg-tf-surface border border-tf-border rounded-tf-card overflow-hidden shadow-xl">
      <div class="px-6 py-4 bg-tf-canvas border-b border-tf-border flex items-start justify-between gap-3">
        <div>
          <div id="gm-meta" class="font-mono text-[12px] font-semibold text-tf-accent-text"></div>
          <h2 id="gm-title" class="font-display text-[22px] font-bold text-tf-ink mt-1 leading-snug"></h2>
        </div>
        <button id="gm-close" type="button" aria-label="Close workbook" class="w-8 h-8 rounded-tf-input border border-tf-border bg-tf-surface text-tf-muted hover:text-tf-ink cursor-pointer shrink-0">✕</button>
      </div>
      <div class="p-6 overflow-y-auto space-y-4">
        <p id="gm-summary" class="text-[14px] leading-[1.65] text-tf-muted"></p>
        <div id="gm-steps-wrap" class="space-y-2"></div>
        <div id="gm-ext-wrap" class="hidden pt-3 border-t border-tf-border flex justify-end">
          <a id="gm-ext-link" href="#" target="_blank" rel="noopener noreferrer" class="h-9 px-4 inline-flex items-center rounded-tf-input bg-tf-brand text-white text-[13px] font-medium">
            Open external resource →
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const STORAGE_KEY = 'tf_guides_progress_v1';
    let progress = {};
    try { progress = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch {}

    let allGuides = [];
    let activeCat = 'All';
    let searchQuery = '';

    function esc(s) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function decodeFsVal(v) {
      if (!v || typeof v !== 'object') return undefined;
      if ('stringValue' in v) return v.stringValue;
      if ('booleanValue' in v) return v.booleanValue;
      if ('integerValue' in v) return Number(v.integerValue);
      return undefined;
    }

    function safeUrl(u) {
      return typeof u === 'string' && (/^https?:\/\//i.test(u) || /^\/[^/]/.test(u)) ? u : '';
    }

    function parseSteps(g) {
      if (Array.isArray(g.steps)) return g.steps.filter(Boolean);
      if (typeof g.stepsJson === 'string' && g.stepsJson.trim()) {
        try {
          const p = JSON.parse(g.stepsJson);
          if (Array.isArray(p)) return p.filter(Boolean).map(String);
        } catch {}
      }
      if (typeof g.stepsText === 'string' && g.stepsText.trim()) {
        return g.stepsText.split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
      }
      return [];
    }

    function syncProgressTotals() {
      let totalSteps = 0;
      let totalDone = 0;
      allGuides.forEach((g) => {
        const steps = g.steps || [];
        const arr = progress[g.id] || [];
        totalSteps += steps.length;
        totalDone += steps.filter((_, i) => Boolean(arr[i])).length;
      });
      const pct = totalSteps ? Math.round((totalDone / totalSteps) * 100) : 0;
      const countEl = document.getElementById('overall-count');
      const fillEl = document.getElementById('overall-fill');
      if (countEl) countEl.textContent = `${totalDone} / ${totalSteps} steps`;
      if (fillEl) fillEl.style.width = `${pct}%`;
    }

    function render() {
      const grid = document.getElementById('guides-grid');
      const filtered = allGuides.filter((g) => {
        const matchCat = activeCat === 'All' || g.category === activeCat;
        const q = searchQuery.toLowerCase();
        const hay = `${g.title} ${g.summary || ''} ${g.category || ''}`.toLowerCase();
        return matchCat && (!q || hay.includes(q));
      });

      const vis = document.getElementById('guide-visible-count');
      if (vis) vis.textContent = `${filtered.length} workbook${filtered.length === 1 ? '' : 's'}`;

      if (allGuides.length === 0) {
        grid.innerHTML = '<div data-tf-copy="guides.empty_state" class="p-10 text-center text-tf-muted">No study guides published yet. Add guides from TF Dashboard.</div>';
        syncProgressTotals();
        return;
      }

      if (filtered.length === 0) {
        grid.innerHTML = '<div class="p-10 text-center text-tf-muted">No workbooks match your filter.</div>';
        syncProgressTotals();
        return;
      }

      grid.innerHTML = filtered.map((g, idx) => {
        const steps = g.steps || [];
        const arr = progress[g.id] || [];
        const done = steps.filter((_, i) => Boolean(arr[i])).length;
        const pct = steps.length ? Math.round((done / steps.length) * 100) : 0;
        return `
          <div class="guide-row p-5 sm:p-6 grid grid-cols-1 md:grid-cols-[1fr_200px] gap-5 items-center hover:bg-tf-canvas/60 transition cursor-pointer" data-id="${esc(g.id)}" tabindex="0" role="button">
            <div>
              <div class="flex flex-wrap items-center gap-2 text-[12px]">
                <span class="tf-serial-chip">№ ${esc(g.serial || ('GD-' + String(idx + 1).padStart(2, '0')))}</span>
                <span class="font-semibold text-tf-accent-text">${esc(g.category || 'Study Guide')}</span>
                <span class="font-mono bg-tf-sunken border border-tf-border-strong px-2 py-0.5 rounded-tf-input text-tf-muted font-medium">${esc(g.level || 'Guide')}</span>
              </div>
              <h2 class="font-display text-[19px] font-semibold text-tf-ink mt-2 leading-[1.3]">${esc(g.title)}</h2>
              <p class="text-[13.5px] leading-[1.6] text-tf-muted mt-1.5 max-w-[64ch]">${esc(g.summary || '')}</p>
            </div>
            <div class="flex flex-col items-stretch md:items-end gap-2">
              ${steps.length ? `
                <div class="w-full flex justify-between text-[12px] text-tf-muted font-medium">
                  <span>${done}/${steps.length} milestones</span>
                  <span class="font-mono text-tf-accent-text">${pct}%</span>
                </div>
                <div class="w-full h-1.5 bg-tf-sunken rounded-full overflow-hidden">
                  <div class="h-full bg-tf-accent" style="width: ${pct}%;"></div>
                </div>` : ''}
              <span class="px-3.5 py-2 rounded-tf-input bg-tf-canvas text-tf-ink text-[12.5px] font-medium border border-tf-border text-center">
                Open workbook →
              </span>
            </div>
          </div>`;
      }).join('');

      grid.querySelectorAll('.guide-row').forEach((row) => {
        const id = row.getAttribute('data-id');
        row.addEventListener('click', () => openGuide(id));
        row.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openGuide(id); }
        });
      });

      syncProgressTotals();
    }

    function openGuide(id) {
      const g = allGuides.find((x) => x.id === id);
      if (!g) return;
      document.getElementById('gm-meta').textContent = `${g.serial || 'GD'} · ${g.category || 'Study Guide'} · ${g.level || ''}`;
      document.getElementById('gm-title').textContent = g.title;
      document.getElementById('gm-summary').textContent = g.summary || '';

      const wrap = document.getElementById('gm-steps-wrap');
      const steps = g.steps || [];
      if (steps.length === 0) {
        wrap.innerHTML = '<div class="text-[13px] text-tf-subtle">No checklist milestones listed on this guide yet.</div>';
      } else {
        const arr = progress[g.id] || [];
        wrap.innerHTML = steps.map((txt, i) => `
          <label class="flex items-start gap-3 p-3 rounded-tf-input border border-tf-border bg-tf-canvas/50 cursor-pointer hover:border-tf-brand transition">
            <input type="checkbox" data-step="${i}" ${arr[i] ? 'checked' : ''} class="mt-0.5 w-4 h-4 accent-[#0F766E]" />
            <span class="text-[13.5px] leading-[1.55] text-tf-ink">${esc(txt)}</span>
          </label>`).join('');
        wrap.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
          cb.addEventListener('change', () => {
            const idx = Number(cb.getAttribute('data-step'));
            if (!Array.isArray(progress[g.id])) progress[g.id] = [];
            progress[g.id][idx] = cb.checked;
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(progress)); } catch {}
            render();
          });
        });
      }

      const extWrap = document.getElementById('gm-ext-wrap');
      const extLink = document.getElementById('gm-ext-link');
      const ext = safeUrl(g.url);
      if (ext && ext.startsWith('http')) {
        extLink.href = ext;
        extWrap.classList.remove('hidden');
      } else {
        extWrap.classList.add('hidden');
      }

      const modal = document.getElementById('guide-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeGuide() {
      const modal = document.getElementById('guide-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    document.getElementById('gm-close')?.addEventListener('click', closeGuide);
    document.getElementById('guide-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'guide-modal') closeGuide();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeGuide();
    });

    document.querySelectorAll('#cat-tabs .tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#cat-tabs .tab-btn').forEach((b) => {
          b.className = 'tab-btn w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-medium text-tf-muted hover:text-tf-ink';
        });
        btn.className = 'tab-btn active w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-semibold bg-tf-surface text-tf-ink border border-tf-border';
        activeCat = btn.getAttribute('data-cat');
        render();
      });
    });

    document.getElementById('guide-search')?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim();
      render();
    });

    (async () => {
      try {
        const res = await fetch('https://firestore.googleapis.com/v1/projects/tf-unions/databases/(default)/documents/guides?pageSize=200', { cache: 'no-store' });
        if (res.ok) {
          const json = await res.json();
          const list = [];
          (json.documents || []).forEach((d) => {
            const o = { id: d.name.split('/').pop() };
            const f = d.fields || {};
            Object.keys(f).forEach((k) => { o[k] = decodeFsVal(f[k]); });
            if (!o.archived && o.title) {
              o.steps = parseSteps(o);
              list.push(o);
            }
          });
          allGuides = list;
        }
      } catch {}
      render();
    })();
  </script>
</GuidesLayout>
