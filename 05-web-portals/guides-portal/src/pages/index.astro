---
import GuidesLayout from '../layouts/GuidesLayout.astro';
import { ROADMAPS } from '../data/guides';

const categories = ['Research & ISEF', 'Olympiads', 'Global Admissions', 'Engineering'] as const;
---
<GuidesLayout title="TF Guides — Academic & Research Workbooks">
  <main class="max-w-[1160px] mx-auto px-4 sm:px-6 mt-7 mb-16 grid grid-cols-1 lg:grid-cols-[310px_1fr] gap-6 items-start">
    <aside class="bg-tf-surface border border-tf-border rounded-tf-card p-6 lg:sticky lg:top-8 shadow-[0_1px_2px_rgb(22_26_34/0.04)]">
      <div class="pl-2.5 border-l-2 border-tf-accent text-[12.5px] text-tf-muted font-medium">
        Curatorial STEM syllabus
      </div>
      <h1 class="font-display text-[27px] leading-[1.1] mt-2.5 text-tf-ink">Research and Olympiad roadmaps</h1>
      <p class="text-[13.5px] leading-[1.6] text-tf-muted mt-2.5">
        Structured playbooks authored by ISEF finalists, Olympiad medalists, and global scholars. Check off milestones locally as you advance.
      </p>

      <input
        id="guide-search"
        type="search"
        placeholder="Search topic or skill..."
        aria-label="Search guides"
        class="w-full h-10 px-3 rounded-tf-input mt-4 bg-tf-sunken/60 border border-tf-border text-tf-ink placeholder-tf-subtle text-[14px] focus:bg-tf-surface focus:border-tf-brand focus:outline-none"
      />

      <div class="mt-3.5 flex flex-col gap-1 p-1 bg-tf-sunken border border-tf-border-strong rounded-tf-card" id="cat-tabs">
        <button type="button" class="tab-btn active w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-semibold bg-tf-surface text-tf-ink border border-tf-border" data-cat="All">
          All workbooks ({ROADMAPS.length})
        </button>
        {categories.map((cat) => (
          <button type="button" class="tab-btn w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-medium text-tf-muted hover:text-tf-ink" data-cat={cat}>
            {cat}
          </button>
        ))}
      </div>

      <div class="mt-4 pt-4 border-t border-tf-border text-[12.5px] text-tf-muted">
        <div class="flex justify-between items-center">
          <span>Workbook completion</span>
          <strong id="overall-count" class="font-mono text-tf-accent-text">0 / {ROADMAPS.reduce((a, g) => a + g.steps.length, 0)}</strong>
        </div>
        <div class="h-2 bg-tf-sunken rounded-full overflow-hidden mt-2 border border-tf-border-strong">
          <div id="overall-fill" class="h-full bg-tf-accent transition-all duration-200" style="width: 0%;"></div>
        </div>
      </div>
    </aside>

    <section class="bg-tf-surface border border-tf-border rounded-tf-card overflow-hidden shadow-[0_1px_2px_rgb(22_26_34/0.04)]">
      <div class="px-6 py-4 bg-tf-sunken border-b border-tf-border flex items-center justify-between gap-3">
        <strong class="font-display text-[18px] text-tf-ink">Active roadmaps &amp; checklists</strong>
        <span class="font-mono text-[12px] text-tf-muted" id="guide-visible-count">{ROADMAPS.length} workbooks</span>
      </div>

      <div id="guides-grid" class="divide-y divide-tf-sunken">
        {ROADMAPS.map((g) => (
          <a
            href={`/guides/${g.id}`}
            class="guide-row p-5 sm:p-6 grid grid-cols-1 md:grid-cols-[1fr_200px] gap-5 items-center hover:bg-tf-canvas/60 transition block"
            data-id={g.id}
            data-cat={g.category}
            data-search={`${g.title} ${g.summary} ${g.category}`.toLowerCase()}
          >
            <div>
              <div class="flex flex-wrap items-center gap-2 text-[12px]">
                <span class="tf-serial-chip">№ {g.serial}</span>
                <span class="font-semibold text-tf-accent-text">{g.category}</span>
                <span class="font-mono bg-tf-sunken border border-tf-border-strong px-2 py-0.5 rounded-tf-input text-tf-muted font-medium">{g.level}</span>
              </div>
              <h2 class="font-display text-[19px] font-semibold text-tf-ink mt-2 leading-[1.3]">{g.title}</h2>
              <p class="text-[13.5px] leading-[1.6] text-tf-muted mt-1.5 max-w-[64ch]">{g.summary}</p>
            </div>
            <div class="flex flex-col items-stretch md:items-end gap-2">
              <div class="w-full flex justify-between text-[12px] text-tf-muted font-medium">
                <span class="step-label">0/{g.steps.length} milestones</span>
                <span class="step-pct font-mono text-tf-accent-text">0%</span>
              </div>
              <div class="w-full h-1.5 bg-tf-sunken rounded-full overflow-hidden">
                <div class="step-fill h-full bg-tf-accent" style="width: 0%;"></div>
              </div>
              <span class="px-3.5 py-2 rounded-tf-input bg-tf-canvas text-tf-ink text-[12.5px] font-medium border border-tf-border text-center">
                Open workbook →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ ROADMAPS }}>
    if (window.location.hash.startsWith('#guide-')) {
      const slug = window.location.hash.replace('#guide-', '');
      if (ROADMAPS.some((g) => g.id === slug)) {
        window.location.replace(`/guides/${slug}`);
      }
    }

    const STORAGE_KEY = 'tf_guides_progress_v1';
    let progress = {};
    try { progress = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch {}

    function syncProgressUI() {
      let totalSteps = 0;
      let totalDone = 0;
      ROADMAPS.forEach((g) => {
        const done = (progress[g.id] || []).filter(Boolean).length;
        const tot = g.steps.length;
        totalSteps += tot;
        totalDone += done;
        const pct = tot ? Math.round((done / tot) * 100) : 0;
        const row = document.querySelector(`.guide-row[data-id="${g.id}"]`);
        if (row) {
          row.querySelector('.step-label').textContent = `${done}/${tot} milestones`;
          row.querySelector('.step-pct').textContent = `${pct}%`;
          row.querySelector('.step-fill').style.width = `${pct}%`;
        }
      });
      const overallPct = totalSteps ? Math.round((totalDone / totalSteps) * 100) : 0;
      document.getElementById('overall-count').textContent = `${totalDone} / ${totalSteps} steps`;
      document.getElementById('overall-fill').style.width = `${overallPct}%`;
    }

    let activeCat = 'All';
    let searchQuery = '';

    function filterRows() {
      let visible = 0;
      document.querySelectorAll('.guide-row').forEach((row) => {
        const matchCat = activeCat === 'All' || row.getAttribute('data-cat') === activeCat;
        const q = searchQuery.toLowerCase();
        const matchQ = !q || row.getAttribute('data-search').includes(q);
        const show = matchCat && matchQ;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      document.getElementById('guide-visible-count').textContent = `${visible} workbook${visible === 1 ? '' : 's'}`;
    }

    document.querySelectorAll('#cat-tabs .tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#cat-tabs .tab-btn').forEach((b) => {
          b.className = 'tab-btn w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-medium text-tf-muted hover:text-tf-ink';
        });
        btn.className = 'tab-btn active w-full text-left px-3 py-2 rounded-[7px] text-[13px] font-semibold bg-tf-surface text-tf-ink border border-tf-border';
        activeCat = btn.getAttribute('data-cat');
        filterRows();
      });
    });

    document.getElementById('guide-search')?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim();
      filterRows();
    });

    syncProgressUI();
  </script>
</GuidesLayout>
