---
import GuidesLayout from '../../layouts/GuidesLayout.astro';
import { ROADMAPS, type GuideWorkbook } from '../../data/guides';

export function getStaticPaths() {
  return ROADMAPS.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

interface Props {
  guide: GuideWorkbook;
}

const { guide } = Astro.props;

const courseJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: guide.title,
  description: guide.summary,
  provider: {
    '@type': 'Organization',
    name: 'TF Unions',
    sameAs: 'https://www.tfunions.com',
  },
  timeRequired: guide.level,
  educationalLevel: 'High School / Pre-University STEM',
});
---
<GuidesLayout title={`${guide.title} — TF Guides`} description={guide.summary} backHref="/" backLabel="All workbooks">
  <main class="max-w-[820px] mx-auto px-4 sm:px-6 mt-7 mb-16">
    <article class="bg-tf-surface border border-tf-border rounded-tf-card overflow-hidden shadow-[0_1px_2px_rgb(22_26_34/0.04)]">
      <div class="bg-tf-canvas p-6 sm:p-8 border-b border-tf-border">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="tf-serial-chip">№ {guide.serial}</span>
            <span class="font-mono text-[12px] font-semibold text-tf-accent-text">{guide.category} · {guide.level}</span>
          </div>
          <span class="tf-stamp">Syllabus Ready</span>
        </div>

        <h1 class="font-display mt-3 text-[26px] sm:text-[32px] font-bold leading-[1.15] text-tf-ink">
          {guide.title}
        </h1>
        <p class="mt-3 text-[15px] leading-[1.65] text-tf-muted">
          {guide.summary}
        </p>
      </div>

      <div class="p-6 sm:p-8">
        <div class="tf-ledger-line !mt-0">
          <span class="tf-ledger-line__label">Actionable milestones · <span id="guide-done-count">0 / {guide.steps.length}</span></span>
        </div>

        <div id="steps-list" class="space-y-2.5">
          {guide.steps.map((step, i) => (
            <label class="step-item flex items-start gap-3 p-3.5 rounded-tf-card bg-tf-canvas border border-tf-border cursor-pointer transition" data-step={i}>
              <input type="checkbox" class="step-checkbox mt-1 w-4 h-4 accent-[#0F766E] cursor-pointer" data-step={i} />
              <span class="text-[14.5px] leading-[1.55] text-tf-ink">{step}</span>
            </label>
          ))}
        </div>

        <div class="mt-6 pt-5 border-t border-tf-border flex flex-wrap items-center justify-between gap-3">
          <a href="/" class="text-[13.5px] font-medium text-tf-brand hover:underline">← Back to all workbooks</a>
          <a href="https://connect.tfunions.com" class="text-[13px] font-medium text-tf-accent-text hover:underline">Find a study circle on TF Connect →</a>
        </div>
      </div>
    </article>
  </main>

  <script type="application/ld+json" set:html={courseJsonLd}></script>

  <script is:inline define:vars={{ guideId: guide.id, totalSteps: guide.steps.length }}>
    const STORAGE_KEY = 'tf_guides_progress_v1';
    let progress = {};
    try { progress = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch {}

    function save() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(progress)); } catch {}
    }

    function refresh() {
      const arr = Array.isArray(progress[guideId]) ? progress[guideId] : [];
      let done = 0;
      document.querySelectorAll('.step-item').forEach((item) => {
        const idx = Number(item.getAttribute('data-step'));
        const checked = Boolean(arr[idx]);
        if (checked) done++;
        const cb = item.querySelector('.step-checkbox');
        if (cb) cb.checked = checked;
        item.classList.toggle('bg-tf-accent-soft', checked);
        item.classList.toggle('border-tf-accent-border', checked);
        item.classList.toggle('bg-tf-canvas', !checked);
        item.classList.toggle('border-tf-border', !checked);
      });
      document.getElementById('guide-done-count').textContent = `${done} / ${totalSteps}`;
    }

    document.querySelectorAll('.step-checkbox').forEach((cb) => {
      cb.addEventListener('change', () => {
        const idx = Number(cb.getAttribute('data-step'));
        if (!Array.isArray(progress[guideId])) progress[guideId] = [];
        progress[guideId][idx] = cb.checked;
        save();
        refresh();
      });
    });

    refresh();
  </script>
</GuidesLayout>
