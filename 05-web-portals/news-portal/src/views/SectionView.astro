---
import NewsLayout from '../layouts/NewsLayout.astro';
import PageHead from '../components/PageHead.astro';
import OppRow from '../components/OppRow.astro';
import { opportunitiesFor, ALL_TOPICS, type Section } from '../lib/data';
import { dateLabel, deadlineKey, openingKey } from '../lib/dates';
import { t, href, catLabel, SECTION_TITLES_AR, type Lang } from '../lib/i18n';

export interface Props { section: Section; lang: Lang }
const { section, lang } = Astro.props;
const now = new Date();
const items = opportunitiesFor(section.id).sort((a, b) => {
  const la = dateLabel(a, now).isOpen ? 0 : 1;
  const lb = dateLabel(b, now).isOpen ? 0 : 1;
  if (la !== lb) return la - lb;
  return la === 0 ? deadlineKey(a) - deadlineKey(b) : openingKey(a, now) - openingKey(b, now);
});
const title = lang === 'ar' ? SECTION_TITLES_AR[section.id].title : section.title;
const subtitle = lang === 'ar' ? SECTION_TITLES_AR[section.id].subtitle : section.subtitle;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: section.title,
  itemListElement: items.slice(0, 50).map((o, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://news.tfunions.com/opportunity/${o.id}`,
    name: o.title,
  })),
};
const chip = 'h-9 px-3.5 inline-flex items-center rounded-tf-pill border border-transparent text-[13px] font-medium text-tf-muted hover:text-tf-ink transition aria-pressed:bg-tf-surface aria-pressed:border-tf-border aria-pressed:text-tf-ink aria-pressed:font-semibold';
---
<NewsLayout
  title={`${title} — TF News`}
  description={subtitle}
  lang={lang}
  altPath={section.route}
  active="browse"
  backHref={href(lang, '/directories')}
  backLabel={t(lang, 'nav.learn')}
  jsonLd={ld}
>
  <PageHead title={title} subtitle={subtitle} kicker={section.id.toUpperCase()} copyPrefix={`news_sec_${section.id}${lang === 'ar' ? '_ar' : ''}`} />

  {section.id === 'study' && (
    <div class="-mt-3 mb-8 flex flex-wrap gap-2">
      <a href={href(lang, '/study/universities')} class="h-9 px-3.5 inline-flex items-center rounded-tf-card bg-tf-surface border border-tf-border hover:border-tf-brand text-[13px] font-medium transition">{t(lang, 'uni.title')}</a>
      <a href={href(lang, '/study/programs')} class="h-9 px-3.5 inline-flex items-center rounded-tf-card bg-tf-surface border border-tf-border hover:border-tf-brand text-[13px] font-medium transition">{t(lang, 'prog.title')}</a>
    </div>
  )}

  <div
    data-listing
    data-default-status="open"
    data-topics-map={JSON.stringify(section.topicsByCategory)}
    data-default-topics={JSON.stringify(section.defaultTopics)}
  >
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2" data-ctl="status" role="group" aria-label="Status">
        <button type="button" data-value="open" aria-pressed="true" class={chip}>{t(lang, 'section.open')}</button>
        <button type="button" data-value="upcoming" aria-pressed="false" class={chip}>{t(lang, 'section.upcoming')}</button>
        <button type="button" data-value="all" aria-pressed="false" class={chip}>{t(lang, 'section.all')}</button>
      </div>

      <div class="flex flex-wrap items-center gap-2" data-ctl="category" role="group" aria-label="Category">
        {section.categories.map((c) => (
          <button type="button" data-value={c} aria-pressed={c === 'All' ? 'true' : 'false'} class={chip}>{catLabel(lang, c)}</button>
        ))}
      </div>

      <div class="flex flex-wrap gap-3">
        <label class="sr-only" for="topic-sel">{section.topicsLabel}</label>
        <select
          id="topic-sel"
          data-ctl="topic"
          data-all-label={lang === 'ar' ? 'كل الفرص' : ALL_TOPICS}
          class="h-10 px-3 rounded-tf-input bg-tf-surface border border-tf-border text-[14px] focus:border-tf-brand focus:outline-none"
        >
          <option value={ALL_TOPICS}>{ALL_TOPICS}</option>
        </select>
        <label class="sr-only" for="list-q">{t(lang, 'section.search')}</label>
        <input
          id="list-q"
          data-ctl="q"
          type="search"
          placeholder={t(lang, 'section.search')}
          class="flex-1 min-w-[200px] h-10 px-3 rounded-tf-input bg-tf-surface border border-tf-border text-[14px] placeholder-tf-subtle focus:border-tf-brand focus:outline-none"
        />
      </div>
    </div>

    <div class="mt-6 bg-tf-surface border border-tf-border rounded-tf-card">
      <div class="px-5 py-3 bg-tf-sunken border-b border-tf-border rounded-t-tf-card text-[12.5px] text-tf-muted font-mono">
        <span data-count>{items.length}</span> {t(lang, 'section.count')}
      </div>
      <ul data-list class="px-5">
        {items.map((o) => <OppRow o={o} lang={lang} />)}
      </ul>
      <div data-empty hidden class="p-10 text-center">
        <p class="text-tf-muted">{t(lang, 'section.empty')}</p>
        <button type="button" data-reset class="mt-3 text-[13px] font-medium text-tf-brand hover:underline">{t(lang, 'section.reset')}</button>
      </div>
    </div>
  </div>
</NewsLayout>
