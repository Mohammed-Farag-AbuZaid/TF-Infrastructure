---
import NewsLayout from '../../../layouts/NewsLayout.astro';
import { universities, waysFor, regionOf, isExternal, qsLabel, websiteHost, type University } from '../../../lib/data';

export function getStaticPaths() {
  return universities.map((uni) => ({
    params: { id: String(uni.uniId) },
    props: { uni },
  }));
}

interface Props {
  uni: University;
}

const { uni } = Astro.props;
const ways = waysFor(uni.uniId);
const fullCount = ways.filter((w) => w.coverage === 'full').length;
const partialCount = ways.filter((w) => w.coverage === 'partial').length;
const region = regionOf(uni);
const host = websiteHost(uni);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollegeOrUniversity',
  name: uni.name,
  url: uni.website || undefined,
  address: {
    '@type': 'PostalAddress',
    addressCountry: uni.country,
  },
};
---
<NewsLayout
  title={`${uni.name} — Funding & Scholarships`}
  description={`Verified scholarship and financial aid routes for ${uni.name} (${uni.country}).`}
  lang="en"
  active="browse"
  backHref="/study/universities"
  backLabel="Universities"
  jsonLd={ld}
>
  <article class="max-w-[900px]">
    <div class="text-[13px] font-mono text-tf-muted">
      {qsLabel(uni)} · {uni.country} · {region}
    </div>
    <h1 class="font-display mt-2 text-[clamp(1.9rem,3.5vw,2.7rem)] font-bold leading-[1.12] tracking-[-0.025em] text-tf-ink">
      {uni.name}
    </h1>

    <div class="mt-6 py-5 border-y border-tf-border flex flex-wrap gap-x-10 gap-y-4">
      <div>
        <div class="text-[12px] text-tf-muted">Ways to get funded</div>
        <div class="mt-1 font-mono text-[16px] font-semibold text-tf-ink">{ways.length}</div>
      </div>
      <div>
        <div class="text-[12px] text-tf-muted">Full funding</div>
        <div class={`mt-1 font-mono text-[16px] font-semibold ${fullCount > 0 ? 'text-tf-accent-text' : 'text-tf-ink'}`}>{fullCount}</div>
      </div>
      <div>
        <div class="text-[12px] text-tf-muted">Partial funding</div>
        <div class="mt-1 font-mono text-[16px] font-semibold text-tf-ink">{partialCount}</div>
      </div>
    </div>

    {uni.website && (
      <div class="mt-4">
        <a
          href={uni.website}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[13.5px] font-medium text-tf-brand hover:underline"
        >
          Official website{host ? ` · ${host}` : ''} ↗
        </a>
      </div>
    )}

    <section class="mt-10">
      <h2 class="font-display text-[24px] font-bold text-tf-ink">Ways to get funded</h2>

      {ways.length > 2 && (
        <div id="uni-way-filters" class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter funding ways">
          {[
            ['all', 'All'],
            ['full', 'Full funding'],
            ['partial', 'Partial'],
            ['university', "University's own"],
            ['external', 'External'],
          ].map(([k, label], idx) => (
            <button
              type="button"
              data-wf={k}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class="wf-btn h-9 px-3.5 rounded-tf-pill border border-transparent text-[13px] font-medium text-tf-muted hover:text-tf-ink aria-pressed:bg-tf-surface aria-pressed:border-tf-border aria-pressed:text-tf-ink aria-pressed:font-semibold transition"
            >
              {label}
            </button>
          ))}
        </div>
      )}

      {ways.length === 0 ? (
        <div class="mt-5 p-6 bg-tf-surface border border-tf-border rounded-tf-card">
          <p class="text-[14.5px] leading-[1.6] text-tf-muted">
            {uni.waysFound > 0
              ? `This university reports ${uni.waysFound} funding route(s) whose detailed breakdown is currently syncing from the upstream registry. Check the official university financial aid site in the meantime.`
              : 'No specific funding routes are cataloged for this university yet. Visit the official website above for institutional aid policies.'}
          </p>
        </div>
      ) : (
        <div class="mt-5 bg-tf-surface border border-tf-border rounded-tf-card divide-y divide-tf-border" id="uni-ways-list">
          {ways.map((w) => {
            const covClass =
              w.coverage === 'full'
                ? 'bg-tf-accent-soft border-tf-accent-border text-tf-accent-text'
                : w.coverage === 'partial'
                  ? 'bg-tf-signal-soft border-tf-signal/30 text-tf-signal'
                  : 'bg-tf-sunken border-tf-border text-tf-muted';
            return (
              <a
                href={`/admissions/university/${uni.uniId}/way/${w.wayNo}`}
                class="uni-way-row block p-5 hover:bg-tf-canvas/50 transition"
                data-cov={w.coverage}
                data-scope={isExternal(w) ? 'external' : 'university'}
              >
                <div class="flex flex-wrap items-center gap-2.5 text-[12px]">
                  <span class={`font-mono px-2 py-0.5 rounded border font-semibold ${covClass}`}>
                    {w.coverage === 'full' ? 'Full funding' : w.coverage === 'partial' ? 'Partial funding' : 'Funding'}
                  </span>
                  <span class="text-tf-muted">{isExternal(w) ? 'External program' : "University's own"}</span>
                </div>
                <h3 class="font-display text-[19px] font-semibold text-tf-ink mt-2">{w.title}</h3>
                {w.provider && <p class="text-[13.5px] text-tf-muted mt-1">By {w.provider}</p>}
              </a>
            );
          })}
        </div>
      )}

      <p class="mt-6 text-[13px] text-tf-muted leading-relaxed">
        Every passage is sourced from official university or scholarship provider pages. Always confirm deadlines directly before submitting.
      </p>
    </section>
  </article>

  <script is:inline>
    const buttons = document.querySelectorAll('.wf-btn');
    const rows = document.querySelectorAll('.uni-way-row');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-wf');
        buttons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
        rows.forEach((r) => {
          const cov = r.getAttribute('data-cov');
          const scope = r.getAttribute('data-scope');
          const show =
            key === 'all' ||
            (key === 'full' && cov === 'full') ||
            (key === 'partial' && cov === 'partial') ||
            (key === 'university' && scope === 'university') ||
            (key === 'external' && scope === 'external');
          r.style.display = show ? '' : 'none';
        });
      });
    });
  </script>
</NewsLayout>
