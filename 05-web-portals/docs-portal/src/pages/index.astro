---
/**
 * TF Unions Official Documentation & FAQ (`https://docs.tfunions.com`)
 * Built with the `tf_minimal` design system: white page (#FFFFFF), 1000px frame,
 * thin top bar (#D2D2D7), underline tabs, hairline rows, single #002583 accent.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Documentation — TF Unions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-white text-[#1D1D1F] font-['Inter',-apple-system,BlinkMacSystemFont,sans-serif] antialiased">
    <div class="max-w-[1000px] mx-auto px-6 pb-24">
      <!-- TfTopBar -->
      <header class="h-16 border-b border-[#D2D2D7]/70 flex items-center justify-between">
        <a href="https://www.tfunions.com" class="text-[15px] font-medium text-[#002583] hover:opacity-75 transition">
          ‹ TF Unions
        </a>
        <div class="flex items-center gap-6 text-[14px]">
          <a href="https://news.tfunions.com" class="text-[#6E6E73] hover:text-[#1D1D1F] transition">TF News</a>
          <a href="https://guides.tfunions.com" class="text-[#6E6E73] hover:text-[#1D1D1F] transition">TF Guides</a>
          <a href="https://verify.tfunions.com" class="text-[#6E6E73] hover:text-[#1D1D1F] transition">Verify</a>
          <a href="https://auth.tfunions.com" class="text-[#002583] font-semibold hover:opacity-75 transition">Sign in</a>
        </div>
      </header>

      <!-- Intro -->
      <section class="mt-14 sm:mt-20">
        <h1 class="text-[36px] sm:text-[52px] font-bold tracking-[-1.6px] leading-[1.08] text-[#1D1D1F]">
          Documentation &amp; FAQ.
        </h1>
        <p class="mt-3.5 text-[17px] leading-[1.45] text-[#6E6E73] max-w-[640px]">
          How the TF Unions ecosystem works for students, contributors, and partners across Egypt.
        </p>
      </section>

      <!-- TfTabs -->
      <nav class="mt-10 border-b border-[#D2D2D7]/70 flex gap-7 overflow-x-auto">
        <a href="#platforms" class="py-3 border-b-2 border-[#1D1D1F] text-[15px] font-semibold text-[#1D1D1F] shrink-0">Platforms</a>
        <a href="#account" class="py-3 border-b-2 border-transparent text-[15px] font-semibold text-[#6E6E73] hover:text-[#1D1D1F] shrink-0">Unified Account</a>
        <a href="#faq" class="py-3 border-b-2 border-transparent text-[15px] font-semibold text-[#6E6E73] hover:text-[#1D1D1F] shrink-0">FAQ</a>
      </nav>

      <!-- Platforms List -->
      <section id="platforms" class="mt-14">
        <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">Platforms</h2>
        <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70">
          <a href="https://www.tfunions.com" class="py-4 flex items-center justify-between hover:bg-[#F5F5F7]/60 px-1 transition">
            <div>
              <div class="text-[12px] text-[#6E6E73]">www.tfunions.com</div>
              <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">TF Unions Foundation</div>
            </div>
            <span class="text-[13px] text-[#002583] font-semibold">Open ›</span>
          </a>
          <a href="https://news.tfunions.com" class="py-4 flex items-center justify-between hover:bg-[#F5F5F7]/60 px-1 transition">
            <div>
              <div class="text-[12px] text-[#6E6E73]">news.tfunions.com</div>
              <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">TF News — Scholarships, Admissions &amp; Programs</div>
            </div>
            <span class="text-[13px] text-[#002583] font-semibold">Open ›</span>
          </a>
          <a href="https://guides.tfunions.com" class="py-4 flex items-center justify-between hover:bg-[#F5F5F7]/60 px-1 transition">
            <div>
              <div class="text-[12px] text-[#6E6E73]">guides.tfunions.com</div>
              <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">TF Guides — STEM, Olympiad &amp; Research Roadmaps</div>
            </div>
            <span class="text-[13px] text-[#002583] font-semibold">Open ›</span>
          </a>
          <a href="https://connect.tfunions.com" class="py-4 flex items-center justify-between hover:bg-[#F5F5F7]/60 px-1 transition">
            <div>
              <div class="text-[12px] text-[#6E6E73]">connect.tfunions.com</div>
              <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">TF Connect — Study Circles &amp; Mentorship Cohorts</div>
            </div>
            <span class="text-[13px] text-[#002583] font-semibold">Open ›</span>
          </a>
          <a href="https://auth.tfunions.com" class="py-4 flex items-center justify-between hover:bg-[#F5F5F7]/60 px-1 transition">
            <div>
              <div class="text-[12px] text-[#6E6E73]">auth.tfunions.com</div>
              <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Unified Single Sign-On</div>
            </div>
            <span class="text-[13px] text-[#002583] font-semibold">Open ›</span>
          </a>
          <a href="https://verify.tfunions.com" class="py-4 flex items-center justify-between hover:bg-[#F5F5F7]/60 px-1 transition">
            <div>
              <div class="text-[12px] text-[#6E6E73]">verify.tfunions.com</div>
              <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Certificate Verification Registry</div>
            </div>
            <span class="text-[13px] text-[#002583] font-semibold">Open ›</span>
          </a>
        </div>
      </section>

      <!-- Unified Account Section -->
      <section id="account" class="mt-16">
        <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">One account, every service</h2>
        <div class="mt-4 rounded-[20px] bg-[#F5F5F7] p-7">
          <p class="text-[15px] leading-[1.6] text-[#1D1D1F]">
            Your TF account at <a href="https://auth.tfunions.com" class="text-[#002583] font-medium hover:underline">auth.tfunions.com</a> sets a shared session across <span class="font-mono text-[14px]">*.tfunions.com</span>. Sign in once to access TF News, TF Guides, TF Connect, and volunteer tools without creating separate logins.
          </p>
        </div>
      </section>

      <!-- FAQ Section -->
      <section id="faq" class="mt-16">
        <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">Frequently asked questions</h2>
        <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70">
          <div class="py-5">
            <h3 class="text-[16px] font-semibold text-[#1D1D1F]">What is TF Unions?</h3>
            <p class="mt-1.5 text-[15px] leading-[1.5] text-[#6E6E73]">
              An independent non-profit educational initiative founded by Mohammed Farag and Mohammed Abdelghany to help ambitious students in Egypt achieve their science, research, and university goals.
            </p>
          </div>
          <div class="py-5">
            <h3 class="text-[16px] font-semibold text-[#1D1D1F]">Do I need to attend a STEM school?</h3>
            <p class="mt-1.5 text-[15px] leading-[1.5] text-[#6E6E73]">
              No. TF Unions is open to students across Thanaweya Amma, STEM schools, IGCSE, American Diploma, Azhar, Prep schools, and universities.
            </p>
          </div>
          <div class="py-5">
            <h3 class="text-[16px] font-semibold text-[#1D1D1F]">Do I need top grades to join?</h3>
            <p class="mt-1.5 text-[15px] leading-[1.5] text-[#6E6E73]">
              No. What matters is having meaningful goals, curiosity, and the initiative to learn and build.
            </p>
          </div>
          <div class="py-5">
            <h3 class="text-[16px] font-semibold text-[#1D1D1F]">Is every TF Unions service free for students?</h3>
            <p class="mt-1.5 text-[15px] leading-[1.5] text-[#6E6E73]">
              Yes. Every student resource, opportunity database, and roadmap is free of charge and free of advertisements.
            </p>
          </div>
        </div>
      </section>
    </div>
  </body>
</html>
