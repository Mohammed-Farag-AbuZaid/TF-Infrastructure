---
export interface Props {
  title: string;
  description?: string;
  backLabel?: string;
  backHref?: string;
}

const {
  title,
  description = 'TF Unions — Helping ambitious students in Egypt achieve their science, research, and university goals.',
  backLabel,
  backHref = '/',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — TF Unions</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script defer src="https://analytics.tfunions.com/script.js" data-website-id="tfunions-foundation"></script>
  </head>
  <body class="min-h-screen bg-white text-[#1D1D1F] font-['Inter',-apple-system,BlinkMacSystemFont,sans-serif] antialiased selection:bg-[#002583]/15 selection:text-[#002583]">
    <div class="max-w-[1000px] mx-auto px-6 pb-20">
      <!-- TfTopBar (64px height, 0.5px #D2D2D7 bottom hairline) -->
      <header class="h-16 border-b border-[#D2D2D7]/70 flex items-center justify-between gap-4">
        <div class="flex items-center gap-6">
          {backLabel ? (
            <a href={backHref} class="text-[15px] font-medium text-[#002583] hover:opacity-75 transition flex items-center gap-1">
              <span>‹</span> {backLabel}
            </a>
          ) : (
            <a href="/" class="text-[17px] font-bold tracking-[-0.2px] text-[#1D1D1F]">
              TF Unions
            </a>
          )}
          <nav class="hidden md:flex items-center gap-6 text-[14px] text-[#6E6E73]">
            <a href="/about" class="hover:text-[#1D1D1F] transition">About</a>
            <a href="/team" class="hover:text-[#1D1D1F] transition">Team</a>
            <a href="/volunteer" class="hover:text-[#1D1D1F] transition">Volunteer</a>
            <a href="/ideas" class="hover:text-[#1D1D1F] transition">Ideas</a>
            <a href="/transparency" class="hover:text-[#1D1D1F] transition">Ledger</a>
            <a href="https://docs.tfunions.com" class="hover:text-[#1D1D1F] transition">Docs</a>
          </nav>
        </div>

        <div class="flex items-center gap-5" id="sso-nav-slot">
          <a
            href="https://auth.tfunions.com/?redirect_to=https://www.tfunions.com"
            class="text-[14px] font-semibold text-[#002583] hover:opacity-75 transition"
          >
            Sign in
          </a>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <!-- Minimal Hairline Footer -->
      <footer class="mt-24 pt-8 border-t border-[#D2D2D7]/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[13px] text-[#6E6E73]">
        <div>
          <span class="font-semibold text-[#1D1D1F]">TF Unions</span> — Founded by Mohammed Farag &amp; Mohammed Abdelghany.
        </div>
        <div class="flex flex-wrap items-center gap-5">
          <a href="https://news.tfunions.com" class="hover:text-[#1D1D1F] transition">TF News</a>
          <a href="https://guides.tfunions.com" class="hover:text-[#1D1D1F] transition">TF Guides</a>
          <a href="https://connect.tfunions.com" class="hover:text-[#1D1D1F] transition">TF Connect</a>
          <a href="https://verify.tfunions.com" class="hover:text-[#1D1D1F] transition">Verify</a>
          <a href="/charter" class="hover:text-[#1D1D1F] transition">Charter</a>
          <a href="/support" class="hover:text-[#1D1D1F] transition">Support</a>
          <a href="https://status.tfunions.com" class="hover:text-[#1D1D1F] transition">Status</a>
        </div>
      </footer>
    </div>

    <script src="/widgets/tf-qa-widget.js" defer></script>
    <tf-qa-widget service="Foundation_Portal"></tf-qa-widget>

    <script is:inline>
      (function () {
        try {
          const match = document.cookie.match(/(?:^|;\s*)tf_user_hint=([^;]*)/);
          const localUser = localStorage.getItem('tf_sso_user');
          let hint = null;
          if (match) {
            hint = JSON.parse(decodeURIComponent(match[1]));
          } else if (localUser) {
            const parsed = JSON.parse(localUser);
            hint = { name: parsed.full_name || parsed.firstName || parsed.name };
          }
          if (hint && hint.name) {
            const slot = document.getElementById('sso-nav-slot');
            if (slot) {
              slot.innerHTML = `<span class="text-[14px] text-[#6E6E73]">${hint.name}</span>`;
            }
          }
        } catch {}
      })();
    </script>
  </body>
</html>
