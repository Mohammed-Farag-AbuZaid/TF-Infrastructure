---
export interface Props {
  title: string;
  description?: string;
  backLabel?: string;
  backHref?: string;
}

const {
  title,
  description = 'TF Unions — Egyptian STEM & University Union. Verified admissions, Olympiad & research roadmaps, regional study chapters, and open financial ledger.',
  backLabel,
  backHref = '/',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Team', href: '/team' },
  { label: 'Volunteer', href: '/volunteer' },
  { label: 'Ideas', href: '/ideas' },
  { label: 'Ledger', href: '/transparency' },
  { label: 'Support', href: '/support' },
];

const ecosystemLinks = [
  { label: 'Foundation', href: 'https://www.tfunions.com', active: true },
  { label: 'TF News', href: 'https://news.tfunions.com' },
  { label: 'TF Guides', href: 'https://guides.tfunions.com' },
  { label: 'TF Connect', href: 'https://connect.tfunions.com' },
  { label: 'Verify Registry', href: 'https://verify.tfunions.com' },
  { label: 'Docs', href: 'https://docs.tfunions.com' },
];

const faviconSvg = encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="6" fill="#0A1931"/><rect x="2" y="2" width="28" height="28" rx="4" fill="none" stroke="#1E3A6D" stroke-width="1.5"/><rect x="22" y="5" width="5" height="5" rx="1" fill="#C88A14"/><path d="M6.5 9.5h11.5v2.7h-4.2V23h-3V12.2H6.5V9.5zm10.8 0H25v2.7h-4.7v2.9h3.9v2.6h-3.9V23h-3V9.5z" fill="#fff"/></svg>`
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — TF Unions</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — TF Unions`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0A1931" />
    <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,${faviconSvg}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,500..700;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script defer src="https://analytics.tfunions.com/script.js" data-website-id="tfunions-foundation"></script>
    <style is:global>
      :root {
        --tf-navy: #0A1931;
        --tf-navy-mid: #102447;
        --tf-navy-border: #1E3A6D;
        --tf-stone: #ECEAE4;
        --tf-sand: #E2DFD7;
        --tf-paper: #FFFFFF;
        --tf-border: #CFCBC2;
        --tf-cobalt: #14388C;
        --tf-brass: #C88A14;
        --tf-ink: #12161F;
        --tf-slate: #4A5262;
      }
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: #ECEAE4;
        color: #12161F;
      }
      .font-display {
        font-family: 'Newsreader', Georgia, serif;
      }
      .font-code {
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }
      *:focus-visible {
        outline: 2px solid #C88A14;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#ECEAE4] text-[#12161F] antialiased selection:bg-[#14388C]/20 selection:text-[#0A1931] flex flex-col">
    <!-- Top Institutional Portal Switcher -->
    <div class="bg-[#061022] border-b border-[#1E3A6D] text-[#CBD5E1]">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-10 flex items-center justify-between gap-4 overflow-x-auto">
        <div class="flex items-stretch h-full gap-1 shrink-0 text-[12px]">
          {ecosystemLinks.map((item) => (
            <a
              href={item.href}
              class={
                item.active
                  ? 'px-3.5 flex items-center font-semibold text-white bg-[#0A1931] border-t-2 border-t-[#C88A14] border-x border-[#1E3A6D] whitespace-nowrap'
                  : 'px-3 flex items-center text-[#94A3B8] hover:text-white hover:bg-[#102447]/60 transition whitespace-nowrap'
              }
            >
              {item.label}
            </a>
          ))}
        </div>
        <a
          href="https://auth.tfunions.com/?redirect_to=https://www.tfunions.com"
          class="hidden sm:inline-flex items-center gap-1.5 text-[12px] font-medium text-[#CBD5E1] hover:text-[#C88A14] transition whitespace-nowrap"
        >
          TF Passport SSO ›
        </a>
      </div>
    </div>

    <!-- Main Deep Oxford Navy Masthead -->
    <header class="bg-[#0A1931] border-b border-[#1E3A6D] text-white sticky top-0 z-40 shadow-[0_2px_10px_rgba(10,25,49,0.16)]">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-[72px] flex items-center justify-between gap-4">
        <div class="flex items-center gap-7">
          <a href={backLabel ? backHref : '/'} class="flex items-center gap-3 group shrink-0">
            <svg width="34" height="34" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0 rounded-md">
              <rect width="32" height="32" rx="6" fill="#14388C" />
              <rect x="0.75" y="0.75" width="30.5" height="30.5" rx="5.25" stroke="#1E3A6D" stroke-width="1.5" />
              <rect x="22.5" y="5" width="4.5" height="4.5" rx="1" fill="#C88A14" />
              <path d="M6.8 9.5H18.2V12.2H14V23H11V12.2H6.8V9.5ZM17.6 9.5H25V12.2H20.6V15.1H24.4V17.7H20.6V23H17.6V9.5Z" fill="#FFFFFF" />
            </svg>
            <div class="flex flex-col">
              {backLabel ? (
                <span class="font-display text-[19px] font-bold tracking-[-0.015em] text-white group-hover:text-[#C88A14] transition leading-tight">
                  ‹ {backLabel}
                </span>
              ) : (
                <span class="font-display text-[22px] font-bold tracking-[-0.02em] text-white leading-none">
                  TF Unions
                </span>
              )}
              <span class="text-[11px] text-[#94A3B8] font-medium mt-0.5 leading-none">
                Egyptian STEM &amp; University Union
              </span>
            </div>
          </a>

          <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
            {navLinks.map((link) => {
              const isActive = pathname === link.href;
              return (
                <a
                  href={link.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={
                    isActive
                      ? 'px-3.5 py-2 rounded-md text-[13.5px] font-semibold text-white bg-[#102447] border border-[#1E3A6D] border-b-2 border-b-[#C88A14]'
                      : 'px-3.5 py-2 rounded-md text-[13.5px] font-medium text-[#CBD5E1] hover:text-white hover:bg-[#102447]/70 transition'
                  }
                >
                  {link.label}
                </a>
              );
            })}
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <div id="sso-nav-slot" class="flex items-center gap-2">
            <a
              href="https://auth.tfunions.com/?redirect_to=https://www.tfunions.com"
              class="inline-flex items-center justify-center h-9 px-4 rounded-md bg-[#C88A14] hover:bg-[#B2790E] text-[#0A1931] text-[13px] font-bold transition"
            >
              Sign in
            </a>
          </div>

          <button
            id="mobile-menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label="Toggle navigation menu"
            class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-md bg-[#102447] border border-[#1E3A6D] text-white hover:border-[#C88A14] transition"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-nav-drawer" class="hidden md:hidden border-t border-[#1E3A6D] bg-[#0A1931] px-4 py-4 space-y-1">
        {navLinks.map((link) => {
          const isActive = pathname === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={
                isActive
                  ? 'block px-3.5 py-2.5 rounded-md text-[14px] font-semibold text-white bg-[#102447] border-l-2 border-[#C88A14]'
                  : 'block px-3.5 py-2.5 rounded-md text-[14px] font-medium text-[#CBD5E1] hover:text-white hover:bg-[#102447]'
              }
            >
              {link.label}
            </a>
          );
        })}
        <div class="pt-3 mt-3 border-t border-[#1E3A6D] grid grid-cols-2 gap-2 text-[13px]">
          <a href="https://news.tfunions.com" class="px-3 py-2 rounded-md bg-[#102447] border border-[#1E3A6D] font-medium text-white">TF News</a>
          <a href="https://guides.tfunions.com" class="px-3 py-2 rounded-md bg-[#102447] border border-[#1E3A6D] font-medium text-white">TF Guides</a>
          <a href="https://connect.tfunions.com" class="px-3 py-2 rounded-md bg-[#102447] border border-[#1E3A6D] font-medium text-white">TF Connect</a>
          <a href="https://verify.tfunions.com" class="px-3 py-2 rounded-md bg-[#102447] border border-[#1E3A6D] font-medium text-white">Verify Registry</a>
        </div>
      </div>
    </header>

    <!-- Warm Stone Page Canvas Container -->
    <main class="flex-1 w-full max-w-[1200px] mx-auto px-4 sm:px-6 pb-20">
      <slot />
    </main>

    <!-- Dark Navy Institutional Footer -->
    <footer class="bg-[#0A1931] text-[#CBD5E1] border-t-2 border-[#C88A14] mt-auto">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-[13px]">
        <div>
          <div class="flex items-center gap-2.5">
            <svg width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="rounded-md">
              <rect width="32" height="32" rx="6" fill="#14388C" />
              <rect x="22.5" y="5" width="4.5" height="4.5" rx="1" fill="#C88A14" />
              <path d="M6.8 9.5H18.2V12.2H14V23H11V12.2H6.8V9.5ZM17.6 9.5H25V12.2H20.6V15.1H24.4V17.7H20.6V23H17.6V9.5Z" fill="#FFFFFF" />
            </svg>
            <span class="font-display text-[17px] font-bold text-white">TF Unions</span>
          </div>
          <p class="mt-3 text-[#94A3B8] leading-[1.6]">
            Independent non-profit student academic union empowering STEM and university scholars across all 27 Egyptian governorates.
          </p>
          <p class="mt-3 text-[12px] text-[#CBD5E1]">
            Founded by Mohammed Farag &amp; Mohammed Abdelghany.
          </p>
        </div>

        <div>
          <div class="text-[12px] font-bold text-white border-b border-[#1E3A6D] pb-2">Student Platforms</div>
          <ul class="mt-3 space-y-2 text-[#CBD5E1]">
            <li><a href="https://news.tfunions.com" class="hover:text-[#C88A14] transition">TF News &amp; Admissions</a></li>
            <li><a href="https://guides.tfunions.com" class="hover:text-[#C88A14] transition">TF Guides &amp; Roadmaps</a></li>
            <li><a href="https://connect.tfunions.com" class="hover:text-[#C88A14] transition">TF Connect Chapters</a></li>
            <li><a href="https://auth.tfunions.com" class="hover:text-[#C88A14] transition">TF Passport Single Sign-On</a></li>
          </ul>
        </div>

        <div>
          <div class="text-[12px] font-bold text-white border-b border-[#1E3A6D] pb-2">Foundation</div>
          <ul class="mt-3 space-y-2 text-[#CBD5E1]">
            <li><a href="/about" class="hover:text-[#C88A14] transition">About &amp; Mission</a></li>
            <li><a href="/team" class="hover:text-[#C88A14] transition">71-Member Team Constellation</a></li>
            <li><a href="/volunteer" class="hover:text-[#C88A14] transition">Volunteer Tracks</a></li>
            <li><a href="/ideas" class="hover:text-[#C88A14] transition">Student Idea Incubator</a></li>
          </ul>
        </div>

        <div>
          <div class="text-[12px] font-bold text-white border-b border-[#1E3A6D] pb-2">Accountability &amp; API</div>
          <ul class="mt-3 space-y-2 text-[#CBD5E1]">
            <li><a href="https://verify.tfunions.com" class="hover:text-[#C88A14] transition">Verify Certificate Serial</a></li>
            <li><a href="/transparency" class="hover:text-[#C88A14] transition">Open Financial Ledger</a></li>
            <li><a href="/charter" class="hover:text-[#C88A14] transition">Non-Profit Charter</a></li>
            <li><a href="https://docs.tfunions.com" class="hover:text-[#C88A14] transition">Documentation &amp; API</a></li>
            <li><a href="https://status.tfunions.com" class="hover:text-[#C88A14] transition">System Status</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-[#1E3A6D] bg-[#061022]">
        <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[12px] text-[#94A3B8]">
          <span>© 2025–2026 TF Unions Foundation. Open access and ad-free for all students.</span>
          <a href="/support" class="font-semibold text-[#C88A14] hover:underline">Support the Mission ›</a>
        </div>
      </div>
    </footer>

    <script src="/widgets/tf-qa-widget.js" defer></script>
    <tf-qa-widget service="Foundation_Portal"></tf-qa-widget>

    <script is:inline>
      (function () {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const drawer = document.getElementById('mobile-nav-drawer');
        if (toggleBtn && drawer) {
          toggleBtn.addEventListener('click', () => {
            const isHidden = drawer.classList.toggle('hidden');
            toggleBtn.setAttribute('aria-expanded', String(!isHidden));
          });
        }

        // XSS-safe SSO session display + sign out
        try {
          const match = document.cookie.match(/(?:^|;\s*)tf_user_hint=([^;]*)/);
          const localUser = localStorage.getItem('tf_sso_user');
          let hint = null;
          if (match) {
            hint = JSON.parse(decodeURIComponent(match[1]));
          } else if (localUser) {
            const parsed = JSON.parse(localUser);
            hint = { name: parsed.full_name || parsed.firstName || parsed.name };
          }
          if (hint && hint.name) {
            const slot = document.getElementById('sso-nav-slot');
            if (slot) {
              slot.replaceChildren();

              const badge = document.createElement('a');
              badge.href = 'https://auth.tfunions.com';
              badge.className = 'inline-flex items-center gap-2 h-9 px-3 rounded-md bg-[#102447] border border-[#1E3A6D] text-[13px] font-semibold text-white hover:border-[#C88A14] transition';
              badge.textContent = String(hint.name).slice(0, 32);

              const signOutBtn = document.createElement('button');
              signOutBtn.type = 'button';
              signOutBtn.className = 'h-9 px-3 rounded-md bg-transparent border border-[#1E3A6D] text-[12px] font-semibold text-[#CBD5E1] hover:text-white hover:border-white/50 transition';
              signOutBtn.textContent = 'Sign out';
              signOutBtn.addEventListener('click', async () => {
                try {
                  await fetch('https://n8n.tfunions.com/tf-api/api/sessionLogout', {
                    method: 'POST',
                    credentials: 'include',
                  });
                } catch {}
                document.cookie = 'tf_user_hint=; Secure; SameSite=Lax; Domain=.tfunions.com; Path=/; Max-Age=0';
                localStorage.removeItem('tf_sso_token');
                localStorage.removeItem('tf_sso_user');
                window.location.reload();
              });

              slot.appendChild(badge);
              slot.appendChild(signOutBtn);
            }
          }
        } catch {}
      })();
    </script>
  </body>
</html>
