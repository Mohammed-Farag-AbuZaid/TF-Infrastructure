---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'TF Unions â€” An independent non-profit educational ecosystem helping ambitious students across Egypt achieve their STEM, research, and innovation goals.',
} = Astro.props;
---
<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | TF Unions</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Privacy-First Analytics (Umami on analytics.tfunions.com) -->
    <script defer src="https://analytics.tfunions.com/script.js" data-website-id="tfunions-foundation"></script>
  </head>
  <body class="min-h-screen bg-[#070E24] text-white font-['Inter',sans-serif] flex flex-col selection:bg-[#FFB800] selection:text-[#070E24]">
    <!-- Top Unified Ecosystem Navbar -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-[#070E24]/85 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <span class="w-9 h-9 rounded-lg bg-[#002583] border border-[#FFB800]/50 flex items-center justify-center font-['Exo_2'] font-extrabold text-[#FFB800] text-lg group-hover:scale-105 transition">
            TF
          </span>
          <div>
            <span class="font-['Exo_2'] font-bold text-lg tracking-tight text-white">TF Unions</span>
            <span class="hidden sm:inline-block ml-2 text-[10px] font-semibold uppercase tracking-widest px-2 py-0.5 rounded bg-[#FFB800]/15 text-[#FFB800]">
              Foundation OS
            </span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/about" class="hover:text-[#FFB800] transition">About</a>
          <a href="/charter" class="hover:text-[#FFB800] transition">Charter</a>
          <a href="/team" class="hover:text-[#FFB800] transition">Team</a>
          <a href="/volunteer" class="hover:text-[#FFB800] transition">Volunteer</a>
          <a href="/ideas" class="hover:text-[#FFB800] transition">Idea Incubator</a>
          <a href="/support" class="hover:text-[#FFB800] transition">Support</a>
          <a href="/transparency" class="hover:text-[#FFB800] transition">Open Ledger</a>
          <a href="https://tf-verify-portal.pages.dev" class="hover:text-[#FFB800] transition">Verify Cert</a>
          <a href="https://tf-docs-portal.pages.dev" class="hover:text-[#FFB800] transition">Docs ↗</a>
        </nav>

        <!-- Dynamic SSO User Hint Slot -->
        <div class="flex items-center gap-3" id="sso-nav-slot">
          <a
            href="https://tf-auth-hub.pages.dev/?redirect_to=https://tf-foundation-portal.pages.dev"
            class="px-4 py-2 rounded-xl bg-[#FFB800] hover:bg-[#ffc633] text-[#070E24] font-['Exo_2'] font-bold text-xs transition shadow"
          >
            Unified Sign In →
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Ecosystem Footer -->
    <footer class="border-t border-white/10 bg-[#050A1A] py-12 px-6 mt-20">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 text-sm">
        <div>
          <div class="flex items-center gap-2.5 mb-3">
            <span class="w-7 h-7 rounded bg-[#002583] border border-[#FFB800]/50 flex items-center justify-center font-['Exo_2'] font-extrabold text-[#FFB800] text-sm">TF</span>
            <span class="font-['Exo_2'] font-bold text-base">TF Unions</span>
          </div>
          <p class="text-slate-400 text-xs leading-relaxed">
            An independent non-profit educational ecosystem helping ambitious students across Egypt achieve their science, research, and innovation goals.
          </p>
          <p class="mt-3 text-xs text-[#FFB800] font-semibold">"Ø²ÙƒØ§Ø© Ø§Ù„Ø¹Ù„Ù… Ù†Ø´Ø±Ù‡ â€” Sharing knowledge is a responsibility."</p>
        </div>

        <div>
          <h4 class="font-['Exo_2'] font-bold text-xs uppercase tracking-wider text-slate-300 mb-3">Ecosystem Services</h4>
          <ul class="space-y-2 text-xs text-slate-400">
            <li><a href="https://news.tfunions.com" class="hover:text-white">TF News â€” Opportunities &amp; 1,500+ Universities</a></li>
            <li><a href="https://connect.tfunions.com" class="hover:text-white">TF Connect â€” Peer &amp; Senior Cohorts</a></li>
            <li><a href="https://guide.tfunions.com" class="hover:text-white">TF Guide â€” STEM Study Roadmaps</a></li>
            <li><a href="https://verify.tfunions.com" class="hover:text-white">Credential &amp; Certificate Verifier</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-['Exo_2'] font-bold text-xs uppercase tracking-wider text-slate-300 mb-3">Foundation Governance</h4>
          <ul class="space-y-2 text-xs text-slate-400">
            <li><a href="/about" class="hover:text-white">Mission, Vision &amp; Values</a></li>
            <li><a href="/charter" class="hover:text-white">Official Non-Profit Charter</a></li>
            <li><a href="/team" class="hover:text-white">Founders &amp; Contributors Wall</a></li>
            <li><a href="/transparency" class="hover:text-white">100% Open-Book Financial Ledger</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-['Exo_2'] font-bold text-xs uppercase tracking-wider text-slate-300 mb-3">Infrastructure &amp; Trust</h4>
          <ul class="space-y-2 text-xs text-slate-400">
            <li><a href="https://status.tfunions.com" class="hover:text-white">ðŸŸ¢ Live Ecosystem Status (Uptime Kuma)</a></li>
            <li><a href="https://docs.tfunions.com" class="hover:text-white">Official Wiki &amp; FAQ</a></li>
            <li><a href="/volunteer" class="hover:text-white">Join Seasonal Volunteer Cohort</a></li>
            <li><a href="/ideas" class="hover:text-white">Propose a Student Project</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
        <p>Copyright Â© 2026 TF Unions (formerly Altafawwoq Union). Founded by Mohammed Farag &amp; Mohammed Abdelghany.</p>
        <p class="mt-2 sm:mt-0">One account. All TF Unions services.</p>
      </div>
    </footer>

    <!-- Global QA & Bug Reporter Web Component -->
    <script src="/widgets/tf-qa-widget.js" defer></script>
    <tf-qa-widget service="Foundation_Portal"></tf-qa-widget>

    <!-- Instant Root-Domain `tf_user_hint` Cookie Hydration -->
    <script is:inline>
      (function () {
        try {
          const match = document.cookie.match(/(?:^|;\s*)tf_user_hint=([^;]*)/);
          if (!match) return;
          const hint = JSON.parse(decodeURIComponent(match[1]));
          if (hint && hint.name) {
            const slot = document.getElementById('sso-nav-slot');
            if (slot) {
              slot.innerHTML = `
                <span class="px-3 py-1.5 rounded-xl bg-[#002583]/80 border border-[#FFB800]/40 text-xs font-semibold text-white flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  ${hint.name} <span class="text-[10px] uppercase text-[#FFB800]">(${hint.role || 'student'})</span>
                </span>
              `;
            }
          }
        } catch {}
      })();
    </script>
  </body>
</html>

