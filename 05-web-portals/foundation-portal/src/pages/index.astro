---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: 'TF News',
    subtitle: 'Scholarships, internships, programs, and admission pathways for 1,500+ universities.',
    stat: '1,500+ universities',
    href: 'https://news.tfunions.com',
  },
  {
    title: 'TF Guides',
    subtitle: 'Step-by-step roadmaps for Olympiads, scientific research, and university preparation.',
    stat: 'guides.tfunions.com',
    href: 'https://guides.tfunions.com',
  },
  {
    title: 'TF Connect',
    subtitle: 'Peer study circles and senior mentorship cohorts connecting students across Egypt.',
    stat: 'connect.tfunions.com',
    href: 'https://connect.tfunions.com',
  },
  {
    title: 'Volunteer & Incubator',
    subtitle: 'Join seasonal contributor tracks or propose and upvote student-built tools.',
    stat: '27 governorates',
    href: '/volunteer',
  },
];

const foundationRows = [
  { category: 'Mission', title: 'About TF Unions & Charter', meta: 'Non-profit', href: '/about' },
  { category: 'People', title: 'Founders & Contributors Directory', meta: 'Team', href: '/team' },
  { category: 'Join', title: 'Apply for Seasonal Volunteer Tracks', meta: 'Open', href: '/volunteer' },
  { category: 'Community', title: 'Student Project & Idea Incubator', meta: 'Vote', href: '/ideas' },
  { category: 'Registry', title: 'Verify a TF Unions Certificate', meta: 'verify.tfunions.com', href: 'https://verify.tfunions.com' },
  { category: 'Finances', title: 'Open-Book Financial Ledger & Support', meta: '100% public', href: '/transparency' },
];
---
<BaseLayout title="Home">
  <!-- Intro (matches _intro in home_page.dart) -->
  <section class="mt-14 sm:mt-[88px]">
    <h1
      class="font-bold text-[#1D1D1F] leading-[1.08] tracking-[-1.5px] sm:tracking-[-2px]"
      style="font-size: clamp(36px, 6vw, 64px);"
    >
      Science &amp; opportunity,<br />all in one place.
    </h1>
    <p class="mt-[18px] text-[18px] leading-[1.45] text-[#6E6E73] max-w-[640px]">
      Open tools, verified university pathways, and study communities for ambitious students across Egypt.
    </p>
  </section>

  <!-- Four Equal Section Tiles (matches _SectionTile in home_page.dart) -->
  <section class="mt-14 sm:mt-20 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {sections.map((s) => (
      <a
        href={s.href}
        class="group flex flex-col justify-between bg-[#F5F5F7] hover:bg-[#ECECEE] rounded-[20px] p-7 min-h-[216px] transition"
      >
        <div>
          <h2 class="text-[24px] font-bold tracking-[-0.5px] leading-[1.2] text-[#1D1D1F]">
            {s.title}
          </h2>
          <p class="mt-2 text-[15px] leading-[1.45] text-[#6E6E73]">
            {s.subtitle}
          </p>
        </div>
        <div class="mt-6 flex items-center justify-between">
          <span class="text-[13px] text-[#6E6E73]">{s.stat}</span>
          <span class="text-[15px] font-semibold text-[#002583] flex items-center gap-1">
            Explore <span class="text-[18px] leading-none">›</span>
          </span>
        </div>
      </a>
    ))}
  </section>

  <!-- Two Plain Lists (matches _lists in home_page.dart) -->
  <section class="mt-16 sm:mt-24 grid grid-cols-1 md:grid-cols-2 gap-14">
    <!-- Left Column: Live Opportunities from VPS PostgreSQL -->
    <div>
      <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">Latest opportunities</h2>
      <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70" id="live-opps-list">
        <div class="py-4 flex items-center justify-between">
          <div>
            <div class="text-[12px] text-[#6E6E73]">Loading</div>
            <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Fetching live opportunities...</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Foundation & Ecosystem Directory -->
    <div>
      <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">Foundation</h2>
      <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70">
        {foundationRows.map((r) => (
          <a href={r.href} class="py-4 px-0.5 flex items-center justify-between hover:bg-black/[0.02] transition">
            <div class="pr-4">
              <div class="text-[12px] text-[#6E6E73]">{r.category}</div>
              <div class="text-[16px] font-semibold text-[#1D1D1F] leading-[1.3] mt-0.5">{r.title}</div>
            </div>
            <span class="text-[13px] text-[#6E6E73] shrink-0">{r.meta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (async () => {
      const container = document.getElementById('live-opps-list');
      if (!container) return;
      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/opportunities');
        const data = await res.json();
        const list = (data.opportunities || []).slice(0, 6);
        if (list.length === 0) {
          container.innerHTML = `<div class="py-6 text-[15px] text-[#6E6E73]">No opportunities listed right now.</div>`;
          return;
        }
        container.innerHTML = list
          .map(
            (o) => `
            <a href="https://news.tfunions.com" class="py-4 px-0.5 flex items-center justify-between hover:bg-black/[0.02] transition">
              <div class="pr-4">
                <div class="text-[12px] text-[#6E6E73]">${o.category || o.section || 'Opportunity'}</div>
                <div class="text-[16px] font-semibold text-[#1D1D1F] leading-[1.3] mt-0.5 line-clamp-1">${o.title}</div>
              </div>
              <span class="text-[13px] text-[#6E6E73] shrink-0">${o.topic || 'Explore'}</span>
            </a>
          `
          )
          .join('');
      } catch {
        container.innerHTML = `<div class="py-6 text-[15px] text-[#6E6E73]">Explore all opportunities on <a href="https://news.tfunions.com" class="text-[#002583] font-medium">news.tfunions.com</a>.</div>`;
      }
    })();
  </script>
</BaseLayout>
