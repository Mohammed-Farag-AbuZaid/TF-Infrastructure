---
import BaseLayout from '../layouts/BaseLayout.astro';

const platforms = [
  {
    code: 'PORTAL · NEWS',
    title: 'TF News & Admissions',
    subtitle: 'Curated scholarships, international summer programs, internships, and admission pathways across 1,500+ universities.',
    stat: '1,500+ university pathways',
    href: 'https://news.tfunions.com',
    cta: 'Open TF News',
  },
  {
    code: 'ROADMAPS · GUIDES',
    title: 'TF Guides',
    subtitle: 'Structured, step-by-step protocols for STEM research, ISEF fairs, scientific writing, and international Olympiads.',
    stat: 'guides.tfunions.com',
    href: 'https://guides.tfunions.com',
    cta: 'Browse Guides',
  },
  {
    code: 'NETWORK · CONNECT',
    title: 'TF Connect',
    subtitle: 'Peer study circles, regional student union chapters, project guilds, and alumni mentorship cohorts across Egypt.',
    stat: 'connect.tfunions.com',
    href: 'https://connect.tfunions.com',
    cta: 'Explore Chapters',
  },
  {
    code: 'STOREFRONT · LABS',
    title: 'STEM Shop & Resources',
    subtitle: 'Student hardware kits, lab components, and zero-markup technical supplies curated for STEM & Capstone builds.',
    stat: 'Volunteer & Idea Hub',
    href: '/volunteer',
    cta: 'Join & Build',
  },
];

const foundationRows = [
  { category: 'People', title: 'Interactive Team Constellation (71 Members)', meta: 'team', href: '/team' },
  { category: 'Mission', title: 'About TF Unions & Institutional Charter', meta: 'charter', href: '/about' },
  { category: 'Join', title: 'Apply for Seasonal Volunteer Tracks', meta: 'Open', href: '/volunteer' },
  { category: 'Community', title: 'Student Project & Idea Incubator', meta: 'Vote', href: '/ideas' },
  { category: 'Registry', title: 'Verify a TF Unions Certificate Serial', meta: 'verify.tfunions.com', href: 'https://verify.tfunions.com' },
  { category: 'Finances', title: 'Open-Book Financial Ledger & Support', meta: '100% public', href: '/transparency' },
];

const metrics = [
  { label: 'Active Leaders & Contributors', value: '71', accent: 'text-[#002583]' },
  { label: 'University Pathways', value: '1,500+', accent: 'text-[#11141C]' },
  { label: 'Egyptian Governorates', value: '27', accent: 'text-[#11141C]' },
  { label: 'Recurring SaaS Overhead', value: '$0 / mo', accent: 'text-[#15803D]' },
];
---
<BaseLayout title="Home">
  <!-- Elevated Hero Architectural Card -->
  <section class="mt-8 sm:mt-12 bg-white border border-[#E2E5EC] rounded-2xl p-7 sm:p-11 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">
      TF UNIONS FOUNDATION · EGYPTIAN STEM &amp; UNIVERSITY SCHOLARS NETWORK
    </div>
    <h1
      class="mt-4 font-bold text-[#11141C] leading-[1.06] tracking-[-0.035em]"
      style="font-size: clamp(34px, 5.2vw, 56px);"
    >
      Science &amp; opportunity,<br />built for every student.
    </h1>
    <p class="mt-4 text-[17px] leading-[1.55] text-[#525866] max-w-[660px]">
      An independent non-profit ecosystem uniting verified university admissions, Olympia &amp; research roadmaps, regional study chapters, and open educational tools across Egypt.
    </p>

    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a
        href="/team"
        class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-[#002583] hover:bg-[#001B61] text-white text-[14px] font-semibold transition shadow-[0_1px_2px_rgba(15,23,42,0.08)]"
      >
        Explore Team Constellation ›
      </a>
      <a
        href="https://verify.tfunions.com"
        class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-white border border-[#E2E5EC] hover:border-[#002583]/40 text-[#11141C] text-[14px] font-semibold transition"
      >
        Verify a Certificate
      </a>
      <a
        href="/volunteer"
        class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-[#F3F5F8] border border-[#E2E5EC] hover:border-[#D99B00] text-[#11141C] text-[14px] font-semibold transition"
      >
        Volunteer
      </a>
    </div>

    <!-- Key Metrics Strip inside Hero Widget -->
    <div class="mt-9 pt-7 border-t border-[#E2E5EC] grid grid-cols-2 md:grid-cols-4 gap-5">
      {metrics.map((m) => (
        <div class="bg-[#F8F9FB] border border-[#E2E5EC] rounded-xl px-4 py-3.5">
          <div class={`text-[24px] sm:text-[26px] font-bold tracking-[-0.02em] ${m.accent}`}>{m.value}</div>
          <div class="text-[12px] font-medium text-[#525866] mt-0.5">{m.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Four Distinct Division Widget Cards -->
  <section class="mt-10">
    <div class="flex items-end justify-between gap-4 mb-4">
      <div>
        <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">CORE PLATFORMS</div>
        <h2 class="mt-1 text-[24px] sm:text-[28px] font-bold tracking-[-0.02em] text-[#11141C]">Ecosystem Divisions</h2>
      </div>
      <a href="https://docs.tfunions.com" class="text-[13px] font-semibold text-[#002583] hover:underline shrink-0">
        Architecture Docs ›
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {platforms.map((s) => (
        <a
          href={s.href}
          class="group flex flex-col justify-between bg-white border border-[#E2E5EC] hover:border-[#002583]/40 rounded-2xl p-6 sm:p-7 min-h-[210px] transition shadow-[0_1px_2px_rgba(15,23,42,0.04)] hover:shadow-[0_6px_16px_rgba(0,37,131,0.06)]"
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#002583]">{s.code}</span>
              <span class="w-2 h-2 rounded-sm bg-[#D99B00]" aria-hidden="true"></span>
            </div>
            <h3 class="mt-3 text-[21px] font-bold tracking-[-0.02em] text-[#11141C] group-hover:text-[#002583] transition">
              {s.title}
            </h3>
            <p class="mt-2 text-[14px] leading-[1.55] text-[#525866]">
              {s.subtitle}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#E2E5EC] flex items-center justify-between">
            <span class="text-[12px] font-mono text-[#7A8191]">{s.stat}</span>
            <span class="text-[13px] font-semibold text-[#002583] flex items-center gap-1">
              {s.cta} <span class="transition-transform group-hover:translate-x-0.5">›</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Two Elevated List Widgets: Live Opportunities + Foundation Directory -->
  <section class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-5">
    <!-- Left Widget: Live Opportunities -->
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="flex items-center justify-between gap-3 pb-4 border-b border-[#E2E5EC]">
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">LIVE FEED</div>
          <h2 class="mt-0.5 text-[20px] font-bold tracking-[-0.02em] text-[#11141C]">Latest Opportunities</h2>
        </div>
        <a href="https://news.tfunions.com" class="text-[13px] font-semibold text-[#002583] hover:underline shrink-0">
          All ›
        </a>
      </div>

      <div class="divide-y divide-[#E2E5EC]" id="live-opps-list">
        <div class="py-4">
          <div class="text-[12px] text-[#7A8191]">Syncing registry</div>
          <div class="text-[15px] font-semibold text-[#11141C] mt-0.5">Loading live opportunities...</div>
        </div>
      </div>
    </div>

    <!-- Right Widget: Foundation & Governance -->
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="flex items-center justify-between gap-3 pb-4 border-b border-[#E2E5EC]">
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">GOVERNANCE</div>
          <h2 class="mt-0.5 text-[20px] font-bold tracking-[-0.02em] text-[#11141C]">Foundation Directory</h2>
        </div>
        <a href="/charter" class="text-[13px] font-semibold text-[#002583] hover:underline shrink-0">
          Charter ›
        </a>
      </div>

      <div class="divide-y divide-[#E2E5EC]">
        {foundationRows.map((r) => (
          <a href={r.href} class="py-3.5 px-2 -mx-2 rounded-lg flex items-center justify-between hover:bg-[#F8F9FB] transition group">
            <div class="pr-4">
              <div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#7A8191]">{r.category}</div>
              <div class="text-[15px] font-semibold text-[#11141C] group-hover:text-[#002583] leading-[1.35] mt-0.5 transition">
                {r.title}
              </div>
            </div>
            <span class="text-[12px] font-medium text-[#525866] bg-[#F3F5F8] border border-[#E2E5EC] px-2.5 py-1 rounded-md shrink-0">
              {r.meta}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Ecosystem Quick Launch Directory Bar -->
  <section class="mt-10 bg-white border border-[#E2E5EC] rounded-2xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[#E2E5EC]">
      <div>
        <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">SUBDOMAIN ARCHITECTURE</div>
        <h2 class="mt-0.5 text-[20px] font-bold tracking-[-0.02em] text-[#11141C]">Every TF Unions Service in One Place</h2>
      </div>
      <a
        href="https://auth.tfunions.com/?redirect_to=https://www.tfunions.com"
        class="inline-flex items-center justify-center h-9 px-4 rounded-xl bg-[#F3F5F8] border border-[#E2E5EC] hover:border-[#002583]/40 text-[13px] font-semibold text-[#11141C] transition shrink-0"
      >
        Single Sign-On ›
      </a>
    </div>
    <div class="mt-5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <a href="/team" class="p-3.5 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 transition">
        <div class="text-[11px] font-mono text-[#7A8191]">/team</div>
        <div class="mt-1 text-[14px] font-semibold text-[#11141C]">Team Graph</div>
      </a>
      <a href="https://guides.tfunions.com" class="p-3.5 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 transition">
        <div class="text-[11px] font-mono text-[#7A8191]">guides.tf</div>
        <div class="mt-1 text-[14px] font-semibold text-[#11141C]">Roadmaps</div>
      </a>
      <a href="https://connect.tfunions.com" class="p-3.5 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 transition">
        <div class="text-[11px] font-mono text-[#7A8191]">connect.tf</div>
        <div class="mt-1 text-[14px] font-semibold text-[#11141C]">Chapters</div>
      </a>
      <a href="https://verify.tfunions.com" class="p-3.5 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 transition">
        <div class="text-[11px] font-mono text-[#7A8191]">verify.tf</div>
        <div class="mt-1 text-[14px] font-semibold text-[#11141C]">Credentials</div>
      </a>
      <a href="https://docs.tfunions.com" class="p-3.5 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 transition">
        <div class="text-[11px] font-mono text-[#7A8191]">docs.tf</div>
        <div class="mt-1 text-[14px] font-semibold text-[#11141C]">API &amp; Docs</div>
      </a>
      <a href="/transparency" class="p-3.5 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 transition">
        <div class="text-[11px] font-mono text-[#7A8191]">/ledger</div>
        <div class="mt-1 text-[14px] font-semibold text-[#11141C]">Open Ledger</div>
      </a>
    </div>
  </section>

  <script is:inline>
    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const FALLBACK_OPPS = [
      { category: 'Research Program', title: 'Pioneer Academics & Research Mentorship Pathways', topic: 'Global' },
      { category: 'Olympiad', title: 'Egyptian International Science & Engineering Fair (ISEF) Prep', topic: 'STEM' },
      { category: 'Scholarship', title: 'US & European Need-Blind Financial Aid Guide 2026–2027', topic: 'Admissions' },
      { category: 'Engineering', title: 'Open Hardware & Robotics Capstone Grant Directory', topic: 'Engineering' },
    ];

    function renderOpps(container, list) {
      container.innerHTML = list
        .map(
          (o) => `
          <a href="https://news.tfunions.com" class="py-3.5 px-2 -mx-2 rounded-lg flex items-center justify-between hover:bg-[#F8F9FB] transition group">
            <div class="pr-4">
              <div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#7A8191]">${esc(o.category || o.section || 'Opportunity')}</div>
              <div class="text-[15px] font-semibold text-[#11141C] group-hover:text-[#002583] leading-[1.35] mt-0.5 line-clamp-1 transition">${esc(o.title)}</div>
            </div>
            <span class="text-[12px] font-medium text-[#002583] bg-[#F3F5F8] border border-[#E2E5EC] px-2.5 py-1 rounded-md shrink-0">${esc(o.topic || 'Explore')}</span>
          </a>
        `
        )
        .join('');
    }

    (async () => {
      const container = document.getElementById('live-opps-list');
      if (!container) return;
      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/opportunities');
        const data = await res.json();
        const list = (data.opportunities || []).slice(0, 6);
        renderOpps(container, list.length > 0 ? list : FALLBACK_OPPS);
      } catch {
        renderOpps(container, FALLBACK_OPPS);
      }
    })();
  </script>
</BaseLayout>
