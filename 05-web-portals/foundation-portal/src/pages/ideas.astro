---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Ideas" backLabel="TF Unions" backHref="/">
  <section class="mt-14 sm:mt-20 max-w-[640px]">
    <h1 class="text-[36px] sm:text-[52px] font-bold tracking-[-1.6px] leading-[1.08] text-[#1D1D1F]">
      Idea incubator.
    </h1>
    <p class="mt-4 text-[17px] leading-[1.5] text-[#6E6E73]">
      Propose and upvote tools, study resources, and community initiatives for students in Egypt.
    </p>
  </section>

  <section class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-12">
    <!-- Left 2 cols: Ideas List -->
    <div class="md:col-span-2">
      <h2 class="text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Proposed ideas</h2>
      <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70" id="ideas-list">
        <div class="py-5 flex items-center justify-between gap-4">
          <div>
            <div class="text-[12px] text-[#6E6E73]">TF News • Planned</div>
            <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">
              Arabic-to-English Research Abstract Reviewer &amp; LaTeX Template Pack
            </div>
            <p class="text-[14px] text-[#6E6E73] mt-1">
              Checklist and peer review queue for ISEF and science fair students.
            </p>
          </div>
          <button
            type="button"
            data-id="1"
            class="upvote-btn px-3.5 py-2 rounded-[10px] bg-[#F5F5F7] hover:bg-[#ECECEE] text-[13px] font-semibold text-[#1D1D1F] shrink-0 transition"
          >
            ▲ <span class="count">142</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Right col: Propose Form -->
    <div>
      <h2 class="text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Propose an idea</h2>
      <div id="idea-alert" class="hidden mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[14px] font-medium"></div>
      <form id="idea-form" class="mt-4 space-y-3.5">
        <input
          id="idea-title"
          type="text"
          required
          placeholder="Title"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <textarea
          id="idea-desc"
          rows="4"
          required
          placeholder="What problem does this solve for students?"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        ></textarea>
        <button
          type="submit"
          class="w-full h-12 rounded-[12px] bg-[#002583] hover:opacity-95 text-white font-semibold text-[15px] transition"
        >
          Submit idea
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    const listEl = document.getElementById('ideas-list');
    const form = document.getElementById('idea-form');
    const alertBox = document.getElementById('idea-alert');

    async function loadIdeas() {
      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/ideas');
        const data = await res.json();
        const items = data.ideas || [];
        if (items.length > 0) {
          listEl.innerHTML = items
            .map(
              (item) => `
              <div class="py-5 flex items-center justify-between gap-4">
                <div>
                  <div class="text-[12px] text-[#6E6E73]">${item.source_service || 'Ecosystem'} • ${item.status || 'Open'}</div>
                  <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">${item.title}</div>
                  <p class="text-[14px] text-[#6E6E73] mt-1">${item.description || ''}</p>
                </div>
                <button
                  type="button"
                  data-id="${item.item_id}"
                  class="upvote-btn px-3.5 py-2 rounded-[10px] bg-[#F5F5F7] hover:bg-[#ECECEE] text-[13px] font-semibold text-[#1D1D1F] shrink-0 transition"
                >
                  ▲ <span class="count">${item.upvote_count || 1}</span>
                </button>
              </div>
            `
            )
            .join('');
          bindUpvotes();
        }
      } catch {}
    }

    function bindUpvotes() {
      document.querySelectorAll('.upvote-btn').forEach((btn) => {
        btn.onclick = async () => {
          const itemId = Number(btn.getAttribute('data-id'));
          const countEl = btn.querySelector('.count');
          try {
            const res = await fetch('https://n8n.tfunions.com/tf-api/api/idea-upvote', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ itemId, uid: localStorage.getItem('tf_voter_id') || 'web_' + Date.now() }),
            });
            const data = await res.json();
            if (data.upvoteCount) countEl.textContent = data.upvoteCount;
          } catch {}
        };
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.textContent = 'Submitting...';
      alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#6E6E73] text-[14px] font-medium';
      alertBox.classList.remove('hidden');
      try {
        await fetch('https://n8n.tfunions.com/tf-api/api/qa-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            submissionType: 'Project_Idea',
            service: 'Foundation_Portal',
            title: document.getElementById('idea-title').value.trim(),
            description: document.getElementById('idea-desc').value.trim(),
            pageUrl: window.location.href,
          }),
        });
        alertBox.textContent = 'Idea published.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#15803D] text-[14px] font-medium';
        form.reset();
        loadIdeas();
      } catch {
        alertBox.textContent = 'Could not submit idea.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#B91C1C] text-[14px] font-medium';
      }
    });

    bindUpvotes();
    loadIdeas();
  </script>
</BaseLayout>
