---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Ideas Backlog" backLabel="Home" backHref="/">
  <section class="mt-8 bg-white border border-[#DFDDD6] rounded-xl overflow-hidden shadow-[0_1px_2px_rgba(22,26,34,0.04)] max-w-[920px]">
    <div class="p-6 sm:p-7 border-b border-[#DFDDD6] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div data-tf-copy="ideas.eyebrow" class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
          Community engineering backlog
        </div>
        <h1 data-tf-copy="ideas.headline" class="font-display mt-2 text-[28px] sm:text-[32px] font-bold text-[#161A22] tracking-[-0.02em]">
          Student Idea Incubator
        </h1>
        <p data-tf-copy="ideas.subtitle" class="text-[14px] text-[#525866] mt-1">
          Browse and vote on open-source student tools, scholarship filters, and study resources.
        </p>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <span id="ideas-count" class="font-code text-[12px] font-medium text-[#0B5F58] bg-[#EDF7F5] border border-[#BCE3DC] px-3 py-1.5 rounded-lg">
          0 proposals
        </span>
        <a
          data-tf-copy="ideas.cta_propose"
          href="/ideas-submit"
          class="h-9 px-4 inline-flex items-center rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition"
        >
          Propose an idea →
        </a>
      </div>
    </div>

    <div class="px-6 py-3 bg-[#EAE8E1] border-b border-[#DFDDD6] flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-1" id="idea-filters">
        <button type="button" data-status="all" class="idea-filter active px-3 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition">All</button>
        <button type="button" data-status="open" class="idea-filter px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Open</button>
        <button type="button" data-status="planned" class="idea-filter px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Planned</button>
      </div>
      <input
        id="idea-search"
        data-tf-copy="ideas.search_placeholder"
        type="search"
        placeholder="Filter proposals..."
        class="w-full sm:w-56 h-8 px-3 rounded-lg bg-white border border-[#DFDDD6] text-[12.5px] text-[#161A22] placeholder-[#767D8C] focus:border-[#1B365D] focus:outline-none"
      />
    </div>

    <div class="divide-y divide-[#EAE8E1]" id="ideas-list">
      <div class="p-10 text-center text-[14px] text-[#767D8C]">Loading proposals...</div>
    </div>
  </section>

  <script is:inline>
    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function decodeFsVal(v) {
      if (!v || typeof v !== 'object') return undefined;
      if ('stringValue' in v) return v.stringValue;
      if ('booleanValue' in v) return v.booleanValue;
      if ('integerValue' in v) return Number(v.integerValue);
      if ('doubleValue' in v) return Number(v.doubleValue);
      return undefined;
    }

    const listEl = document.getElementById('ideas-list');
    const countBadge = document.getElementById('ideas-count');
    const searchInput = document.getElementById('idea-search');

    let cachedIdeas = [];
    let statusFilter = 'all';
    let searchTerm = '';

    function renderList() {
      const q = searchTerm.toLowerCase();
      const filtered = cachedIdeas.filter((it) => {
        const st = String(it.status || 'open').toLowerCase();
        const matchStatus = statusFilter === 'all' || st.includes(statusFilter);
        const matchQ = !q || String(it.title || '').toLowerCase().includes(q) || String(it.description || '').toLowerCase().includes(q);
        return matchStatus && matchQ;
      });

      if (countBadge) {
        countBadge.textContent = `${filtered.length} proposal${filtered.length === 1 ? '' : 's'}`;
      }

      if (filtered.length === 0) {
        listEl.innerHTML = '<div data-tf-copy="ideas.empty_state" class="p-10 text-center text-[14px] text-[#767D8C]">No proposals submitted yet.</div>';
        return;
      }

      listEl.innerHTML = filtered
        .map((item) => `
          <div class="p-6 flex items-center justify-between gap-4 hover:bg-[#FAF9F6] transition">
            <div>
              <div class="flex items-center gap-2 text-[12px]">
                <span class="font-medium text-[#0B5F58]">${esc(item.service || 'TF Unions')}</span>
                <span class="px-2 py-0.5 rounded-md bg-[#EAE8E1] border border-[#DCD9D0] text-[#525866] font-medium">${esc(String(item.status || 'Open'))}</span>
              </div>
              <div class="font-display text-[18px] font-semibold text-[#161A22] mt-1">${esc(item.title)}</div>
              <p class="text-[13.5px] text-[#525866] mt-1">${esc(item.description || '')}</p>
            </div>
          </div>
        `).join('');
    }

    async function loadIdeas() {
      try {
        const res = await fetch('https://firestore.googleapis.com/v1/projects/tf-unions/databases/(default)/documents/ideas?pageSize=100', { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          cachedIdeas = (data.documents || []).map((doc) => {
            const o = { id: doc.name.split('/').pop() };
            const f = doc.fields || {};
            Object.keys(f).forEach((k) => { o[k] = decodeFsVal(f[k]); });
            return o;
          });
        }
      } catch {}
      renderList();
    }

    document.querySelectorAll('.idea-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.idea-filter').forEach((b) => {
          b.className = 'idea-filter px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition';
        });
        btn.className = 'idea-filter active px-3 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition';
        statusFilter = btn.getAttribute('data-status') || 'all';
        renderList();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchTerm = e.target.value.trim();
        renderList();
      });
    }

    loadIdeas();
  </script>
</BaseLayout>
