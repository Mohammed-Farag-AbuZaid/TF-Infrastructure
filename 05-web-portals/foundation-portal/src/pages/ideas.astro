---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Ideas Backlog" backLabel="Home" backHref="/">
  <section class="mt-8 bg-white border border-[#DFDDD6] rounded-xl overflow-hidden shadow-[0_1px_2px_rgba(22,26,34,0.04)] max-w-[920px]">
    <div class="p-6 sm:p-7 border-b border-[#DFDDD6] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
          Community engineering backlog
        </div>
        <h1 class="font-display mt-2 text-[28px] sm:text-[32px] font-bold text-[#161A22] tracking-[-0.02em]">
          Student Idea Incubator
        </h1>
        <p class="text-[14px] text-[#525866] mt-1">
          Vote on open-source student utilities, scholarship filters, and research guides in the PostgreSQL queue.
        </p>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <span id="ideas-count" class="font-code text-[12px] font-medium text-[#0F766E] bg-[#EDF7F5] border border-[#BCE3DC] px-3 py-1.5 rounded-lg">
          1 proposal
        </span>
        <a
          href="/ideas-submit"
          class="h-9 px-4 inline-flex items-center rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition"
        >
          Propose an idea →
        </a>
      </div>
    </div>

    <div class="px-6 py-3 bg-[#EAE8E1] border-b border-[#DFDDD6] flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-1" id="idea-filters">
        <button type="button" data-status="all" class="idea-filter active px-3 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition">All</button>
        <button type="button" data-status="open" class="idea-filter px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Open</button>
        <button type="button" data-status="planned" class="idea-filter px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Planned</button>
      </div>
      <input
        id="idea-search"
        type="search"
        placeholder="Filter proposals..."
        class="w-full sm:w-56 h-8 px-3 rounded-lg bg-white border border-[#DFDDD6] text-[12.5px] text-[#161A22] placeholder-[#767D8C] focus:border-[#1B365D] focus:outline-none"
      />
    </div>

    <div class="divide-y divide-[#EAE8E1]" id="ideas-list">
      <div class="p-6 flex items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-[12px]">
            <span class="font-medium text-[#0F766E]">TF News</span>
            <span class="px-2 py-0.5 rounded-md bg-[#EAE8E1] border border-[#DCD9D0] text-[#525866] font-medium">Planned</span>
          </div>
          <div class="font-display text-[18px] font-semibold text-[#161A22] mt-1">
            Arabic-to-English Research Abstract Reviewer &amp; LaTeX Template Pack
          </div>
          <p class="text-[13.5px] text-[#525866] mt-1">
            Checklist and peer review queue for ISEF and science fair students.
          </p>
        </div>
        <button
          type="button"
          data-id="1"
          class="upvote-btn px-3.5 py-2 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] hover:border-[#1B365D] text-[13px] font-semibold text-[#161A22] shrink-0 transition"
        >
          ▲ <span class="count font-code">142</span>
        </button>
      </div>
    </div>
  </section>

  <script is:inline>
    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getVoterId() {
      let id = localStorage.getItem('tf_voter_id');
      if (!id) {
        id = 'web_' + Math.random().toString(36).slice(2) + Date.now();
        localStorage.setItem('tf_voter_id', id);
      }
      return id;
    }

    const listEl = document.getElementById('ideas-list');
    const countBadge = document.getElementById('ideas-count');
    const searchInput = document.getElementById('idea-search');

    let cachedIdeas = [
      {
        item_id: 1,
        source_service: 'TF News',
        status: 'Planned',
        title: 'Arabic-to-English Research Abstract Reviewer & LaTeX Template Pack',
        description: 'Checklist and peer review queue for ISEF and science fair students.',
        upvote_count: 142,
      },
    ];
    let statusFilter = 'all';
    let searchTerm = '';

    function renderList() {
      const q = searchTerm.toLowerCase();
      const filtered = cachedIdeas.filter((it) => {
        const st = String(it.status || 'Open').toLowerCase();
        const matchStatus = statusFilter === 'all' || st.includes(statusFilter);
        const matchQ = !q || String(it.title || '').toLowerCase().includes(q) || String(it.description || '').toLowerCase().includes(q);
        return matchStatus && matchQ;
      });

      if (countBadge) {
        countBadge.textContent = `${filtered.length} proposal${filtered.length === 1 ? '' : 's'}`;
      }

      if (filtered.length === 0) {
        listEl.innerHTML = `<div class="p-8 text-center text-[14px] text-[#767D8C]">No proposals match this filter yet.</div>`;
        return;
      }

      listEl.innerHTML = filtered
        .map(
          (item) => `
          <div class="p-6 flex items-center justify-between gap-4 hover:bg-[#FAF9F6] transition">
            <div>
              <div class="flex items-center gap-2 text-[12px]">
                <span class="font-medium text-[#0F766E]">${esc(item.source_service || 'Ecosystem')}</span>
                <span class="px-2 py-0.5 rounded-md bg-[#EAE8E1] border border-[#DCD9D0] text-[#525866] font-medium">${esc(String(item.status || 'Open').replace(/_/g, ' '))}</span>
              </div>
              <div class="font-display text-[18px] font-semibold text-[#161A22] mt-1">${esc(item.title)}</div>
              <p class="text-[13.5px] text-[#525866] mt-1">${esc(item.description || '')}</p>
            </div>
            <button
              type="button"
              data-id="${Number(item.item_id)}"
              class="upvote-btn px-3.5 py-2 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] hover:border-[#1B365D] text-[13px] font-semibold text-[#161A22] shrink-0 transition"
            >
              ▲ <span class="count font-code">${Number(item.upvote_count || 1)}</span>
            </button>
          </div>
        `
        )
        .join('');
      bindUpvotes();
    }

    async function loadIdeas() {
      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/ideas');
        const data = await res.json();
        const items = data.ideas || [];
        if (items.length > 0) {
          cachedIdeas = items;
          renderList();
        }
      } catch {}
    }

    function bindUpvotes() {
      document.querySelectorAll('.upvote-btn').forEach((btn) => {
        btn.onclick = async () => {
          const itemId = Number(btn.getAttribute('data-id'));
          const countEl = btn.querySelector('.count');
          try {
            const res = await fetch('https://n8n.tfunions.com/tf-api/api/idea-upvote', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ itemId, uid: getVoterId() }),
            });
            const data = await res.json();
            if (data.upvoteCount) {
              countEl.textContent = data.upvoteCount;
              btn.classList.add('border-[#0F766E]', 'text-[#0F766E]', 'bg-[#EDF7F5]');
            }
          } catch {}
        };
      });
    }

    document.querySelectorAll('.idea-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.idea-filter').forEach((b) => {
          b.className = 'idea-filter px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition';
        });
        btn.className = 'idea-filter active px-3 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition';
        statusFilter = btn.getAttribute('data-status') || 'all';
        renderList();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchTerm = e.target.value.trim();
        renderList();
      });
    }

    bindUpvotes();
    loadIdeas();
  </script>
</BaseLayout>
