    <!-- Dynamic Team & Sliding Status Filter Pills -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2.5">
      <div id="team-filter-buttons" class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter directory and orbital map by team"></div>

      <div id="dir-status-buttons" class="tf-pill-track inline-flex rounded-xl bg-[#EAE8E1] p-1 border border-[#DCD9D0]" role="group" aria-label="Filter directory by member tenure status">
        <div id="dir-status-pill" class="tf-pill-indicator bg-white border border-[#DFDDD6] shadow-xs"></div>
        <button type="button" data-dstatus="milestone" class="dst-btn relative z-10 px-3 py-1 rounded-lg text-[12px] font-semibold text-[#161A22] transition">Milestone (<span id="cnt-d-milestone">0</span>)</button>
        <button type="button" data-dstatus="alumni" class="dst-btn relative z-10 px-3 py-1 rounded-lg text-[12px] font-medium text-[#525866] transition">S1 Alumni (<span id="cnt-d-alumni">{alumniCount}</span>)</button>
        <button type="button" data-dstatus="all" class="dst-btn relative z-10 px-3 py-1 rounded-lg text-[12px] font-medium text-[#525866] transition">All ({publicMembers.length})</button>
