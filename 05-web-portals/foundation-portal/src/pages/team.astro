        <select
          id="directory-sort"
          aria-label="Sort directory"
          class="h-9 px-2.5 bg-white border border-[#DFDDD6] rounded-lg text-[12.5px] text-[#161A22] focus:border-[#1B365D] focus:outline-none"
        >
          <option value="tier">Sort: Leadership tier</option>
          <option value="name">Sort: Name A–Z</option>
