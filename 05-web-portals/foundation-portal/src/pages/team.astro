  </section>

  <script is:inline define:vars={{ initialMembers: publicMembers }}>
    (function () {
      var BASE_STEPS = [
        { key: '2025-07-15', short: 'Jul 2025', title: 'Founding Month', desc: 'July 2025 — Mohammed Farag & Mohammed Abdelghany launch TF Unions alone' },
        { key: '2025-08-05', short: 'Early Aug 25', title: 'Track Heads', desc: 'Early August 2025 — 21 Track & Division Heads appointed across Season 1' },
        { key: '2025-08-20', short: 'Mid Aug 25', title: 'Full S1 Teams', desc: 'Mid August 2025 — Vice Heads & full student teams join ~2 weeks later' },
        { key: '2025-11-15', short: 'Nov 2025', title: 'S1 Concludes', desc: 'November 2025 — Season 1 cohort completes its journey; Founders carry TF Unions forward' },
        { key: '2026-10-15', short: 'Oct 2026', title: 'Zain AI Joins', desc: 'October 2026 — Zain joins in Season 2 as the first Autonomous AI teammate & assistant' },
        { key: 'present', short: 'Live Now', title: 'Season 2 (2026)', desc: 'Season 2 Live Now (2026) — Active Founders & Zain AI (scrub back to 2025 to view Season 1)' },
      ];
      var STEPS = BASE_STEPS.slice();

      var DIV_META = {
        Founders: { label: 'Founders', nodeFill: '#F3F2EE', nodeInk: '#0F1D33', ring: '#5EC4B8', barColor: '#1B365D', badgeBg: '#E4EAF2', badgeText: '#1B365D' },
        'AI & Automation': { label: 'AI · Zain', nodeFill: '#0F766E', nodeInk: '#FFFFFF', ring: '#5EC4B8', barColor: '#0F766E', badgeBg: '#EDF7F5', badgeText: '#0B5F58' },
        'PR Team': { label: 'PR', nodeFill: '#5EC4B8', nodeInk: '#0F1D33', ring: '#5EC4B8', barColor: '#0F766E', badgeBg: '#EDF7F5', badgeText: '#0B5F58' },
        'Social Media Team': { label: 'Social Media', nodeFill: '#E7A35C', nodeInk: '#0F1D33', ring: '#E7A35C', barColor: '#A2570F', badgeBg: '#FEF6EB', badgeText: '#A2570F' },
        'Content Production': { label: 'Content Prod.', nodeFill: '#FDBA74', nodeInk: '#0F1D33', ring: '#FDBA74', barColor: '#C2410C', badgeBg: '#FFF7ED', badgeText: '#9A3412' },
        'Academic Fields': { label: 'Academic Fields', nodeFill: '#6EE7B7', nodeInk: '#0F1D33', ring: '#6EE7B7', barColor: '#047857', badgeBg: '#ECFDF5', badgeText: '#065F46' },
        'Marketing Team': { label: 'Marketing', nodeFill: '#CBD5E1', nodeInk: '#0F1D33', ring: '#CBD5E1', barColor: '#64748B', badgeBg: '#F1F5F9', badgeText: '#334155' },
        'HR Team': { label: 'HR', nodeFill: '#8FB1E0', nodeInk: '#0F1D33', ring: '#8FB1E0', barColor: '#334155', badgeBg: '#EAE8E1', badgeText: '#334155' },
        'IT Team': { label: 'IT & Systems', nodeFill: '#93C5FD', nodeInk: '#0F1D33', ring: '#93C5FD', barColor: '#1D4ED8', badgeBg: '#EFF6FF', badgeText: '#1E40AF' },
        'Research & Guides': { label: 'Research & Guides', nodeFill: '#6EE7B7', nodeInk: '#0F1D33', ring: '#6EE7B7', barColor: '#047857', badgeBg: '#ECFDF5', badgeText: '#065F46' },
        'Chapters & Connect': { label: 'Chapters', nodeFill: '#FDBA74', nodeInk: '#0F1D33', ring: '#FDBA74', barColor: '#C2410C', badgeBg: '#FFF7ED', badgeText: '#9A3412' },
        'Finance & Operations': { label: 'Finance & Ops', nodeFill: '#CBD5E1', nodeInk: '#0F1D33', ring: '#CBD5E1', barColor: '#475569', badgeBg: '#F1F5F9', badgeText: '#334155' },
      };

      var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      function normDate(d) {
        var s = String(d || '').trim();
        if (/^\d{4}-\d{2}$/.test(s)) return s + '-01';
        return s;
      }
      function fmtMonth(ym) {
        var s = String(ym || '').trim();
        var parts = s.split('-');
        if (parts.length >= 2) {
          var mo = Number(parts[1]);
          if (mo >= 1 && mo <= 12) {
            var day = Number(parts[2] || 0);
            var pre = day >= 13 && day <= 18 ? 'Mid ' : '';
            return pre + MONTHS[mo - 1] + ' ' + parts[0];
          }
        }
        return s || 'Present';
      }
      function fmtTenure(m) {
        var start = m.startDate || m.cohortDate || '2025-07-01';
        var end = m.endDate || '';
        return fmtMonth(start) + ' – ' + (end ? fmtMonth(end) : 'Present');
      }

      var FALLBACK_META = DIV_META.Founders;
      var prefersReducedMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var ALL_MEMBERS = [];
      var BY_ID = new Map();
      var POS = new Map();
      var REPORTS_BY_ID = new Map();
      var NODE_ANIM = new Map();
      var NODE_ELS = new Map();
      var EDGE_ELS = new Map();

      var state = {
        stepIdx: 5,
        dirStatus: 'milestone',
        team: 'All',
        search: '',
        sort: 'tier',
        selectedId: null,
        hoveredId: null,
        isPlaying: false,
        playTimer: null,
        displayedHeroCount: 3,
      };

      var cam = { x: 0, y: 0, zoom: 1, tx: 0, ty: 0, tzoom: 1 };
      var dragging = false;
      var dragStart = { x: 0, y: 0, camX: 0, camY: 0 };
      var rafId = null;

      var SVG_NS = 'http://www.w3.org/2000/svg';
      var CX = 540;
      var CY = 400;
      var stageEl = document.getElementById('constellation-stage');
      var heroMilestoneEl = document.getElementById('hero-milestone-name');
      var heroActiveNumEl = document.getElementById('hero-active-num');
      var heroActiveUnitEl = document.getElementById('hero-active-unit');
      var heroAlumniChipEl = document.getElementById('hero-alumni-chip');
      var divBarEl = document.getElementById('division-bar');
      var divLegendEl = document.getElementById('division-legend');
      var milestoneTrackEl = document.getElementById('milestone-pill-track');
      var timelinePillEl = document.getElementById('timeline-active-pill');
      var timelineProgressEl = document.getElementById('timeline-progress-fill');
      var teamFiltersEl = document.getElementById('team-filter-buttons');
      var dirStatusTrackEl = document.getElementById('dir-status-buttons');
      var dirStatusPillEl = document.getElementById('dir-status-pill');
      var sliderEl = document.getElementById('timeline-slider');
      var cohortDescEl = document.getElementById('cohort-desc');
      var activeBadgeEl = document.getElementById('active-count-badge');
      var sourceStatusEl = document.getElementById('data-source-status');
      var dirSubtitleEl = document.getElementById('dir-subtitle');
      var searchInput = document.getElementById('graph-search');
      var searchMatchPill = document.getElementById('search-match-pill');
      var searchClearBtn = document.getElementById('search-clear-btn');
      var sortSelect = document.getElementById('directory-sort');
      var directoryGrid = document.getElementById('directory-grid');
      var spotlightView = document.getElementById('spotlight-view');
      var spotlightList = document.getElementById('spotlight-list');
      var spotlightSub = document.getElementById('spotlight-sub');
      var inspectorView = document.getElementById('inspector-view');
      var playBtn = document.getElementById('play-btn');
      var playSvg = document.getElementById('play-svg');
      var pauseSvg = document.getElementById('pause-svg');
      var playLabel = document.getElementById('play-label');
      var svgEl = document.getElementById('network-svg');
      var viewportEl = document.getElementById('graph-viewport');
      var graphContent = document.getElementById('graph-content');
      var edgesLayer = document.getElementById('edges-layer');
      var nodesLayer = document.getElementById('nodes-layer');
      var tooltipEl = document.getElementById('node-tooltip');

      function esc(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function metaFor(team) {
        return DIV_META[team] || FALLBACK_META;
      }

      function initialsOf(name) {
        return String(name || '')
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map(function (p) { return p[0] || ''; })
          .join('')
          .toUpperCase();
      }

      function shortLabel(m) {
        var parts = String(m.name || '').trim().split(/\s+/);
        if (m.tier === 0 && parts.length > 1) {
          return parts[0].charAt(0) + '. ' + parts[1];
        }
        return parts[0] || '';
      }

      function isActiveAtStep(m, idx) {
        var step = STEPS[idx] || STEPS[STEPS.length - 1];
        var start = normDate(m.startDate || m.cohortDate || '2025-07-01');
        var end = m.endDate ? normDate(m.endDate) : '';
        if (step.key === 'present') {
          return !end && m.status !== 'alumni';
        }
        return start <= step.key && (!end || end > step.key);
      }

      function bestStepForMember(m) {
        var idxPresent = STEPS.length - 1;
        if (isActiveAtStep(m, idxPresent)) return idxPresent;
        // Find the peak step where this Season 1 member was actively serving
        for (var i = STEPS.length - 2; i >= 0; i--) {
          if (isActiveAtStep(m, i)) return i;
        }
        return idxPresent;
      }

      function matchesFilter(m) {
        var teamOk = state.team === 'All' || m.team === state.team;
        var q = state.search.toLowerCase().trim();
        if (!q) return teamOk;
        var hay = [m.name, m.arabicName, m.role, m.school, m.team, m.subTrack, m.bio]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();
        return teamOk && hay.includes(q);
      }

      function getLineageSet(memberId) {
        var set = new Set();
        if (!memberId) return set;
        var cur = BY_ID.get(memberId);
        var hops = 0;
        while (cur && !set.has(cur.id) && hops < 12) {
          set.add(cur.id);
          cur = cur.parent ? BY_ID.get(cur.parent) : null;
          hops++;
        }
        var children = REPORTS_BY_ID.get(memberId) || [];
        children.forEach(function (c) { set.add(c.id); });
        return set;
      }

      // Balanced 360-deg Multi-Sector Orbital Coordinates for up to 130+ nodes with Zain AI north apex
      function computeOrbitalLayout(members) {
        POS.clear();

        var foundersList = members.filter(function (m) {
          return m.team === 'Founders' || m.tier === 0;
        });
        if (foundersList.length === 1) {
          POS.set(foundersList[0].id, { x: CX, y: CY + 10, r: 24 });
        } else if (foundersList.length === 2) {
          POS.set(foundersList[0].id, { x: CX + 50, y: CY + 12, r: 23 });
          POS.set(foundersList[1].id, { x: CX - 50, y: CY + 12, r: 23 });
        } else {
          foundersList.forEach(function (f, idx) {
            var a = (idx / Math.max(1, foundersList.length)) * Math.PI * 2;
            POS.set(f.id, { x: CX + Math.cos(a) * 52, y: CY + Math.sin(a) * 52, r: 22 });
          });
        }

        // Pin AI & Automation (Zain) at clean north pedestal above Founders
        var aiNodes = members.filter(function (m) {
          return m.isAI || m.team === 'AI & Automation';
        });
        aiNodes.forEach(function (ai, idx) {
          var offset = (idx - (aiNodes.length - 1) / 2) * 56;
          POS.set(ai.id, { x: CX + offset, y: CY - 92, r: 19.5 });
        });

        // Clean angular sectors (radians; -PI/2 is straight north reserved for AI)
        var D = Math.PI / 180;
        var SECTORS = {
          'PR Team': [-72 * D, -26 * D],
          'Social Media Team': [-20 * D, 24 * D],
          'Content Production': [30 * D, 78 * D],
          'Academic Fields': [84 * D, 166 * D],
          'Marketing Team': [174 * D, 204 * D],
          'HR Team': [212 * D, 256 * D],
          'IT Team': [-104 * D, -96 * D],
          'Research & Guides': [79 * D, 83 * D],
          'Chapters & Connect': [168 * D, 172 * D],
          'Finance & Operations': [205 * D, 211 * D],
        };

        var TIER_RINGS = {
          1: { baseR: 148, spread: 10, nodeR: 15.5 },
          2: { baseR: 214, spread: 16, nodeR: 12.5 },
          3: { baseR: 282, spread: 26, nodeR: 9.8 },
          4: { baseR: 340, spread: 24, nodeR: 8.6 },
        };

        var teams = [...new Set(members.map(function (m) { return m.team; }))].filter(function (t) {
          return t !== 'Founders' && t !== 'AI & Automation';
        });
        var fallbackSectors = Object.values(SECTORS);

        teams.forEach(function (teamName, qIdx) {
          var range = SECTORS[teamName] || fallbackSectors[qIdx % fallbackSectors.length];
          var startA = range[0];
          var endA = range[1];

          for (var tier = 1; tier <= 4; tier++) {
            var bucket = members
              .filter(function (m) { return !m.isAI && m.team === teamName && m.tier === tier; })
              .slice()
              .sort(function (a, b) {
                return String(a.subTrack || '').localeCompare(String(b.subTrack || '')) ||
                  String(a.parent || '').localeCompare(String(b.parent || '')) ||
                  a.name.localeCompare(b.name);
              });

            if (bucket.length === 0) continue;
            var ring = TIER_RINGS[tier] || TIER_RINGS[4];

            if (bucket.length <= 5 || ring.spread === 0) {
              bucket.forEach(function (m, i) {
                var frac = bucket.length === 1 ? 0.5 : i / (bucket.length - 1);
                var angle = startA + frac * (endA - startA);
                POS.set(m.id, {
                  x: CX + Math.cos(angle) * ring.baseR,
                  y: CY + Math.sin(angle) * ring.baseR,
                  r: ring.nodeR,
                });
              });
            } else {
              var innerCount = Math.ceil(bucket.length / 2);
              var outerCount = bucket.length - innerCount;
              var innerR = ring.baseR - ring.spread * 0.52;
              var outerR = ring.baseR + ring.spread * 0.62;

              bucket.forEach(function (m, i) {
                var isOuter = i % 2 === 1;
                var idxInBand = Math.floor(i / 2);
                var bandTotal = isOuter ? outerCount : innerCount;
                var frac = bandTotal === 1 ? 0.5 : (idxInBand + (isOuter ? 0.28 : 0)) / Math.max(1, bandTotal - 1 + 0.28);
                var clamped = Math.max(0.02, Math.min(0.98, frac));
                var angle = startA + clamped * (endA - startA);
                var radius = isOuter ? outerR : innerR;
                POS.set(m.id, {
                  x: CX + Math.cos(angle) * radius,
                  y: CY + Math.sin(angle) * radius,
                  r: ring.nodeR,
                });
              });
            }
          }
        });
      }

      function curvePath(x1, y1, x2, y2) {
        var mx = (x1 + x2) / 2;
        var my = (y1 + y2) / 2;
        var cx = mx + (CX - mx) * 0.16;
        var cy = my + (CY - my) * 0.16;
        return 'M ' + x1.toFixed(1) + ' ' + y1.toFixed(1) + ' Q ' + cx.toFixed(1) + ' ' + cy.toFixed(1) + ' ' + x2.toFixed(1) + ' ' + y2.toFixed(1);
      }

      function indexMembers(members) {
        ALL_MEMBERS = members;
        BY_ID.clear();
        REPORTS_BY_ID.clear();
        members.forEach(function (m) { BY_ID.set(m.id, m); });
        members.forEach(function (m) {
          if (m.parent && m.parent !== m.id) {
            if (!REPORTS_BY_ID.has(m.parent)) REPORTS_BY_ID.set(m.parent, []);
            REPORTS_BY_ID.get(m.parent).push(m);
          }
        });
        computeOrbitalLayout(members);
        syncSvgDom();
      }

      function syncSvgDom() {
        edgesLayer.replaceChildren();
        nodesLayer.replaceChildren();
        NODE_ELS.clear();
        EDGE_ELS.clear();

        ALL_MEMBERS.forEach(function (m) {
          var pos = POS.get(m.id) || { x: m.x, y: m.y, r: m.r };
          var pPos = m.parent ? POS.get(m.parent) : null;
          var active = isActiveAtStep(m, state.stepIdx);
          var initOpacity = active ? 1 : 0;
          var initScale = active ? 1 : 0.2;

          if (!NODE_ANIM.has(m.id)) {
            NODE_ANIM.set(m.id, {
              x: active ? pos.x : pPos ? pPos.x : pos.x,
              y: active ? pos.y : pPos ? pPos.y : pos.y,
              vx: 0,
              vy: 0,
              scale: initScale,
              vscale: 0,
              opacity: initOpacity,
              tx: pos.x,
              ty: pos.y,
              tscale: initScale,
              topacity: initOpacity,
              delayUntil: 0,
              r: pos.r,
            });
          } else {
            NODE_ANIM.get(m.id).r = pos.r;
          }

          if (m.parent && BY_ID.has(m.parent)) {
            var path = document.createElementNS(SVG_NS, 'path');
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke-linecap', 'round');
            edgesLayer.appendChild(path);
            EDGE_ELS.set(m.id, path);
          }

          var meta = metaFor(m.team);
          var isFounder = m.tier === 0;
          var isAi = Boolean(m.isAI);
          var g = document.createElementNS(SVG_NS, 'g');
          g.setAttribute('class', 'node-group cursor-pointer');
          g.setAttribute('tabindex', '0');
          g.setAttribute('role', 'button');
          g.setAttribute('aria-label', m.name + ' — ' + m.role);
          g.dataset.id = m.id;

          if (isAi) {
            var pulseRing = document.createElementNS(SVG_NS, 'circle');
            pulseRing.setAttribute('r', String(pos.r + 9));
            pulseRing.setAttribute('fill', 'none');
            pulseRing.setAttribute('stroke', '#5EC4B8');
            pulseRing.setAttribute('stroke-width', '1.4');
            pulseRing.setAttribute('class', 'tf-ai-pulse-ring');
            g.appendChild(pulseRing);

            var orbitDash = document.createElementNS(SVG_NS, 'circle');
            orbitDash.setAttribute('r', String(pos.r + 5));
            orbitDash.setAttribute('fill', 'none');
            orbitDash.setAttribute('stroke', '#7DD3C8');
            orbitDash.setAttribute('stroke-width', '1.6');
            orbitDash.setAttribute('stroke-dasharray', '5 4');
            orbitDash.setAttribute('class', 'tf-ai-orbit');
            g.appendChild(orbitDash);
          }

          var halo = document.createElementNS(SVG_NS, 'circle');
          halo.setAttribute('fill', 'none');
          halo.setAttribute('stroke', meta.ring);
          halo.setAttribute('stroke-width', '2.2');
          halo.setAttribute('opacity', '0');

          var circle = document.createElementNS(SVG_NS, 'circle');
          circle.setAttribute('r', String(pos.r));
          circle.setAttribute('fill', meta.nodeFill);
          circle.setAttribute('stroke', isAi ? '#7DD3C8' : '#0F1D33');
          circle.setAttribute('stroke-width', isFounder || isAi ? '2.4' : '1.5');
          circle.setAttribute('filter', 'url(#node-glow)');

          var abbr = document.createElementNS(SVG_NS, 'text');
          abbr.setAttribute('text-anchor', 'middle');
          abbr.setAttribute('dominant-baseline', 'central');
          abbr.setAttribute('fill', meta.nodeInk);
          abbr.setAttribute('font-size', isAi ? '10' : pos.r > 18 ? '11' : pos.r > 12 ? '8.5' : '7');
          abbr.setAttribute('font-weight', '700');
          abbr.setAttribute('pointer-events', 'none');
          abbr.textContent = isAi ? 'AI' : initialsOf(m.name);

          var label = document.createElementNS(SVG_NS, 'text');
          label.setAttribute('text-anchor', 'middle');
          label.setAttribute('y', String(pos.r + (isAi ? 16 : 13)));
          label.setAttribute('fill', isAi ? '#7DD3C8' : '#F3F2EE');
          label.setAttribute('font-size', isFounder || isAi ? '11.5' : '10');
          label.setAttribute('font-weight', isFounder || isAi ? '600' : '500');
          label.setAttribute('pointer-events', 'none');
          label.setAttribute('class', 'select-none');
          label.textContent = isAi ? 'Zain · AI' : shortLabel(m);

          g.appendChild(halo);
          g.appendChild(circle);
          g.appendChild(abbr);
          g.appendChild(label);

          g.addEventListener('click', function (e) {
            e.stopPropagation();
            selectMember(m.id, true);
          });
          g.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              selectMember(m.id, true);
            }
          });
          g.addEventListener('mouseenter', function () {
            state.hoveredId = m.id;
            showTooltip(m);
            refreshVisualStyles();
          });
          g.addEventListener('mouseleave', function () {
            if (state.hoveredId === m.id) state.hoveredId = null;
            hideTooltip();
            refreshVisualStyles();
          });

          nodesLayer.appendChild(g);
          NODE_ELS.set(m.id, { g: g, halo: halo, label: label, pos: pos });
        });
      }

      function showTooltip(m) {
        var anim = NODE_ANIM.get(m.id);
        if (!anim) return;
        var svgRect = svgEl.getBoundingClientRect();
        var vpRect = viewportEl.getBoundingClientRect();
        var scale = Math.min(svgRect.width / 1080, svgRect.height / 800);
        var ox = (svgRect.width - 1080 * scale) / 2;
        var oy = (svgRect.height - 800 * scale) / 2;
        var sx = ox + (anim.x * cam.zoom + cam.x) * scale;
        var sy = oy + (anim.y * cam.zoom + cam.y) * scale;

        var suffix = m.isAI ? ' · AI Core' : '';
        tooltipEl.textContent = m.name + ' · ' + m.role + suffix;
        tooltipEl.style.left = Math.min(Math.max(12, sx + 14), vpRect.width - 250) + 'px';
        tooltipEl.style.top = Math.max(12, sy - 34) + 'px';
        tooltipEl.classList.remove('hidden');
      }

      function hideTooltip() {
        tooltipEl.classList.add('hidden');
      }

      function updateTargets() {
        var now = performance.now();
        ALL_MEMBERS.forEach(function (m, idx) {
          var a = NODE_ANIM.get(m.id);
          var pos = POS.get(m.id) || { x: m.x, y: m.y, r: m.r };
          var pPos = m.parent ? POS.get(m.parent) : null;
          if (!a) return;

          var active = isActiveAtStep(m, state.stepIdx);
          if (active) {
            var wasHidden = a.topacity === 0;
            if (wasHidden && pPos && m.parent && !prefersReducedMotion) {
              a.x = pPos.x;
              a.y = pPos.y;
              a.vx = 0;
              a.vy = 0;
            }
            a.delayUntil = (wasHidden && !prefersReducedMotion) ? now + Math.min(260, m.tier * 38 + (idx % 12) * 14) : 0;
            a.tx = pos.x;
            a.ty = pos.y;
            a.tscale = 1;
            a.topacity = 1;
          } else {
            a.delayUntil = 0;
            a.tx = pPos ? pPos.x : CX;
            a.ty = pPos ? pPos.y : CY;
            a.tscale = 0.2;
            a.topacity = 0;
          }
        });
        startAnimation();
      }

      function startAnimation() {
        if (rafId != null) return;
        rafId = requestAnimationFrame(tickAnimation);
      }

      function tickAnimation(now) {
        rafId = null;
        var camEase = prefersReducedMotion ? 1 : 0.2;
        var stiffness = prefersReducedMotion ? 1 : 0.14;
        var damping = 0.72;
        var moving = false;

        if (Math.abs(cam.tx - cam.x) > 0.25 || Math.abs(cam.ty - cam.y) > 0.25 || Math.abs(cam.tzoom - cam.zoom) > 0.002) {
          cam.x += (cam.tx - cam.x) * camEase;
          cam.y += (cam.ty - cam.y) * camEase;
          cam.zoom += (cam.tzoom - cam.zoom) * camEase;
          moving = true;
        } else {
          cam.x = cam.tx;
          cam.y = cam.ty;
          cam.zoom = cam.tzoom;
        }
        graphContent.setAttribute('transform', 'translate(' + cam.x.toFixed(2) + ', ' + cam.y.toFixed(2) + ') scale(' + cam.zoom.toFixed(4) + ')');

        ALL_MEMBERS.forEach(function (m) {
          var a = NODE_ANIM.get(m.id);
          if (!a) return;
          if (a.delayUntil && now < a.delayUntil) {
            moving = true;
            return;
          }

          if (prefersReducedMotion) {
            a.x = a.tx;
            a.y = a.ty;
            a.scale = a.tscale;
            a.opacity = a.topacity;
            return;
          }

          a.vx = (a.vx + (a.tx - a.x) * stiffness) * damping;
          a.vy = (a.vy + (a.ty - a.y) * stiffness) * damping;
          a.vscale = (a.vscale + (a.tscale - a.scale) * stiffness) * damping;

          a.x += a.vx;
          a.y += a.vy;
          a.scale += a.vscale;
          a.opacity += (a.topacity - a.opacity) * 0.18;

          if (
            Math.abs(a.tx - a.x) > 0.25 ||
            Math.abs(a.ty - a.y) > 0.25 ||
            Math.abs(a.vx) > 0.12 ||
            Math.abs(a.vy) > 0.12 ||
            Math.abs(a.tscale - a.scale) > 0.005 ||
            Math.abs(a.topacity - a.opacity) > 0.01
          ) {
            moving = true;
          } else {
            a.x = a.tx;
            a.y = a.ty;
            a.vx = 0;
            a.vy = 0;
            a.scale = a.tscale;
            a.vscale = 0;
            a.opacity = a.topacity;
          }
        });

        refreshVisualStyles();
        if (moving) startAnimation();
      }

      function refreshVisualStyles() {
        var focusId = state.hoveredId || state.selectedId;
        var lineage = getLineageSet(focusId);
        var hasSearch = state.search.trim().length > 0;
        var hasTeam = state.team !== 'All';
        var activeTeams = new Set();

        ALL_MEMBERS.forEach(function (m) {
          if (isActiveAtStep(m, state.stepIdx) && matchesFilter(m)) {
            activeTeams.add(m.team);
          }
          var a = NODE_ANIM.get(m.id);
          var els = NODE_ELS.get(m.id);
          if (!a || !els) return;

          var isHidden = a.opacity < 0.02;
          els.g.style.display = isHidden ? 'none' : '';
          if (isHidden) {
            var hiddenEdge = EDGE_ELS.get(m.id);
            if (hiddenEdge) hiddenEdge.style.display = 'none';
            return;
          }

          var active = isActiveAtStep(m, state.stepIdx);
          var matched = matchesFilter(m);
          var inLineage = !focusId || lineage.has(m.id);
          var filterMul = matched ? (inLineage ? 1 : 0.24) : 0.12;
          var isSelected = state.selectedId === m.id;
          var isHovered = state.hoveredId === m.id;

          var baseAlpha = isSelected || isHovered || (focusId && inLineage) ? 1 : a.opacity;
          var finalOpacity = Math.min(1, baseAlpha * filterMul);

          els.g.setAttribute('transform', 'translate(' + a.x.toFixed(2) + ', ' + a.y.toFixed(2) + ') scale(' + a.scale.toFixed(3) + ')');
          els.g.setAttribute('opacity', finalOpacity.toFixed(3));
          els.g.style.pointerEvents = a.topacity === 0 ? 'none' : 'auto';

          els.halo.setAttribute('r', String(els.pos.r + (isSelected ? 6 : 4)));
          els.halo.setAttribute('opacity', isSelected || isHovered || (m.tier === 0 && active) ? '1' : '0');

          var showLabel =
            m.tier === 0 ||
            m.isAI ||
            (active && m.tier <= 1) ||
            isSelected ||
            isHovered ||
            (focusId && inLineage) ||
            (hasSearch && matched) ||
            (hasTeam && matched && m.tier <= 2) ||
            cam.zoom >= 1.32;
          els.label.style.opacity = showLabel ? '1' : '0';

          var edge = EDGE_ELS.get(m.id);
          if (edge && m.parent) {
            var pa = NODE_ANIM.get(m.parent);
            if (!pa || pa.opacity < 0.02) {
              edge.style.display = 'none';
            } else {
              edge.style.display = '';
              edge.setAttribute('d', curvePath(a.x, a.y, pa.x, pa.y));

              var isFounderLink = m.id === 'founder-1' && m.parent === 'founder-2';
              var isAiLink = Boolean(m.isAI);
              var highlightEdge = focusId && lineage.has(m.id) && lineage.has(m.parent);
              edge.setAttribute('stroke', highlightEdge || isAiLink ? '#5EC4B8' : isFounderLink ? '#8FB1E0' : 'rgba(255,255,255,0.16)');
              edge.setAttribute('stroke-width', isFounderLink || isAiLink ? '2.2' : highlightEdge ? '2' : '1');
              edge.setAttribute('stroke-opacity', String(Math.min(baseAlpha, pa.opacity) * (highlightEdge || isAiLink ? 1 : (hasTeam || hasSearch) && !matched ? 0.22 : 0.78)));
              edge.classList.toggle('tf-edge-flow', Boolean(highlightEdge || isAiLink));
            }
          }
        });

        document.querySelectorAll('[data-sector-team]').forEach(function (lbl) {
          var tname = lbl.getAttribute('data-sector-team');
          lbl.style.opacity = activeTeams.has(tname) ? '1' : '0.14';
        });
      }

      function fitStepCamera() {
        if (state.team !== 'All' || state.selectedId) return;
        var active = ALL_MEMBERS.filter(function (m) { return isActiveAtStep(m, state.stepIdx); });
        if (active.length <= 5 && active.length > 0) {
          var hasAi = active.some(function (m) { return m.isAI; });
          var zoom = 1.24;
          var focusY = hasAi ? CY - 26 : CY + 8;
          cam.tzoom = zoom;
          cam.tx = CX - CX * zoom;
          cam.ty = CY - focusY * zoom;
        } else {
          cam.tx = 0;
          cam.ty = 0;
          cam.tzoom = 1;
        }
        startAnimation();
      }

      function fitTeamCamera(team) {
        if (team === 'All') {
          fitStepCamera();
          return;
        }
        var coords = ALL_MEMBERS
          .filter(function (m) { return m.team === team && isActiveAtStep(m, state.stepIdx); })
          .map(function (m) { return POS.get(m.id); })
          .filter(Boolean);
        if (coords.length === 0) return;

        var minX = Math.min.apply(null, coords.map(function (c) { return c.x; }));
        var maxX = Math.max.apply(null, coords.map(function (c) { return c.x; }));
        var minY = Math.min.apply(null, coords.map(function (c) { return c.y; }));
        var maxY = Math.max.apply(null, coords.map(function (c) { return c.y; }));
        var w = Math.max(180, maxX - minX + 200);
        var h = Math.max(180, maxY - minY + 200);
        var zoom = Math.min(1.65, Math.max(0.95, Math.min(1080 / w, 800 / h)));
        var cx = (minX + maxX) / 2;
        var cy = (minY + maxY) / 2;
        cam.tzoom = zoom;
        cam.tx = CX - cx * zoom;
        cam.ty = CY - cy * zoom;
        startAnimation();
      }

      function animateHeroCounter(target) {
        if (prefersReducedMotion) {
          state.displayedHeroCount = target;
          heroActiveNumEl.textContent = String(target);
          return;
        }
        var start = state.displayedHeroCount;
        var diff = target - start;
        if (diff === 0) {
          heroActiveNumEl.textContent = String(target);
          return;
        }
        var startTime = performance.now();
        var duration = 360;
        function step(now) {
          var p = Math.min(1, (now - startTime) / duration);
          var eased = 1 - Math.pow(1 - p, 3);
          state.displayedHeroCount = Math.round(start + diff * eased);
          heroActiveNumEl.textContent = String(state.displayedHeroCount);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      function selectMember(id, flyTo) {
        var m = BY_ID.get(id);
        if (!m) return;

        if (!isActiveAtStep(m, state.stepIdx)) {
          var targetIdx = bestStepForMember(m);
          if (targetIdx !== -1) setStep(targetIdx, true);
        }

        state.selectedId = id;
        if (window.location.hash !== '#member=' + encodeURIComponent(id)) {
          history.replaceState(null, '', '#member=' + encodeURIComponent(id));
        }

        renderInspector(m);
        if (flyTo) {
          var pos = POS.get(m.id) || { x: m.x, y: m.y };
          cam.tzoom = Math.max(cam.tzoom, 1.38);
          cam.tx = CX - pos.x * cam.tzoom;
          cam.ty = CY - pos.y * cam.tzoom;
          startAnimation();
        } else {
          refreshVisualStyles();
        }
      }

      function closeInspector() {
        state.selectedId = null;
        inspectorView.classList.add('hidden');
        inspectorView.classList.remove('flex');
        spotlightView.classList.remove('hidden');
        if (window.location.hash.startsWith('#member=')) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
        refreshVisualStyles();
      }

      function makeDarkChip(member) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'px-2.5 py-1 rounded bg-[#1D3253] border border-white/15 hover:border-[#5EC4B8] text-[12px] font-medium text-[#ECEAE4] transition text-left';
        btn.textContent = member.name + (member.isAI ? ' (AI)' : '');
        btn.addEventListener('click', function () { selectMember(member.id, true); });
        return btn;
      }

      function renderInspector(m) {
        var meta = metaFor(m.team);
        var avatarEl = document.getElementById('insp-avatar');
        avatarEl.textContent = m.isAI ? 'AI' : initialsOf(m.name);
        avatarEl.style.backgroundColor = meta.nodeFill;
        avatarEl.style.color = meta.nodeInk;

        document.getElementById('insp-name').textContent = m.name;
        var arabicEl = document.getElementById('insp-arabic');
        if (m.arabicName && m.arabicName.trim() && m.arabicName.trim() !== m.name.trim()) {
          arabicEl.textContent = m.arabicName;
          arabicEl.classList.remove('hidden');
        } else {
          arabicEl.classList.add('hidden');
        }

        var teamBadge = document.getElementById('insp-team-badge');
        teamBadge.textContent = m.team;
        teamBadge.style.backgroundColor = meta.badgeBg;
        teamBadge.style.color = meta.badgeText;

        var isAlum = Boolean(m.endDate) || m.status === 'alumni';
        var stBadge = document.getElementById('insp-status-badge');
        stBadge.textContent = m.isAI ? 'AI Active' : isAlum ? 'S1 Alumni' : 'Active';
        stBadge.className = isAlum
          ? 'inline-block px-2 py-0.5 rounded text-[11px] font-code font-medium bg-white/10 text-[#CBD5E1]'
          : 'inline-block px-2 py-0.5 rounded text-[11px] font-code font-medium bg-[#0F766E]/35 text-[#7DD3C8]';

        document.getElementById('insp-role').textContent = m.role;
        document.getElementById('insp-school').textContent = m.school || 'TF Unions';
        document.getElementById('insp-grade').textContent = m.grade || (isAlum ? 'Season 1' : 'Core');
        document.getElementById('insp-cohort').textContent = fmtTenure(m);
        document.getElementById('insp-bio').textContent = m.bio || 'Contributor in ' + m.team + '.';

        var parent = m.parent ? BY_ID.get(m.parent) : null;
        var reports = REPORTS_BY_ID.get(m.id) || [];
        var prevMember = m.replaces ? BY_ID.get(m.replaces) : null;
        var nextMember = m.replacedBy ? BY_ID.get(m.replacedBy) : null;

        var lineageBox = document.getElementById('insp-lineage');
        var parentWrap = document.getElementById('insp-parent-wrap');
        var parentSlot = document.getElementById('insp-parent-slot');
        var reportsWrap = document.getElementById('insp-reports-wrap');
        var reportsLabel = document.getElementById('insp-reports-label');
        var reportsSlot = document.getElementById('insp-reports-slot');
        var replacesWrap = document.getElementById('insp-replaces-wrap');
        var replacesSlot = document.getElementById('insp-replaces-slot');
        var replacedWrap = document.getElementById('insp-replaced-wrap');
        var replacedSlot = document.getElementById('insp-replaced-slot');

        parentSlot.replaceChildren();
        reportsSlot.replaceChildren();
        replacesSlot.replaceChildren();
        replacedSlot.replaceChildren();

        if (parent) {
          parentSlot.appendChild(makeDarkChip(parent));
          parentWrap.classList.remove('hidden');
        } else {
          parentWrap.classList.add('hidden');
        }

        if (reports.length > 0) {
          reportsLabel.textContent = 'Direct reports (' + reports.length + ')';
          reports.slice(0, 12).forEach(function (r) { reportsSlot.appendChild(makeDarkChip(r)); });
          reportsWrap.classList.remove('hidden');
        } else {
          reportsWrap.classList.add('hidden');
        }

        if (prevMember) {
          replacesSlot.appendChild(makeDarkChip(prevMember));
          replacesWrap.classList.remove('hidden');
        } else {
          replacesWrap.classList.add('hidden');
        }

        if (nextMember) {
          replacedSlot.appendChild(makeDarkChip(nextMember));
          replacedWrap.classList.remove('hidden');
        } else {
          replacedWrap.classList.add('hidden');
        }

        lineageBox.classList.toggle('hidden', !parent && reports.length === 0 && !prevMember && !nextMember);
        spotlightView.classList.add('hidden');
        inspectorView.classList.remove('hidden');
        inspectorView.classList.add('flex');
      }

      function renderSpotlight(activeMembers) {
        var list = activeMembers
          .filter(function (m) {
            return (m.tier <= 1 || m.isAI) && (state.team === 'All' || m.team === state.team);
          })
          .slice(0, 12);

        spotlightSub.textContent = list.length + ' key leads active at ' + STEPS[state.stepIdx].short;
        spotlightList.replaceChildren();

        list.forEach(function (m) {
          var meta = metaFor(m.team);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-full text-left p-2.5 rounded-lg bg-[#0F1D33]/65 hover:bg-[#1D3253] border border-white/10 hover:border-[#5EC4B8]/60 flex items-center justify-between gap-3 transition group';

          var left = document.createElement('div');
          left.className = 'flex items-center gap-2.5 min-w-0';

          var dot = document.createElement('span');
          dot.className = 'w-8 h-8 rounded-lg flex items-center justify-center font-bold text-[11px] shrink-0';
          dot.style.backgroundColor = meta.nodeFill;
          dot.style.color = meta.nodeInk;
          dot.textContent = m.isAI ? 'AI' : initialsOf(m.name);

          var info = document.createElement('div');
          info.className = 'min-w-0';
          info.innerHTML =
            '<div class="text-[13px] font-semibold text-[#F3F2EE] truncate group-hover:text-white">' +
            esc(m.name) +
            '</div><div class="text-[11.5px] text-[#9AA7BC] truncate">' +
            esc(m.role + ' · ' + m.team.replace(' Team', '')) +
            '</div>';

          left.appendChild(dot);
          left.appendChild(info);

          var arrow = document.createElement('span');
          arrow.className = 'text-[#5EC4B8] text-[12px] shrink-0';
          arrow.textContent = '→';

          btn.appendChild(left);
          btn.appendChild(arrow);
          btn.addEventListener('click', function () { selectMember(m.id, true); });
          spotlightList.appendChild(btn);
        });
      }

      function positionSlidingPill(container, pill, activeBtn) {
        if (!container || !pill || !activeBtn) return;
        var cr = container.getBoundingClientRect();
        var br = activeBtn.getBoundingClientRect();
        if (cr.width === 0 || br.width === 0) return;
        pill.style.width = br.width.toFixed(1) + 'px';
        pill.style.transform = 'translateX(' + (br.left - cr.left).toFixed(1) + 'px)';
      }

      function renderControls() {
        var active = ALL_MEMBERS.filter(function (m) { return isActiveAtStep(m, state.stepIdx); });
        var departedByNow = ALL_MEMBERS.filter(function (m) {
          var end = m.endDate ? normDate(m.endDate) : '';
          var step = STEPS[state.stepIdx] || STEPS[STEPS.length - 1];
          if (step.key === 'present') return isMemberAlumni(m);
          return Boolean(end) && end <= step.key;
        });

        heroMilestoneEl.textContent = STEPS[state.stepIdx].short + ' · ' + STEPS[state.stepIdx].title;
        animateHeroCounter(active.length);
        heroActiveUnitEl.textContent = active.length <= 3 ? 'active core' : 'active contributors';

        if (departedByNow.length > 0) {
          heroAlumniChipEl.textContent = departedByNow.length + ' S1 Alumni (2025)';
          heroAlumniChipEl.classList.remove('hidden');
        } else {
          heroAlumniChipEl.classList.add('hidden');
        }

        activeBadgeEl.textContent =
          departedByNow.length > 0
            ? active.length + ' active · ' + departedByNow.length + ' alumni'
            : active.length + ' active';
        cohortDescEl.textContent = STEPS[state.stepIdx].desc;

        // Proportional division bar + interactive legend strictly reflect currently active members
        var teamOrder = [...new Set(ALL_MEMBERS.map(function (m) { return m.team; }))];
        divBarEl.replaceChildren();
        divLegendEl.replaceChildren();

        teamOrder.forEach(function (teamName) {
          var count = active.filter(function (m) { return m.team === teamName; }).length;
          if (count === 0) return;
          var meta = metaFor(teamName);
          var pct = (count / Math.max(1, active.length)) * 100;

          var seg = document.createElement('div');
          seg.className = 'h-full transition-all duration-500';
          seg.style.width = pct.toFixed(2) + '%';
          seg.style.backgroundColor = meta.barColor;
          seg.title = meta.label + ': ' + count;
          divBarEl.appendChild(seg);

          var chip = document.createElement('button');
          chip.type = 'button';
          var isSelected = state.team === teamName;
          chip.className = 'inline-flex items-center gap-1.5 hover:text-[#161A22] transition ' + (isSelected ? 'text-[#1B365D] font-semibold underline' : '');
          chip.innerHTML =
            '<span class="w-2 h-2 rounded-full inline-block" style="background-color:' +
            meta.barColor +
            ';"></span><span>' +
            esc(meta.label) +
            ' <strong class="font-code text-[#161A22]">' +
            count +
            '</strong></span>';
          chip.addEventListener('click', function () {
            state.team = isSelected ? 'All' : teamName;
            renderControls();
            renderDirectory();
            fitTeamCamera(state.team);
            refreshVisualStyles();
          });
          divLegendEl.appendChild(chip);
        });

        // Search UI badge
        var dirActivePool = ALL_MEMBERS.filter(function (m) { return isActiveAtStep(m, state.stepIdx); });
        var cntMilEl = document.getElementById('cnt-d-milestone');
        var cntAluEl = document.getElementById('cnt-d-alumni');
        if (cntMilEl) cntMilEl.textContent = String(dirActivePool.length);
        if (cntAluEl) cntAluEl.textContent = String(ALL_MEMBERS.filter(isMemberAlumni).length);

        var matchedNow = ALL_MEMBERS.filter(matchesFilter);
        if (state.search.trim()) {
          searchMatchPill.textContent = matchedNow.length + ' match' + (matchedNow.length === 1 ? '' : 'es');
          searchMatchPill.classList.remove('hidden');
          searchClearBtn.classList.remove('hidden');
        } else {
          searchMatchPill.classList.add('hidden');
          searchClearBtn.classList.add('hidden');
        }

        // Smooth sliding milestone pill track
        timelineProgressEl.style.width = ((state.stepIdx / Math.max(1, STEPS.length - 1)) * 100).toFixed(1) + '%';
        Array.from(milestoneTrackEl.querySelectorAll('.ms-pill-btn')).forEach(function (el) { el.remove(); });
        var activeStepBtn = null;

        STEPS.forEach(function (step, idx) {
          var count = ALL_MEMBERS.filter(function (m) { return isActiveAtStep(m, idx); }).length;
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('role', 'tab');
          var isCur = idx === state.stepIdx;
          btn.setAttribute('aria-selected', isCur ? 'true' : 'false');
          btn.className = 'ms-pill-btn relative z-10 px-2 py-1.5 rounded-lg text-center transition ' + (isCur ? 'text-white' : 'text-[#9AA7BC] hover:text-[#ECEAE4]');
          btn.innerHTML =
            '<span class="font-code text-[10.5px] block ' +
            (isCur ? 'text-[#7DD3C8]' : 'text-[#9AA7BC]') +
            '">' +
            esc(step.short) +
            ' (' +
            count +
            ')</span><strong class="block text-[11.5px] font-semibold truncate">' +
            esc(step.title) +
            '</strong>';
          btn.addEventListener('click', function () { setStep(idx, false); });
          milestoneTrackEl.appendChild(btn);
          if (isCur) activeStepBtn = btn;
        });

        requestAnimationFrame(function () {
          positionSlidingPill(milestoneTrackEl, timelinePillEl, activeStepBtn);
        });

        // Directory filter pills
        var poolForPills = state.dirStatus === 'all' ? ALL_MEMBERS : state.dirStatus === 'alumni' ? ALL_MEMBERS.filter(isMemberAlumni) : active;
        var filterOrder = ['All'].concat(teamOrder);
        teamFiltersEl.replaceChildren();
        filterOrder.forEach(function (teamName) {
          var count = teamName === 'All' ? poolForPills.length : poolForPills.filter(function (m) { return m.team === teamName; }).length;
          if (teamName !== 'All' && count === 0) return;

          var btn = document.createElement('button');
          btn.type = 'button';
          var isSel = state.team === teamName;
          btn.className =
            'px-3 py-1.5 rounded-lg text-[12.5px] font-medium border transition ' +
            (isSel
              ? 'bg-[#1B365D] text-white border-[#1B365D]'
              : 'bg-white text-[#525866] border-[#DFDDD6] hover:border-[#1B365D]/50 hover:text-[#161A22]');
          btn.textContent = (teamName === 'All' ? 'All teams' : metaFor(teamName).label) + ' (' + count + ')';
          btn.addEventListener('click', function () {
            state.team = teamName;
            renderControls();
            renderDirectory();
            fitTeamCamera(teamName);
            refreshVisualStyles();
          });
          teamFiltersEl.appendChild(btn);
        });

        renderSpotlight(active);
      }

      function isMemberAlumni(m) {
        return Boolean(m.endDate) || m.status === 'alumni';
      }

      function syncDirStatusButtons() {
        var activeBtn = null;
        document.querySelectorAll('#dir-status-buttons .dst-btn').forEach(function (b) {
          var act = b.getAttribute('data-dstatus') === state.dirStatus;
          b.className = act
            ? 'dst-btn relative z-10 px-3 py-1 rounded-lg text-[12px] font-semibold text-[#161A22] transition'
            : 'dst-btn relative z-10 px-3 py-1 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] transition';
          if (act) activeBtn = b;
        });
        requestAnimationFrame(function () {
          positionSlidingPill(dirStatusTrackEl, dirStatusPillEl, activeBtn);
        });
      }

      document.querySelectorAll('#dir-status-buttons .dst-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.dirStatus = btn.getAttribute('data-dstatus') || 'all';
          syncDirStatusButtons();
          renderControls();
          renderDirectory();
        });
      });

      function renderDirectory() {
        var pool = ALL_MEMBERS.filter(function (m) {
          if (state.dirStatus === 'alumni') return isMemberAlumni(m);
          if (state.dirStatus === 'all') return true;
          return isActiveAtStep(m, state.stepIdx);
        });
        var active = pool.filter(matchesFilter);

        var alumniTotal = ALL_MEMBERS.filter(isMemberAlumni).length;
        if (state.dirStatus === 'alumni') {
          dirSubtitleEl.textContent = 'Showing ' + active.length + ' Season 1 Alumni pioneers (' + alumniTotal + ' total recorded).';
        } else if (state.dirStatus === 'all') {
          dirSubtitleEl.textContent = 'Showing ' + active.length + ' of ' + ALL_MEMBERS.length + ' contributors across Season 1 Archive & Season 2 Core.';
        } else {
          dirSubtitleEl.textContent = 'Showing ' + active.length + ' contributors active at ' + STEPS[state.stepIdx].short + '.';
        }

        var sorted = active.slice().sort(function (a, b) {
          if (state.sort === 'name') return a.name.localeCompare(b.name);
          if (state.sort === 'cohort') {
            return normDate(a.startDate || a.cohortDate || '').localeCompare(normDate(b.startDate || b.cohortDate || '')) || a.tier - b.tier || a.name.localeCompare(b.name);
          }
          // Pin Active + AI near top of tier sort
          var aAlum = isMemberAlumni(a) ? 1 : 0;
          var bAlum = isMemberAlumni(b) ? 1 : 0;
          if (aAlum !== bAlum) return aAlum - bAlum;
          return a.tier - b.tier || a.team.localeCompare(b.team) || a.name.localeCompare(b.name);
        });

        directoryGrid.replaceChildren();
        if (sorted.length === 0) {
          var empty = document.createElement('div');
          empty.className = 'sm:col-span-2 lg:col-span-3 py-12 text-center border-t border-[#DFDDD6] text-[14px] text-[#767D8C]';
          empty.textContent = state.dirStatus === 'alumni' ? 'No alumni contributors recorded yet.' : 'No contributors match your filter at this milestone.';
          directoryGrid.appendChild(empty);
          return;
        }

        sorted.forEach(function (m, idx) {
          var meta = metaFor(m.team);
          var isAlum = isMemberAlumni(m);
          var card = document.createElement('article');
          card.className = 'border-t border-[#DFDDD6] pt-4 flex flex-col justify-between tf-card-enter';
          if (!prefersReducedMotion) {
            card.style.animationDelay = Math.min(idx * 16, 280) + 'ms';
          }

          var successor = m.replacedBy ? BY_ID.get(m.replacedBy) : null;
          var predecessor = m.replaces ? BY_ID.get(m.replaces) : null;
          var handoverLine = successor
            ? 'Succeeded by ' + successor.name
            : predecessor
              ? 'Preceded by ' + predecessor.name
              : '';

          card.innerHTML =
            '<div>' +
            '<div class="flex items-start justify-between gap-3">' +
            '<div class="flex items-center gap-3 min-w-0">' +
            '<div class="w-9 h-9 rounded-lg flex items-center justify-center font-bold text-[#F3F2EE] text-[12px] shrink-0" style="background-color:' +
            meta.barColor +
            ';">' +
            esc(m.isAI ? 'AI' : initialsOf(m.name)) +
            '</div>' +
            '<div class="min-w-0">' +
            '<h3 class="font-display font-semibold text-[16px] text-[#161A22] leading-snug truncate">' +
            esc(m.name) +
            '</h3>' +
            '<div class="text-[12.5px] font-medium text-[#525866] truncate">' +
            esc(m.role) +
            '</div>' +
            '</div>' +
            '</div>' +
            '<div class="flex flex-col items-end gap-1 shrink-0">' +
            '<span class="px-2 py-0.5 rounded text-[11px] font-medium" style="background-color:' +
            meta.badgeBg +
            ';color:' +
            meta.badgeText +
            ';">' +
            esc(meta.label) +
            '</span>' +
            (m.isAI
              ? '<span class="px-1.5 py-0.5 rounded bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58] text-[10px] font-code font-semibold">AI 24/7</span>'
              : isAlum
                ? '<span class="px-1.5 py-0.5 rounded bg-[#EAE8E1] text-[#525866] text-[10px] font-code">S1 Alumni</span>'
                : '<span class="px-1.5 py-0.5 rounded bg-[#EDF7F5] text-[#0B5F58] text-[10px] font-code">Active</span>') +
            '</div>' +
            '</div>' +
            '<p class="mt-2.5 text-[13px] text-[#525866] leading-relaxed line-clamp-2">' +
            esc(m.bio || m.school || 'TF Unions contributor') +
            '</p>' +
            (handoverLine ? '<div class="mt-1.5 font-code text-[11px] text-[#0B5F58]">' + esc(handoverLine) + '</div>' : '') +
            '</div>';

          var footer = document.createElement('div');
          footer.className = 'mt-3 flex items-center justify-between gap-2 text-[12px] text-[#767D8C]';
          var metaSpan = document.createElement('span');
          metaSpan.className = 'truncate font-code text-[11px]';
          metaSpan.textContent = fmtTenure(m) + (m.school ? ' · ' + m.school : '');

          var mapBtn = document.createElement('button');
          mapBtn.type = 'button';
          mapBtn.className = 'text-[#1B365D] font-medium hover:underline shrink-0';
          mapBtn.textContent = 'Locate ↑';
          mapBtn.addEventListener('click', function () {
            stageEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
            selectMember(m.id, true);
          });

          footer.appendChild(metaSpan);
          footer.appendChild(mapBtn);
          card.appendChild(footer);
          directoryGrid.appendChild(card);
        });
      }

      function setStep(idx, skipCameraFit) {
        state.stepIdx = Math.max(0, Math.min(STEPS.length - 1, Number(idx)));
        sliderEl.value = String(state.stepIdx);
        updateTargets();
        renderControls();
        renderDirectory();
        if (!skipCameraFit) {
          fitTeamCamera(state.team);
        }
      }

      function togglePlay() {
        if (state.isPlaying) {
          clearInterval(state.playTimer);
          state.playTimer = null;
          state.isPlaying = false;
          playSvg.classList.remove('hidden');
          pauseSvg.classList.add('hidden');
          playLabel.textContent = 'Play Season 1';
        } else {
          state.isPlaying = true;
          playSvg.classList.add('hidden');
          pauseSvg.classList.remove('hidden');
          playLabel.textContent = 'Pause story';
          if (state.stepIdx === STEPS.length - 1) setStep(0, false);
          state.playTimer = setInterval(function () {
            if (state.stepIdx >= STEPS.length - 1) {
              togglePlay();
            } else {
              setStep(state.stepIdx + 1, false);
            }
          }, 1650);
        }
      }

      // Wire events
      sliderEl.addEventListener('input', function (e) { setStep(e.target.value, false); });
      playBtn.addEventListener('click', togglePlay);
      searchInput.addEventListener('input', function (e) {
        state.search = e.target.value;
        renderControls();
        renderDirectory();
        refreshVisualStyles();
      });
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && state.search.trim()) {
          var first = ALL_MEMBERS.find(function (m) {
            return isActiveAtStep(m, state.stepIdx) && matchesFilter(m);
          });
          if (first) {
            stageEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
            selectMember(first.id, true);
          }
        }
      });
      searchClearBtn.addEventListener('click', function () {
        state.search = '';
        searchInput.value = '';
        renderControls();
        renderDirectory();
        refreshVisualStyles();
        searchInput.focus();
      });
      sortSelect.addEventListener('change', function (e) {
        state.sort = e.target.value;
        renderDirectory();
      });

      window.addEventListener('resize', function () {
        var activeTab = milestoneTrackEl.querySelector('[aria-selected="true"]');
        positionSlidingPill(milestoneTrackEl, timelinePillEl, activeTab);
        syncDirStatusButtons();
      });

      document.getElementById('close-inspector-btn').addEventListener('click', closeInspector);
      document.getElementById('copy-link-btn').addEventListener('click', function () {
        if (!state.selectedId) return;
        var url = window.location.origin + '/team#member=' + encodeURIComponent(state.selectedId);
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).catch(function () {});
        }
        var lbl = document.getElementById('copy-link-label');
        lbl.textContent = 'Copied';
        setTimeout(function () { lbl.textContent = 'Copy'; }, 1500);
      });

      document.querySelectorAll('[data-highlight-founder]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var fid = btn.getAttribute('data-highlight-founder');
          stageEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
          if (fid) selectMember(fid, true);
        });
      });

      document.getElementById('btn-zoom-in').addEventListener('click', function () {
        var nextZoom = Math.min(2.5, cam.tzoom * 1.22);
        var ratio = nextZoom / cam.tzoom;
        cam.tx = CX - (CX - cam.tx) * ratio;
        cam.ty = CY - (CY - cam.ty) * ratio;
        cam.tzoom = nextZoom;
        startAnimation();
      });
      document.getElementById('btn-zoom-out').addEventListener('click', function () {
        var nextZoom = Math.max(0.7, cam.tzoom / 1.22);
        var ratio = nextZoom / cam.tzoom;
        cam.tx = CX - (CX - cam.tx) * ratio;
        cam.ty = CY - (CY - cam.ty) * ratio;
        cam.tzoom = nextZoom;
        startAnimation();
      });
      document.getElementById('btn-zoom-reset').addEventListener('click', function () {
        if (state.team === 'All' && !state.selectedId) {
          fitStepCamera();
        } else {
          cam.tx = 0;
          cam.ty = 0;
          cam.tzoom = 1;
          startAnimation();
        }
      });

      viewportEl.addEventListener('wheel', function (e) {
        e.preventDefault();
        var rect = svgEl.getBoundingClientRect();
        var scale = Math.min(rect.width / 1080, rect.height / 800) || 1;
        var ox = (rect.width - 1080 * scale) / 2;
        var oy = (rect.height - 800 * scale) / 2;
        var px = (e.clientX - rect.left - ox) / scale;
        var py = (e.clientY - rect.top - oy) / scale;

        var factor = e.deltaY < 0 ? 1.12 : 0.89;
        var nextZoom = Math.min(2.5, Math.max(0.7, cam.tzoom * factor));
        var ratio = nextZoom / cam.tzoom;
        cam.x = cam.tx = px - (px - cam.tx) * ratio;
        cam.y = cam.ty = py - (py - cam.ty) * ratio;
        cam.zoom = cam.tzoom = nextZoom;
        graphContent.setAttribute('transform', 'translate(' + cam.x.toFixed(2) + ', ' + cam.y.toFixed(2) + ') scale(' + cam.zoom.toFixed(4) + ')');
        refreshVisualStyles();
      }, { passive: false });

      viewportEl.addEventListener('pointerdown', function (e) {
        if (e.target.closest('.node-group')) return;
        dragging = true;
        dragStart = { x: e.clientX, y: e.clientY, camX: cam.x, camY: cam.y };
        viewportEl.setPointerCapture(e.pointerId);
      });
      viewportEl.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var rect = svgEl.getBoundingClientRect();
        var scale = Math.min(rect.width / 1080, rect.height / 800) || 1;
        cam.x = cam.tx = dragStart.camX + (e.clientX - dragStart.x) / scale;
        cam.y = cam.ty = dragStart.camY + (e.clientY - dragStart.y) / scale;
        graphContent.setAttribute('transform', 'translate(' + cam.x.toFixed(2) + ', ' + cam.y.toFixed(2) + ') scale(' + cam.zoom.toFixed(4) + ')');
      });
      viewportEl.addEventListener('pointerup', function () { dragging = false; });
      viewportEl.addEventListener('pointercancel', function () { dragging = false; });
      viewportEl.addEventListener('click', function (e) {
        if (!e.target.closest('.node-group') && Math.hypot(e.clientX - dragStart.x, e.clientY - dragStart.y) < 5) {
          closeInspector();
        }
      });

      document.addEventListener('keydown', function (e) {
        var tag = document.activeElement && document.activeElement.tagName;
        var inInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
        if (e.key === '/' && !inInput) {
          e.preventDefault();
          searchInput.focus();
          return;
        }
        if (e.key === 'Escape') {
          if (state.selectedId) closeInspector();
          if (document.activeElement === searchInput) searchInput.blur();
          return;
        }
        if (inInput) return;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          setStep(state.stepIdx + 1, false);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          setStep(state.stepIdx - 1, false);
        } else if (e.key === ' ') {
          e.preventDefault();
          togglePlay();
        }
      });

      // Boot immediately from sanitized snapshot
      indexMembers(initialMembers);
      updateTargets();
      syncDirStatusButtons();
      renderControls();
      renderDirectory();
      fitStepCamera();

      var params = new URLSearchParams(window.location.search);
      if (params.get('team')) {
        state.team = params.get('team');
        renderControls();
        renderDirectory();
        fitTeamCamera(state.team);
      }
      if (window.location.hash.startsWith('#member=')) {
        var targetId = decodeURIComponent(window.location.hash.slice('#member='.length));
        if (BY_ID.has(targetId)) selectMember(targetId, true);
      }

      function decodeFsValue(v) {
        if (!v || typeof v !== 'object') return undefined;
        if ('stringValue' in v) return v.stringValue;
        if ('booleanValue' in v) return v.booleanValue;
        if ('integerValue' in v) return Number(v.integerValue);
        if ('doubleValue' in v) return Number(v.doubleValue);
        if ('nullValue' in v) return null;
        if ('timestampValue' in v) return v.timestampValue;
        if ('arrayValue' in v) return (v.arrayValue.values || []).map(decodeFsValue);
        if ('mapValue' in v) {
          var o = {};
          var f = v.mapValue.fields || {};
          Object.keys(f).forEach(function (k) { o[k] = decodeFsValue(f[k]); });
          return o;
        }
        return undefined;
      }

      async function fetchFsTeamMembers() {
        var res = await fetch(
          'https://firestore.googleapis.com/v1/projects/tf-unions/databases/(default)/documents/teamMembers?pageSize=250',
          { cache: 'no-store' }
        );
        if (!res.ok) return [];
        var data = await res.json();
        return (data.documents || []).map(function (doc) {
          var o = { id: doc.name.split('/').pop() };
          var fields = doc.fields || {};
          Object.keys(fields).forEach(function (k) { o[k] = decodeFsValue(fields[k]); });
          return {
            id: o.id,
            name: o.name || '',
            arabicName: o.arabicName || '',
            role: o.role || '',
            team: o.team || 'HR Team',
            subTrack: o.subTrack || '',
            tier: typeof o.tier === 'number' ? o.tier : 4,
            isAI: Boolean(o.isAI),
            school: o.school || 'TF Unions',
            grade: o.grade || '',
            cohortDate: o.startDate || o.cohortDate || '2025-07-01',
            startDate: o.startDate || o.cohortDate || '2025-07-01',
            endDate: o.endDate || '',
            status: o.endDate ? 'alumni' : (o.status || 'active'),
            replacedBy: o.replacedBy || '',
            replaces: o.replaces || '',
            cohortLabel: o.cohortLabel || '',
            bio: o.bio || '',
            x: typeof o.x === 'number' ? o.x : 540,
            y: typeof o.y === 'number' ? o.y : 400,
            r: typeof o.r === 'number' ? o.r : 11,
            parent: o.parent || null,
            hub: o.hub || o.team || 'HR Team',
            archived: Boolean(o.archived),
          };
        });
      }

      async function refreshDynamicMembers() {
        var baseList = initialMembers.slice();
        try {
          var ctrl = new AbortController();
          var timer = setTimeout(function () { ctrl.abort(); }, 2500);
          var res = await fetch('/team.json', { signal: ctrl.signal, cache: 'no-store' });
          clearTimeout(timer);
          if (res.ok) {
            var payload = await res.json();
            var list = Array.isArray(payload) ? payload : payload && Array.isArray(payload.members) ? payload.members : null;
            if (list && list.length > 0) baseList = list;
          }
        } catch (_) {}

        try {
          var overrides = await fetchFsTeamMembers();
          var map = new Map(baseList.map(function (m) { return [m.id, m]; }));
          overrides.forEach(function (ov) {
            var prev = map.get(ov.id) || {};
            map.set(ov.id, Object.assign({}, prev, ov, { id: ov.id }));
          });
          var merged = Array.from(map.values()).filter(function (m) { return !m.archived && m.name; });
          if (merged.length > 0) {
            indexMembers(merged);
            updateTargets();
            renderControls();
            renderDirectory();
            if (state.selectedId && BY_ID.has(state.selectedId)) {
              renderInspector(BY_ID.get(state.selectedId));
            }
            sourceStatusEl.textContent = overrides.length > 0 ? 'Live Studio synced' : 'Live registry synced';
          }
        } catch (_) {
          indexMembers(baseList);
          updateTargets();
          renderControls();
          renderDirectory();
          sourceStatusEl.textContent = 'Live registry synced';
        }
      }
      refreshDynamicMembers();
    })();
  </script>
</BaseLayout>
