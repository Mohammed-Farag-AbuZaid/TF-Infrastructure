      <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
        <div class="relative flex-1 md:w-64">
          <input
            id="graph-search"
            type="search"
            placeholder="Search name, school, track..."
            aria-label="Search team directory"
            class="w-full h-9 pl-3 pr-14 bg-white border border-[#DFDDD6] rounded-lg text-[13px] text-[#161A22] placeholder-[#767D8C] focus:border-[#1B365D] focus:outline-none"
          />
          <span id="search-match-pill" class="hidden absolute right-7 top-1/2 -translate-y-1/2 font-code text-[11px] text-[#0B5F58]"></span>
          <button
            id="search-clear-btn"
            type="button"
            aria-label="Clear search"
            class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-[#767D8C] hover:text-[#161A22] p-0.5"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
