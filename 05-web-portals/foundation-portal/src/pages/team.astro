---
import BaseLayout from '../layouts/BaseLayout.astro';
import teamData from '../data/team-nodes.json';
import { toPublicMember } from './team.json';

const publicMembers = (teamData as Parameters<typeof toPublicMember>[0][]).map(toPublicMember);
const founders = publicMembers.filter((m) => m.tier === 0);
const zainMember = publicMembers.find((m) => m.id === 'zain-ai' || m.isAI);
const coreLeaders = zainMember ? [...founders, zainMember] : founders;
const alumniCount = publicMembers.filter((m) => Boolean(m.endDate) || m.status === 'alumni').length;
const activeCoreCount = publicMembers.length - alumniCount;
const teamCount = new Set(publicMembers.map((m) => m.team)).size;
---
<BaseLayout title="Team" backLabel="TF Unions" backHref="/">
  <style is:inline>
    @keyframes tf-flow {
      from { stroke-dashoffset: 24; }
      to { stroke-dashoffset: 0; }
    }
    @keyframes tf-ai-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes tf-ai-pulse {
      0%, 100% { opacity: 0.72; transform: scale(1); }
      50% { opacity: 0.22; transform: scale(1.22); }
    }
    @keyframes tf-live-ping {
      0% { transform: scale(0.95); opacity: 0.85; }
      75%, 100% { transform: scale(2.05); opacity: 0; }
    }
    @keyframes tf-card-enter {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .tf-edge-flow {
      stroke-dasharray: 6 6;
      animation: tf-flow 1.15s linear infinite;
    }
    .tf-ai-orbit {
      transform-origin: 0px 0px;
      animation: tf-ai-spin 22s linear infinite;
    }
    .tf-ai-pulse-ring {
      transform-origin: 0px 0px;
      animation: tf-ai-pulse 3.2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    .tf-live-dot {
      position: relative;
    }
    .tf-live-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      background-color: #0F766E;
      animation: tf-live-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    .tf-card-enter {
      animation: tf-card-enter 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .tf-pill-track {
      position: relative;
    }
    .tf-pill-indicator {
      position: absolute;
      top: 3px;
      bottom: 3px;
      left: 0;
      border-radius: 8px;
      transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1), width 380ms cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
    }
    .tf-timeline-progress {
      transition: width 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    @media (prefers-reduced-motion: reduce) {
      .tf-edge-flow,
      .tf-ai-orbit,
      .tf-ai-pulse-ring,
      .tf-live-dot::after,
      .tf-card-enter {
        animation: none !important;
      }
      .tf-edge-flow {
        stroke-dasharray: none;
      }
      .tf-pill-indicator,
      .tf-timeline-progress {
        transition: none !important;
      }
    }
  </style>

  <!-- Asymmetric 12-Column Editorial Hero -->
  <section class="pt-8 sm:pt-12 pb-8 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-end">
    <div class="lg:col-span-7">
      <h1
        data-tf-copy="team.headline"
        class="font-display font-bold text-[#161A22] leading-[1.03] tracking-[-0.03em]"
        style="font-size: clamp(34px, 4.6vw, 54px);"
      >
        From Season 1 roots to an AI-augmented core.
      </h1>
      <p data-tf-copy="team.subtitle" class="mt-4 text-[16px] leading-[1.65] text-[#525866] max-w-[60ch]">
        Two co-founders launched TF Unions in July 2025, grew Season 1 to {alumniCount} student leaders across Egypt through November 2025, welcomed Zain as our first AI teammate in October 2026, and continue leading Season 2 today.
      </p>
    </div>

    <!-- Clean White Summary & Morphing Division Bar -->
    <div class="lg:col-span-5 bg-white border border-[#DFDDD6] rounded-xl p-5 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-[12.5px] font-medium text-[#525866]">
            <span class="w-2 h-2 rounded-full bg-[#0F766E] inline-block tf-live-dot" aria-hidden="true"></span>
            <span id="hero-milestone-name">Live Now · Season 2 (2026)</span>
          </div>
          <div class="mt-2 flex items-baseline gap-2.5 flex-wrap">
            <span id="hero-active-num" class="font-display font-bold text-[46px] leading-none tracking-[-0.03em] text-[#161A22] tabular-nums">
              {activeCoreCount}
            </span>
            <span id="hero-active-unit" class="text-[13.5px] text-[#525866] font-medium">active core</span>
            <span id="hero-alumni-chip" class="font-code text-[11.5px] px-2 py-0.5 rounded bg-[#EAE8E1] text-[#525866]">
              {alumniCount} S1 Alumni (2025)
            </span>
          </div>
        </div>

        <a
          href="/roster"
          class="text-[12.5px] font-medium text-[#1B365D] hover:underline shrink-0 pt-0.5"
        >
          Full roster →
        </a>
      </div>

      <!-- Morphing Proportional Division Bar -->
      <div id="division-bar" class="mt-4 h-2.5 w-full rounded-full overflow-hidden bg-[#EAE8E1] flex gap-[2px]" aria-label="Division proportions"></div>

      <!-- Clickable Division Legend -->
      <div id="division-legend" class="mt-3 flex flex-wrap gap-x-3.5 gap-y-1.5 text-[12px] text-[#525866]"></div>
    </div>
  </section>

  <!-- Deep Fjord Architectural Observatory Stage -->
  <section
    id="constellation-stage"
    class="rounded-2xl overflow-hidden bg-[#0F1D33] border border-[#1B365D]/40 shadow-[0_12px_36px_rgba(15,29,51,0.16)]"
  >
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_348px]">
      <!-- Interactive SVG Orbital Canvas -->
      <div class="relative bg-[#0F1D33] overflow-hidden">
        <!-- Floating Top Controls Row -->
        <div class="absolute top-3.5 left-3.5 right-3.5 z-10 flex flex-wrap items-center justify-between gap-2 pointer-events-none">
          <div class="pointer-events-auto flex flex-wrap items-center gap-2">
            <div id="stage-status-chip" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#142540]/95 border border-white/10 text-[11.5px] text-[#CBD5E1]">
              <span id="data-source-dot" class="w-1.5 h-1.5 rounded-full bg-[#5EC4B8]"></span>
              <span id="data-source-status">Live registry</span>
            </div>
          </div>

          <div class="pointer-events-auto flex items-center gap-1 bg-[#142540]/95 p-1 rounded-lg border border-white/15">
            <button id="btn-zoom-in" type="button" class="w-7 h-7 rounded flex items-center justify-center text-[#ECEAE4] hover:bg-white/10 transition" aria-label="Zoom in" title="Zoom in">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </button>
            <button id="btn-zoom-out" type="button" class="w-7 h-7 rounded flex items-center justify-center text-[#ECEAE4] hover:bg-white/10 transition" aria-label="Zoom out" title="Zoom out">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </button>
            <button id="btn-zoom-reset" type="button" class="px-2 h-7 rounded flex items-center justify-center text-[#CBD5E1] hover:bg-white/10 text-[11px] font-code font-medium transition" title="Fit orbital map">
              Fit
            </button>
          </div>
        </div>

        <!-- Crisp Hover Tooltip -->
        <div
          id="node-tooltip"
          class="hidden pointer-events-none absolute z-30 px-3 py-1.5 rounded-lg bg-[#F3F2EE] text-[#161A22] border border-[#DFDDD6] text-[12px] font-medium shadow-lg whitespace-nowrap"
        ></div>

        <div id="graph-viewport" class="w-full h-[450px] sm:h-[540px] lg:h-[640px] cursor-grab active:cursor-grabbing select-none touch-none">
          <svg
            id="network-svg"
            viewBox="0 0 1080 800"
            class="w-full h-full"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label="Interactive TF Unions orbital team constellation"
          >
            <defs>
              <radialGradient id="stage-glow" cx="50%" cy="50%" r="54%">
                <stop offset="0%" stop-color="#1B365D" stop-opacity="0.58" />
                <stop offset="65%" stop-color="#132542" stop-opacity="0.22" />
                <stop offset="100%" stop-color="#0F1D33" stop-opacity="0" />
              </radialGradient>
              <filter id="node-glow" x="-35%" y="-35%" width="170%" height="170%">
                <feDropShadow dx="0" dy="2" stdDeviation="3.2" flood-color="#060D1A" flood-opacity="0.5" />
              </filter>
            </defs>

            <rect width="1080" height="800" fill="url(#stage-glow)" />

            <g id="graph-content">
              <!-- Architectural Orbital Rings & Dynamic Sector Axes -->
              <g id="orbits-layer" pointer-events="none">
                <line x1="540" y1="36" x2="540" y2="764" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                <line x1="140" y1="400" x2="940" y2="400" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                <circle cx="540" cy="400" r="96" fill="none" stroke="rgba(94,196,184,0.16)" stroke-width="1" stroke-dasharray="2 4" />
                <circle cx="540" cy="400" r="148" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="3 5" />
                <circle cx="540" cy="400" r="214" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="1" stroke-dasharray="3 5" />
                <circle cx="540" cy="400" r="284" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="3 5" />
                <circle cx="540" cy="400" r="342" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1" stroke-dasharray="3 5" />

                <!-- Sector Labels positioned directly outside their angular arcs -->
                <text data-sector-team="AI & Automation" x="540" y="54" text-anchor="middle" font-size="10.5" font-weight="600" letter-spacing="0.09em" fill="#5EC4B8" style="transition: opacity 320ms ease;">AI &amp; AUTOMATION</text>
                <text data-sector-team="PR Team" x="802" y="138" text-anchor="start" font-size="10.5" font-weight="600" letter-spacing="0.08em" fill="#5EC4B8" style="transition: opacity 320ms ease;">PR TEAM</text>
                <text data-sector-team="Social Media Team" x="908" y="405" text-anchor="start" font-size="10.5" font-weight="600" letter-spacing="0.08em" fill="#E7A35C" style="transition: opacity 320ms ease;">SOCIAL MEDIA</text>
                <text data-sector-team="Content Production" x="772" y="692" text-anchor="start" font-size="10.5" font-weight="600" letter-spacing="0.08em" fill="#FDBA74" style="transition: opacity 320ms ease;">CONTENT PROD.</text>
                <text data-sector-team="Academic Fields" x="378" y="758" text-anchor="middle" font-size="10.5" font-weight="600" letter-spacing="0.08em" fill="#6EE7B7" style="transition: opacity 320ms ease;">ACADEMIC FIELDS</text>
                <text data-sector-team="Marketing Team" x="172" y="405" text-anchor="end" font-size="10.5" font-weight="600" letter-spacing="0.08em" fill="#CBD5E1" style="transition: opacity 320ms ease;">MARKETING</text>
                <text data-sector-team="HR Team" x="278" y="138" text-anchor="end" font-size="10.5" font-weight="600" letter-spacing="0.08em" fill="#8FB1E0" style="transition: opacity 320ms ease;">HR TEAM</text>
              </g>

              <g id="edges-layer"></g>
              <g id="nodes-layer"></g>
            </g>
          </svg>
        </div>

        <div class="hidden sm:flex items-center justify-between px-4 pb-2.5 text-[11px] text-[#9AA7BC]">
          <span>Click any node to inspect lineage · Drag canvas to pan · Scroll to zoom</span>
          <span class="font-code">/ search · ← → step · Space play</span>
        </div>
      </div>

      <!-- Docked Right Panel: Cohort Spotlight OR Selected Member Inspector -->
      <aside
        id="side-panel"
        aria-label="Member spotlight and inspector"
        class="bg-[#142540] border-t lg:border-t-0 lg:border-l border-white/10 text-[#ECEAE4] p-5 flex flex-col lg:h-[668px] overflow-y-auto"
      >
        <!-- Default State: Cohort Spotlight -->
        <div id="spotlight-view" class="flex flex-col h-full">
          <div class="flex items-center justify-between gap-2 pb-3 border-b border-white/10">
            <div>
              <h2 class="font-display font-semibold text-[17px] text-[#F3F2EE]">Cohort spotlight</h2>
              <p id="spotlight-sub" class="text-[12px] text-[#9AA7BC] mt-0.5">Select a node on the orbital map or click below</p>
            </div>
          </div>

          <div id="spotlight-list" class="mt-3 space-y-2 overflow-y-auto flex-1 pr-0.5"></div>

          <div class="mt-4 pt-3 border-t border-white/10 text-[12px] text-[#9AA7BC] flex items-center justify-between">
            <span>Browse all {publicMembers.length} records</span>
            <a href="#directory-section" class="text-[#5EC4B8] font-medium hover:underline">Jump to directory ↓</a>
          </div>
        </div>

        <!-- Selected Member State -->
        <div id="inspector-view" class="hidden flex-col h-full">
          <div class="flex items-start justify-between gap-3 pb-4 border-b border-white/10">
            <div class="flex items-center gap-3 min-w-0">
              <div id="insp-avatar" class="w-11 h-11 rounded-xl flex items-center justify-center font-bold text-[#0F1D33] text-[14px] shrink-0"></div>
              <div class="min-w-0">
                <h2 id="insp-name" class="font-display font-bold text-[18px] text-[#F3F2EE] leading-tight"></h2>
                <div id="insp-arabic" class="text-[12.5px] text-[#C7D0DE] mt-0.5 hidden"></div>
                <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                  <span id="insp-team-badge" class="inline-block px-2 py-0.5 rounded text-[11px] font-medium"></span>
                  <span id="insp-status-badge" class="inline-block px-2 py-0.5 rounded text-[11px] font-code font-medium"></span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-1 shrink-0">
              <button
                id="copy-link-btn"
                type="button"
                class="h-7 px-2 rounded border border-white/15 hover:border-[#5EC4B8] text-[11px] font-medium text-[#C7D0DE] hover:text-white transition inline-flex items-center gap-1"
                title="Copy deep link"
              >
                <span id="copy-link-label">Copy</span>
              </button>
              <button
                id="close-inspector-btn"
                type="button"
                class="w-7 h-7 rounded flex items-center justify-center text-[#9AA7BC] hover:text-white hover:bg-white/10 transition"
                aria-label="Back to cohort spotlight"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </button>
            </div>
          </div>

          <div class="mt-4 space-y-2 text-[13px]">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">Role</span>
              <strong id="insp-role" class="text-[#F3F2EE] font-medium text-right"></strong>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">School / Stack</span>
              <span id="insp-school" class="text-[#ECEAE4] text-right"></span>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">Grade</span>
              <span id="insp-grade" class="text-[#ECEAE4] text-right"></span>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">Tenure</span>
              <span id="insp-cohort" class="font-code text-[#7DD3C8] font-medium text-right"></span>
            </div>
          </div>

          <p id="insp-bio" class="mt-4 p-3.5 rounded-xl bg-[#0F1D33]/80 border border-white/10 text-[12.5px] leading-[1.6] text-[#C7D0DE]"></p>

          <div id="insp-lineage" class="mt-4 pt-3 border-t border-white/10 space-y-3 hidden">
            <div id="insp-parent-wrap" class="hidden">
              <div class="text-[11px] font-medium text-[#9AA7BC] mb-1.5">Reports to</div>
              <div id="insp-parent-slot" class="flex flex-wrap gap-1.5"></div>
            </div>
            <div id="insp-reports-wrap" class="hidden">
              <div id="insp-reports-label" class="text-[11px] font-medium text-[#9AA7BC] mb-1.5">Direct reports</div>
              <div id="insp-reports-slot" class="flex flex-wrap gap-1.5 max-h-28 overflow-y-auto"></div>
            </div>
            <div id="insp-replaces-wrap" class="hidden">
              <div class="text-[11px] font-medium text-[#9AA7BC] mb-1.5">Preceded by</div>
              <div id="insp-replaces-slot" class="flex flex-wrap gap-1.5"></div>
            </div>
            <div id="insp-replaced-wrap" class="hidden">
              <div class="text-[11px] font-medium text-[#9AA7BC] mb-1.5">Succeeded by</div>
              <div id="insp-replaced-slot" class="flex flex-wrap gap-1.5"></div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- Smooth Sliding Pill Season 1 Timeline Bar -->
    <div class="bg-[#0B1628] border-t border-white/10 px-4 sm:px-5 py-4 text-[#ECEAE4]">
      <div class="flex flex-col lg:flex-row lg:items-center gap-4">
        <button
          id="play-btn"
          type="button"
          class="h-10 px-4 rounded-xl bg-[#F3F2EE] hover:bg-white text-[#0F1D33] text-[13px] font-semibold transition inline-flex items-center gap-2 shrink-0 w-fit shadow-xs"
        >
          <svg id="play-svg" width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
            <polygon points="2,1 11,6 2,11" />
          </svg>
          <svg id="pause-svg" width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" class="hidden">
            <rect x="2" y="1.5" width="3" height="9" rx="0.5" />
            <rect x="7" y="1.5" width="3" height="9" rx="0.5" />
          </svg>
          <span id="play-label">Play Season 1</span>
        </button>

        <div class="flex-1 min-w-0 space-y-2.5">
          <div class="flex items-center justify-between gap-3 text-[12.5px]">
            <span id="cohort-desc" class="text-[#F3F2EE] font-medium truncate">
              Season 2 Live Now (2026) — Active Founders &amp; Zain AI (select 2025 tabs to replay Season 1)
            </span>
            <span id="active-count-badge" class="font-code text-[#7DD3C8] shrink-0">{activeCoreCount} active · {alumniCount} alumni</span>
          </div>

          <!-- Progress Rail + Fluid Sliding Pill Milestones -->
          <div class="relative">
            <div class="h-1 w-full rounded-full bg-white/10 overflow-hidden mb-2">
              <div id="timeline-progress-fill" class="h-full bg-[#5EC4B8] tf-timeline-progress" style="width: 100%;"></div>
            </div>
            <div
              id="milestone-pill-track"
              class="tf-pill-track grid grid-cols-3 sm:grid-cols-6 gap-1 p-1 rounded-xl bg-[#101F38] border border-white/10"
              role="tablist"
              aria-label="Season 1 to Season 2 timeline toggle"
            >
              <div id="timeline-active-pill" class="tf-pill-indicator bg-[#1D365C] border border-[#5EC4B8]/45 shadow-sm"></div>
            </div>
          </div>

          <!-- Keyboard-accessible range fallback kept synced cleanly -->
          <input
            id="timeline-slider"
            type="range"
            min="0"
            max="5"
            step="1"
            value="5"
            aria-label="Timeline step"
            class="sr-only"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Core Leadership & First AI Teammate Editorial Strip -->
  <section class="pt-12 pb-6">
    <div class="flex items-baseline justify-between gap-4 pb-4 border-b border-[#DFDDD6]">
      <h2 data-tf-copy="team.founders_heading" class="font-display font-bold text-[22px] text-[#161A22] tracking-[-0.02em]">Core leadership &amp; first AI teammate</h2>
      <span class="font-code text-[12px] text-[#0B5F58]">Jul 2025 Founding · Oct 2026 AI Core</span>
    </div>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
      {coreLeaders.map((f) => {
        const isAi = Boolean(f.isAI);
        return (
          <article class={`bg-white border ${isAi ? 'border-[#0F766E]/45 border-t-[3px] border-t-[#0F766E]' : 'border-[#DFDDD6]'} rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.03)] flex flex-col justify-between transition hover:border-[#B8B4A8]`}>
            <div>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="font-display font-bold text-[20px] text-[#161A22]">{f.name}</h3>
                    {isAi ? (
                      <span class="px-2 py-0.5 rounded bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58] font-code text-[11px] font-semibold">AI Member</span>
                    ) : null}
                  </div>
                  <div class={`text-[13px] font-medium mt-0.5 ${isAi ? 'text-[#0B5F58]' : 'text-[#1B365D]'}`}>{f.role}</div>
                </div>
                <span class="font-code text-[12px] text-[#767D8C] shrink-0">{f.arabicName}</span>
              </div>

              <p class="mt-3 text-[13.5px] leading-[1.62] text-[#525866]">{f.bio}</p>

              {isAi ? (
                <div class="mt-3.5 flex flex-wrap gap-1.5">
                  <span class="px-2 py-0.5 rounded bg-[#F3F2EE] border border-[#DFDDD6] text-[11px] font-medium text-[#161A22]">Scholarship Research</span>
                  <span class="px-2 py-0.5 rounded bg-[#F3F2EE] border border-[#DFDDD6] text-[11px] font-medium text-[#161A22]">24/7 Stack Ops</span>
                  <span class="px-2 py-0.5 rounded bg-[#F3F2EE] border border-[#DFDDD6] text-[11px] font-medium text-[#161A22]">Multi-Agent Code</span>
                  <span class="px-2 py-0.5 rounded bg-[#F3F2EE] border border-[#DFDDD6] text-[11px] font-medium text-[#161A22]">Executive Assistant</span>
                </div>
              ) : null}
            </div>

            <div class="mt-4 pt-3 border-t border-[#EAE8E1] flex items-center justify-between text-[12.5px]">
              <span class="text-[#767D8C] font-code text-[11.5px]">{f.cohortLabel || f.school}</span>
              <button
                type="button"
                data-highlight-founder={f.id}
                class={`font-medium hover:underline ${isAi ? 'text-[#0B5F58]' : 'text-[#1B365D]'}`}
              >
                {isAi ? 'Locate Zain ↑' : 'Highlight branch ↑'}
              </button>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Synchronized Searchable Member Directory -->
  <section id="directory-section" class="pt-8 pb-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-[#DFDDD6]">
      <div>
        <h2 class="font-display font-bold text-[24px] text-[#161A22] tracking-[-0.02em]">
          Team &amp; Season 1 Alumni directory
        </h2>
        <p id="dir-subtitle" class="mt-1 text-[14.5px] text-[#525866]">
          Showing contributors across TF Unions Season 1 &amp; Season 2.
        </p>
