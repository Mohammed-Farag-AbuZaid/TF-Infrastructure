---
import BaseLayout from '../layouts/BaseLayout.astro';
import teamData from '../data/team-nodes.json';
import { toPublicMember } from './team.json';

const publicMembers = (teamData as Parameters<typeof toPublicMember>[0][]).map(toPublicMember);
const founders = publicMembers.filter((m) => m.tier === 0);
const teamCount = new Set(publicMembers.map((m) => m.team)).size;
---
<BaseLayout title="Team" backLabel="TF Unions" backHref="/">
  <style is:inline>
    @keyframes tf-flow {
      from { stroke-dashoffset: 24; }
      to { stroke-dashoffset: 0; }
    }
    .tf-edge-flow {
      stroke-dasharray: 6 6;
      animation: tf-flow 1.15s linear infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .tf-edge-flow {
        animation: none;
        stroke-dasharray: none;
      }
    }
  </style>

  <!-- Asymmetric 12-Column Editorial Hero -->
  <section class="pt-8 sm:pt-12 pb-8 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-end">
    <div class="lg:col-span-7">
      <h1
        class="font-display font-bold text-[#161A22] leading-[1.03] tracking-[-0.03em]"
        style="font-size: clamp(34px, 4.6vw, 54px);"
      >
        Seventy-one students building Egypt’s STEM union.
      </h1>
      <p class="mt-4 text-[16px] leading-[1.65] text-[#525866] max-w-[58ch]">
        From two founding systems architects in October 2025 to {publicMembers.length} active leaders across {teamCount} operational divisions — scrub the timeline below or explore the live directory.
      </p>
    </div>

    <!-- Clean White Summary & Morphing Division Bar -->
    <div class="lg:col-span-5 bg-white border border-[#DFDDD6] rounded-xl p-5 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-[12.5px] font-medium text-[#525866]">
            <span class="w-2 h-2 rounded-full bg-[#0F766E] inline-block" aria-hidden="true"></span>
            <span id="hero-milestone-name">Nov 2026 · Full Network</span>
          </div>
          <div class="mt-2 flex items-baseline gap-2.5">
            <span id="hero-active-num" class="font-display font-bold text-[46px] leading-none tracking-[-0.03em] text-[#161A22] tabular-nums">
              {publicMembers.length}
            </span>
            <span class="text-[13.5px] text-[#525866] font-medium">active contributors</span>
          </div>
        </div>

        <a
          href="/roster"
          class="text-[12.5px] font-medium text-[#1B365D] hover:underline shrink-0 pt-0.5"
        >
          Full roster →
        </a>
      </div>

      <!-- Morphing Proportional Division Bar -->
      <div id="division-bar" class="mt-4 h-2.5 w-full rounded-full overflow-hidden bg-[#EAE8E1] flex gap-[2px]" aria-label="Division proportions"></div>

      <!-- Clickable Division Legend -->
      <div id="division-legend" class="mt-3 flex flex-wrap gap-x-3.5 gap-y-1.5 text-[12px] text-[#525866]"></div>
    </div>
  </section>

  <!-- Deep Fjord Architectural Observatory Stage -->
  <section
    id="constellation-stage"
    class="rounded-2xl overflow-hidden bg-[#0F1D33] border border-[#1B365D]/40 shadow-[0_12px_36px_rgba(15,29,51,0.16)]"
  >
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px]">
      <!-- Interactive SVG Orbital Canvas -->
      <div class="relative bg-[#0F1D33] overflow-hidden">
        <!-- Floating Top Controls Row -->
        <div class="absolute top-3.5 left-3.5 right-3.5 z-10 flex items-center justify-between gap-2 pointer-events-none">
          <div id="stage-status-chip" class="pointer-events-auto inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#142540]/90 border border-white/10 text-[11.5px] text-[#CBD5E1]">
            <span id="data-source-dot" class="w-1.5 h-1.5 rounded-full bg-[#5EC4B8]"></span>
            <span id="data-source-status">Live registry</span>
          </div>

          <div class="pointer-events-auto flex items-center gap-1 bg-[#142540]/95 p-1 rounded-lg border border-white/15">
            <button id="btn-zoom-in" type="button" class="w-7 h-7 rounded flex items-center justify-center text-[#ECEAE4] hover:bg-white/10 transition" aria-label="Zoom in" title="Zoom in">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </button>
            <button id="btn-zoom-out" type="button" class="w-7 h-7 rounded flex items-center justify-center text-[#ECEAE4] hover:bg-white/10 transition" aria-label="Zoom out" title="Zoom out">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </button>
            <button id="btn-zoom-reset" type="button" class="px-2 h-7 rounded flex items-center justify-center text-[#CBD5E1] hover:bg-white/10 text-[11px] font-code font-medium transition" title="Fit orbital map">
              Fit
            </button>
          </div>
        </div>

        <!-- Crisp Hover Tooltip -->
        <div
          id="node-tooltip"
          class="hidden pointer-events-none absolute z-30 px-3 py-1.5 rounded-lg bg-[#F3F2EE] text-[#161A22] border border-[#DFDDD6] text-[12px] font-medium shadow-lg whitespace-nowrap"
        ></div>

        <div id="graph-viewport" class="w-full h-[430px] sm:h-[520px] lg:h-[620px] cursor-grab active:cursor-grabbing select-none touch-none">
          <svg
            id="network-svg"
            viewBox="0 0 1000 760"
            class="w-full h-full"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label="Interactive TF Unions orbital team constellation"
          >
            <defs>
              <radialGradient id="stage-glow" cx="50%" cy="50%" r="52%">
                <stop offset="0%" stop-color="#1B365D" stop-opacity="0.55" />
                <stop offset="100%" stop-color="#0F1D33" stop-opacity="0" />
              </radialGradient>
              <filter id="node-glow" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#08101E" flood-opacity="0.45" />
              </filter>
            </defs>

            <rect width="1000" height="760" fill="url(#stage-glow)" />

            <g id="graph-content">
              <!-- Architectural Orbital Rings & Quadrant Axes -->
              <g id="orbits-layer" pointer-events="none">
                <line x1="500" y1="36" x2="500" y2="724" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
                <line x1="135" y1="380" x2="865" y2="380" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
                <circle cx="500" cy="380" r="130" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="3 5" />
                <circle cx="500" cy="380" r="200" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="1" stroke-dasharray="3 5" />
                <circle cx="500" cy="380" r="268" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="3 5" />
                <circle cx="500" cy="380" r="334" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1" stroke-dasharray="3 5" />

                <!-- Quadrant Titles -->
                <text x="175" y="64" font-size="11" font-weight="600" letter-spacing="0.08em" fill="#8FB1E0">HR TEAM</text>
                <text x="825" y="64" text-anchor="end" font-size="11" font-weight="600" letter-spacing="0.08em" fill="#5EC4B8">PR &amp; OUTREACH</text>
                <text x="175" y="712" font-size="11" font-weight="600" letter-spacing="0.08em" fill="#CBD5E1">MARKETING</text>
                <text x="825" y="712" text-anchor="end" font-size="11" font-weight="600" letter-spacing="0.08em" fill="#E7A35C">SOCIAL MEDIA</text>
              </g>

              <g id="edges-layer"></g>
              <g id="nodes-layer"></g>
            </g>
          </svg>
        </div>

        <div class="hidden sm:flex items-center justify-between px-4 pb-2.5 text-[11px] text-[#9AA7BC]">
          <span>Click any node to inspect lineage · Drag canvas to pan · Scroll to zoom</span>
          <span class="font-code">/ search · ← → step · Space play</span>
        </div>
      </div>

      <!-- Docked Right Panel: Cohort Spotlight OR Selected Member Inspector -->
      <aside
        id="side-panel"
        aria-label="Member spotlight and inspector"
        class="bg-[#142540] border-t lg:border-t-0 lg:border-l border-white/10 text-[#ECEAE4] p-5 flex flex-col lg:h-[648px] overflow-y-auto"
      >
        <!-- Default State: Cohort Spotlight -->
        <div id="spotlight-view" class="flex flex-col h-full">
          <div class="flex items-center justify-between gap-2 pb-3 border-b border-white/10">
            <div>
              <h2 class="font-display font-semibold text-[17px] text-[#F3F2EE]">Cohort spotlight</h2>
              <p id="spotlight-sub" class="text-[12px] text-[#9AA7BC] mt-0.5">Select a node on the orbital map or click below</p>
            </div>
          </div>

          <div id="spotlight-list" class="mt-3 space-y-2 overflow-y-auto flex-1 pr-0.5"></div>

          <div class="mt-4 pt-3 border-t border-white/10 text-[12px] text-[#9AA7BC] flex items-center justify-between">
            <span>Browse all contributors</span>
            <a href="#directory-section" class="text-[#5EC4B8] font-medium hover:underline">Jump to directory ↓</a>
          </div>
        </div>

        <!-- Selected Member State -->
        <div id="inspector-view" class="hidden flex-col h-full">
          <div class="flex items-start justify-between gap-3 pb-4 border-b border-white/10">
            <div class="flex items-center gap-3 min-w-0">
              <div id="insp-avatar" class="w-11 h-11 rounded-xl flex items-center justify-center font-bold text-[#0F1D33] text-[14px] shrink-0"></div>
              <div class="min-w-0">
                <h2 id="insp-name" class="font-display font-bold text-[18px] text-[#F3F2EE] leading-tight"></h2>
                <div id="insp-arabic" class="text-[12.5px] text-[#C7D0DE] mt-0.5 hidden"></div>
                <span id="insp-team-badge" class="inline-block mt-1.5 px-2 py-0.5 rounded text-[11px] font-medium"></span>
              </div>
            </div>

            <div class="flex items-center gap-1 shrink-0">
              <button
                id="copy-link-btn"
                type="button"
                class="h-7 px-2 rounded border border-white/15 hover:border-[#5EC4B8] text-[11px] font-medium text-[#C7D0DE] hover:text-white transition inline-flex items-center gap-1"
                title="Copy deep link"
              >
                <span id="copy-link-label">Copy</span>
              </button>
              <button
                id="close-inspector-btn"
                type="button"
                class="w-7 h-7 rounded flex items-center justify-center text-[#9AA7BC] hover:text-white hover:bg-white/10 transition"
                aria-label="Back to cohort spotlight"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </button>
            </div>
          </div>

          <div class="mt-4 space-y-2 text-[13px]">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">Role</span>
              <strong id="insp-role" class="text-[#F3F2EE] font-medium text-right"></strong>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">School / Univ.</span>
              <span id="insp-school" class="text-[#ECEAE4] text-right"></span>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">Grade</span>
              <span id="insp-grade" class="text-[#ECEAE4] text-right"></span>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[#9AA7BC]">Joined</span>
              <span id="insp-cohort" class="font-code text-[#7DD3C8] font-medium"></span>
            </div>
          </div>

          <p id="insp-bio" class="mt-4 p-3.5 rounded-xl bg-[#0F1D33]/80 border border-white/10 text-[12.5px] leading-[1.6] text-[#C7D0DE]"></p>

          <div id="insp-lineage" class="mt-4 pt-3 border-t border-white/10 space-y-3 hidden">
            <div id="insp-parent-wrap" class="hidden">
              <div class="text-[11px] font-medium text-[#9AA7BC] mb-1.5">Reports to</div>
              <div id="insp-parent-slot" class="flex flex-wrap gap-1.5"></div>
            </div>
            <div id="insp-reports-wrap" class="hidden">
              <div id="insp-reports-label" class="text-[11px] font-medium text-[#9AA7BC] mb-1.5">Direct reports</div>
              <div id="insp-reports-slot" class="flex flex-wrap gap-1.5 max-h-28 overflow-y-auto"></div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- Integrated Timeline Control Bar -->
    <div class="bg-[#0B1628] border-t border-white/10 px-5 py-4 text-[#ECEAE4]">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <button
          id="play-btn"
          type="button"
          class="h-9 px-4 rounded-lg bg-[#F3F2EE] hover:bg-white text-[#0F1D33] text-[13px] font-semibold transition inline-flex items-center gap-2 shrink-0 w-fit"
        >
          <svg id="play-svg" width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
            <polygon points="2,1 11,6 2,11" />
          </svg>
          <svg id="pause-svg" width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" class="hidden">
            <rect x="2" y="1.5" width="3" height="9" rx="0.5" />
            <rect x="7" y="1.5" width="3" height="9" rx="0.5" />
          </svg>
          <span id="play-label">Play growth</span>
        </button>

        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between text-[12px] text-[#9AA7BC] mb-1.5">
            <span id="cohort-desc" class="text-[#F3F2EE] font-medium truncate">
              November 2026 — Nationwide Scale Across All 27 Governorates
            </span>
            <span id="active-count-badge" class="font-code text-[#7DD3C8] shrink-0 ml-2">{publicMembers.length} active</span>
          </div>
          <input
            id="timeline-slider"
            type="range"
            min="0"
            max="4"
            step="1"
            value="4"
            aria-label="Cohort timeline milestone slider"
            class="w-full h-1.5 bg-white/15 rounded-lg appearance-none cursor-pointer accent-[#5EC4B8] focus:outline-none"
          />
          <div id="milestone-buttons" class="grid grid-cols-5 gap-1.5 text-[11px] mt-2"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Founding Leadership Editorial Strip -->
  <section class="pt-12 pb-6">
    <div class="flex items-baseline justify-between gap-4 pb-4 border-b border-[#DFDDD6]">
      <h2 class="font-display font-bold text-[22px] text-[#161A22] tracking-[-0.02em]">Founding leadership</h2>
      <span class="font-code text-[12px] text-[#0B5F58]">Oct 2025 · Inception</span>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8">
      {founders.map((f) => (
        <article class="bg-white border border-[#DFDDD6] rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.03)] flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-display font-bold text-[20px] text-[#161A22]">{f.name}</h3>
                <div class="text-[13.5px] font-medium text-[#1B365D] mt-0.5">{f.role}</div>
              </div>
              <span class="font-code text-[12px] text-[#767D8C]">{f.arabicName}</span>
            </div>
            <p class="mt-3 text-[14px] leading-[1.6] text-[#525866]">{f.bio}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#EAE8E1] flex items-center justify-between text-[13px]">
            <span class="text-[#767D8C]">{f.school}</span>
            <button
              type="button"
              data-highlight-founder={f.id}
              class="font-medium text-[#1B365D] hover:underline"
            >
              Highlight branch ↑
            </button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Synchronized Searchable Member Directory -->
  <section id="directory-section" class="pt-8 pb-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-[#DFDDD6]">
      <div>
        <h2 class="font-display font-bold text-[24px] text-[#161A22] tracking-[-0.02em]">
          Active cohort directory
        </h2>
        <p id="dir-subtitle" class="mt-1 text-[14.5px] text-[#525866]">
          Showing {publicMembers.length} active contributors synced to the selected milestone.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
        <div class="relative flex-1 md:w-64">
          <input
            id="graph-search"
            type="search"
            placeholder="Search name, school, role..."
            aria-label="Search team directory"
            class="w-full h-9 pl-3 pr-14 bg-white border border-[#DFDDD6] rounded-lg text-[13px] text-[#161A22] placeholder-[#767D8C] focus:border-[#1B365D] focus:outline-none"
          />
          <span id="search-match-pill" class="hidden absolute right-7 top-1/2 -translate-y-1/2 font-code text-[11px] text-[#0B5F58]"></span>
          <button
            id="search-clear-btn"
            type="button"
            aria-label="Clear search"
            class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-[#767D8C] hover:text-[#161A22] p-0.5"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <select
          id="directory-sort"
          aria-label="Sort directory"
          class="h-9 px-2.5 bg-white border border-[#DFDDD6] rounded-lg text-[12.5px] text-[#161A22] focus:border-[#1B365D] focus:outline-none"
        >
          <option value="tier">Sort: Leadership tier</option>
          <option value="name">Sort: Name A–Z</option>
          <option value="cohort">Sort: Joined oldest first</option>
        </select>
      </div>
    </div>

    <!-- Dynamic Team Filter Pills -->
    <div id="team-filter-buttons" class="mt-4 flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter directory and orbital map by team"></div>

    <!-- Editorial 3-Column Hairline Grid -->
    <div id="directory-grid" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6"></div>
  </section>

  <script is:inline define:vars={{ initialMembers: publicMembers }}>
    (function () {
      var STEPS = [
        { key: '2025-10', short: 'Oct 2025', title: 'Founders', desc: 'October 2025 — Co-Founding Systems & Operations Architects' },
        { key: '2026-01', short: 'Jan 2026', title: 'Heads', desc: 'January 2026 — Division Heads Across HR, PR, Marketing & Social Media' },
        { key: '2026-04', short: 'Apr 2026', title: 'Vice Heads', desc: 'April 2026 — Vice Heads & Regional Chapter Coordinators' },
        { key: '2026-07', short: 'Jul 2026', title: 'Committees', desc: 'July 2026 — Interview Panels, Outreach Leads & Guild Managers' },
        { key: '2026-11', short: 'Nov 2026', title: 'Full Network', desc: 'November 2026 — Nationwide Scale Across All 27 Governorates' },
      ];

      var DIV_META = {
        Founders: { label: 'Founders', nodeFill: '#F3F2EE', nodeInk: '#0F1D33', ring: '#5EC4B8', barColor: '#1B365D', badgeBg: '#E4EAF2', badgeText: '#1B365D' },
        'HR Team': { label: 'HR', nodeFill: '#8FB1E0', nodeInk: '#0F1D33', ring: '#8FB1E0', barColor: '#334155', badgeBg: '#EAE8E1', badgeText: '#334155' },
        'PR Team': { label: 'PR & Outreach', nodeFill: '#5EC4B8', nodeInk: '#0F1D33', ring: '#5EC4B8', barColor: '#0F766E', badgeBg: '#EDF7F5', badgeText: '#0B5F58' },
        'Marketing Team': { label: 'Marketing', nodeFill: '#CBD5E1', nodeInk: '#0F1D33', ring: '#CBD5E1', barColor: '#64748B', badgeBg: '#F1F5F9', badgeText: '#334155' },
        'Social Media Team': { label: 'Social Media', nodeFill: '#E7A35C', nodeInk: '#0F1D33', ring: '#E7A35C', barColor: '#A2570F', badgeBg: '#FEF6EB', badgeText: '#A2570F' },
      };

      var FALLBACK_META = DIV_META.Founders;
      var prefersReducedMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var ALL_MEMBERS = [];
      var BY_ID = new Map();
      var POS = new Map();
      var REPORTS_BY_ID = new Map();
      var NODE_ANIM = new Map();
      var NODE_ELS = new Map();
      var EDGE_ELS = new Map();

      var state = {
        stepIdx: 4,
        team: 'All',
        search: '',
        sort: 'tier',
        selectedId: null,
        hoveredId: null,
        isPlaying: false,
        playTimer: null,
        displayedHeroCount: initialMembers.length,
      };

      var cam = { x: 0, y: 0, zoom: 1, tx: 0, ty: 0, tzoom: 1 };
      var dragging = false;
      var dragStart = { x: 0, y: 0, camX: 0, camY: 0 };
      var rafId = null;

      var SVG_NS = 'http://www.w3.org/2000/svg';
      var stageEl = document.getElementById('constellation-stage');
      var heroMilestoneEl = document.getElementById('hero-milestone-name');
      var heroActiveNumEl = document.getElementById('hero-active-num');
      var divBarEl = document.getElementById('division-bar');
      var divLegendEl = document.getElementById('division-legend');
      var milestoneButtonsEl = document.getElementById('milestone-buttons');
      var teamFiltersEl = document.getElementById('team-filter-buttons');
      var sliderEl = document.getElementById('timeline-slider');
      var cohortDescEl = document.getElementById('cohort-desc');
      var activeBadgeEl = document.getElementById('active-count-badge');
      var sourceStatusEl = document.getElementById('data-source-status');
      var dirSubtitleEl = document.getElementById('dir-subtitle');
      var searchInput = document.getElementById('graph-search');
      var searchMatchPill = document.getElementById('search-match-pill');
      var searchClearBtn = document.getElementById('search-clear-btn');
      var sortSelect = document.getElementById('directory-sort');
      var directoryGrid = document.getElementById('directory-grid');
      var spotlightView = document.getElementById('spotlight-view');
      var spotlightList = document.getElementById('spotlight-list');
      var spotlightSub = document.getElementById('spotlight-sub');
      var inspectorView = document.getElementById('inspector-view');
      var playBtn = document.getElementById('play-btn');
      var playSvg = document.getElementById('play-svg');
      var pauseSvg = document.getElementById('pause-svg');
      var playLabel = document.getElementById('play-label');
      var svgEl = document.getElementById('network-svg');
      var viewportEl = document.getElementById('graph-viewport');
      var graphContent = document.getElementById('graph-content');
      var edgesLayer = document.getElementById('edges-layer');
      var nodesLayer = document.getElementById('nodes-layer');
      var tooltipEl = document.getElementById('node-tooltip');

      function esc(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function metaFor(team) {
        return DIV_META[team] || FALLBACK_META;
      }

      function initialsOf(name) {
        return String(name || '')
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map(function (p) { return p[0] || ''; })
          .join('')
          .toUpperCase();
      }

      function shortLabel(m) {
        var parts = String(m.name || '').trim().split(/\s+/);
        if (m.tier === 0 && parts.length > 1) {
          return parts[0].charAt(0) + '. ' + parts[1];
        }
        return parts[0] || '';
      }

      function isActiveAtStep(m, idx) {
        return (m.cohortDate || '2026-11') <= STEPS[idx].key;
      }

      function matchesFilter(m) {
        var teamOk = state.team === 'All' || m.team === state.team;
        var q = state.search.toLowerCase().trim();
        if (!q) return teamOk;
        var hay = [m.name, m.arabicName, m.role, m.school, m.team, m.bio]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();
        return teamOk && hay.includes(q);
      }

      // Guarded ancestor + direct report walk (avoids founder mutual parent cycle)
      function getLineageSet(memberId) {
        var set = new Set();
        if (!memberId) return set;
        var cur = BY_ID.get(memberId);
        var hops = 0;
        while (cur && !set.has(cur.id) && hops < 12) {
          set.add(cur.id);
          cur = cur.parent ? BY_ID.get(cur.parent) : null;
          hops++;
        }
        var children = REPORTS_BY_ID.get(memberId) || [];
        children.forEach(function (c) { set.add(c.id); });
        return set;
      }

      // Compute balanced non-overlapping orbital coordinates around center (500, 380)
      function computeOrbitalLayout(members) {
        POS.clear();
        var CX = 500;
        var CY = 380;

        var foundersList = members.filter(function (m) {
          return m.team === 'Founders' || m.tier === 0;
        });
        if (foundersList.length === 1) {
          POS.set(foundersList[0].id, { x: CX, y: CY, r: 23 });
        } else if (foundersList.length === 2) {
          POS.set(foundersList[0].id, { x: CX + 54, y: CY, r: 22 });
          POS.set(foundersList[1].id, { x: CX - 54, y: CY, r: 22 });
        } else {
          foundersList.forEach(function (f, idx) {
            var a = (idx / Math.max(1, foundersList.length)) * Math.PI * 2;
            POS.set(f.id, { x: CX + Math.cos(a) * 48, y: CY + Math.sin(a) * 48, r: 22 });
          });
        }

        // Quadrant angular ranges in radians (padded away from vertical/horizontal axes)
        var QUADRANTS = {
          'HR Team': [(-168 * Math.PI) / 180, (-102 * Math.PI) / 180],
          'PR Team': [(-78 * Math.PI) / 180, (-12 * Math.PI) / 180],
          'Marketing Team': [(102 * Math.PI) / 180, (168 * Math.PI) / 180],
          'Social Media Team': [(12 * Math.PI) / 180, (78 * Math.PI) / 180],
        };

        var TIER_RINGS = {
          1: { baseR: 130, spread: 0, nodeR: 17 },
          2: { baseR: 200, spread: 14, nodeR: 13.5 },
          3: { baseR: 266, spread: 24, nodeR: 11 },
          4: { baseR: 328, spread: 22, nodeR: 9.5 },
        };

        var teams = [...new Set(members.map(function (m) { return m.team; }))].filter(function (t) { return t !== 'Founders'; });
        var fallbackQuadrants = Object.values(QUADRANTS);

        teams.forEach(function (teamName, qIdx) {
          var range = QUADRANTS[teamName] || fallbackQuadrants[qIdx % fallbackQuadrants.length];
          var startA = range[0];
          var endA = range[1];

          for (var tier = 1; tier <= 4; tier++) {
            var bucket = members
              .filter(function (m) { return m.team === teamName && m.tier === tier; })
              .slice()
              .sort(function (a, b) {
                return String(a.parent || '').localeCompare(String(b.parent || '')) || a.name.localeCompare(b.name);
              });

            if (bucket.length === 0) continue;
            var ring = TIER_RINGS[tier] || TIER_RINGS[4];

            if (bucket.length <= 7 || ring.spread === 0) {
              bucket.forEach(function (m, i) {
                var frac = bucket.length === 1 ? 0.5 : i / (bucket.length - 1);
                var angle = startA + frac * (endA - startA);
                POS.set(m.id, {
                  x: CX + Math.cos(angle) * ring.baseR,
                  y: CY + Math.sin(angle) * ring.baseR,
                  r: ring.nodeR,
                });
              });
            } else {
              // Split larger tiers into staggered inner & outer sub-arcs for clean separation
              var innerCount = Math.ceil(bucket.length / 2);
              var outerCount = bucket.length - innerCount;
              var innerR = ring.baseR - ring.spread * 0.55;
              var outerR = ring.baseR + ring.spread * 0.65;

              bucket.forEach(function (m, i) {
                var isOuter = i % 2 === 1;
                var idxInBand = Math.floor(i / 2);
                var bandTotal = isOuter ? outerCount : innerCount;
                var frac = bandTotal === 1 ? 0.5 : (idxInBand + (isOuter ? 0.25 : 0)) / (bandTotal - 1 + 0.25);
                var clamped = Math.max(0.02, Math.min(0.98, frac));
                var angle = startA + clamped * (endA - startA);
                var radius = isOuter ? outerR : innerR;
                POS.set(m.id, {
                  x: CX + Math.cos(angle) * radius,
                  y: CY + Math.sin(angle) * radius,
                  r: ring.nodeR,
                });
              });
            }
          }
        });
      }

      function curvePath(x1, y1, x2, y2) {
        var mx = (x1 + x2) / 2;
        var my = (y1 + y2) / 2;
        // Gently bow toward stage center (500, 380) for architectural curvature
        var cx = mx + (500 - mx) * 0.16;
        var cy = my + (380 - my) * 0.16;
        return 'M ' + x1.toFixed(1) + ' ' + y1.toFixed(1) + ' Q ' + cx.toFixed(1) + ' ' + cy.toFixed(1) + ' ' + x2.toFixed(1) + ' ' + y2.toFixed(1);
      }

      function indexMembers(members) {
        ALL_MEMBERS = members;
        BY_ID.clear();
        REPORTS_BY_ID.clear();
        members.forEach(function (m) { BY_ID.set(m.id, m); });
        members.forEach(function (m) {
          if (m.parent && m.parent !== m.id) {
            if (!REPORTS_BY_ID.has(m.parent)) REPORTS_BY_ID.set(m.parent, []);
            REPORTS_BY_ID.get(m.parent).push(m);
          }
        });
        computeOrbitalLayout(members);
        syncSvgDom();
      }

      function syncSvgDom() {
        edgesLayer.replaceChildren();
        nodesLayer.replaceChildren();
        NODE_ELS.clear();
        EDGE_ELS.clear();

        ALL_MEMBERS.forEach(function (m) {
          var pos = POS.get(m.id) || { x: m.x, y: m.y, r: m.r };
          var pPos = m.parent ? POS.get(m.parent) : null;
          var active = isActiveAtStep(m, state.stepIdx);

          if (!NODE_ANIM.has(m.id)) {
            NODE_ANIM.set(m.id, {
              x: active ? pos.x : pPos ? pPos.x : pos.x,
              y: active ? pos.y : pPos ? pPos.y : pos.y,
              scale: active ? 1 : 0.25,
              opacity: active ? 1 : 0,
              tx: pos.x,
              ty: pos.y,
              tscale: active ? 1 : 0.25,
              topacity: active ? 1 : 0,
              r: pos.r,
            });
          } else {
            NODE_ANIM.get(m.id).r = pos.r;
          }

          if (m.parent && BY_ID.has(m.parent)) {
            var path = document.createElementNS(SVG_NS, 'path');
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke-linecap', 'round');
            edgesLayer.appendChild(path);
            EDGE_ELS.set(m.id, path);
          }

          var meta = metaFor(m.team);
          var isFounder = m.tier === 0;
          var g = document.createElementNS(SVG_NS, 'g');
          g.setAttribute('class', 'node-group cursor-pointer');
          g.setAttribute('tabindex', '0');
          g.setAttribute('role', 'button');
          g.setAttribute('aria-label', m.name + ' — ' + m.role);
          g.dataset.id = m.id;

          var halo = document.createElementNS(SVG_NS, 'circle');
          halo.setAttribute('fill', 'none');
          halo.setAttribute('stroke', meta.ring);
          halo.setAttribute('stroke-width', '2.2');
          halo.setAttribute('opacity', '0');

          var circle = document.createElementNS(SVG_NS, 'circle');
          circle.setAttribute('r', String(pos.r));
          circle.setAttribute('fill', meta.nodeFill);
          circle.setAttribute('stroke', '#0F1D33');
          circle.setAttribute('stroke-width', isFounder ? '2.5' : '1.6');
          circle.setAttribute('filter', 'url(#node-glow)');

          var abbr = document.createElementNS(SVG_NS, 'text');
          abbr.setAttribute('text-anchor', 'middle');
          abbr.setAttribute('dominant-baseline', 'central');
          abbr.setAttribute('fill', meta.nodeInk);
          abbr.setAttribute('font-size', pos.r > 18 ? '11' : pos.r > 12 ? '9' : '7.5');
          abbr.setAttribute('font-weight', '700');
          abbr.setAttribute('pointer-events', 'none');
          abbr.textContent = initialsOf(m.name);

          var label = document.createElementNS(SVG_NS, 'text');
          label.setAttribute('text-anchor', 'middle');
          label.setAttribute('y', String(pos.r + 13));
          label.setAttribute('fill', '#F3F2EE');
          label.setAttribute('font-size', isFounder ? '11.5' : '10');
          label.setAttribute('font-weight', isFounder ? '600' : '500');
          label.setAttribute('pointer-events', 'none');
          label.setAttribute('class', 'select-none');
          label.textContent = shortLabel(m);

          g.appendChild(halo);
          g.appendChild(circle);
          g.appendChild(abbr);
          g.appendChild(label);

          g.addEventListener('click', function (e) {
            e.stopPropagation();
            selectMember(m.id, true);
          });
          g.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              selectMember(m.id, true);
            }
          });
          g.addEventListener('mouseenter', function () {
            state.hoveredId = m.id;
            showTooltip(m);
            refreshVisualStyles();
          });
          g.addEventListener('mouseleave', function () {
            if (state.hoveredId === m.id) state.hoveredId = null;
            hideTooltip();
            refreshVisualStyles();
          });

          nodesLayer.appendChild(g);
          NODE_ELS.set(m.id, { g: g, halo: halo, label: label, pos: pos });
        });
      }

      function showTooltip(m) {
        var anim = NODE_ANIM.get(m.id);
        if (!anim) return;
        var svgRect = svgEl.getBoundingClientRect();
        var vpRect = viewportEl.getBoundingClientRect();
        var scale = Math.min(svgRect.width / 1000, svgRect.height / 760);
        var ox = (svgRect.width - 1000 * scale) / 2;
        var oy = (svgRect.height - 760 * scale) / 2;
        var sx = ox + (anim.x * cam.zoom + cam.x) * scale;
        var sy = oy + (anim.y * cam.zoom + cam.y) * scale;

        tooltipEl.textContent = m.name + ' · ' + m.role;
        tooltipEl.style.left = Math.min(Math.max(12, sx + 14), vpRect.width - 230) + 'px';
        tooltipEl.style.top = Math.max(12, sy - 34) + 'px';
        tooltipEl.classList.remove('hidden');
      }

      function hideTooltip() {
        tooltipEl.classList.add('hidden');
      }

      function updateTargets() {
        ALL_MEMBERS.forEach(function (m) {
          var a = NODE_ANIM.get(m.id);
          var pos = POS.get(m.id) || { x: m.x, y: m.y, r: m.r };
          var pPos = m.parent ? POS.get(m.parent) : null;
          if (!a) return;

          var active = isActiveAtStep(m, state.stepIdx);
          if (active) {
            if (a.topacity === 0 && pPos && m.parent && isActiveAtStep(BY_ID.get(m.parent), state.stepIdx) && !prefersReducedMotion) {
              a.x = pPos.x;
              a.y = pPos.y;
            }
            a.tx = pos.x;
            a.ty = pos.y;
            a.tscale = 1;
            a.topacity = 1;
          } else {
            a.tx = pPos ? pPos.x : pos.x;
            a.ty = pPos ? pPos.y : pos.y;
            a.tscale = 0.25;
            a.topacity = 0;
          }
        });
        startAnimation();
      }

      function startAnimation() {
        if (rafId != null) return;
        rafId = requestAnimationFrame(tickAnimation);
      }

      function tickAnimation() {
        rafId = null;
        var ease = prefersReducedMotion ? 1 : 0.22;
        var moving = false;

        if (Math.abs(cam.tx - cam.x) > 0.2 || Math.abs(cam.ty - cam.y) > 0.2 || Math.abs(cam.tzoom - cam.zoom) > 0.002) {
          cam.x += (cam.tx - cam.x) * ease;
          cam.y += (cam.ty - cam.y) * ease;
          cam.zoom += (cam.tzoom - cam.zoom) * ease;
          moving = true;
        } else {
          cam.x = cam.tx;
          cam.y = cam.ty;
          cam.zoom = cam.tzoom;
        }
        graphContent.setAttribute('transform', 'translate(' + cam.x.toFixed(2) + ', ' + cam.y.toFixed(2) + ') scale(' + cam.zoom.toFixed(4) + ')');

        ALL_MEMBERS.forEach(function (m) {
          var a = NODE_ANIM.get(m.id);
          if (!a) return;
          if (
            Math.abs(a.tx - a.x) > 0.2 ||
            Math.abs(a.ty - a.y) > 0.2 ||
            Math.abs(a.tscale - a.scale) > 0.005 ||
            Math.abs(a.topacity - a.opacity) > 0.01
          ) {
            a.x += (a.tx - a.x) * ease;
            a.y += (a.ty - a.y) * ease;
            a.scale += (a.tscale - a.scale) * ease;
            a.opacity += (a.topacity - a.opacity) * ease;
            moving = true;
          } else {
            a.x = a.tx;
            a.y = a.ty;
            a.scale = a.tscale;
            a.opacity = a.topacity;
          }
        });

        refreshVisualStyles();
        if (moving) startAnimation();
      }

      function refreshVisualStyles() {
        var focusId = state.hoveredId || state.selectedId;
        var lineage = getLineageSet(focusId);
        var hasSearch = state.search.trim().length > 0;
        var hasTeam = state.team !== 'All';

        ALL_MEMBERS.forEach(function (m) {
          var a = NODE_ANIM.get(m.id);
          var els = NODE_ELS.get(m.id);
          if (!a || !els) return;

          var isHidden = a.opacity < 0.02;
          els.g.style.display = isHidden ? 'none' : '';
          if (isHidden) {
            var hiddenEdge = EDGE_ELS.get(m.id);
            if (hiddenEdge) hiddenEdge.style.display = 'none';
            return;
          }

          var matched = matchesFilter(m);
          var inLineage = !focusId || lineage.has(m.id);
          var targetAlpha = matched ? (inLineage ? 1 : 0.28) : 0.14;
          var finalOpacity = a.opacity * targetAlpha;

          els.g.setAttribute('transform', 'translate(' + a.x.toFixed(2) + ', ' + a.y.toFixed(2) + ') scale(' + a.scale.toFixed(3) + ')');
          els.g.setAttribute('opacity', finalOpacity.toFixed(3));
          els.g.style.pointerEvents = a.topacity === 0 ? 'none' : 'auto';

          var isSelected = state.selectedId === m.id;
          var isHovered = state.hoveredId === m.id;
          els.halo.setAttribute('r', String(els.pos.r + (isSelected ? 6 : 4)));
          els.halo.setAttribute('opacity', isSelected || isHovered || m.tier === 0 ? '1' : '0');

          // Declutter small outer labels at 100% view; reveal on focus/team/search/zoom
          var showLabel =
            m.tier <= 1 ||
            isSelected ||
            isHovered ||
            (focusId && inLineage) ||
            (hasSearch && matched) ||
            (hasTeam && matched && m.tier <= 2) ||
            cam.zoom >= 1.28;
          els.label.style.opacity = showLabel ? '1' : '0';

          var edge = EDGE_ELS.get(m.id);
          if (edge && m.parent) {
            var pa = NODE_ANIM.get(m.parent);
            if (!pa || pa.opacity < 0.02) {
              edge.style.display = 'none';
            } else {
              edge.style.display = '';
              edge.setAttribute('d', curvePath(a.x, a.y, pa.x, pa.y));

              var isFounderLink = m.id === 'founder-1' && m.parent === 'founder-2';
              var highlightEdge = focusId && lineage.has(m.id) && lineage.has(m.parent);
              edge.setAttribute('stroke', highlightEdge ? '#5EC4B8' : isFounderLink ? '#8FB1E0' : 'rgba(255,255,255,0.16)');
              edge.setAttribute('stroke-width', isFounderLink ? '2.2' : highlightEdge ? '2' : '1');
              edge.setAttribute('stroke-opacity', String(Math.min(a.opacity, pa.opacity) * (highlightEdge ? 1 : (hasTeam || hasSearch) && !matched ? 0.25 : 0.85)));
              edge.classList.toggle('tf-edge-flow', Boolean(highlightEdge));
            }
          }
        });
      }

      function fitTeamCamera(team) {
        if (team === 'All') {
          cam.tx = 0;
          cam.ty = 0;
          cam.tzoom = 1;
          startAnimation();
          return;
        }
        var coords = ALL_MEMBERS
          .filter(function (m) { return m.team === team && isActiveAtStep(m, state.stepIdx); })
          .map(function (m) { return POS.get(m.id); })
          .filter(Boolean);
        if (coords.length === 0) return;

        var minX = Math.min.apply(null, coords.map(function (c) { return c.x; }));
        var maxX = Math.max.apply(null, coords.map(function (c) { return c.x; }));
        var minY = Math.min.apply(null, coords.map(function (c) { return c.y; }));
        var maxY = Math.max.apply(null, coords.map(function (c) { return c.y; }));
        var w = Math.max(160, maxX - minX + 180);
        var h = Math.max(160, maxY - minY + 180);
        var zoom = Math.min(1.65, Math.max(0.95, Math.min(1000 / w, 760 / h)));
        var cx = (minX + maxX) / 2;
        var cy = (minY + maxY) / 2;
        cam.tzoom = zoom;
        cam.tx = 500 - cx * zoom;
        cam.ty = 380 - cy * zoom;
        startAnimation();
      }

      function animateHeroCounter(target) {
        if (prefersReducedMotion) {
          state.displayedHeroCount = target;
          heroActiveNumEl.textContent = String(target);
          return;
        }
        var start = state.displayedHeroCount;
        var diff = target - start;
        if (diff === 0) return;
        var startTime = performance.now();
        var duration = 360;
        function step(now) {
          var p = Math.min(1, (now - startTime) / duration);
          var eased = 1 - Math.pow(1 - p, 3);
          state.displayedHeroCount = Math.round(start + diff * eased);
          heroActiveNumEl.textContent = String(state.displayedHeroCount);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      function selectMember(id, flyTo) {
        var m = BY_ID.get(id);
        if (!m) return;

        var neededIdx = STEPS.findIndex(function (s) {
          return (m.cohortDate || '2026-11') <= s.key;
        });
        if (neededIdx !== -1 && neededIdx > state.stepIdx) {
          setStep(neededIdx, true);
        }

        state.selectedId = id;
        if (window.location.hash !== '#member=' + encodeURIComponent(id)) {
          history.replaceState(null, '', '#member=' + encodeURIComponent(id));
        }

        renderInspector(m);
        if (flyTo) {
          var pos = POS.get(m.id) || { x: m.x, y: m.y };
          cam.tzoom = Math.max(cam.tzoom, 1.35);
          cam.tx = 500 - pos.x * cam.tzoom;
          cam.ty = 380 - pos.y * cam.tzoom;
          startAnimation();
        } else {
          refreshVisualStyles();
        }
      }

      function closeInspector() {
        state.selectedId = null;
        inspectorView.classList.add('hidden');
        inspectorView.classList.remove('flex');
        spotlightView.classList.remove('hidden');
        if (window.location.hash.startsWith('#member=')) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
        refreshVisualStyles();
      }

      function makeDarkChip(member) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'px-2.5 py-1 rounded bg-[#1D3253] border border-white/15 hover:border-[#5EC4B8] text-[12px] font-medium text-[#ECEAE4] transition text-left';
        btn.textContent = member.name;
        btn.addEventListener('click', function () { selectMember(member.id, true); });
        return btn;
      }

      function renderInspector(m) {
        var meta = metaFor(m.team);
        var avatarEl = document.getElementById('insp-avatar');
        avatarEl.textContent = initialsOf(m.name);
        avatarEl.style.backgroundColor = meta.nodeFill;

        document.getElementById('insp-name').textContent = m.name;
        var arabicEl = document.getElementById('insp-arabic');
        if (m.arabicName && m.arabicName.trim() && m.arabicName.trim() !== m.name.trim()) {
          arabicEl.textContent = m.arabicName;
          arabicEl.classList.remove('hidden');
        } else {
          arabicEl.classList.add('hidden');
        }

        var teamBadge = document.getElementById('insp-team-badge');
        teamBadge.textContent = m.team;
        teamBadge.style.backgroundColor = meta.badgeBg;
        teamBadge.style.color = meta.badgeText;

        document.getElementById('insp-role').textContent = m.role;
        document.getElementById('insp-school').textContent = m.school || 'TF Unions';
        document.getElementById('insp-grade').textContent = m.grade || 'Active cohort';
        document.getElementById('insp-cohort').textContent = m.cohortLabel || m.cohortDate;
        document.getElementById('insp-bio').textContent = m.bio || 'Contributor in ' + m.team + '.';

        var parent = m.parent ? BY_ID.get(m.parent) : null;
        var reports = REPORTS_BY_ID.get(m.id) || [];
        var lineageBox = document.getElementById('insp-lineage');
        var parentWrap = document.getElementById('insp-parent-wrap');
        var parentSlot = document.getElementById('insp-parent-slot');
        var reportsWrap = document.getElementById('insp-reports-wrap');
        var reportsLabel = document.getElementById('insp-reports-label');
        var reportsSlot = document.getElementById('insp-reports-slot');

        parentSlot.replaceChildren();
        reportsSlot.replaceChildren();

        if (parent) {
          parentSlot.appendChild(makeDarkChip(parent));
          parentWrap.classList.remove('hidden');
        } else {
          parentWrap.classList.add('hidden');
        }

        if (reports.length > 0) {
          reportsLabel.textContent = 'Direct reports (' + reports.length + ')';
          reports.slice(0, 10).forEach(function (r) { reportsSlot.appendChild(makeDarkChip(r)); });
          reportsWrap.classList.remove('hidden');
        } else {
          reportsWrap.classList.add('hidden');
        }

        lineageBox.classList.toggle('hidden', !parent && reports.length === 0);
        spotlightView.classList.add('hidden');
        inspectorView.classList.remove('hidden');
        inspectorView.classList.add('flex');
      }

      function renderSpotlight(activeMembers) {
        var heads = activeMembers
          .filter(function (m) {
            return m.tier <= 1 && (state.team === 'All' || m.team === state.team);
          })
          .slice(0, 10);

        spotlightSub.textContent = heads.length + ' core leaders active at ' + STEPS[state.stepIdx].short;
        spotlightList.replaceChildren();

        heads.forEach(function (m) {
          var meta = metaFor(m.team);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-full text-left p-2.5 rounded-lg bg-[#0F1D33]/65 hover:bg-[#1D3253] border border-white/10 hover:border-[#5EC4B8]/60 flex items-center justify-between gap-3 transition group';

          var left = document.createElement('div');
          left.className = 'flex items-center gap-2.5 min-w-0';

          var dot = document.createElement('span');
          dot.className = 'w-8 h-8 rounded-lg flex items-center justify-center font-bold text-[11px] text-[#0F1D33] shrink-0';
          dot.style.backgroundColor = meta.nodeFill;
          dot.textContent = initialsOf(m.name);

          var info = document.createElement('div');
          info.className = 'min-w-0';
          info.innerHTML =
            '<div class="text-[13px] font-semibold text-[#F3F2EE] truncate group-hover:text-white">' +
            esc(m.name) +
            '</div><div class="text-[11.5px] text-[#9AA7BC] truncate">' +
            esc(m.role + ' · ' + m.team.replace(' Team', '')) +
            '</div>';

          left.appendChild(dot);
          left.appendChild(info);

          var arrow = document.createElement('span');
          arrow.className = 'text-[#5EC4B8] text-[12px] shrink-0';
          arrow.textContent = '→';

          btn.appendChild(left);
          btn.appendChild(arrow);
          btn.addEventListener('click', function () { selectMember(m.id, true); });
          spotlightList.appendChild(btn);
        });
      }

      function renderControls() {
        var active = ALL_MEMBERS.filter(function (m) { return isActiveAtStep(m, state.stepIdx); });
        var matched = active.filter(matchesFilter);

        heroMilestoneEl.textContent = STEPS[state.stepIdx].short + ' · ' + STEPS[state.stepIdx].title;
        animateHeroCounter(active.length);
        activeBadgeEl.textContent = active.length + ' active';
        cohortDescEl.textContent = STEPS[state.stepIdx].desc;
        dirSubtitleEl.textContent =
          'Showing ' + matched.length + ' of ' + active.length + ' active contributors at ' + STEPS[state.stepIdx].short + '.';

        // Proportional division bar + interactive legend
        var teamOrder = [...new Set(ALL_MEMBERS.map(function (m) { return m.team; }))];
        divBarEl.replaceChildren();
        divLegendEl.replaceChildren();

        teamOrder.forEach(function (teamName) {
          var count = active.filter(function (m) { return m.team === teamName; }).length;
          if (count === 0) return;
          var meta = metaFor(teamName);
          var pct = (count / Math.max(1, active.length)) * 100;

          var seg = document.createElement('div');
          seg.className = 'h-full transition-all duration-500';
          seg.style.width = pct.toFixed(2) + '%';
          seg.style.backgroundColor = meta.barColor;
          seg.title = meta.label + ': ' + count;
          divBarEl.appendChild(seg);

          var chip = document.createElement('button');
          chip.type = 'button';
          var isSelected = state.team === teamName;
          chip.className = 'inline-flex items-center gap-1.5 hover:text-[#161A22] transition ' + (isSelected ? 'text-[#1B365D] font-semibold underline' : '');
          chip.innerHTML =
            '<span class="w-2 h-2 rounded-full inline-block" style="background-color:' +
            meta.barColor +
            ';"></span><span>' +
            esc(meta.label) +
            ' <strong class="font-code text-[#161A22]">' +
            count +
            '</strong></span>';
          chip.addEventListener('click', function () {
            state.team = isSelected ? 'All' : teamName;
            renderControls();
            renderDirectory();
            fitTeamCamera(state.team);
            refreshVisualStyles();
          });
          divLegendEl.appendChild(chip);
        });

        // Search UI badge
        if (state.search.trim()) {
          searchMatchPill.textContent = matched.length + ' match' + (matched.length === 1 ? '' : 'es');
          searchMatchPill.classList.remove('hidden');
          searchClearBtn.classList.remove('hidden');
        } else {
          searchMatchPill.classList.add('hidden');
          searchClearBtn.classList.add('hidden');
        }

        // Milestone buttons in dark footer bar
        milestoneButtonsEl.replaceChildren();
        STEPS.forEach(function (step, idx) {
          var count = ALL_MEMBERS.filter(function (m) { return isActiveAtStep(m, idx); }).length;
          var btn = document.createElement('button');
          btn.type = 'button';
          var align = idx === 0 ? 'text-left' : idx === STEPS.length - 1 ? 'text-right' : 'text-center';
          var isCur = idx === state.stepIdx;
          btn.className = align + ' transition ' + (isCur ? 'text-[#5EC4B8]' : 'text-[#9AA7BC] hover:text-white');
          btn.innerHTML =
            '<span class="font-code block">' +
            esc(step.short) +
            ' (' +
            count +
            ')</span><strong class="font-medium ' +
            (isCur ? 'text-white' : '') +
            '">' +
            esc(step.title) +
            '</strong>';
          btn.addEventListener('click', function () { setStep(idx, false); });
          milestoneButtonsEl.appendChild(btn);
        });

        // Directory filter pills
        var filterOrder = ['All'].concat(teamOrder);
        teamFiltersEl.replaceChildren();
        filterOrder.forEach(function (teamName) {
          var count = teamName === 'All' ? active.length : active.filter(function (m) { return m.team === teamName; }).length;
          if (teamName !== 'All' && count === 0) return;

          var btn = document.createElement('button');
          btn.type = 'button';
          var isSel = state.team === teamName;
          btn.className =
            'px-3 py-1.5 rounded-lg text-[12.5px] font-medium border transition ' +
            (isSel
              ? 'bg-[#1B365D] text-white border-[#1B365D]'
              : 'bg-white text-[#525866] border-[#DFDDD6] hover:border-[#1B365D]/50 hover:text-[#161A22]');
          btn.textContent = (teamName === 'All' ? 'All teams' : metaFor(teamName).label) + ' (' + count + ')';
          btn.addEventListener('click', function () {
            state.team = teamName;
            renderControls();
            renderDirectory();
            fitTeamCamera(teamName);
            refreshVisualStyles();
          });
          teamFiltersEl.appendChild(btn);
        });

        renderSpotlight(active);
      }

      function renderDirectory() {
        var active = ALL_MEMBERS.filter(function (m) {
          return isActiveAtStep(m, state.stepIdx) && matchesFilter(m);
        });

        var sorted = active.slice().sort(function (a, b) {
          if (state.sort === 'name') return a.name.localeCompare(b.name);
          if (state.sort === 'cohort') {
            return (a.cohortDate || '').localeCompare(b.cohortDate || '') || a.tier - b.tier || a.name.localeCompare(b.name);
          }
          return a.tier - b.tier || a.team.localeCompare(b.team) || a.name.localeCompare(b.name);
        });

        directoryGrid.replaceChildren();
        if (sorted.length === 0) {
          var empty = document.createElement('div');
          empty.className = 'sm:col-span-2 lg:col-span-3 py-12 text-center border-t border-[#DFDDD6] text-[14px] text-[#767D8C]';
          empty.textContent = 'No contributors match your filter at this milestone.';
          directoryGrid.appendChild(empty);
          return;
        }

        sorted.forEach(function (m) {
          var meta = metaFor(m.team);
          var card = document.createElement('article');
          card.className = 'border-t border-[#DFDDD6] pt-4 flex flex-col justify-between';

          card.innerHTML =
            '<div>' +
            '<div class="flex items-start justify-between gap-3">' +
            '<div class="flex items-center gap-3 min-w-0">' +
            '<div class="w-9 h-9 rounded-lg flex items-center justify-center font-bold text-[#F3F2EE] text-[12px] shrink-0" style="background-color:' +
            meta.barColor +
            ';">' +
            esc(initialsOf(m.name)) +
            '</div>' +
            '<div class="min-w-0">' +
            '<h3 class="font-display font-semibold text-[16px] text-[#161A22] leading-snug truncate">' +
            esc(m.name) +
            '</h3>' +
            '<div class="text-[12.5px] font-medium text-[#525866] truncate">' +
            esc(m.role) +
            '</div>' +
            '</div>' +
            '</div>' +
            '<span class="px-2 py-0.5 rounded text-[11px] font-medium shrink-0" style="background-color:' +
            meta.badgeBg +
            ';color:' +
            meta.badgeText +
            ';">' +
            esc(meta.label) +
            '</span>' +
            '</div>' +
            '<p class="mt-2.5 text-[13px] text-[#525866] leading-relaxed line-clamp-2">' +
            esc(m.bio || m.school || 'TF Unions contributor') +
            '</p>' +
            '</div>';

          var footer = document.createElement('div');
          footer.className = 'mt-3 flex items-center justify-between gap-2 text-[12px] text-[#767D8C]';
          var metaSpan = document.createElement('span');
          metaSpan.className = 'truncate';
          metaSpan.textContent = (m.school || 'TF Unions') + ' · ' + (m.cohortLabel || m.cohortDate);

          var mapBtn = document.createElement('button');
          mapBtn.type = 'button';
          mapBtn.className = 'text-[#1B365D] font-medium hover:underline shrink-0';
          mapBtn.textContent = 'Locate ↑';
          mapBtn.addEventListener('click', function () {
            stageEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
            selectMember(m.id, true);
          });

          footer.appendChild(metaSpan);
          footer.appendChild(mapBtn);
          card.appendChild(footer);
          directoryGrid.appendChild(card);
        });
      }

      function setStep(idx, skipCameraFit) {
        state.stepIdx = Math.max(0, Math.min(STEPS.length - 1, Number(idx)));
        sliderEl.value = String(state.stepIdx);
        updateTargets();
        renderControls();
        renderDirectory();
        if (!skipCameraFit && state.team !== 'All') {
          fitTeamCamera(state.team);
        }
      }

      function togglePlay() {
        if (state.isPlaying) {
          clearInterval(state.playTimer);
          state.playTimer = null;
          state.isPlaying = false;
          playSvg.classList.remove('hidden');
          pauseSvg.classList.add('hidden');
          playLabel.textContent = 'Play growth';
        } else {
          state.isPlaying = true;
          playSvg.classList.add('hidden');
          pauseSvg.classList.remove('hidden');
          playLabel.textContent = 'Pause';
          if (state.stepIdx === STEPS.length - 1) setStep(0, true);
          state.playTimer = setInterval(function () {
            if (state.stepIdx >= STEPS.length - 1) {
              togglePlay();
            } else {
              setStep(state.stepIdx + 1, true);
            }
          }, 1500);
        }
      }

      // Wire events
      sliderEl.addEventListener('input', function (e) { setStep(e.target.value, true); });
      playBtn.addEventListener('click', togglePlay);
      searchInput.addEventListener('input', function (e) {
        state.search = e.target.value;
        renderControls();
        renderDirectory();
        refreshVisualStyles();
      });
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && state.search.trim()) {
          var first = ALL_MEMBERS.find(function (m) {
            return isActiveAtStep(m, state.stepIdx) && matchesFilter(m);
          });
          if (first) {
            stageEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
            selectMember(first.id, true);
          }
        }
      });
      searchClearBtn.addEventListener('click', function () {
        state.search = '';
        searchInput.value = '';
        renderControls();
        renderDirectory();
        refreshVisualStyles();
        searchInput.focus();
      });
      sortSelect.addEventListener('change', function (e) {
        state.sort = e.target.value;
        renderDirectory();
      });

      document.getElementById('close-inspector-btn').addEventListener('click', closeInspector);
      document.getElementById('copy-link-btn').addEventListener('click', function () {
        if (!state.selectedId) return;
        var url = window.location.origin + '/team#member=' + encodeURIComponent(state.selectedId);
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).catch(function () {});
        }
        var lbl = document.getElementById('copy-link-label');
        lbl.textContent = 'Copied';
        setTimeout(function () { lbl.textContent = 'Copy'; }, 1500);
      });

      document.querySelectorAll('[data-highlight-founder]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var fid = btn.getAttribute('data-highlight-founder');
          stageEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
          if (fid) selectMember(fid, true);
        });
      });

      document.getElementById('btn-zoom-in').addEventListener('click', function () {
        var nextZoom = Math.min(2.4, cam.tzoom * 1.22);
        var ratio = nextZoom / cam.tzoom;
        cam.tx = 500 - (500 - cam.tx) * ratio;
        cam.ty = 380 - (380 - cam.ty) * ratio;
        cam.tzoom = nextZoom;
        startAnimation();
      });
      document.getElementById('btn-zoom-out').addEventListener('click', function () {
        var nextZoom = Math.max(0.7, cam.tzoom / 1.22);
        var ratio = nextZoom / cam.tzoom;
        cam.tx = 500 - (500 - cam.tx) * ratio;
        cam.ty = 380 - (380 - cam.ty) * ratio;
        cam.tzoom = nextZoom;
        startAnimation();
      });
      document.getElementById('btn-zoom-reset').addEventListener('click', function () {
        cam.tx = 0;
        cam.ty = 0;
        cam.tzoom = 1;
        startAnimation();
      });

      viewportEl.addEventListener('wheel', function (e) {
        e.preventDefault();
        var rect = svgEl.getBoundingClientRect();
        var scale = Math.min(rect.width / 1000, rect.height / 760) || 1;
        var ox = (rect.width - 1000 * scale) / 2;
        var oy = (rect.height - 760 * scale) / 2;
        var px = (e.clientX - rect.left - ox) / scale;
        var py = (e.clientY - rect.top - oy) / scale;

        var factor = e.deltaY < 0 ? 1.12 : 0.89;
        var nextZoom = Math.min(2.4, Math.max(0.7, cam.tzoom * factor));
        var ratio = nextZoom / cam.tzoom;
        cam.x = cam.tx = px - (px - cam.tx) * ratio;
        cam.y = cam.ty = py - (py - cam.ty) * ratio;
        cam.zoom = cam.tzoom = nextZoom;
        graphContent.setAttribute('transform', 'translate(' + cam.x.toFixed(2) + ', ' + cam.y.toFixed(2) + ') scale(' + cam.zoom.toFixed(4) + ')');
        refreshVisualStyles();
      }, { passive: false });

      viewportEl.addEventListener('pointerdown', function (e) {
        if (e.target.closest('.node-group')) return;
        dragging = true;
        dragStart = { x: e.clientX, y: e.clientY, camX: cam.x, camY: cam.y };
        viewportEl.setPointerCapture(e.pointerId);
      });
      viewportEl.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var rect = svgEl.getBoundingClientRect();
        var scale = Math.min(rect.width / 1000, rect.height / 760) || 1;
        cam.x = cam.tx = dragStart.camX + (e.clientX - dragStart.x) / scale;
        cam.y = cam.ty = dragStart.camY + (e.clientY - dragStart.y) / scale;
        graphContent.setAttribute('transform', 'translate(' + cam.x.toFixed(2) + ', ' + cam.y.toFixed(2) + ') scale(' + cam.zoom.toFixed(4) + ')');
      });
      viewportEl.addEventListener('pointerup', function () { dragging = false; });
      viewportEl.addEventListener('pointercancel', function () { dragging = false; });
      viewportEl.addEventListener('click', function (e) {
        if (!e.target.closest('.node-group') && Math.hypot(e.clientX - dragStart.x, e.clientY - dragStart.y) < 5) {
          closeInspector();
        }
      });

      document.addEventListener('keydown', function (e) {
        var tag = document.activeElement && document.activeElement.tagName;
        var inInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
        if (e.key === '/' && !inInput) {
          e.preventDefault();
          searchInput.focus();
          return;
        }
        if (e.key === 'Escape') {
          if (state.selectedId) closeInspector();
          if (document.activeElement === searchInput) searchInput.blur();
          return;
        }
        if (inInput) return;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          setStep(state.stepIdx + 1, true);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          setStep(state.stepIdx - 1, true);
        } else if (e.key === ' ') {
          e.preventDefault();
          togglePlay();
        }
      });

      // Boot immediately from sanitized snapshot
      indexMembers(initialMembers);
      updateTargets();
      renderControls();
      renderDirectory();

      var params = new URLSearchParams(window.location.search);
      if (params.get('team')) {
        state.team = params.get('team');
        renderControls();
        renderDirectory();
        fitTeamCamera(state.team);
      }
      if (window.location.hash.startsWith('#member=')) {
        var targetId = decodeURIComponent(window.location.hash.slice('#member='.length));
        if (BY_ID.has(targetId)) selectMember(targetId, true);
      }

      async function refreshDynamicMembers() {
        try {
          var ctrl = new AbortController();
          var timer = setTimeout(function () { ctrl.abort(); }, 2500);
          var res = await fetch('/team.json', { signal: ctrl.signal, cache: 'no-store' });
          clearTimeout(timer);
          if (!res.ok) return;
          var payload = await res.json();
          var list = Array.isArray(payload) ? payload : payload && Array.isArray(payload.members) ? payload.members : null;
          if (!list || list.length === 0) return;

          indexMembers(list);
          updateTargets();
          renderControls();
          renderDirectory();
          if (state.selectedId && BY_ID.has(state.selectedId)) {
            renderInspector(BY_ID.get(state.selectedId));
          }
          sourceStatusEl.textContent = 'Live registry synced';
        } catch (_) {}
      }
      refreshDynamicMembers();
    })();
  </script>
</BaseLayout>
