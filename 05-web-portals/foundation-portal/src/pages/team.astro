---
import BaseLayout from '../layouts/BaseLayout.astro';
import teamData from '../data/team-nodes.json';
---
<BaseLayout title="Team Constellation" backLabel="TF Unions" backHref="/">
  <!-- Calm White Header & Interactive Timeline Control Panel -->
  <section class="mt-8 bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-8 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-5">
      <div>
        <div class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
          Organizational evolution, October 2025 to November 2026
        </div>
        <h1 class="font-display mt-2.5 text-[28px] sm:text-[38px] font-bold tracking-[-0.025em] leading-[1.1] text-[#161A22]">
          Union cohort and leadership constellation.
        </h1>
        <p class="mt-2.5 text-[15px] leading-[1.6] text-[#525866] max-w-[680px]">
          Trace how TF Unions grew from two founding systems architects in <strong class="text-[#161A22] font-semibold">October 2025</strong> to <strong class="text-[#0F766E] font-semibold">71 student leaders</strong> across Egypt in <strong class="text-[#161A22] font-semibold">November 2026</strong>.
        </p>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <button
          id="play-btn"
          type="button"
          class="h-9 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition flex items-center gap-1.5"
        >
          <span id="play-icon" class="text-[11px]">▶</span>
          <span id="play-label">Play timeline</span>
        </button>
        <span class="font-code px-3 py-1.5 bg-[#EDF7F5] border border-[#BCE3DC] text-[#0F766E] text-[12px] font-medium rounded-lg" id="active-count-badge">
          71 active
        </span>
      </div>
    </div>

    <!-- Recessed Timeline Scrubber Well -->
    <div class="mt-7 pt-5 border-t border-[#DFDDD6]">
      <div class="flex items-center justify-between text-[12px] text-[#525866] mb-3">
        <span class="font-code text-[#767D8C]">Oct 2025 (Inception)</span>
        <span id="cohort-desc" class="text-center text-[#161A22] font-medium hidden sm:inline">November 2026 — Nationwide Scale (71 Active Members Across Egypt)</span>
        <span class="font-code text-[#0F766E] font-medium">Nov 2026 (71 Members)</span>
      </div>

      <div class="p-3 bg-[#F3F2EE] border border-[#DFDDD6] rounded-lg">
        <input
          id="timeline-slider"
          type="range"
          min="0"
          max="4"
          step="1"
          value="4"
          aria-label="Cohort timeline milestone slider"
          class="w-full h-1.5 bg-[#DCD9D0] rounded-lg appearance-none cursor-pointer accent-[#1B365D] focus:outline-none"
        />

        <div class="grid grid-cols-5 gap-2 text-[11.5px] text-[#767D8C] mt-3">
          <button type="button" class="text-left hover:text-[#161A22] transition" onclick="setStep(0)">
            <span class="font-code block">Oct 2025</span>
            <strong class="text-[#161A22] font-semibold">Founders</strong>
          </button>
          <button type="button" class="text-center hover:text-[#161A22] transition" onclick="setStep(1)">
            <span class="font-code block">Jan 2026</span>
            <strong class="text-[#161A22] font-semibold">Heads</strong>
          </button>
          <button type="button" class="text-center hover:text-[#161A22] transition" onclick="setStep(2)">
            <span class="font-code block">Apr 2026</span>
            <strong class="text-[#161A22] font-semibold">Vice Heads</strong>
          </button>
          <button type="button" class="text-center hover:text-[#161A22] transition" onclick="setStep(3)">
            <span class="font-code block">Jul 2026</span>
            <strong class="text-[#161A22] font-semibold">Committees</strong>
          </button>
          <button type="button" class="text-right hover:text-[#161A22] transition" onclick="setStep(4)">
            <span class="font-code block">Nov 2026</span>
            <strong class="text-[#161A22] font-semibold">Full Network</strong>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Interactive Constellation Widget -->
  <section class="mt-6 bg-white border border-[#DFDDD6] rounded-xl shadow-[0_1px_2px_rgba(22,26,34,0.04)] overflow-hidden">
    <!-- Segmented Team Filter & Search Bar -->
    <div class="px-5 py-3.5 bg-[#EAE8E1] border-b border-[#DFDDD6] flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-1" id="team-filter-buttons">
        <button type="button" data-team="All" class="team-btn active px-3 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition">All teams (71)</button>
        <button type="button" data-team="Founders" class="team-btn px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Founders (2)</button>
        <button type="button" data-team="HR Team" class="team-btn px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">HR team (26)</button>
        <button type="button" data-team="Marketing Team" class="team-btn px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Marketing (12)</button>
        <button type="button" data-team="PR Team" class="team-btn px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">PR &amp; Outreach (17)</button>
        <button type="button" data-team="Social Media Team" class="team-btn px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Social Media (14)</button>
      </div>

      <div class="w-full sm:w-64">
        <input
          id="graph-search"
          type="text"
          placeholder="Search member or school..."
          class="w-full h-9 px-3 bg-white border border-[#DFDDD6] rounded-lg text-[13px] text-[#161A22] placeholder-[#767D8C] focus:border-[#1B365D] focus:outline-none"
        />
      </div>
    </div>

    <!-- Calm Radial Dot Canvas SVG Constellation -->
    <div class="relative bg-[#FAF9F6] overflow-hidden" style="min-height: 600px; background-image: radial-gradient(#DCD9D0 1px, transparent 1px); background-size: 24px 24px;">
      <!-- Zoom Controls -->
      <div class="absolute top-4 right-4 z-10 flex flex-col gap-1 bg-white p-1 rounded-lg border border-[#DFDDD6] shadow-[0_1px_3px_rgba(22,26,34,0.06)]">
        <button id="btn-zoom-in" type="button" class="w-8 h-8 rounded-md flex items-center justify-center text-[#161A22] hover:bg-[#F3F2EE] font-medium text-[15px]" title="Zoom In">+</button>
        <button id="btn-zoom-out" type="button" class="w-8 h-8 rounded-md flex items-center justify-center text-[#161A22] hover:bg-[#F3F2EE] font-medium text-[15px]" title="Zoom Out">−</button>
        <button id="btn-zoom-reset" type="button" class="w-8 h-8 rounded-md flex items-center justify-center text-[#525866] hover:bg-[#F3F2EE] text-[10.5px] font-code font-medium" title="Reset View">100%</button>
      </div>

      <div id="graph-viewport" class="w-full h-full cursor-grab active:cursor-grabbing select-none" style="height: 620px;">
        <svg id="network-svg" viewBox="0 0 1000 680" class="w-full h-full" preserveAspectRatio="xMidYMid meet">
          <defs>
            <filter id="node-shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="1.5" stdDeviation="2" flood-color="#161A22" flood-opacity="0.10" />
            </filter>
            <filter id="glow-founder" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#1B365D" flood-opacity="0.18" />
            </filter>
          </defs>

          <g id="graph-content">
            <g id="edges-layer"></g>

            <g id="hubs-layer">
              <circle cx="230" cy="170" r="34" fill="#1B365D" fill-opacity="0.04" stroke="#1B365D" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3,3" />
              <text x="230" y="124" text-anchor="middle" font-size="11" font-weight="600" fill="#1B365D">HR Team</text>

              <circle cx="770" cy="170" r="34" fill="#0F766E" fill-opacity="0.05" stroke="#0F766E" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="3,3" />
              <text x="770" y="124" text-anchor="middle" font-size="11" font-weight="600" fill="#0F766E">PR &amp; Outreach</text>

              <circle cx="250" cy="480" r="34" fill="#334155" fill-opacity="0.05" stroke="#334155" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3,3" />
              <text x="250" y="526" text-anchor="middle" font-size="11" font-weight="600" fill="#334155">Marketing</text>

              <circle cx="750" cy="480" r="34" fill="#B45309" fill-opacity="0.05" stroke="#B45309" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3,3" />
              <text x="750" y="526" text-anchor="middle" font-size="11" font-weight="600" fill="#B45309">Social Media</text>
            </g>

            <g id="nodes-layer"></g>
          </g>
        </svg>
      </div>

      <!-- Calm Floating Member Inspector Sheet -->
      <div
        id="member-inspector"
        class="hidden absolute bottom-4 left-4 right-4 sm:right-auto sm:w-[410px] bg-white border border-[#1B365D]/40 rounded-xl p-5 shadow-[0_8px_24px_rgba(22,26,34,0.10)] z-20"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            <div id="insp-avatar" class="w-11 h-11 rounded-lg flex items-center justify-center font-semibold text-white text-[14px]">
              MF
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 id="insp-name" class="font-display font-bold text-[18px] text-[#161A22] leading-tight">Mohammed Farag</h3>
                <span id="insp-team-badge" class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-[#EAE8E1] text-[#525866]">Founders</span>
              </div>
              <div id="insp-role" class="text-[13px] font-medium text-[#1B365D] mt-0.5">Co-Founder &amp; Principal Systems Architect</div>
            </div>
          </div>
          <button id="close-inspector-btn" type="button" class="text-[#767D8C] hover:text-[#161A22] px-2 py-1 text-[18px] leading-none" aria-label="Close inspector">&times;</button>
        </div>

        <div class="mt-4 pt-3 border-t border-[#DFDDD6] text-[13px] space-y-1.5 text-[#525866]">
          <div class="flex items-center justify-between">
            <span>School / University</span>
            <strong id="insp-school" class="text-[#161A22] font-medium text-right">TF Unions Core</strong>
          </div>
          <div class="flex items-center justify-between">
            <span>Academic grade</span>
            <span id="insp-grade" class="text-[#161A22]">Founding Cohort</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Joined timeline</span>
            <span id="insp-cohort" class="font-code text-[#0F766E] font-medium">Oct 2025</span>
          </div>
        </div>

        <div class="mt-3 p-3 bg-[#F3F2EE] border border-[#DFDDD6] rounded-lg text-[12.5px] text-[#525866] leading-relaxed" id="insp-bio">
          Principal Systems Architect leading cloud, backend, and portal infrastructure across Egypt.
        </div>
      </div>
    </div>
  </section>

  <!-- Directory Roster Synchronized with Timeline -->
  <section class="mt-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-5 pb-3 border-b border-[#DFDDD6]">
      <div>
        <h2 class="font-display text-[24px] font-bold tracking-[-0.02em] text-[#161A22]">Directory roster</h2>
        <p class="text-[14px] text-[#525866]">
          Contributors active in the selected timeline milestone. Click any card to highlight on the constellation.
        </p>
      </div>
      <div class="font-code text-[12.5px] font-medium text-[#0F766E]">
        <span id="roster-count">71</span> active contributors
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="member-cards-container"></div>
  </section>

  <script is:inline define:vars={{ teamData }}>
    const ALL_MEMBERS = teamData;

    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const STEPS = [
      { key: '2025-10', label: 'Oct 2025', desc: 'October 2025 — Co-Founders Inception (Mohammed Farag & Mohammed Abdelghany)' },
      { key: '2026-01', label: 'Jan 2026', desc: 'January 2026 — Executive Heads of HR, Marketing, PR & Social Media' },
      { key: '2026-04', label: 'Apr 2026', desc: 'April 2026 — Vice Heads & Regional Guild Leaders' },
      { key: '2026-07', label: 'Jul 2026', desc: 'July 2026 — Interview Committees, Outreach Leads & Managers' },
      { key: '2026-11', label: 'Nov 2026', desc: 'November 2026 — Nationwide Scale (71 Active Members Across Egypt)' }
    ];

    let currentStepIndex = 4;
    let selectedTeam = 'All';
    let searchQuery = '';
    let selectedMemberId = null;
    let isPlaying = false;
    let playInterval = null;

    let zoomLevel = 1;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const timelineSlider = document.getElementById('timeline-slider');
    const cohortDesc = document.getElementById('cohort-desc');
    const activeCountBadge = document.getElementById('active-count-badge');
    const rosterCount = document.getElementById('roster-count');
    const playBtn = document.getElementById('play-btn');
    const playIcon = document.getElementById('play-icon');
    const playLabel = document.getElementById('play-label');
    const graphSearch = document.getElementById('graph-search');
    const graphContent = document.getElementById('graph-content');
    const nodesLayer = document.getElementById('nodes-layer');
    const edgesLayer = document.getElementById('edges-layer');
    const cardsContainer = document.getElementById('member-cards-container');
    const inspector = document.getElementById('member-inspector');
    const closeInspectorBtn = document.getElementById('close-inspector-btn');

    // Calm architectural node palette (no harsh purple gradients)
    const TEAM_COLORS = {
      'Founders': { bg: '#1B365D', fill: '#1B365D', badge: 'bg-[#EEF2F6] text-[#1B365D]' },
      'HR Team': { bg: '#334155', fill: '#334155', badge: 'bg-[#EAE8E1] text-[#334155]' },
      'Marketing Team': { bg: '#0F766E', fill: '#0F766E', badge: 'bg-[#EDF7F5] text-[#0F766E]' },
      'PR Team': { bg: '#2563EB', fill: '#2563EB', badge: 'bg-[#EFF6FF] text-[#1D4ED8]' },
      'Social Media Team': { bg: '#B45309', fill: '#B45309', badge: 'bg-[#FEF6EB] text-[#B45309]' }
    };

    function isMemberActiveAtStep(member, stepIdx) {
      return member.cohortDate <= STEPS[stepIdx].key;
    }

    function getFilteredMembers() {
      return ALL_MEMBERS.filter(m => {
        const matchesTimeline = isMemberActiveAtStep(m, currentStepIndex);
        const matchesTeam = selectedTeam === 'All' || m.team === selectedTeam;
        const q = searchQuery.toLowerCase().trim();
        const matchesQuery = !q ||
          m.name.toLowerCase().includes(q) ||
          (m.arabicName && m.arabicName.includes(q)) ||
          m.role.toLowerCase().includes(q) ||
          m.school.toLowerCase().includes(q);
        return matchesTimeline && matchesTeam && matchesQuery;
      });
    }

    function renderGraph() {
      const activeMembers = ALL_MEMBERS.filter(m => isMemberActiveAtStep(m, currentStepIndex));
      const activeIdSet = new Set(activeMembers.map(m => m.id));

      activeCountBadge.textContent = `${activeMembers.length} active`;
      cohortDesc.textContent = STEPS[currentStepIndex].desc;

      let edgesHtml = '';
      activeMembers.forEach(m => {
        if (m.parent && activeIdSet.has(m.parent)) {
          const parent = ALL_MEMBERS.find(p => p.id === m.parent);
          if (parent) {
            const isFounderLink = m.id === 'founder-1' && m.parent === 'founder-2';
            const isHighlighted = selectedMemberId === m.id || selectedMemberId === m.parent;
            edgesHtml += `
              <line
                x1="${m.x}" y1="${m.y}"
                x2="${parent.x}" y2="${parent.y}"
                stroke="${isFounderLink ? '#1B365D' : (isHighlighted ? '#0F766E' : '#DCD9D0')}"
                stroke-width="${isFounderLink ? '2.5' : (isHighlighted ? '2' : '1.1')}"
                stroke-opacity="${isHighlighted ? '1' : '0.85'}"
              />
            `;
          }
        }
      });
      edgesLayer.innerHTML = edgesHtml;

      let nodesHtml = '';
      activeMembers.forEach(m => {
        const colors = TEAM_COLORS[m.team] || TEAM_COLORS['Founders'];
        const isSelected = selectedMemberId === m.id;
        const isFounder = m.tier === 0;
        const initials = m.name.split(' ').slice(0, 2).map(p => p[0]).join('').toUpperCase();
        const safeId = esc(m.id);

        nodesHtml += `
          <g class="node-group cursor-pointer" data-id="${safeId}" onclick="inspectMember('${safeId}')">
            ${isSelected ? `<circle cx="${m.x}" cy="${m.y}" r="${m.r + 6}" fill="none" stroke="#0F766E" stroke-width="2" />` : ''}
            <circle
              cx="${m.x}"
              cy="${m.y}"
              r="${m.r}"
              fill="${colors.fill}"
              stroke="#FFFFFF"
              stroke-width="${isFounder ? '2.5' : '1.8'}"
              filter="${isFounder ? 'url(#glow-founder)' : 'url(#node-shadow)'}"
            />
            <text
              x="${m.x}"
              y="${m.y + (m.r > 16 ? 4 : 3)}"
              text-anchor="middle"
              fill="#FFFFFF"
              font-size="${m.r > 20 ? 11 : (m.r > 14 ? 9 : 8)}"
              font-weight="600"
              pointer-events="none"
            >${esc(initials)}</text>
            <text
              x="${m.x}"
              y="${m.y + m.r + 13}"
              text-anchor="middle"
              fill="#161A22"
              font-size="${isFounder ? 11.5 : 9.5}"
              font-weight="${isFounder ? 600 : 500}"
              class="select-none pointer-events-none"
            >${esc(m.name.split(' ')[0])} ${isFounder ? esc(m.name.split(' ')[1] || '') : ''}</text>
          </g>
        `;
      });
      nodesLayer.innerHTML = nodesHtml;
    }

    function renderRoster() {
      const filtered = getFilteredMembers();
      rosterCount.textContent = filtered.length;

      cardsContainer.innerHTML = filtered.map(m => {
        const colors = TEAM_COLORS[m.team] || TEAM_COLORS['Founders'];
        const isSelected = selectedMemberId === m.id;
        const initials = m.name.split(' ').slice(0, 2).map(p => p[0]).join('').toUpperCase();
        const safeId = esc(m.id);

        return `
          <div
            class="p-5 rounded-xl border transition cursor-pointer ${
              isSelected
                ? 'bg-[#EDF7F5]/40 border-[#0F766E] ring-1 ring-[#0F766E]/30'
                : 'bg-white border-[#DFDDD6] hover:border-[#B8B4A8] shadow-[0_1px_2px_rgba(22,26,34,0.03)]'
            }"
            onclick="inspectMember('${safeId}')"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center font-semibold text-white text-[13px] shrink-0" style="background-color: ${colors.bg};">
                  ${esc(initials)}
                </div>
                <div>
                  <h4 class="font-display font-semibold text-[16px] text-[#161A22] leading-tight">${esc(m.name)}</h4>
                  <div class="text-[12.5px] font-medium text-[#525866] mt-0.5">${esc(m.role)}</div>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-md text-[11px] font-medium shrink-0 ${colors.badge}">${esc(m.team.replace(' Team', ''))}</span>
            </div>

            <div class="mt-3 pt-2.5 border-t border-[#EAE8E1] text-[12px] text-[#767D8C] flex items-center justify-between gap-2">
              <span>${esc(m.school || 'TF Unions')}</span>
              <span class="font-code font-medium text-[#161A22]">${esc(m.cohortLabel || m.grade)}</span>
            </div>

            <p class="mt-2 text-[12.5px] text-[#525866] line-clamp-2 leading-relaxed">
              ${esc(m.bio)}
            </p>
          </div>
        `;
      }).join('');
    }

    window.inspectMember = function(id) {
      selectedMemberId = id;
      const m = ALL_MEMBERS.find(item => item.id === id);
      if (!m) return;

      const colors = TEAM_COLORS[m.team] || TEAM_COLORS['Founders'];
      const initials = m.name.split(' ').slice(0, 2).map(p => p[0]).join('').toUpperCase();

      document.getElementById('insp-name').textContent = m.name;
      document.getElementById('insp-role').textContent = m.role;
      document.getElementById('insp-team-badge').textContent = m.team;
      document.getElementById('insp-school').textContent = m.school || 'TF Unions';
      document.getElementById('insp-grade').textContent = `${m.grade} (Age ${m.age || 17})`;
      document.getElementById('insp-cohort').textContent = m.cohortLabel;
      document.getElementById('insp-bio').textContent = m.bio;

      const avatar = document.getElementById('insp-avatar');
      avatar.textContent = initials;
      avatar.style.backgroundColor = colors.bg;

      inspector.classList.remove('hidden');
      renderGraph();
      renderRoster();
    };

    window.setStep = function(idx) {
      currentStepIndex = parseInt(idx);
      timelineSlider.value = currentStepIndex;
      renderGraph();
      renderRoster();
    };

    timelineSlider.addEventListener('input', (e) => setStep(e.target.value));

    closeInspectorBtn.addEventListener('click', () => {
      inspector.classList.add('hidden');
      selectedMemberId = null;
      renderGraph();
      renderRoster();
    });

    document.querySelectorAll('#team-filter-buttons .team-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#team-filter-buttons .team-btn').forEach(b => {
          b.className = 'team-btn px-3 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition';
        });
        btn.className = 'team-btn active px-3 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition';
        selectedTeam = btn.dataset.team;
        renderRoster();
      });
    });

    graphSearch.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      renderRoster();
    });

    playBtn.addEventListener('click', () => {
      if (isPlaying) {
        clearInterval(playInterval);
        isPlaying = false;
        playIcon.textContent = '▶';
        playLabel.textContent = 'Play timeline';
      } else {
        isPlaying = true;
        playIcon.textContent = '⏸';
        playLabel.textContent = 'Pause';
        playInterval = setInterval(() => {
          currentStepIndex = (currentStepIndex + 1) % STEPS.length;
          setStep(currentStepIndex);
        }, 1800);
      }
    });

    function updateTransform() {
      graphContent.setAttribute('transform', `translate(${panX}, ${panY}) scale(${zoomLevel})`);
    }
    document.getElementById('btn-zoom-in').addEventListener('click', () => {
      zoomLevel = Math.min(zoomLevel + 0.2, 2.2);
      updateTransform();
    });
    document.getElementById('btn-zoom-out').addEventListener('click', () => {
      zoomLevel = Math.max(zoomLevel - 0.2, 0.6);
      updateTransform();
    });
    document.getElementById('btn-zoom-reset').addEventListener('click', () => {
      zoomLevel = 1; panX = 0; panY = 0;
      updateTransform();
    });

    const viewport = document.getElementById('graph-viewport');
    viewport.addEventListener('mousedown', (e) => {
      if (e.target.closest('.node-group')) return;
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
    });
    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      updateTransform();
    });
    window.addEventListener('mouseup', () => { isDragging = false; });

    renderGraph();
    renderRoster();
  </script>
</BaseLayout>
