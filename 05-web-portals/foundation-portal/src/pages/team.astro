---
import BaseLayout from '../layouts/BaseLayout.astro';
import teamData from '../data/team-nodes.json';
---
<BaseLayout title="Team Constellation" backLabel="TF Unions" backHref="/">
  <!-- Deep Oxford Navy Header Stage -->
  <section class="mt-7 bg-[#0A1931] text-white border border-[#1E3A6D] rounded-lg p-7 sm:p-9 shadow-[0_3px_12px_rgba(10,25,49,0.08)]">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-5">
      <div>
        <div class="inline-block pl-3 border-l-2 border-[#C88A14] text-[13px] font-medium text-[#E2E8F0]">
          Organizational evolution, October 2025 to November 2026
        </div>
        <h1 class="font-display mt-3 text-[32px] sm:text-[44px] font-bold tracking-[-0.025em] leading-[1.08] text-white">
          Union cohort and leadership constellation.
        </h1>
        <p class="mt-3 text-[15.5px] leading-[1.55] text-[#CBD5E1] max-w-[700px]">
          Trace how TF Unions grew from two founding systems architects in <strong class="text-white">October 2025</strong> to <strong class="text-[#C88A14]">71 student leaders</strong> across Egypt in <strong class="text-white">November 2026</strong>.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <button
          id="play-btn"
          type="button"
          class="h-10 px-4 rounded-md bg-[#C88A14] hover:bg-[#B2790E] text-[#0A1931] text-[13px] font-bold transition flex items-center gap-1.5"
        >
          <span id="play-icon">▶</span>
          <span id="play-label">Play Timeline</span>
        </button>
        <span class="font-code px-3 py-2 bg-[#102447] border border-[#1E3A6D] text-white text-[12px] font-semibold rounded-md" id="active-count-badge">
          71 Members Active
        </span>
      </div>
    </div>

    <!-- Interactive Timeline Scrubber inside Navy Masthead -->
    <div class="mt-7 pt-6 border-t border-[#1E3A6D]">
      <div class="flex items-center justify-between text-[12px] font-semibold text-[#CBD5E1] mb-2.5">
        <span class="font-code text-[#C88A14]">Oct 2025 (Inception)</span>
        <span id="cohort-desc" class="text-center text-white hidden sm:inline">November 2026 — Nationwide Scale (71 Active Members Across Egypt)</span>
        <span class="font-code text-[#C88A14]">Nov 2026 (71 Members)</span>
      </div>

      <input
        id="timeline-slider"
        type="range"
        min="0"
        max="4"
        step="1"
        value="4"
        aria-label="Cohort timeline milestone slider"
        class="w-full h-2 bg-[#1E3A6D] rounded appearance-none cursor-pointer accent-[#C88A14] focus:outline-none"
      />

      <div class="grid grid-cols-5 gap-2 text-[11.5px] text-[#94A3B8] mt-3">
        <button type="button" class="text-left hover:text-white transition" onclick="setStep(0)">
          <span class="font-code block">Oct 2025</span>
          <strong class="text-white font-semibold">Founders</strong>
        </button>
        <button type="button" class="text-center hover:text-white transition" onclick="setStep(1)">
          <span class="font-code block">Jan 2026</span>
          <strong class="text-white font-semibold">Heads</strong>
        </button>
        <button type="button" class="text-center hover:text-white transition" onclick="setStep(2)">
          <span class="font-code block">Apr 2026</span>
          <strong class="text-white font-semibold">Vice Heads</strong>
        </button>
        <button type="button" class="text-center hover:text-white transition" onclick="setStep(3)">
          <span class="font-code block">Jul 2026</span>
          <strong class="text-white font-semibold">Committees</strong>
        </button>
        <button type="button" class="text-right hover:text-white transition" onclick="setStep(4)">
          <span class="font-code block">Nov 2026</span>
          <strong class="text-white font-semibold">Full Network</strong>
        </button>
      </div>
    </div>
  </section>

  <!-- Main Interactive Constellation Widget -->
  <section class="mt-6 bg-white border border-[#CFCBC2] rounded-lg shadow-[0_2px_6px_rgba(10,25,49,0.05)] overflow-hidden">
    <!-- Filter & Search Bar -->
    <div class="px-5 sm:px-6 py-4 bg-[#E2DFD7] border-b border-[#CFCBC2] flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-1.5" id="team-filter-buttons">
        <button type="button" data-team="All" class="team-btn active px-3 py-1.5 rounded-md text-[12px] font-semibold bg-[#0A1931] text-white border border-[#0A1931] transition">All Teams (71)</button>
        <button type="button" data-team="Founders" class="team-btn px-3 py-1.5 rounded-md text-[12px] font-semibold bg-white text-[#12161F] border border-[#CFCBC2] hover:border-[#14388C] transition">Founders (2)</button>
        <button type="button" data-team="HR Team" class="team-btn px-3 py-1.5 rounded-md text-[12px] font-semibold bg-white text-[#12161F] border border-[#CFCBC2] hover:border-[#14388C] transition">HR Team (26)</button>
        <button type="button" data-team="Marketing Team" class="team-btn px-3 py-1.5 rounded-md text-[12px] font-semibold bg-white text-[#12161F] border border-[#CFCBC2] hover:border-[#14388C] transition">Marketing (12)</button>
        <button type="button" data-team="PR Team" class="team-btn px-3 py-1.5 rounded-md text-[12px] font-semibold bg-white text-[#12161F] border border-[#CFCBC2] hover:border-[#14388C] transition">PR &amp; Outreach (17)</button>
        <button type="button" data-team="Social Media Team" class="team-btn px-3 py-1.5 rounded-md text-[12px] font-semibold bg-white text-[#12161F] border border-[#CFCBC2] hover:border-[#14388C] transition">Social Media (14)</button>
      </div>

      <div class="w-full sm:w-64">
        <input
          id="graph-search"
          type="text"
          placeholder="Search member or school..."
          class="w-full h-9 px-3 bg-white border border-[#CFCBC2] rounded-md text-[13px] text-[#12161F] placeholder-[#687082] focus:border-[#14388C] focus:outline-none"
        />
      </div>
    </div>

    <!-- Interactive Visual SVG Constellation -->
    <div class="relative bg-[#FAFAF8] overflow-hidden" style="min-height: 600px;">
      <!-- Zoom Controls -->
      <div class="absolute top-4 right-4 z-10 flex flex-col gap-1 bg-white p-1 rounded-md border border-[#CFCBC2] shadow-sm">
        <button id="btn-zoom-in" type="button" class="w-8 h-8 rounded flex items-center justify-center text-[#12161F] hover:bg-[#ECEAE4] font-bold text-[16px]" title="Zoom In">+</button>
        <button id="btn-zoom-out" type="button" class="w-8 h-8 rounded flex items-center justify-center text-[#12161F] hover:bg-[#ECEAE4] font-bold text-[16px]" title="Zoom Out">−</button>
        <button id="btn-zoom-reset" type="button" class="w-8 h-8 rounded flex items-center justify-center text-[#12161F] hover:bg-[#ECEAE4] text-[11px] font-semibold" title="Reset View">100%</button>
      </div>

      <div id="graph-viewport" class="w-full h-full cursor-grab active:cursor-grabbing select-none" style="height: 620px;">
        <svg id="network-svg" viewBox="0 0 1000 680" class="w-full h-full" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="grad-founder" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0A1931" />
              <stop offset="100%" stop-color="#14388C" />
            </linearGradient>
            <linearGradient id="grad-hr" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#7C3AED" />
              <stop offset="100%" stop-color="#5B21B6" />
            </linearGradient>
            <linearGradient id="grad-marketing" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#059669" />
              <stop offset="100%" stop-color="#065F46" />
            </linearGradient>
            <linearGradient id="grad-pr" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0284C7" />
              <stop offset="100%" stop-color="#075985" />
            </linearGradient>
            <linearGradient id="grad-social" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#C88A14" />
              <stop offset="100%" stop-color="#92400E" />
            </linearGradient>
            <filter id="node-shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-opacity="0.14" />
            </filter>
            <filter id="glow-founder" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="0" stdDeviation="5" flood-color="#0A1931" flood-opacity="0.35" />
            </filter>
          </defs>

          <g id="graph-content">
            <g id="edges-layer"></g>

            <g id="hubs-layer">
              <circle cx="230" cy="170" r="32" fill="#7C3AED" fill-opacity="0.07" stroke="#7C3AED" stroke-width="1.5" stroke-dasharray="3,3" />
              <text x="230" y="125" text-anchor="middle" font-size="11" font-weight="700" fill="#5B21B6">HR Team</text>

              <circle cx="770" cy="170" r="32" fill="#0284C7" fill-opacity="0.07" stroke="#0284C7" stroke-width="1.5" stroke-dasharray="3,3" />
              <text x="770" y="125" text-anchor="middle" font-size="11" font-weight="700" fill="#075985">PR &amp; Outreach</text>

              <circle cx="250" cy="480" r="32" fill="#059669" fill-opacity="0.07" stroke="#059669" stroke-width="1.5" stroke-dasharray="3,3" />
              <text x="250" y="525" text-anchor="middle" font-size="11" font-weight="700" fill="#065F46">Marketing</text>

              <circle cx="750" cy="480" r="32" fill="#C88A14" fill-opacity="0.08" stroke="#C88A14" stroke-width="1.5" stroke-dasharray="3,3" />
              <text x="750" y="525" text-anchor="middle" font-size="11" font-weight="700" fill="#92400E">Social Media</text>
            </g>

            <g id="nodes-layer"></g>
          </g>
        </svg>
      </div>

      <!-- Floating Member Inspector Sheet -->
      <div
        id="member-inspector"
        class="hidden absolute bottom-4 left-4 right-4 sm:right-auto sm:w-[420px] bg-white border-2 border-[#0A1931] rounded-lg p-5 shadow-xl z-20"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            <div id="insp-avatar" class="w-11 h-11 rounded-md flex items-center justify-center font-bold text-white text-[15px]">
              MF
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 id="insp-name" class="font-display font-bold text-[19px] text-[#12161F] leading-tight">Mohammed Farag</h3>
                <span id="insp-team-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-[#E2DFD7] text-[#12161F]">Founders</span>
              </div>
              <div id="insp-role" class="text-[13px] font-semibold text-[#14388C] mt-0.5">Co-Founder &amp; Principal Systems Architect</div>
            </div>
          </div>
          <button id="close-inspector-btn" type="button" class="text-[#4A5262] hover:text-[#12161F] px-2 py-1 text-[16px]" aria-label="Close inspector">&times;</button>
        </div>

        <div class="mt-4 pt-3 border-t border-[#CFCBC2] text-[13px] space-y-1.5 text-[#4A5262]">
          <div class="flex items-center justify-between">
            <span>School / University</span>
            <strong id="insp-school" class="text-[#12161F] text-right">TF Unions Core</strong>
          </div>
          <div class="flex items-center justify-between">
            <span>Academic Grade</span>
            <span id="insp-grade" class="text-[#12161F]">Founding Cohort</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Joined Timeline</span>
            <span id="insp-cohort" class="font-code text-[#14388C] font-semibold">Oct 2025</span>
          </div>
        </div>

        <div class="mt-3 p-3 bg-[#ECEAE4] border border-[#CFCBC2] rounded-md text-[12.5px] text-[#12161F] leading-relaxed" id="insp-bio">
          Principal Systems Architect leading cloud, backend, and portal infrastructure across Egypt.
        </div>
      </div>
    </div>
  </section>

  <!-- Directory Roster Synchronized with Timeline -->
  <section class="mt-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-5 pb-3 border-b border-[#CFCBC2]">
      <div>
        <h2 class="font-display text-[28px] font-bold tracking-[-0.02em] text-[#12161F]">Directory Roster</h2>
        <p class="text-[14px] text-[#4A5262]">
          Showing contributors active in the selected timeline milestone. Select any member card to highlight on the graph.
        </p>
      </div>
      <div class="font-code text-[13px] font-semibold text-[#14388C]">
        <span id="roster-count">71</span> Active Contributors
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="member-cards-container"></div>
  </section>

  <script is:inline define:vars={{ teamData }}>
    const ALL_MEMBERS = teamData;

    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const STEPS = [
      { key: '2025-10', label: 'Oct 2025', desc: 'October 2025 — Co-Founders Inception (Mohammed Farag & Mohammed Abdelghany)' },
      { key: '2026-01', label: 'Jan 2026', desc: 'January 2026 — Executive Heads of HR, Marketing, PR & Social Media' },
      { key: '2026-04', label: 'Apr 2026', desc: 'April 2026 — Vice Heads & Regional Guild Leaders' },
      { key: '2026-07', label: 'Jul 2026', desc: 'July 2026 — Interview Committees, Outreach Leads & Managers' },
      { key: '2026-11', label: 'Nov 2026', desc: 'November 2026 — Nationwide Scale (71 Active Members Across Egypt)' }
    ];

    let currentStepIndex = 4;
    let selectedTeam = 'All';
    let searchQuery = '';
    let selectedMemberId = null;
    let isPlaying = false;
    let playInterval = null;

    let zoomLevel = 1;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const timelineSlider = document.getElementById('timeline-slider');
    const cohortDesc = document.getElementById('cohort-desc');
    const activeCountBadge = document.getElementById('active-count-badge');
    const rosterCount = document.getElementById('roster-count');
    const playBtn = document.getElementById('play-btn');
    const playIcon = document.getElementById('play-icon');
    const playLabel = document.getElementById('play-label');
    const graphSearch = document.getElementById('graph-search');
    const graphContent = document.getElementById('graph-content');
    const nodesLayer = document.getElementById('nodes-layer');
    const edgesLayer = document.getElementById('edges-layer');
    const cardsContainer = document.getElementById('member-cards-container');
    const inspector = document.getElementById('member-inspector');
    const closeInspectorBtn = document.getElementById('close-inspector-btn');

    const TEAM_COLORS = {
      'Founders': { bg: '#0A1931', fill: 'url(#grad-founder)', badge: 'bg-[#0A1931] text-white' },
      'HR Team': { bg: '#5B21B6', fill: 'url(#grad-hr)', badge: 'bg-[#EDE9FE] text-[#5B21B6]' },
      'Marketing Team': { bg: '#065F46', fill: 'url(#grad-marketing)', badge: 'bg-[#D1FAE5] text-[#065F46]' },
      'PR Team': { bg: '#075985', fill: 'url(#grad-pr)', badge: 'bg-[#E0F2FE] text-[#075985]' },
      'Social Media Team': { bg: '#92400E', fill: 'url(#grad-social)', badge: 'bg-[#FEF3C7] text-[#92400E]' }
    };

    function isMemberActiveAtStep(member, stepIdx) {
      return member.cohortDate <= STEPS[stepIdx].key;
    }

    function getFilteredMembers() {
      return ALL_MEMBERS.filter(m => {
        const matchesTimeline = isMemberActiveAtStep(m, currentStepIndex);
        const matchesTeam = selectedTeam === 'All' || m.team === selectedTeam;
        const q = searchQuery.toLowerCase().trim();
        const matchesQuery = !q ||
          m.name.toLowerCase().includes(q) ||
          (m.arabicName && m.arabicName.includes(q)) ||
          m.role.toLowerCase().includes(q) ||
          m.school.toLowerCase().includes(q);
        return matchesTimeline && matchesTeam && matchesQuery;
      });
    }

    function renderGraph() {
      const activeMembers = ALL_MEMBERS.filter(m => isMemberActiveAtStep(m, currentStepIndex));
      const activeIdSet = new Set(activeMembers.map(m => m.id));

      activeCountBadge.textContent = `${activeMembers.length} Members Active`;
      cohortDesc.textContent = STEPS[currentStepIndex].desc;

      let edgesHtml = '';
      activeMembers.forEach(m => {
        if (m.parent && activeIdSet.has(m.parent)) {
          const parent = ALL_MEMBERS.find(p => p.id === m.parent);
          if (parent) {
            const isFounderLink = m.id === 'founder-1' && m.parent === 'founder-2';
            const isHighlighted = selectedMemberId === m.id || selectedMemberId === m.parent;
            edgesHtml += `
              <line
                x1="${m.x}" y1="${m.y}"
                x2="${parent.x}" y2="${parent.y}"
                stroke="${isFounderLink ? '#0A1931' : (isHighlighted ? '#C88A14' : '#CFCBC2')}"
                stroke-width="${isFounderLink ? '3' : (isHighlighted ? '2.2' : '1.3')}"
                stroke-opacity="${isHighlighted ? '1' : '0.75'}"
              />
            `;
          }
        }
      });
      edgesLayer.innerHTML = edgesHtml;

      let nodesHtml = '';
      activeMembers.forEach(m => {
        const colors = TEAM_COLORS[m.team] || TEAM_COLORS['Founders'];
        const isSelected = selectedMemberId === m.id;
        const isFounder = m.tier === 0;
        const initials = m.name.split(' ').slice(0, 2).map(p => p[0]).join('').toUpperCase();
        const safeId = esc(m.id);

        nodesHtml += `
          <g class="node-group cursor-pointer" data-id="${safeId}" onclick="inspectMember('${safeId}')">
            ${isSelected ? `<circle cx="${m.x}" cy="${m.y}" r="${m.r + 7}" fill="none" stroke="#C88A14" stroke-width="2.5" />` : ''}
            <circle
              cx="${m.x}"
              cy="${m.y}"
              r="${m.r}"
              fill="${colors.fill}"
              stroke="#FFFFFF"
              stroke-width="${isFounder ? '3' : '2'}"
              filter="${isFounder ? 'url(#glow-founder)' : 'url(#node-shadow)'}"
            />
            <text
              x="${m.x}"
              y="${m.y + (m.r > 16 ? 4 : 3)}"
              text-anchor="middle"
              fill="#FFFFFF"
              font-size="${m.r > 20 ? 11 : (m.r > 14 ? 9 : 8)}"
              font-weight="700"
              pointer-events="none"
            >${esc(initials)}</text>
            <text
              x="${m.x}"
              y="${m.y + m.r + 13}"
              text-anchor="middle"
              fill="#12161F"
              font-size="${isFounder ? 12 : 10}"
              font-weight="${isFounder ? 700 : 600}"
              class="select-none pointer-events-none"
            >${esc(m.name.split(' ')[0])} ${isFounder ? esc(m.name.split(' ')[1] || '') : ''}</text>
          </g>
        `;
      });
      nodesLayer.innerHTML = nodesHtml;
    }

    function renderRoster() {
      const filtered = getFilteredMembers();
      rosterCount.textContent = filtered.length;

      cardsContainer.innerHTML = filtered.map(m => {
        const colors = TEAM_COLORS[m.team] || TEAM_COLORS['Founders'];
        const isSelected = selectedMemberId === m.id;
        const initials = m.name.split(' ').slice(0, 2).map(p => p[0]).join('').toUpperCase();
        const safeId = esc(m.id);

        return `
          <div
            class="p-5 rounded-lg border transition cursor-pointer ${
              isSelected
                ? 'bg-[#FFFDF7] border-[#C88A14] ring-2 ring-[#C88A14]/40'
                : 'bg-white border-[#CFCBC2] hover:border-[#14388C]'
            }"
            onclick="inspectMember('${safeId}')"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-md flex items-center justify-center font-bold text-white text-[13.5px] shrink-0" style="background-color: ${colors.bg};">
                  ${esc(initials)}
                </div>
                <div>
                  <h4 class="font-display font-bold text-[17px] text-[#12161F] leading-tight">${esc(m.name)}</h4>
                  <div class="text-[12.5px] font-semibold text-[#14388C] mt-0.5">${esc(m.role)}</div>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded text-[11px] font-semibold shrink-0 ${colors.badge}">${esc(m.team.replace(' Team', ''))}</span>
            </div>

            <div class="mt-3 pt-2.5 border-t border-[#E2DFD7] text-[12px] text-[#4A5262] flex items-center justify-between gap-2">
              <span>${esc(m.school || 'TF Unions')}</span>
              <span class="font-code font-medium text-[#12161F]">${esc(m.cohortLabel || m.grade)}</span>
            </div>

            <p class="mt-2 text-[12.5px] text-[#4A5262] line-clamp-2 leading-relaxed">
              ${esc(m.bio)}
            </p>
          </div>
        `;
      }).join('');
    }

    window.inspectMember = function(id) {
      selectedMemberId = id;
      const m = ALL_MEMBERS.find(item => item.id === id);
      if (!m) return;

      const colors = TEAM_COLORS[m.team] || TEAM_COLORS['Founders'];
      const initials = m.name.split(' ').slice(0, 2).map(p => p[0]).join('').toUpperCase();

      document.getElementById('insp-name').textContent = m.name;
      document.getElementById('insp-role').textContent = m.role;
      document.getElementById('insp-team-badge').textContent = m.team;
      document.getElementById('insp-school').textContent = m.school || 'TF Unions';
      document.getElementById('insp-grade').textContent = `${m.grade} (Age ${m.age || 17})`;
      document.getElementById('insp-cohort').textContent = m.cohortLabel;
      document.getElementById('insp-bio').textContent = m.bio;

      const avatar = document.getElementById('insp-avatar');
      avatar.textContent = initials;
      avatar.style.backgroundColor = colors.bg;

      inspector.classList.remove('hidden');
      renderGraph();
      renderRoster();
    };

    window.setStep = function(idx) {
      currentStepIndex = parseInt(idx);
      timelineSlider.value = currentStepIndex;
      renderGraph();
      renderRoster();
    };

    timelineSlider.addEventListener('input', (e) => setStep(e.target.value));

    closeInspectorBtn.addEventListener('click', () => {
      inspector.classList.add('hidden');
      selectedMemberId = null;
      renderGraph();
      renderRoster();
    });

    document.querySelectorAll('#team-filter-buttons .team-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#team-filter-buttons .team-btn').forEach(b => {
          b.className = 'team-btn px-3 py-1.5 rounded-md text-[12px] font-semibold bg-white text-[#12161F] border border-[#CFCBC2] hover:border-[#14388C] transition';
        });
        btn.className = 'team-btn active px-3 py-1.5 rounded-md text-[12px] font-semibold bg-[#0A1931] text-white border border-[#0A1931] transition';
        selectedTeam = btn.dataset.team;
        renderRoster();
      });
    });

    graphSearch.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      renderRoster();
    });

    playBtn.addEventListener('click', () => {
      if (isPlaying) {
        clearInterval(playInterval);
        isPlaying = false;
        playIcon.textContent = '▶';
        playLabel.textContent = 'Play Timeline';
      } else {
        isPlaying = true;
        playIcon.textContent = '⏸';
        playLabel.textContent = 'Pause';
        playInterval = setInterval(() => {
          currentStepIndex = (currentStepIndex + 1) % STEPS.length;
          setStep(currentStepIndex);
        }, 1800);
      }
    });

    function updateTransform() {
      graphContent.setAttribute('transform', `translate(${panX}, ${panY}) scale(${zoomLevel})`);
    }
    document.getElementById('btn-zoom-in').addEventListener('click', () => {
      zoomLevel = Math.min(zoomLevel + 0.2, 2.2);
      updateTransform();
    });
    document.getElementById('btn-zoom-out').addEventListener('click', () => {
      zoomLevel = Math.max(zoomLevel - 0.2, 0.6);
      updateTransform();
    });
    document.getElementById('btn-zoom-reset').addEventListener('click', () => {
      zoomLevel = 1; panX = 0; panY = 0;
      updateTransform();
    });

    const viewport = document.getElementById('graph-viewport');
    viewport.addEventListener('mousedown', (e) => {
      if (e.target.closest('.node-group')) return;
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
    });
    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      updateTransform();
    });
    window.addEventListener('mouseup', () => { isDragging = false; });

    renderGraph();
    renderRoster();
  </script>
</BaseLayout>
