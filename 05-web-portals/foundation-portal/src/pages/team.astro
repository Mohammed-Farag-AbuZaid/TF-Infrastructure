---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Team" backLabel="TF Unions" backHref="/">
  <section class="mt-14 sm:mt-20 max-w-[720px]">
    <h1 class="text-[36px] sm:text-[52px] font-bold tracking-[-1.6px] leading-[1.08] text-[#1D1D1F]">
      Team &amp; contributors.
    </h1>
    <p class="mt-4 text-[17px] leading-[1.5] text-[#6E6E73]">
      The co-founders and seasonal contributors building the TF Unions ecosystem.
    </p>
  </section>

  <!-- Founders Tiles -->
  <section class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-[#F5F5F7] rounded-[20px] p-7 flex flex-col justify-between min-h-[190px]">
      <div>
        <div class="text-[13px] text-[#6E6E73]">Co-Founder</div>
        <h2 class="mt-1 text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Mohammed Farag</h2>
        <p class="mt-2 text-[15px] leading-[1.45] text-[#6E6E73]">
          Founder &amp; Principal Systems Architect
        </p>
      </div>
      <div class="mt-6 flex items-center justify-between text-[13px]">
        <span class="text-[#6E6E73]">Founding Cohort</span>
        <a href="https://github.com/Mohammed-Farag-AbuZaid" target="_blank" rel="noreferrer" class="text-[#002583] font-semibold hover:underline">
          GitHub ›
        </a>
      </div>
    </div>

    <div class="bg-[#F5F5F7] rounded-[20px] p-7 flex flex-col justify-between min-h-[190px]">
      <div>
        <div class="text-[13px] text-[#6E6E73]">Co-Founder</div>
        <h2 class="mt-1 text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Mohammed Abdelghany</h2>
        <p class="mt-2 text-[15px] leading-[1.45] text-[#6E6E73]">
          Co-Founder &amp; Head of Ecosystem Operations
        </p>
      </div>
      <div class="mt-6 flex items-center justify-between text-[13px]">
        <span class="text-[#6E6E73]">Founding Cohort</span>
        <a href="https://www.linkedin.com/company/tfunions" target="_blank" rel="noreferrer" class="text-[#002583] font-semibold hover:underline">
          LinkedIn ›
        </a>
      </div>
    </div>
  </section>

  <!-- Live Directory from Baserow -->
  <section class="mt-16">
    <div class="flex items-center justify-between">
      <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">Directory</h2>
      <a href="/volunteer" class="text-[14px] font-semibold text-[#002583] hover:underline">Apply to join ›</a>
    </div>
    <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70" id="team-directory-rows">
      <div class="py-4 flex items-center justify-between">
        <div>
          <div class="text-[12px] text-[#6E6E73]">Founders</div>
          <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Mohammed Farag</div>
        </div>
        <span class="text-[13px] text-[#6E6E73]">Founder &amp; Principal Systems Architect</span>
      </div>
      <div class="py-4 flex items-center justify-between">
        <div>
          <div class="text-[12px] text-[#6E6E73]">Founders</div>
          <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Mohammed Abdelghany</div>
        </div>
        <span class="text-[13px] text-[#6E6E73]">Co-Founder &amp; Head of Ecosystem Operations</span>
      </div>
    </div>
  </section>

  <script is:inline>
    (async () => {
      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/team-directory');
        const data = await res.json();
        const members = (data.members || []).filter((m) => m.display_name);
        if (members.length > 0) {
          const box = document.getElementById('team-directory-rows');
          box.innerHTML = members
            .map(
              (m) => `
              <div class="py-4 flex items-center justify-between">
                <div>
                  <div class="text-[12px] text-[#6E6E73]">${m.season_badge || 'Founding Cohort'}</div>
                  <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">${m.display_name}</div>
                </div>
                <span class="text-[13px] text-[#6E6E73]">${m.role_title || 'Contributor'}</span>
              </div>
            `
            )
            .join('');
        }
      } catch {}
    })();
  </script>
</BaseLayout>
