            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Cohort Year</label>
              <input id="crf-cohort" type="text" value="2026" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
