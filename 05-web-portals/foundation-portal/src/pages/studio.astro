    function loadTab(id) {
      if (id === 'team') loadTeamPanel();
      else if (id === 'ledger') loadLedgerPanel();
      else if (id === 'chapters') loadChaptersPanel();
      else if (id === 'guides') loadGuidesPanel();
      else if (id === 'certificates') loadCertificatesPanel();
      else if (id === 'opportunities') loadOpportunitiesPanel();
      else if (id === 'access') loadAccessPanel();
      else if (id === 'audit') loadAuditPanel();
