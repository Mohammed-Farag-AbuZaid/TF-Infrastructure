---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Redirecting to TF Dashboard" backLabel="Home" backHref="/" noindex={true}>
  <meta slot="head" http-equiv="refresh" content="0;url=https://dashboard.tfunions.com/" />
  <section class="pt-16 pb-16 max-w-[520px] mx-auto text-center">
    <h1 class="font-display text-[28px] font-bold text-[#161A22]">Moved to TF Dashboard</h1>
    <p class="mt-2.5 text-[14.5px] text-[#525866]">
      Team editing, website copy management, tasks, time tracking, and content tools now live inside the unified TF Dashboard.
    </p>
    <a
      href="https://dashboard.tfunions.com/"
      class="mt-6 h-10 px-5 inline-flex items-center rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[14px] font-medium transition"
    >
      Open TF Dashboard →
    </a>
  </section>
  <script is:inline>
    window.location.replace('https://dashboard.tfunions.com/');
  </script>
</BaseLayout>
