---
import BaseLayout from '../layouts/BaseLayout.astro';
import teamData from '../data/team-nodes.json';
import { toPublicMember } from './team.json';

const baselineMembers = (teamData as Parameters<typeof toPublicMember>[0][]).map(toPublicMember);
---
<BaseLayout title="TF Studio" backLabel="TF Unions" backHref="/">
  <!-- Clean Header -->
  <section class="pt-8 sm:pt-12 pb-6 border-b border-[#DFDDD6] flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1
        class="font-display font-bold text-[#161A22] leading-[1.08] tracking-[-0.03em]"
        style="font-size: clamp(28px, 3.8vw, 42px);"
      >
        TF Studio
      </h1>
      <p class="mt-2 text-[15px] text-[#525866]">
        Role-based website publishing workspace for TF Unions owners and division leads.
      </p>
    </div>

    <div id="studio-user-bar" class="hidden flex-wrap items-center gap-3">
      <span id="studio-role-badge" class="font-code px-2.5 py-1 rounded-md bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58] text-[12px] font-medium"></span>
      <span id="studio-user-email" class="text-[13px] text-[#525866]"></span>
      <button
        id="studio-signout-btn"
        type="button"
        class="h-9 px-3.5 rounded-lg bg-white border border-[#DFDDD6] hover:border-[#1B365D] text-[13px] font-medium text-[#161A22] transition"
      >
        Sign out
      </button>
    </div>
  </section>

  <!-- Loading Gate -->
  <section id="gate-loading" class="py-16 text-center text-[14px] text-[#525866]">
    Checking Firebase Passport &amp; staff permissions...
  </section>

  <!-- Signed-Out Auth Gate -->
  <section id="gate-signin" class="hidden py-10 max-w-[460px] mx-auto">
    <div class="bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-8 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <h2 class="font-display font-bold text-[22px] text-[#161A22]">Sign in to TF Studio</h2>
      <p class="mt-1.5 text-[14px] text-[#525866]">
        Sign in with the Google account or verified email assigned to your TF Unions role.
      </p>

      <div id="auth-error-box" class="hidden mt-4 p-3 rounded-lg bg-[#FEF3F2] border border-[#FECDCA] text-[13px] text-[#B42318]"></div>

      <button
        id="btn-google-signin"
        type="button"
        class="mt-6 w-full h-11 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[14px] font-medium transition flex items-center justify-center gap-2.5"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#FFFFFF" d="M21.35 11.1h-9.17v2.98h5.27c-.23 1.4-1.66 4.1-5.27 4.1-3.17 0-5.76-2.62-5.76-5.85s2.59-5.85 5.76-5.85c1.81 0 3.02.77 3.71 1.43l2.53-2.44C16.81 3.98 14.7 3.1 12.18 3.1 7.09 3.1 2.98 7.21 2.98 12.3s4.11 9.2 9.2 9.2c5.31 0 8.83-3.73 8.83-8.98 0-.6-.06-1.06-.16-1.42Z"/>
        </svg>
        <span>Continue with Google</span>
      </button>

      <div class="my-5 flex items-center gap-3 text-[12px] text-[#767D8C]">
        <div class="flex-1 h-px bg-[#DFDDD6]"></div>
        <span>or email &amp; password</span>
        <div class="flex-1 h-px bg-[#DFDDD6]"></div>
      </div>

      <form id="email-signin-form" class="space-y-3.5">
        <div>
          <label for="signin-email" class="block text-[12.5px] font-medium text-[#161A22] mb-1">Email</label>
          <input id="signin-email" type="email" required autocomplete="email" class="w-full h-10 px-3 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] focus:bg-white focus:border-[#1B365D] focus:outline-none text-[14px]" />
        </div>
        <div>
          <label for="signin-password" class="block text-[12.5px] font-medium text-[#161A22] mb-1">Password</label>
          <input id="signin-password" type="password" required autocomplete="current-password" class="w-full h-10 px-3 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] focus:bg-white focus:border-[#1B365D] focus:outline-none text-[14px]" />
        </div>
        <button type="submit" class="w-full h-10 rounded-lg bg-[#EAE8E1] hover:bg-[#DFDDD6] border border-[#DCD9D0] text-[#161A22] text-[13.5px] font-medium transition">
          Sign in with password
        </button>
      </form>
    </div>
  </section>

  <!-- Unverified Email Notice -->
  <section id="gate-unverified" class="hidden py-10 max-w-[520px] mx-auto">
    <div class="bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-8 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <h2 class="font-display font-bold text-[22px] text-[#161A22]">Verify your email address</h2>
      <p class="mt-2 text-[14px] text-[#525866] leading-relaxed">
        You are signed in as <strong id="unverified-email" class="text-[#161A22]"></strong>, but role permissions require a verified email before Firestore allows edits.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <button id="btn-send-verify" type="button" class="h-10 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13.5px] font-medium transition">
          Send verification email
        </button>
        <button id="btn-refresh-verify" type="button" class="h-10 px-4 rounded-lg bg-white border border-[#DFDDD6] hover:border-[#1B365D] text-[#161A22] text-[13.5px] font-medium transition">
          I've verified — refresh
        </button>
        <button id="btn-unverified-signout" type="button" class="h-10 px-4 rounded-lg text-[13px] font-medium text-[#525866] hover:text-[#161A22]">
          Sign out
        </button>
      </div>
      <p id="verify-status-msg" class="hidden mt-3 text-[13px] text-[#0B5F58]"></p>
    </div>
  </section>

  <!-- Unauthorized Account Gate -->
  <section id="gate-denied" class="hidden py-10 max-w-[540px] mx-auto">
    <div class="bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-8 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <h2 class="font-display font-bold text-[22px] text-[#161A22]">No editor permissions assigned</h2>
      <p class="mt-2 text-[14.5px] text-[#525866] leading-relaxed">
        Signed in as <strong id="denied-email" class="text-[#161A22]"></strong>. Ask the TF Unions Owner to grant your email a role and section permissions under <strong>Access &amp; Roles</strong> inside TF Studio.
      </p>
      <div class="mt-5">
        <button id="btn-denied-signout" type="button" class="h-10 px-4 rounded-lg bg-[#1B365D] text-white text-[13.5px] font-medium transition">
          Sign out &amp; switch account
        </button>
      </div>
    </div>
  </section>

  <!-- Main Authorized Role-Based Studio -->
  <section id="studio-workspace" class="hidden pt-6 pb-12">
    <!-- Active Permissions Summary -->
    <div class="bg-white border border-[#DFDDD6] rounded-xl p-4 sm:p-5 flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="text-[12px] font-medium text-[#767D8C]">Active permissions</div>
        <div id="studio-perm-pills" class="mt-1.5 flex flex-wrap gap-1.5"></div>
      </div>
      <div id="studio-toast" class="hidden font-code text-[12.5px] px-3 py-1.5 rounded-lg bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58]"></div>
    </div>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-6 items-start">
      <!-- Permission-Filtered Section Navigation -->
      <nav id="studio-tabs" class="bg-white border border-[#DFDDD6] rounded-xl p-2 flex lg:flex-col gap-1 overflow-x-auto" aria-label="Studio workspace sections"></nav>

      <!-- Active Editor Panel -->
      <div class="bg-white border border-[#DFDDD6] rounded-xl p-5 sm:p-7 shadow-[0_1px_2px_rgba(22,26,34,0.04)] min-w-0">
        <!-- 1. TEAM EDITOR -->
        <div id="panel-team" class="studio-panel hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#DFDDD6]">
            <div>
              <h2 class="font-display font-bold text-[22px] text-[#161A22]">Team &amp; Cohort Editor</h2>
              <p class="text-[13.5px] text-[#525866] mt-0.5">Edits go live immediately on <a href="/team" class="text-[#1B365D] underline">/team</a> and <a href="/roster" class="text-[#1B365D] underline">/roster</a>. Private emails &amp; phones are never stored publicly.</p>
            </div>
            <button id="team-new-btn" type="button" class="h-9 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition">+ New member</button>
          </div>

          <div class="mt-5 grid grid-cols-1 xl:grid-cols-[1fr_380px] gap-6 items-start">
            <div>
              <input id="team-studio-search" type="search" placeholder="Filter 71+ members by name, team, school..." class="w-full h-9 px-3 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] text-[13px] focus:bg-white focus:border-[#1B365D] focus:outline-none" />
              <div id="team-studio-list" class="mt-3 divide-y divide-[#EAE8E1] max-h-[540px] overflow-y-auto border border-[#DFDDD6] rounded-lg"></div>
            </div>

            <form id="team-form" class="p-4 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] space-y-3">
              <div class="flex items-center justify-between">
                <h3 id="team-form-title" class="font-display font-semibold text-[16px] text-[#161A22]">Add / edit member</h3>
                <button id="team-reset-btn" type="button" class="text-[12px] text-[#525866] hover:text-[#161A22]">Clear</button>
              </div>
              <input id="tf-id" type="hidden" />
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Full name *</label>
                  <input id="tf-name" type="text" required minlength="2" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
                </div>
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Arabic name</label>
                  <input id="tf-arabic" type="text" dir="rtl" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Role *</label>
                  <input id="tf-role" type="text" required placeholder="e.g. Vice Head" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
                </div>
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Division *</label>
                  <select id="tf-team" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]">
                    <option value="Founders">Founders</option>
                    <option value="HR Team">HR Team</option>
                    <option value="PR Team">PR Team</option>
                    <option value="Marketing Team">Marketing Team</option>
                    <option value="Social Media Team">Social Media Team</option>
                  </select>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Leadership tier</label>
                  <select id="tf-tier" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]">
                    <option value="0">0 · Founder</option>
                    <option value="1">1 · Head</option>
                    <option value="2">2 · Vice Head</option>
                    <option value="3">3 · Coordinator / Panel</option>
                    <option value="4" selected>4 · Contributor</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Joined cohort</label>
                  <select id="tf-cohort" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]">
                    <option value="2025-10|Oct 2025">Oct 2025</option>
                    <option value="2026-01|Jan 2026">Jan 2026</option>
                    <option value="2026-04|Apr 2026">Apr 2026</option>
                    <option value="2026-07|Jul 2026">Jul 2026</option>
                    <option value="2026-11|Nov 2026" selected>Nov 2026</option>
                  </select>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">School / University</label>
                  <input id="tf-school" type="text" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
                </div>
                <div>
                  <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Grade / Cohort label</label>
                  <input id="tf-grade" type="text" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
                </div>
              </div>
              <div>
                <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Reports to (parent ID)</label>
                <input id="tf-parent" type="text" placeholder="founder-1" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px] font-code" />
              </div>
              <div>
                <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Bio</label>
                <textarea id="tf-bio" rows="3" class="w-full p-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]"></textarea>
              </div>
              <label class="flex items-center gap-2 text-[12.5px] text-[#525866]">
                <input id="tf-archived" type="checkbox" class="rounded border-[#DCD9D0]" />
                <span>Hide from public constellation &amp; roster</span>
              </label>
              <button type="submit" class="w-full h-9 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition">
                Save live member
              </button>
            </form>
          </div>
        </div>

        <!-- 2. LEDGER EDITOR -->
        <div id="panel-ledger" class="studio-panel hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#DFDDD6]">
            <div>
              <h2 class="font-display font-bold text-[22px] text-[#161A22]">Open Financial Ledger</h2>
              <p class="text-[13.5px] text-[#525866] mt-0.5">Manage verified EGP inflows and outflows shown live on <a href="/transparency" class="text-[#1B365D] underline">/transparency</a>.</p>
            </div>
            <button id="ledger-seed-btn" type="button" class="h-9 px-3.5 rounded-lg bg-[#EAE8E1] hover:bg-[#DFDDD6] text-[#161A22] text-[12.5px] font-medium transition">Import baseline entries</button>
          </div>

          <form id="ledger-form" class="mt-5 p-4 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] grid grid-cols-1 sm:grid-cols-6 gap-3 items-end">
            <input id="lf-id" type="hidden" />
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Date *</label>
              <input id="lf-date" type="date" required class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Contributor / Vendor *</label>
              <input id="lf-vendor" type="text" required minlength="2" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Channel *</label>
              <input id="lf-channel" type="text" required value="Infra / Ops" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Type *</label>
              <select id="lf-type" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]">
                <option value="inflow">Inflow (+)</option>
                <option value="outflow">Outflow (-)</option>
              </select>
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Amount (EGP) *</label>
              <input id="lf-amount" type="number" min="1" step="1" required class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px] font-code" />
            </div>
            <div class="sm:col-span-6 flex justify-end gap-2">
              <button id="ledger-reset-btn" type="button" class="h-9 px-3 rounded-lg text-[12.5px] text-[#525866]">Reset</button>
              <button type="submit" class="h-9 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition">Save entry</button>
            </div>
          </form>

          <div id="ledger-studio-list" class="mt-5 divide-y divide-[#EAE8E1] border border-[#DFDDD6] rounded-lg"></div>
        </div>

        <!-- 3. CHAPTERS EDITOR -->
        <div id="panel-chapters" class="studio-panel hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#DFDDD6]">
            <div>
              <h2 class="font-display font-bold text-[22px] text-[#161A22]">Governorate Chapters &amp; Guilds</h2>
              <p class="text-[13.5px] text-[#525866] mt-0.5">Publish chapters live to <a href="https://connect.tfunions.com" class="text-[#1B365D] underline">connect.tfunions.com</a>.</p>
            </div>
          </div>

          <form id="chapter-form" class="mt-5 p-4 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
            <input id="cf-id" type="hidden" />
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Serial (e.g. CH-28)</label>
              <input id="cf-serial" type="text" required value="CH-28" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px] font-code" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Chapter / Guild Name *</label>
              <input id="cf-name" type="text" required minlength="2" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Type *</label>
              <select id="cf-type" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]">
                <option value="School Chapter">School Chapter</option>
                <option value="Project Guild">Project Guild</option>
                <option value="Research Lab">Research Lab</option>
              </select>
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Governorate *</label>
              <input id="cf-gov" type="text" required placeholder="Cairo" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Focus</label>
              <input id="cf-focus" type="text" placeholder="Physics &amp; Olympiad" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div class="sm:col-span-3">
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Description *</label>
              <input id="cf-desc" type="text" required class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div class="sm:col-span-4 flex justify-end gap-2">
              <button id="chapter-reset-btn" type="button" class="h-9 px-3 rounded-lg text-[12.5px] text-[#525866]">Reset</button>
              <button type="submit" class="h-9 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition">Save chapter</button>
            </div>
          </form>

          <div id="chapter-studio-list" class="mt-5 divide-y divide-[#EAE8E1] border border-[#DFDDD6] rounded-lg"></div>
        </div>

        <!-- 4. GUIDES EDITOR -->
        <div id="panel-guides" class="studio-panel hidden">
          <div class="pb-4 border-b border-[#DFDDD6]">
            <h2 class="font-display font-bold text-[22px] text-[#161A22]">Research &amp; Olympiad Guides</h2>
            <p class="text-[13.5px] text-[#525866] mt-0.5">Publish new guides or announcements live to <a href="https://guides.tfunions.com" class="text-[#1B365D] underline">guides.tfunions.com</a>.</p>
          </div>

          <form id="guide-form" class="mt-5 p-4 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
            <input id="gf-id" type="hidden" />
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Serial (e.g. GD-07)</label>
              <input id="gf-serial" type="text" required value="GD-07" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px] font-code" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Title *</label>
              <input id="gf-title" type="text" required minlength="2" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Category *</label>
              <select id="gf-category" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]">
                <option value="Research & ISEF">Research &amp; ISEF</option>
                <option value="Olympiads">Olympiads</option>
                <option value="Global Admissions">Global Admissions</option>
                <option value="Engineering">Engineering</option>
              </select>
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Duration / Level</label>
              <input id="gf-level" type="text" value="6 Weeks" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Summary *</label>
