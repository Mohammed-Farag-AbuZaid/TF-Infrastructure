    // ---- AUTH HANDLERS ----
    document.getElementById('btn-google-signin').addEventListener('click', async () => {
      authErrBox.classList.add('hidden');
      try {
        await signInWithPopup(auth, googleProvider);
      } catch (err) {
        authErrBox.textContent = err?.message || 'Google sign-in failed.';
        authErrBox.classList.remove('hidden');
      }
    });

    document.getElementById('email-signin-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      authErrBox.classList.add('hidden');
      try {
        await signInWithEmailAndPassword(
          auth,
          document.getElementById('signin-email').value.trim(),
          document.getElementById('signin-password').value,
        );
      } catch (err) {
        authErrBox.textContent = err?.message || 'Invalid email or password.';
        authErrBox.classList.remove('hidden');
      }
    });

    document.getElementById('btn-send-verify').addEventListener('click', async () => {
      if (!auth.currentUser) return;
      await sendEmailVerification(auth.currentUser);
      const msg = document.getElementById('verify-status-msg');
      msg.textContent = 'Verification link sent. Open your inbox, then click Refresh.';
      msg.classList.remove('hidden');
    });

    document.getElementById('btn-refresh-verify').addEventListener('click', async () => {
      if (!auth.currentUser) return;
      await auth.currentUser.reload();
      resolveUserSession(auth.currentUser);
    });

    async function doSignOut() {
      await signOut(auth);
      userBar.classList.add('hidden');
      userBar.classList.remove('flex');
    }

    ['studio-signout-btn', 'btn-unverified-signout', 'btn-denied-signout'].forEach((id) => {
      document.getElementById(id).addEventListener('click', doSignOut);
    });

    async function resolveUserSession(user) {
      currentUser = user;
      if (!user) {
        userBar.classList.add('hidden');
        showOnlyGate(gateSignin);
        return;
      }

      if (!user.email || !user.emailVerified) {
        document.getElementById('unverified-email').textContent = user.email || '(no email)';
        showOnlyGate(gateUnverified);
        return;
      }

      const email = user.email.toLowerCase();
      activeRole = 'none';
      activePerms = new Set();

      const applyStaffData = (d) => {
        if (!d || d.active !== true) return;
        activeRole = d.role || 'staff';
        const list = ['owner', 'admin', 'founder'].includes(activeRole)
          ? ALL_PERMS.map((p) => p.key)
          : Array.isArray(d.permissions) ? d.permissions : [];
        activePerms = new Set(list);
      };

      try {
        const staffRef = doc(db, 'staffAccess', email);
        const staffSnap = await getDoc(staffRef);
        if (staffSnap.exists()) {
          applyStaffData(staffSnap.data());
        } else {
          // Server-enforced bootstrap: succeeds only if email is authorized in firestore.rules
          const bootPayload = {
            email,
            displayName: user.displayName || 'Foundation Owner',
            role: 'owner',
            permissions: ALL_PERMS.map((p) => p.key),
            active: true,
            updatedAt: new Date().toISOString(),
          };
          await setDoc(staffRef, bootPayload);
          applyStaffData(bootPayload);
        }
      } catch (_) {}

      if (activePerms.size === 0) {
        document.getElementById('denied-email').textContent = email;
        showOnlyGate(gateDenied);
        return;
      }

      showOnlyGate(workspace);
      renderWorkspaceChrome();
      if (currentTab) loadTab(currentTab);
    }

    onAuthStateChanged(auth, resolveUserSession);
  </script>
</BaseLayout>
