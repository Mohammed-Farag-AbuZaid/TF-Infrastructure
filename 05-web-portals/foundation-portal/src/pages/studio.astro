            <p class="text-[13.5px] text-[#525866] mt-0.5">Issue or revoke verifiable credential records checked at <a href="https://verify.tfunions.com" class="text-[#1B365D] underline">verify.tfunions.com</a>.</p>
          </div>

          <form id="cert-form" class="mt-5 p-4 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Serial *</label>
              <input id="crf-serial" type="text" required placeholder="TFU-2026-000142" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px] font-code uppercase" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Recipient Full Name *</label>
              <input id="crf-recipient" type="text" required class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
            </div>
            <div>
              <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Credential Role *</label>
              <input id="crf-role" type="text" required placeholder="Research Mentor" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
