          <div id="access-list" class="mt-5 divide-y divide-[#EAE8E1] border border-[#DFDDD6] rounded-lg"></div>
        </div>

        <!-- 8. AUDIT LOG -->
        <div id="panel-audit" class="studio-panel hidden">
          <div class="pb-4 border-b border-[#DFDDD6]">
            <h2 class="font-display font-bold text-[22px] text-[#161A22]">Immutable Audit Trail</h2>
            <p class="text-[13.5px] text-[#525866] mt-0.5">Every write made through TF Studio is logged automatically with actor email and timestamp.</p>
          </div>
          <div id="audit-list" class="mt-5 divide-y divide-[#EAE8E1] border border-[#DFDDD6] rounded-lg"></div>
        </div>
      </div>
    </div>
  </section>

  <script type="module" define:vars={{ baselineMembers }}>
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js';
    import {
      getAuth,
      GoogleAuthProvider,
      signInWithPopup,
      signInWithEmailAndPassword,
      sendEmailVerification,
      signOut,
      onAuthStateChanged,
    } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js';
    import {
      getFirestore,
      collection,
      doc,
      getDoc,
      getDocs,
      setDoc,
      addDoc,
      deleteDoc,
      query,
      orderBy,
      limit,
      serverTimestamp,
    } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js';

    const firebaseConfig = {
      apiKey: 'AIzaSyB0bILaWHg8QXuwl3Fhfht3BQnYLgTkWUk',
      authDomain: 'tf-unions.firebaseapp.com',
      projectId: 'tf-unions',
      storageBucket: 'tf-unions.firebasestorage.app',
      messagingSenderId: '879703010053',
      appId: '1:879703010053:web:1fe4e4476ab1680a67a56c',
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);
    const googleProvider = new GoogleAuthProvider();
    googleProvider.setCustomParameters({ prompt: 'select_account' });

    const ALL_PERMS = [
      { key: 'edit_team', label: 'Edit Team & Roster' },
      { key: 'edit_ledger', label: 'Edit Open Ledger' },
      { key: 'edit_chapters', label: 'Edit Connect Chapters' },
      { key: 'edit_guides', label: 'Edit Guides Workbooks' },
      { key: 'edit_opportunities', label: 'Edit News Opportunities' },
      { key: 'manage_certificates', label: 'Issue & Revoke Certificates' },
      { key: 'moderate_submissions', label: 'Moderate Submissions' },
      { key: 'manage_access', label: 'Manage Roles & Audit Log' },
    ];

    const ROLE_PRESETS = {
      owner: ALL_PERMS.map((p) => p.key),
      admin: ALL_PERMS.map((p) => p.key),
      hr_lead: ['edit_team', 'moderate_submissions'],
      finance_lead: ['edit_ledger'],
      chapters_lead: ['edit_chapters'],
      guides_lead: ['edit_guides'],
      news_editor: ['edit_opportunities'],
      registrar: ['manage_certificates'],
    };

    const SECTIONS = [
      { id: 'team', label: 'Team & Roster', perm: 'edit_team' },
      { id: 'ledger', label: 'Open Ledger', perm: 'edit_ledger' },
      { id: 'chapters', label: 'Connect Chapters', perm: 'edit_chapters' },
      { id: 'guides', label: 'Guides', perm: 'edit_guides' },
      { id: 'certificates', label: 'Certificates', perm: 'manage_certificates' },
      { id: 'opportunities', label: 'Opportunities', perm: 'edit_opportunities' },
      { id: 'access', label: 'Access & Roles', perm: 'manage_access' },
      { id: 'audit', label: 'Audit Trail', perm: 'manage_access' },
    ];

    let currentUser = null;
    let activeRole = 'viewer';
    let activePerms = new Set();
    let currentTab = null;

    const gateLoading = document.getElementById('gate-loading');
    const gateSignin = document.getElementById('gate-signin');
    const gateUnverified = document.getElementById('gate-unverified');
    const gateDenied = document.getElementById('gate-denied');
    const workspace = document.getElementById('studio-workspace');
    const userBar = document.getElementById('studio-user-bar');
    const authErrBox = document.getElementById('auth-error-box');

    function esc(s) {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function showToast(msg) {
      const el = document.getElementById('studio-toast');
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => el.classList.add('hidden'), 3200);
    }

    function showOnlyGate(which) {
      [gateLoading, gateSignin, gateUnverified, gateDenied, workspace].forEach((el) => el.classList.add('hidden'));
      which.classList.remove('hidden');
    }

    async function writeAudit(section, action, targetId, summary) {
      if (!currentUser) return;
      try {
        await addDoc(collection(db, 'auditLogs'), {
          actorUid: currentUser.uid,
          actorEmail: (currentUser.email || '').toLowerCase(),
          section,
          action,
          targetId: String(targetId || ''),
          summary: String(summary || '').slice(0, 220),
          createdAt: serverTimestamp(),
          createdIso: new Date().toISOString(),
        });
      } catch (err) {
        console.warn('Audit log skipped:', err?.message);
      }
    }

    function hasPerm(perm) {
      return activePerms.has('manage_access') && ['owner', 'admin', 'founder'].includes(activeRole)
        ? true
        : activePerms.has(perm);
    }

    function renderWorkspaceChrome() {
      document.getElementById('studio-role-badge').textContent = activeRole.toUpperCase();
      document.getElementById('studio-user-email').textContent = currentUser?.email || '';
      userBar.classList.remove('hidden');
      userBar.classList.add('flex');

      const permPills = document.getElementById('studio-perm-pills');
      permPills.replaceChildren();
      ALL_PERMS.forEach((p) => {
        if (!hasPerm(p.key)) return;
        const span = document.createElement('span');
        span.className = 'px-2.5 py-0.5 rounded bg-[#EAE8E1] border border-[#DCD9D0] text-[12px] font-medium text-[#161A22]';
        span.textContent = p.label;
        permPills.appendChild(span);
      });

      const visibleSections = SECTIONS.filter((s) => hasPerm(s.perm));
      const tabsEl = document.getElementById('studio-tabs');
      tabsEl.replaceChildren();

      if (!visibleSections.some((s) => s.id === currentTab)) {
        currentTab = visibleSections[0]?.id || null;
      }

      visibleSections.forEach((s) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isSel = s.id === currentTab;
        btn.className =
          'px-3 py-2 rounded-lg text-[13px] font-medium text-left whitespace-nowrap transition ' +
          (isSel ? 'bg-[#1B365D] text-white' : 'text-[#525866] hover:text-[#161A22] hover:bg-[#F3F2EE]');
        btn.textContent = s.label;
        btn.addEventListener('click', () => {
          currentTab = s.id;
          renderWorkspaceChrome();
          loadTab(s.id);
        });
        tabsEl.appendChild(btn);
      });

      document.querySelectorAll('.studio-panel').forEach((p) => p.classList.add('hidden'));
      if (currentTab) {
        document.getElementById('panel-' + currentTab)?.classList.remove('hidden');
      }
    }

    // ---- TEAM EDITOR ----
    let mergedTeam = [];
    async function loadTeamPanel() {
      const byId = new Map(baselineMembers.map((m) => [m.id, { ...m }]));
      const snap = await getDocs(collection(db, 'teamMembers'));
      snap.forEach((d) => {
        const data = d.data();
        const prev = byId.get(d.id) || {};
        byId.set(d.id, { ...prev, ...data, id: d.id, _live: true });
      });
      mergedTeam = Array.from(byId.values()).sort((a, b) => (a.tier ?? 4) - (b.tier ?? 4) || a.name.localeCompare(b.name));
      renderTeamList();
    }

    function renderTeamList() {
      const q = (document.getElementById('team-studio-search').value || '').toLowerCase().trim();
      const filtered = mergedTeam.filter((m) => {
        if (!q) return true;
        return [m.name, m.arabicName, m.role, m.team, m.school].filter(Boolean).join(' ').toLowerCase().includes(q);
      });
      const list = document.getElementById('team-studio-list');
      list.replaceChildren();
      if (filtered.length === 0) {
        list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No matching members.</div>';
        return;
      }
      filtered.forEach((m) => {
        const row = document.createElement('div');
        row.className = 'p-3 flex items-center justify-between gap-3 hover:bg-[#FAF9F6]';
        row.innerHTML = `
          <div class="min-w-0">
            <div class="text-[13.5px] font-semibold text-[#161A22] truncate">${esc(m.name)} ${m.archived ? '<span class="text-[#B42318] font-normal">(hidden)</span>' : ''} ${m._live ? '<span class="font-code text-[10.5px] text-[#0B5F58]">live</span>' : ''}</div>
            <div class="text-[12px] text-[#525866] truncate">${esc(m.role)} · ${esc(m.team)}</div>
          </div>
          <button type="button" class="shrink-0 h-8 px-3 rounded border border-[#DFDDD6] hover:border-[#1B365D] text-[12px] font-medium text-[#161A22]">Edit</button>
        `;
        row.querySelector('button').addEventListener('click', () => fillTeamForm(m));
        list.appendChild(row);
      });
    }

    function fillTeamForm(m) {
      document.getElementById('team-form-title').textContent = m ? `Edit: ${m.name}` : 'Add new member';
      document.getElementById('tf-id').value = m?.id || '';
      document.getElementById('tf-name').value = m?.name || '';
      document.getElementById('tf-arabic').value = m?.arabicName || '';
      document.getElementById('tf-role').value = m?.role || '';
      document.getElementById('tf-team').value = m?.team || 'HR Team';
      document.getElementById('tf-tier').value = String(m?.tier ?? 4);
      document.getElementById('tf-cohort').value = `${m?.cohortDate || '2026-11'}|${m?.cohortLabel || 'Nov 2026'}`;
      document.getElementById('tf-school').value = m?.school || '';
      document.getElementById('tf-grade').value = m?.grade || '';
      document.getElementById('tf-parent').value = m?.parent || 'founder-1';
      document.getElementById('tf-bio').value = m?.bio || '';
      document.getElementById('tf-archived').checked = Boolean(m?.archived);
    }

    document.getElementById('team-studio-search').addEventListener('input', renderTeamList);
    document.getElementById('team-new-btn').addEventListener('click', () => fillTeamForm(null));
    document.getElementById('team-reset-btn').addEventListener('click', () => fillTeamForm(null));
    document.getElementById('team-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const rawId = document.getElementById('tf-id').value.trim();
      const id = rawId || 'm-' + Date.now();
      const [cohortDate, cohortLabel] = document.getElementById('tf-cohort').value.split('|');
      const payload = {
        id,
        name: document.getElementById('tf-name').value.trim(),
        arabicName: document.getElementById('tf-arabic').value.trim(),
        role: document.getElementById('tf-role').value.trim(),
        team: document.getElementById('tf-team').value,
        tier: Number(document.getElementById('tf-tier').value),
        school: document.getElementById('tf-school').value.trim() || 'TF Unions',
        grade: document.getElementById('tf-grade').value.trim(),
        cohortDate,
        cohortLabel,
        parent: document.getElementById('tf-parent').value.trim() || null,
        bio: document.getElementById('tf-bio').value.trim(),
        archived: document.getElementById('tf-archived').checked,
        x: 500,
        y: 380,
        r: 12,
        updatedAt: new Date().toISOString(),
      };
      await setDoc(doc(db, 'teamMembers', id), payload, { merge: true });
      await writeAudit('team', rawId ? 'update' : 'create', id, `${payload.name} (${payload.team})`);
      showToast(`Saved ${payload.name} live`);
      await loadTeamPanel();
    });

    // ---- LEDGER EDITOR ----
    async function loadLedgerPanel() {
      const snap = await getDocs(collection(db, 'ledgerEntries'));
      const items = [];
      snap.forEach((d) => items.push({ id: d.id, ...d.data() }));
      items.sort((a, b) => String(b.txDate || '').localeCompare(String(a.txDate || '')));
      const list = document.getElementById('ledger-studio-list');
      list.replaceChildren();
      if (items.length === 0) {
        list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No live ledger entries yet. Click "Import baseline entries" or add one above.</div>';
        return;
      }
      items.forEach((item) => {
        const row = document.createElement('div');
        row.className = 'p-3.5 flex flex-wrap items-center justify-between gap-3';
        const sign = item.entryType === 'outflow' ? '-' : '+';
        row.innerHTML = `
          <div>
            <div class="text-[13.5px] font-semibold text-[#161A22]">${esc(item.donorOrVendor)}</div>
            <div class="font-code text-[12px] text-[#525866]">${esc(item.txDate)} · ${esc(item.paymentChannel)} · ${sign}${Number(item.amountEgp).toLocaleString('en-US')} EGP</div>
          </div>
          <div class="flex gap-2">
            <button type="button" class="edit-btn h-8 px-3 rounded border border-[#DFDDD6] text-[12px] font-medium">Edit</button>
            <button type="button" class="del-btn h-8 px-3 rounded border border-[#FECDCA] text-[#B42318] text-[12px] font-medium">Delete</button>
          </div>
        `;
        row.querySelector('.edit-btn').addEventListener('click', () => {
          document.getElementById('lf-id').value = item.id;
          document.getElementById('lf-date').value = item.txDate;
          document.getElementById('lf-vendor').value = item.donorOrVendor;
          document.getElementById('lf-channel').value = item.paymentChannel;
          document.getElementById('lf-type').value = item.entryType;
          document.getElementById('lf-amount').value = item.amountEgp;
        });
        row.querySelector('.del-btn').addEventListener('click', async () => {
