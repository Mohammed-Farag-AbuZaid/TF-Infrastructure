            <p class="text-[13.5px] text-[#525866] mt-0.5">Grant each teammate exact permissions. Enforced directly inside Firebase Firestore rules.</p>
          </div>

          <form id="access-form" class="mt-5 p-4 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Member Google / Auth Email *</label>
                <input id="af-email" type="email" required placeholder="member@gmail.com" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
              </div>
              <div>
                <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Full Name</label>
                <input id="af-name" type="text" placeholder="Display name" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]" />
              </div>
              <div>
                <label class="block text-[11.5px] font-medium text-[#161A22] mb-1">Role Preset</label>
                <select id="af-role" class="w-full h-9 px-2.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px]">
                  <option value="hr_lead">HR Lead (Team + Moderation)</option>
                  <option value="finance_lead">Finance Lead (Open Ledger)</option>
                  <option value="chapters_lead">Chapters Lead (Connect)</option>
                  <option value="guides_lead">Guides Lead (Guides)</option>
                  <option value="news_editor">News Editor (Opportunities)</option>
                  <option value="registrar">Registrar (Certificates)</option>
                  <option value="admin">Admin (Full Access)</option>
                  <option value="owner">Owner (Full Access)</option>
                  <option value="custom">Custom Permissions</option>
                </select>
              </div>
            </div>

            <div>
              <div class="text-[12px] font-medium text-[#161A22] mb-2">Section Permissions</div>
              <div id="af-perms-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 text-[12.5px]"></div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-[#DFDDD6]">
              <label class="inline-flex items-center gap-2 text-[13px] text-[#161A22] font-medium">
                <input id="af-active" type="checkbox" checked class="rounded border-[#DCD9D0]" />
                <span>Access enabled (uncheck to suspend immediately)</span>
              </label>
              <button type="submit" class="h-9 px-5 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition">
                Save access rule
