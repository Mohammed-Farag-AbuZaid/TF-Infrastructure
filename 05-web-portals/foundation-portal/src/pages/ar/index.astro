---
import BaseLayout from '../../layouts/BaseLayout.astro';

const destinations = [
  {
    code: '01 · المنصات والأقسام',
    title: 'أقسام الاتحاد والمنصات',
    desc: 'أخبار المنح والقبول الجامعي، أدلّة البحث العلمي والأولمبياد، فصول المحافظات، ومتجر ستيم.',
    href: '/divisions',
    cta: 'عرض الأقسام',
    icon: '/illustrations/compass.svg',
  },
  {
    code: '02 · المكتب المباشر',
    title: 'المتابعة المباشرة للاتحاد',
    desc: 'استعرض المواعيد النهائية المفتوحة، فصول المحافظات النشطة، وملخّص الخزانة المالي.',
    href: '/desk',
    cta: 'افتح المكتب',
    icon: '/illustrations/research.svg',
  },
  {
    code: '03 · الأعضاء',
    title: 'الهيكل القيادي (71 عضوًا)',
    desc: 'تتبّع تاريخ التأسيس منذ أكتوبر 2025 أو ابحث عن كل مساهم في مختلف المحافظات.',
    href: '/team',
    cta: 'استكشف الفريق',
    icon: '/illustrations/chapters.svg',
  },
  {
    code: '04 · الشفافية',
    title: 'السجل المالي والميثاق',
    desc: 'تأكّد من الإيرادات والمصروفات بالجنيه المصري، واطّلع على الميثاق غير الهادف للربح، أو أرسل أفكارًا.',
    href: '/transparency',
    cta: 'افتح السجل المالي',
    icon: '/illustrations/ledger.svg',
  },
];
---
<BaseLayout title="الرئيسية" lang="ar" altPath="/">
  <section class="pt-8 sm:pt-12 pb-6 max-w-[820px]">
    <div class="inline-flex items-center gap-2 pr-2.5 border-r-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
      اتحاد طلابي أكاديمي وعلمي مصري مستقل
    </div>

    <h1 class="font-display mt-4 font-bold text-[#161A22] leading-[1.15]" style="font-size: clamp(30px, 4.2vw, 48px);">
      حيث يبحث طلاب المتفوقين في مصر، ويبنون، ويصلون إلى جامعات العالم.
    </h1>

    <p class="mt-4 text-[16px] leading-[1.75] text-[#525866] max-w-[620px]">
      تأسس في أكتوبر 2025 لتمكين طلاب الثانوية والجامعات في جميع محافظات مصر الـ 27 عبر بيانات قبول جامعي موثّقة، وأدلّة بحثية للأولمبياد وISEF، وحلقات دراسة محلية، وبنية توثيق شهادات مفتوحة.
    </p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a href="https://news.tfunions.com/ar/" class="h-11 px-5 inline-flex items-center rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[14px] font-semibold transition">
        تصفّح المنح والفرص (بالعربية) ←
      </a>
      <a href="https://verify.tfunions.com" class="h-11 px-5 inline-flex items-center rounded-lg bg-white border border-[#DFDDD6] hover:border-[#1B365D] text-[#161A22] text-[14px] font-medium transition">
        تحقّق من شهادة
      </a>
      <a href="/photos-submit" class="h-11 px-5 inline-flex items-center rounded-lg bg-white border border-[#DFDDD6] hover:border-[#0B5F58] text-[#0B5F58] text-[14px] font-medium transition">
        أرسل صور الأنشطة للمراجعة
      </a>
    </div>
  </section>

  <section class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
    {destinations.map((item) => (
      <a
        href={item.href}
        class="group bg-white border border-[#DFDDD6] hover:border-[#1B365D]/40 rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.03)] flex flex-col justify-between transition"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="font-code text-[12px] font-medium text-[#0B5F58]">{item.code}</div>
            <h2 class="font-display text-[20px] font-bold text-[#161A22] mt-1.5 group-hover:text-[#1B365D] transition">
              {item.title}
            </h2>
            <p class="mt-2 text-[14px] leading-[1.7] text-[#525866]">
              {item.desc}
            </p>
          </div>
          <img src={item.icon} alt="" width="44" height="44" class="shrink-0 opacity-90" />
        </div>
        <div class="mt-4 pt-3 border-t border-[#EAE8E1] text-[13px] font-semibold text-[#1B365D] flex items-center justify-between">
          <span>{item.cta}</span>
          <span>←</span>
        </div>
      </a>
    ))}
  </section>

  <section class="mt-10 bg-white border border-[#DFDDD6] rounded-xl p-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <div class="font-code text-[12px] text-[#0B5F58] font-medium">الخصوصية وحماية البيانات</div>
      <p class="mt-1 text-[14px] text-[#525866]">اطّلع على سياسة الخصوصية وجدول الاحتفاظ بالبيانات وحقوق الحذف بالكامل.</p>
    </div>
    <a href="/privacy" class="h-10 px-4 inline-flex items-center rounded-lg bg-[#EAE8E1] border border-[#DCD9D0] hover:border-[#1B365D] text-[#161A22] text-[13px] font-medium transition">
      سياسة الخصوصية والبيانات ←
    </a>
  </section>
</BaseLayout>
