---
import BaseLayout from '../../layouts/BaseLayout.astro';

const destinations = [
  {
    title: 'أقسام الاتحاد والمنصات',
    desc: 'أخبار المنح والقبول الجامعي، أدلّة البحث العلمي والأولمبياد، فصول المحافظات، ومتجر ستيم.',
    href: '/divisions',
  },
  {
    title: 'المتابعة المباشرة للاتحاد',
    desc: 'استعرض المواعيد النهائية المفتوحة، فصول المحافظات النشطة، وملخّص الخزانة المالي.',
    href: '/desk',
  },
  {
    title: 'الهيكل القيادي والأعضاء',
    desc: 'تتبّع تاريخ التأسيس منذ أكتوبر 2025 أو ابحث عن كل مساهم في مختلف المحافظات.',
    href: '/team',
  },
  {
    title: 'السجل المالي والميثاق',
    desc: 'تأكّد من الإيرادات والمصروفات بالجنيه المصري، واطّلع على الميثاق غير الهادف للربح.',
    href: '/transparency',
  },
];
---
<BaseLayout title="الرئيسية" lang="ar" altPath="/">
  <section class="pt-12 sm:pt-20 pb-10 max-w-[680px]">
    <h1
      class="font-display font-bold text-[#161A22] leading-[1.15]"
      style="font-size: clamp(30px, 4.2vw, 46px);"
    >
      اتحاد طلاب مصر للبحث العلمي والقبول الجامعي العالمي.
    </h1>

    <p class="mt-4 text-[16px] leading-[1.75] text-[#525866]">
      مستقل وبإدارة طلابية في جميع محافظات مصر الـ 27 — بيانات قبول موثّقة، وأدلّة للأولمبياد والبحث العلمي، وفصول محلية، وسجل مالي مفتوح.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a
        href="https://news.tfunions.com/ar/"
        class="h-10 px-5 inline-flex items-center rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[14px] font-medium transition"
      >
        تصفّح المنح والفرص
      </a>
      <a
        href="https://verify.tfunions.com"
        class="text-[14px] font-medium text-[#1B365D] hover:underline"
      >
        تحقّق من شهادة ←
      </a>
    </div>
  </section>

  <section class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-8">
    {destinations.map((item) => (
      <a href={item.href} class="group block border-t border-[#DFDDD6] pt-5">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-display text-[19px] font-semibold text-[#161A22] group-hover:text-[#1B365D] transition">
            {item.title}
          </h2>
          <span class="text-[#767D8C] group-hover:text-[#1B365D] transition">←</span>
        </div>
        <p class="mt-1.5 text-[14px] leading-[1.7] text-[#525866]">
          {item.desc}
        </p>
      </a>
    ))}
  </section>
</BaseLayout>
