---
import BaseLayout from '../layouts/BaseLayout.astro';
import teamData from '../data/team-nodes.json';
import { toPublicMember } from './team.json';

const publicMembers = (teamData as Parameters<typeof toPublicMember>[0][]).map(toPublicMember);
const alumniCount = publicMembers.filter((m) => Boolean(m.endDate) || m.status === 'alumni').length;
const activeCount = publicMembers.length - alumniCount;
const teamCount = new Set(publicMembers.map((m) => m.team)).size;
---
<BaseLayout title="Directory Roster" backLabel="Team Constellation" backHref="/team">
  <style is:inline>
    @keyframes tf-roster-enter {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .tf-roster-card {
      animation: tf-roster-enter 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .tf-pill-track {
      position: relative;
    }
    .tf-pill-indicator {
      position: absolute;
      top: 3px;
      bottom: 3px;
      left: 0;
      border-radius: 7px;
      transition: transform 340ms cubic-bezier(0.22, 1, 0.36, 1), width 340ms cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .tf-roster-card {
        animation: none !important;
      }
      .tf-pill-indicator {
        transition: none !important;
      }
    }
  </style>

  <section class="pt-8 sm:pt-12 pb-6 border-b border-[#DFDDD6]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <h1
          class="font-display font-bold text-[#161A22] tracking-[-0.03em] leading-[1.08]"
          style="font-size: clamp(28px, 3.8vw, 40px);"
        >
          Member directory roster.
        </h1>
        <p class="mt-2 text-[15px] text-[#525866]">
          Search or filter TF Unions across active Season 2 Core ({activeCount}) and Season 1 (2025) Alumni ({alumniCount}) in {teamCount} divisions.
        </p>
      </div>
      <a
        href="/team"
        class="text-[13.5px] font-medium text-[#1B365D] hover:underline shrink-0"
      >
        Interactive constellation →
      </a>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-1.5" id="roster-team-filters"></div>

      <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
        <div class="tf-pill-track inline-flex rounded-xl bg-[#EAE8E1] p-1 border border-[#DCD9D0]" id="roster-status-filters">
          <div id="roster-status-pill" class="tf-pill-indicator bg-white border border-[#DFDDD6] shadow-xs"></div>
          <button type="button" data-st="active" class="rst-btn relative z-10 px-2.5 py-1 rounded-lg text-[12px] font-semibold text-[#161A22] transition">Core ({activeCount})</button>
          <button type="button" data-st="alumni" class="rst-btn relative z-10 px-2.5 py-1 rounded-lg text-[12px] font-medium text-[#525866] transition">S1 Alumni ({alumniCount})</button>
          <button type="button" data-st="all" class="rst-btn relative z-10 px-2.5 py-1 rounded-lg text-[12px] font-medium text-[#525866] transition">All ({publicMembers.length})</button>
        </div>
        <input
          id="roster-search"
          type="search"
          placeholder="Search name, role, school..."
          aria-label="Search roster"
          class="w-full sm:w-60 h-9 px-3 bg-white border border-[#DFDDD6] rounded-lg text-[13px] text-[#161A22] placeholder-[#767D8C] focus:border-[#1B365D] focus:outline-none"
        />
        <span class="font-code text-[12px] font-medium text-[#0B5F58] shrink-0">
          <span id="roster-count">{publicMembers.length}</span> shown
        </span>
      </div>
    </div>
  </section>

  <section class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6" id="member-cards-container"></section>

  <script is:inline define:vars={{ initialMembers: publicMembers }}>
    (function () {
      var ALL_MEMBERS = initialMembers;
      var prefersReducedMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var TEAM_COLORS = {
        Founders: { bg: '#1B365D', badgeBg: '#E4EAF2', badgeText: '#1B365D' },
        'AI & Automation': { bg: '#0F766E', badgeBg: '#EDF7F5', badgeText: '#0B5F58' },
        'HR Team': { bg: '#334155', badgeBg: '#EAE8E1', badgeText: '#334155' },
        'Marketing Team': { bg: '#475569', badgeBg: '#F1F5F9', badgeText: '#334155' },
        'PR Team': { bg: '#0F766E', badgeBg: '#EDF7F5', badgeText: '#0B5F58' },
        'Social Media Team': { bg: '#A2570F', badgeBg: '#FEF6EB', badgeText: '#A2570F' },
        'Content Production': { bg: '#C2410C', badgeBg: '#FFF7ED', badgeText: '#9A3412' },
        'Academic Fields': { bg: '#047857', badgeBg: '#ECFDF5', badgeText: '#065F46' },
        'IT Team': { bg: '#1D4ED8', badgeBg: '#EFF6FF', badgeText: '#1E40AF' },
        'Research & Guides': { bg: '#047857', badgeBg: '#ECFDF5', badgeText: '#065F46' },
        'Chapters & Connect': { bg: '#C2410C', badgeBg: '#FFF7ED', badgeText: '#9A3412' },
        'Finance & Operations': { bg: '#334155', badgeBg: '#EAE8E1', badgeText: '#334155' },
      };

      function esc(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      function fmtMonth(ym) {
        var s = String(ym || '').trim();
        var parts = s.split('-');
        if (parts.length >= 2) {
          var m = Number(parts[1]);
          if (m >= 1 && m <= 12) {
            var d = Number(parts[2] || 0);
            var pre = d >= 13 && d <= 18 ? 'Mid ' : '';
            return pre + MONTHS[m - 1] + ' ' + parts[0];
          }
        }
        return s || 'Present';
      }

      function memberIsAlumni(m) {
        return Boolean(m.endDate) || m.status === 'alumni';
      }

      function fmtTenure(m) {
        var start = m.startDate || m.cohortDate || '2025-07-01';
        var end = m.endDate || '';
        return fmtMonth(start) + ' – ' + (end ? fmtMonth(end) : 'Present');
      }

      var selectedTeam = 'All';
      var selectedStatus = 'active';
      var searchQuery = '';
      var filtersContainer = document.getElementById('roster-team-filters');
      var statusTrackEl = document.getElementById('roster-status-filters');
      var statusPillEl = document.getElementById('roster-status-pill');
      var cardsContainer = document.getElementById('member-cards-container');
      var rosterCount = document.getElementById('roster-count');

      rosterCount.textContent = ALL_MEMBERS.filter(function (m) { return !memberIsAlumni(m); }).length;

      function positionStatusPill() {
        var activeBtn = statusTrackEl && statusTrackEl.querySelector('[data-st="' + selectedStatus + '"]');
        if (!statusTrackEl || !statusPillEl || !activeBtn) return;
        var cr = statusTrackEl.getBoundingClientRect();
        var br = activeBtn.getBoundingClientRect();
        if (cr.width === 0 || br.width === 0) return;
        statusPillEl.style.width = br.width.toFixed(1) + 'px';
        statusPillEl.style.transform = 'translateX(' + (br.left - cr.left).toFixed(1) + 'px)';
      }

      function syncStatusButtons() {
        document.querySelectorAll('#roster-status-filters .rst-btn').forEach(function (b) {
          var act = b.getAttribute('data-st') === selectedStatus;
          b.className = act
            ? 'rst-btn relative z-10 px-2.5 py-1 rounded-lg text-[12px] font-semibold text-[#161A22] transition'
            : 'rst-btn relative z-10 px-2.5 py-1 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] transition';
        });
        requestAnimationFrame(positionStatusPill);
      }

      document.querySelectorAll('#roster-status-filters .rst-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          selectedStatus = btn.getAttribute('data-st') || 'all';
          syncStatusButtons();
          renderFilterPills();
          renderRoster();
        });
      });

      window.addEventListener('resize', positionStatusPill);

      function matchesStatus(m) {
        var isAlum = memberIsAlumni(m);
        if (selectedStatus === 'active') return !isAlum;
        if (selectedStatus === 'alumni') return isAlum;
        return true;
      }

      function renderFilterPills() {
        var pool = ALL_MEMBERS.filter(matchesStatus);
        var teams = ['All'].concat([...new Set(pool.map(function (m) { return m.team; }))]);
        filtersContainer.replaceChildren();
        teams.forEach(function (teamName) {
          var count = teamName === 'All'
            ? pool.length
            : pool.filter(function (m) { return m.team === teamName; }).length;
          var btn = document.createElement('button');
          btn.type = 'button';
          var isSel = selectedTeam === teamName;
          btn.className =
            'px-3 py-1.5 rounded-lg text-[12.5px] font-medium border transition ' +
            (isSel
              ? 'bg-[#1B365D] text-white border-[#1B365D]'
              : 'bg-white text-[#525866] border-[#DFDDD6] hover:border-[#1B365D]/50 hover:text-[#161A22]');
          btn.textContent = (teamName === 'All' ? 'All teams' : teamName.replace(' Team', '')) + ' (' + count + ')';
          btn.addEventListener('click', function () {
            selectedTeam = teamName;
            renderFilterPills();
            renderRoster();
          });
          filtersContainer.appendChild(btn);
        });
      }

      function renderRoster() {
        var q = searchQuery.toLowerCase().trim();
        var filtered = ALL_MEMBERS.filter(function (m) {
          var matchSt = matchesStatus(m);
          var matchTeam = selectedTeam === 'All' || m.team === selectedTeam;
          var matchQ =
            !q ||
            m.name.toLowerCase().includes(q) ||
            (m.arabicName && m.arabicName.toLowerCase().includes(q)) ||
            m.role.toLowerCase().includes(q) ||
            (m.subTrack && m.subTrack.toLowerCase().includes(q)) ||
            (m.school && m.school.toLowerCase().includes(q));
          return matchSt && matchTeam && matchQ;
        }).slice().sort(function (a, b) {
          var aAlum = memberIsAlumni(a) ? 1 : 0;
          var bAlum = memberIsAlumni(b) ? 1 : 0;
          if (aAlum !== bAlum) return aAlum - bAlum;
          return (a.tier ?? 4) - (b.tier ?? 4) || a.team.localeCompare(b.team) || a.name.localeCompare(b.name);
        });

        rosterCount.textContent = filtered.length;
        if (filtered.length === 0) {
          cardsContainer.innerHTML =
            '<div class="sm:col-span-2 lg:col-span-3 py-12 text-center border-t border-[#DFDDD6] text-[14px] text-[#767D8C]">No contributors match your filter.</div>';
          return;
        }

        cardsContainer.innerHTML = filtered
          .map(function (m, idx) {
            var c = TEAM_COLORS[m.team] || TEAM_COLORS.Founders;
            var isAlum = memberIsAlumni(m);
            var initials = m.isAI
              ? 'AI'
              : m.name
                  .split(/\s+/)
                  .slice(0, 2)
                  .map(function (p) { return p[0] || ''; })
                  .join('')
                  .toUpperCase();
            var delayStyle = prefersReducedMotion ? '' : 'animation-delay:' + Math.min(idx * 14, 240) + 'ms;';
            return (
              '<article class="border-t border-[#DFDDD6] pt-4 flex flex-col justify-between tf-roster-card" style="' + delayStyle + '">' +
              '<div>' +
              '<div class="flex items-start justify-between gap-3">' +
              '<div class="flex items-center gap-3 min-w-0">' +
              '<div class="w-10 h-10 rounded-lg flex items-center justify-center font-semibold text-white text-[13px] shrink-0" style="background-color:' +
              c.bg +
              ';">' +
              esc(initials) +
              '</div>' +
              '<div class="min-w-0">' +
              '<h2 class="font-display font-semibold text-[16px] text-[#161A22] leading-tight truncate">' +
              esc(m.name) +
              '</h2>' +
              '<div class="text-[12.5px] font-medium text-[#525866] mt-0.5 truncate">' +
              esc(m.role) +
              '</div>' +
              '</div>' +
              '</div>' +
              '<div class="flex flex-col items-end gap-1 shrink-0">' +
              '<span class="px-2 py-0.5 rounded text-[11px] font-medium" style="background-color:' +
              c.badgeBg +
              ';color:' +
              c.badgeText +
              ';">' +
              esc((m.team || 'TF Unions').replace(' Team', '')) +
              '</span>' +
              (m.isAI
                ? '<span class="px-1.5 py-0.5 rounded bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58] text-[10px] font-code font-semibold">AI 24/7</span>'
                : isAlum
                  ? '<span class="px-1.5 py-0.5 rounded bg-[#EAE8E1] text-[#525866] text-[10px] font-code">S1 Alumni</span>'
                  : '<span class="px-1.5 py-0.5 rounded bg-[#EDF7F5] text-[#0B5F58] text-[10px] font-code">Active</span>') +
              '</div>' +
              '</div>' +
              '<p class="mt-2.5 text-[12.5px] text-[#525866] leading-relaxed line-clamp-3">' +
              esc(m.bio || m.school || 'TF Unions contributor') +
              '</p>' +
              '</div>' +
              '<div class="mt-3 pt-2.5 flex items-center justify-between gap-2 text-[12px] text-[#767D8C]">' +
              '<span class="truncate font-code text-[11px]">' +
              esc(fmtTenure(m)) +
              (m.school ? ' · ' + esc(m.school) : '') +
              '</span>' +
              '<a href="/team#member=' +
              encodeURIComponent(m.id) +
              '" class="text-[#1B365D] font-medium hover:underline shrink-0">View on map →</a>' +
              '</div>' +
              '</article>'
            );
          })
          .join('');
      }

      document.getElementById('roster-search').addEventListener('input', function (e) {
        searchQuery = e.target.value;
        renderRoster();
      });

      syncStatusButtons();
      renderFilterPills();
      renderRoster();

      function decodeFsVal(v) {
        if (!v || typeof v !== 'object') return undefined;
        if ('stringValue' in v) return v.stringValue;
        if ('booleanValue' in v) return v.booleanValue;
        if ('integerValue' in v) return Number(v.integerValue);
        if ('doubleValue' in v) return Number(v.doubleValue);
        return undefined;
      }

      Promise.all([
        fetch('/team.json', { cache: 'no-store' }).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; }),
        fetch('https://firestore.googleapis.com/v1/projects/tf-unions/databases/(default)/documents/teamMembers?pageSize=250', { cache: 'no-store' }).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; }),
      ]).then(function (results) {
        var jsonPayload = results[0];
        var fsPayload = results[1];
        var base = (jsonPayload && Array.isArray(jsonPayload.members) && jsonPayload.members.length > 0) ? jsonPayload.members : ALL_MEMBERS;
        var map = new Map(base.map(function (m) { return [m.id, m]; }));
        if (fsPayload && Array.isArray(fsPayload.documents)) {
          fsPayload.documents.forEach(function (doc) {
            var id = doc.name.split('/').pop();
            var f = doc.fields || {};
            var ov = { id: id };
            Object.keys(f).forEach(function (k) {
              if (k !== 'email' && k !== 'phone' && k !== 'age') ov[k] = decodeFsVal(f[k]);
            });
            var prev = map.get(id) || {};
            map.set(id, Object.assign({}, prev, ov, { id: id }));
          });
        }
        ALL_MEMBERS = Array.from(map.values()).filter(function (m) { return !m.archived && m.name; });
        var alumLen = ALL_MEMBERS.filter(memberIsAlumni).length;
        var actLen = ALL_MEMBERS.length - alumLen;
        var allBtn = statusTrackEl.querySelector('[data-st="all"]');
        var actBtn = statusTrackEl.querySelector('[data-st="active"]');
        var aluBtn = statusTrackEl.querySelector('[data-st="alumni"]');
        if (allBtn) allBtn.textContent = 'All (' + ALL_MEMBERS.length + ')';
        if (actBtn) actBtn.textContent = 'Core (' + actLen + ')';
        if (aluBtn) aluBtn.textContent = 'S1 Alumni (' + alumLen + ')';
        syncStatusButtons();
        renderFilterPills();
        renderRoster();
      }).catch(function () {});
    })();
  </script>
</BaseLayout>
