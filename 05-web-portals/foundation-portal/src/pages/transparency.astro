---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Open Ledger" backLabel="TF Unions" backHref="/">
  <section class="mt-14 sm:mt-20 max-w-[640px]">
    <h1 class="text-[36px] sm:text-[52px] font-bold tracking-[-1.6px] leading-[1.08] text-[#1D1D1F]">
      Open financial ledger.
    </h1>
    <p class="mt-4 text-[17px] leading-[1.5] text-[#6E6E73]">
      Every verified incoming contribution and outgoing infrastructure expense.
    </p>
  </section>

  <section class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-[#F5F5F7] rounded-[20px] p-7">
      <div class="text-[13px] text-[#6E6E73]">Verified Inflows</div>
      <div class="mt-2 text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">12,000 EGP</div>
    </div>
    <div class="bg-[#F5F5F7] rounded-[20px] p-7">
      <div class="text-[13px] text-[#6E6E73]">Infrastructure Outflows</div>
      <div class="mt-2 text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">4,200 EGP</div>
    </div>
    <div class="bg-[#F5F5F7] rounded-[20px] p-7">
      <div class="text-[13px] text-[#6E6E73]">SaaS Overhead</div>
      <div class="mt-2 text-[28px] font-bold tracking-[-0.6px] text-[#15803D]">$0 / mo</div>
    </div>
  </section>

  <section class="mt-16">
    <div class="flex items-center justify-between">
      <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">Transactions</h2>
      <a href="/support" class="text-[14px] font-semibold text-[#002583] hover:underline">Support TF Unions ›</a>
    </div>
    <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70">
      <div class="py-4 flex items-center justify-between">
        <div>
          <div class="text-[12px] text-[#6E6E73]">2026-01-15 • Incoming</div>
          <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Founders Seed Allocation</div>
        </div>
        <span class="text-[14px] font-semibold text-[#15803D]">+12,000 EGP</span>
      </div>
      <div class="py-4 flex items-center justify-between">
        <div>
          <div class="text-[12px] text-[#6E6E73]">2026-02-01 • VPS &amp; Domain</div>
          <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Dedicated Ubuntu VPS &amp; Domain Renewal</div>
        </div>
        <span class="text-[14px] font-medium text-[#6E6E73]">-4,200 EGP</span>
      </div>
    </div>
  </section>
</BaseLayout>
