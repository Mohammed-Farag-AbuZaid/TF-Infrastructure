---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Open Ledger" backLabel="TF Unions" backHref="/">
  <section class="mt-8 sm:mt-12 bg-white border border-[#E2E5EC] rounded-2xl p-7 sm:p-10 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">FINANCIAL ACCOUNTABILITY</div>
    <h1 class="mt-2 text-[32px] sm:text-[46px] font-bold tracking-[-0.03em] leading-[1.08] text-[#11141C]">
      Open financial ledger.
    </h1>
    <p class="mt-4 text-[16px] sm:text-[17px] leading-[1.55] text-[#525866] max-w-[660px]">
      Every verified incoming contribution and outgoing self-hosted infrastructure expense is audited publicly.
    </p>
  </section>

  <!-- Summary Metrics Cards -->
  <section class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#7A8191]">Verified Inflows</div>
      <div id="metric-inflows" class="mt-2 text-[26px] font-bold tracking-[-0.02em] text-[#11141C]">12,000 EGP</div>
    </div>
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#7A8191]">Infrastructure Outflows</div>
      <div id="metric-outflows" class="mt-2 text-[26px] font-bold tracking-[-0.02em] text-[#11141C]">4,200 EGP</div>
    </div>
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#7A8191]">Net Reserve</div>
      <div id="metric-reserve" class="mt-2 text-[26px] font-bold tracking-[-0.02em] text-[#002583]">7,800 EGP</div>
    </div>
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#7A8191]">Commercial SaaS Overhead</div>
      <div class="mt-2 text-[26px] font-bold tracking-[-0.02em] text-[#15803D]">$0 / mo</div>
    </div>
  </section>

  <!-- Live Ledger Transactions Widget -->
  <section class="mt-6 bg-white border border-[#E2E5EC] rounded-2xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#E2E5EC]">
      <div>
        <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">AUDIT TRAIL</div>
        <h2 class="mt-0.5 text-[22px] font-bold tracking-[-0.02em] text-[#11141C]">Ledger Transactions</h2>
      </div>
      <a
        href="/support"
        class="inline-flex items-center justify-center h-9 px-4 rounded-xl bg-[#F3F5F8] border border-[#E2E5EC] hover:border-[#002583]/40 text-[13px] font-semibold text-[#002583] transition shrink-0"
      >
        Support TF Unions ›
      </a>
    </div>

    <div class="divide-y divide-[#E2E5EC]" id="ledger-rows">
      <div class="py-4 flex items-center justify-between gap-4">
        <div>
          <div class="text-[12px] text-[#7A8191]">2026-01-15 · Founders Allocation · Verified</div>
          <div class="text-[16px] font-semibold text-[#11141C] mt-0.5">Founders Seed Allocation</div>
        </div>
        <span class="text-[14px] font-semibold text-[#15803D] shrink-0">+12,000 EGP</span>
      </div>
      <div class="py-4 flex items-center justify-between gap-4">
        <div>
          <div class="text-[12px] text-[#7A8191]">2026-02-01 · Infrastructure · Verified</div>
          <div class="text-[16px] font-semibold text-[#11141C] mt-0.5">Dedicated Ubuntu VPS &amp; Domain Renewal</div>
        </div>
        <span class="text-[14px] font-semibold text-[#525866] shrink-0">-4,200 EGP</span>
      </div>
    </div>
  </section>

  <script is:inline>
    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function fmtEgp(n) {
      return Number(n || 0).toLocaleString('en-US') + ' EGP';
    }

    (async () => {
      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/ledger');
        if (!res.ok) return;
        const data = await res.json();
        if (!data.ok) return;

        if (data.summary) {
          document.getElementById('metric-inflows').textContent = fmtEgp(data.summary.totalInflowsEgp);
          document.getElementById('metric-outflows').textContent = fmtEgp(data.summary.totalOutflowsEgp);
          document.getElementById('metric-reserve').textContent = fmtEgp(data.summary.netBalanceEgp);
        }

        if (Array.isArray(data.entries) && data.entries.length > 0) {
          const rowsEl = document.getElementById('ledger-rows');
          rowsEl.innerHTML = data.entries
            .map((e) => {
              const isOutflow = e.entryType === 'outflow';
              const sign = isOutflow ? '-' : '+';
              const colorClass = isOutflow ? 'text-[#525866]' : 'text-[#15803D]';
              const statusLabel = String(e.verificationStatus || 'Verified').replace(/_/g, ' ');
              const channelLabel = String(e.paymentChannel || '').replace(/_/g, ' ');
              return `
                <div class="py-4 flex items-center justify-between gap-4">
                  <div>
                    <div class="text-[12px] text-[#7A8191]">${esc(e.txDate)} · ${esc(channelLabel)} · ${esc(statusLabel)}</div>
                    <div class="text-[16px] font-semibold text-[#11141C] mt-0.5">${esc(e.donorOrVendor)}</div>
                  </div>
                  <span class="text-[14px] font-semibold ${colorClass} shrink-0">${sign}${fmtEgp(e.amountEgp)}</span>
                </div>
              `;
            })
            .join('');
        }
      } catch {}
    })();
  </script>
</BaseLayout>
