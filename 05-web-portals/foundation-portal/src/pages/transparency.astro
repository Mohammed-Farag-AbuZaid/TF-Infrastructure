---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Open Ledger" backLabel="TF Unions" backHref="/">
  <!-- Calm White Treasury Header & Telemetry -->
  <section class="mt-8 bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-8 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
          Financial accountability registry
        </div>
        <h1 class="font-display mt-2.5 text-[30px] sm:text-[38px] font-bold leading-[1.1] tracking-[-0.025em] text-[#161A22]">
          Open financial ledger
        </h1>
        <p class="mt-2.5 text-[14.5px] leading-[1.6] text-[#525866] max-w-[620px]">
          Every verified contribution inflow and self-hosted server infrastructure expense is audited publicly in Egyptian Pounds.
        </p>
      </div>
      <div class="flex flex-wrap gap-2.5 shrink-0">
        <button
          id="export-csv-btn"
          type="button"
          class="h-9 px-4 rounded-lg bg-[#F3F2EE] hover:bg-[#EAE8E1] border border-[#DFDDD6] text-[#161A22] text-[13px] font-medium transition"
        >
          Export CSV
        </button>
        <a
          href="/support"
          class="h-9 px-4 inline-flex items-center rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition"
        >
          Support TF Unions →
        </a>
      </div>
    </div>

    <div class="mt-7 pt-6 border-t border-[#DFDDD6] grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-[#F3F2EE] border border-[#DFDDD6] rounded-lg p-4">
        <div class="text-[12px] text-[#767D8C]">Verified inflows</div>
        <div id="metric-inflows" class="font-code mt-1 text-[22px] font-semibold text-[#0B5F58]">12,000 EGP</div>
      </div>
      <div class="bg-[#F3F2EE] border border-[#DFDDD6] rounded-lg p-4">
        <div class="text-[12px] text-[#767D8C]">Infrastructure outflows</div>
        <div id="metric-outflows" class="font-code mt-1 text-[22px] font-semibold text-[#161A22]">4,200 EGP</div>
      </div>
      <div class="bg-[#F3F2EE] border border-[#DFDDD6] rounded-lg p-4">
        <div class="text-[12px] text-[#767D8C]">Net reserve</div>
        <div id="metric-reserve" class="font-code mt-1 text-[22px] font-semibold text-[#1B365D]">7,800 EGP</div>
      </div>
      <div class="bg-[#F3F2EE] border border-[#DFDDD6] rounded-lg p-4">
        <div class="text-[12px] text-[#767D8C]">Commercial SaaS spend</div>
        <div class="font-code mt-1 text-[22px] font-semibold text-[#161A22]">$0 / mo</div>
      </div>
    </div>

    <div class="tf-ledger-line">
      <span class="tf-ledger-line__label">№ 01 · Treasury Ratio</span>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <p class="text-[13px] text-[#525866]">Direct-labeled comparison of verified inflows, server infrastructure expenses, and net reserve.</p>
      <span class="tf-stamp">Audited · Append-Only</span>
    </div>
    <svg id="ledger-bar-chart" viewBox="0 0 680 132" class="w-full h-auto block" role="img" aria-label="Treasury inflows, outflows, and net reserve chart">
      <text x="0" y="24" font-family="Plus Jakarta Sans, sans-serif" font-size="13" fill="#5B606B">Verified inflows</text>
      <rect id="bar-inflows" x="148" y="10" width="380" height="20" rx="5" fill="#0F766E" />
      <text id="lbl-inflows" x="538" y="25" font-family="JetBrains Mono, monospace" font-size="12.5" font-weight="600" fill="#0B5F58">12,000 EGP</text>

      <text x="0" y="66" font-family="Plus Jakarta Sans, sans-serif" font-size="13" fill="#5B606B">Infrastructure outflows</text>
      <rect id="bar-outflows" x="148" y="52" width="133" height="20" rx="5" fill="#1B365D" />
      <text id="lbl-outflows" x="291" y="67" font-family="JetBrains Mono, monospace" font-size="12.5" font-weight="600" fill="#161A22">4,200 EGP</text>

      <text x="0" y="108" font-family="Plus Jakarta Sans, sans-serif" font-size="13" fill="#5B606B">Net reserve</text>
      <rect id="bar-reserve" x="148" y="94" width="247" height="20" rx="5" fill="#E4EAF2" stroke="#1B365D" stroke-width="1.5" stroke-dasharray="4 3" />
      <text id="lbl-reserve" x="405" y="109" font-family="JetBrains Mono, monospace" font-size="12.5" font-weight="600" fill="#1B365D">7,800 EGP</text>
    </svg>
  </section>

  <!-- Crisp Paper Audit Trail Table -->
  <section class="mt-6 bg-white border border-[#DFDDD6] rounded-xl overflow-hidden shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
    <div class="px-6 py-3.5 bg-[#EAE8E1] border-b border-[#DFDDD6] flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-1">
        <button type="button" data-ledger-filter="all" class="ledger-tab active px-3.5 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition">All entries</button>
        <button type="button" data-ledger-filter="inflow" class="ledger-tab px-3.5 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Inflows</button>
        <button type="button" data-ledger-filter="outflow" class="ledger-tab px-3.5 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">Outflows</button>
      </div>
      <span id="ledger-status-label" class="font-code text-[12px] text-[#525866]">Public audit trail</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-[14px]">
        <thead>
          <tr class="bg-[#F3F2EE] border-b border-[#DFDDD6] text-[12px] font-medium text-[#767D8C]">
            <th class="py-3 px-6">Date</th>
            <th class="py-3 px-4">Contributor / Vendor</th>
            <th class="py-3 px-4">Channel</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-6 text-right">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#EAE8E1]" id="ledger-rows"></tbody>
      </table>
    </div>
  </section>

  <script is:inline>
    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function fmtEgp(n) {
      return Number(n || 0).toLocaleString('en-US') + ' EGP';
    }

    const FALLBACK_ENTRIES = [
      {
        txDate: '2026-01-15',
        donorOrVendor: 'Founders Seed Allocation',
        paymentChannel: 'Founders Allocation',
        verificationStatus: 'Verified',
        entryType: 'inflow',
        amountEgp: 12000,
      },
      {
        txDate: '2026-02-01',
        donorOrVendor: 'Dedicated Ubuntu VPS & Domain Renewal',
        paymentChannel: 'Infrastructure',
        verificationStatus: 'Verified',
        entryType: 'outflow',
        amountEgp: 4200,
      },
    ];

    let allEntries = [...FALLBACK_ENTRIES];
    let currentFilter = 'all';

    function renderTable() {
      const tbody = document.getElementById('ledger-rows');
      const filtered = allEntries.filter((e) => currentFilter === 'all' || e.entryType === currentFilter);
      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-8 px-6 text-center text-[#767D8C]">No ledger entries in this view.</td></tr>`;
        return;
      }
      tbody.innerHTML = filtered
        .map((e) => {
          const isOutflow = e.entryType === 'outflow';
          const sign = isOutflow ? '-' : '+';
          const colorCls = isOutflow ? 'text-[#161A22]' : 'text-[#0B5F58]';
          const statusLabel = String(e.verificationStatus || 'Verified').replace(/_/g, ' ');
          const channelLabel = String(e.paymentChannel || '').replace(/_/g, ' ');
          return `
            <tr class="hover:bg-[#FAF9F6] transition">
              <td class="py-3.5 px-6 font-code text-[12.5px] text-[#767D8C] whitespace-nowrap">${esc(e.txDate)}</td>
              <td class="py-3.5 px-4 font-medium text-[#161A22]">${esc(e.donorOrVendor)}</td>
              <td class="py-3.5 px-4 text-[#525866]">${esc(channelLabel)}</td>
              <td class="py-3.5 px-4">
                <span class="px-2 py-0.5 rounded-md bg-[#EDF7F5] border border-[#BCE3DC] text-[11.5px] font-medium text-[#0B5F58]">
                  ${esc(statusLabel)}
                </span>
              </td>
              <td class="py-3.5 px-6 text-right font-code font-medium whitespace-nowrap ${colorCls}">
                ${sign}${fmtEgp(e.amountEgp)}
              </td>
            </tr>
          `;
        })
        .join('');
    }

    document.querySelectorAll('.ledger-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.ledger-tab').forEach((b) => {
          b.className = 'ledger-tab px-3.5 py-1.5 rounded-lg text-[12px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition';
        });
        btn.className = 'ledger-tab active px-3.5 py-1.5 rounded-lg text-[12px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition';
        currentFilter = btn.getAttribute('data-ledger-filter') || 'all';
        renderTable();
      });
    });

    document.getElementById('export-csv-btn').addEventListener('click', () => {
      const header = 'Date,Contributor_or_Vendor,Channel,Status,Type,Amount_EGP\n';
      const lines = allEntries
        .map((e) => [e.txDate, `"${String(e.donorOrVendor || '').replace(/"/g, '""')}"`, e.paymentChannel, e.verificationStatus, e.entryType, e.amountEgp].join(','))
        .join('\n');
      const blob = new Blob([header + lines], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'tfunions-open-ledger.csv';
      a.click();
      URL.revokeObjectURL(url);
    });

    function updateChart(inflows, outflows, reserve) {
      const maxVal = Math.max(Number(inflows) || 0, Number(outflows) || 0, Number(reserve) || 0, 1);
      const maxWidth = 380;
      const items = [
        ['inflows', Number(inflows) || 0],
        ['outflows', Number(outflows) || 0],
        ['reserve', Math.max(0, Number(reserve) || 0)],
      ];
      items.forEach(([key, val]) => {
        const w = Math.max(12, Math.round((val / maxVal) * maxWidth));
        const bar = document.getElementById('bar-' + key);
        const lbl = document.getElementById('lbl-' + key);
        if (bar) bar.setAttribute('width', String(w));
        if (lbl) {
          lbl.setAttribute('x', String(148 + w + 10));
          lbl.textContent = fmtEgp(val);
        }
      });
    }

    renderTable();
    updateChart(12000, 4200, 7800);

    function decodeFsVal(v) {
      if (!v || typeof v !== 'object') return undefined;
      if ('stringValue' in v) return v.stringValue;
      if ('booleanValue' in v) return v.booleanValue;
      if ('integerValue' in v) return Number(v.integerValue);
      if ('doubleValue' in v) return Number(v.doubleValue);
      return undefined;
    }

    (async () => {
      try {
        const fsRes = await fetch('https://firestore.googleapis.com/v1/projects/tf-unions/databases/(default)/documents/ledgerEntries?pageSize=200', { cache: 'no-store' });
        if (fsRes.ok) {
          const fsJson = await fsRes.json();
          const docs = (fsJson.documents || []).map((doc) => {
            const o = { id: doc.name.split('/').pop() };
            const f = doc.fields || {};
            Object.keys(f).forEach((k) => { o[k] = decodeFsVal(f[k]); });
            return o;
          });
          if (docs.length > 0) {
            docs.sort((a, b) => String(b.txDate || '').localeCompare(String(a.txDate || '')));
            let inflows = 0;
            let outflows = 0;
            docs.forEach((d) => {
              const amt = Number(d.amountEgp) || 0;
              if (d.entryType === 'outflow') outflows += amt;
              else inflows += amt;
            });
            const reserve = inflows - outflows;
            document.getElementById('metric-inflows').textContent = fmtEgp(inflows);
            document.getElementById('metric-outflows').textContent = fmtEgp(outflows);
            document.getElementById('metric-reserve').textContent = fmtEgp(reserve);
            updateChart(inflows, outflows, reserve);
            allEntries = docs;
            document.getElementById('ledger-status-label').textContent = `Live Studio Ledger (${allEntries.length} entries)`;
            renderTable();
            return;
          }
        }
      } catch {}

      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/ledger');
        if (!res.ok) return;
        const data = await res.json();
        if (!data.ok) return;

        if (data.summary) {
          document.getElementById('metric-inflows').textContent = fmtEgp(data.summary.totalInflowsEgp);
          document.getElementById('metric-outflows').textContent = fmtEgp(data.summary.totalOutflowsEgp);
          document.getElementById('metric-reserve').textContent = fmtEgp(data.summary.netBalanceEgp);
          updateChart(data.summary.totalInflowsEgp, data.summary.totalOutflowsEgp, data.summary.netBalanceEgp);
        }

        if (Array.isArray(data.entries) && data.entries.length > 0) {
          allEntries = data.entries;
          document.getElementById('ledger-status-label').textContent = `Live PostgreSQL Sync (${allEntries.length} entries)`;
          renderTable();
        }
      } catch {}
    })();
  </script>
</BaseLayout>
