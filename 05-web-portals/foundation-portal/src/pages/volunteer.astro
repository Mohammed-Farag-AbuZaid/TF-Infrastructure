---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Volunteer" backLabel="TF Unions" backHref="/">
  <section class="mt-14 sm:mt-20 max-w-[640px]">
    <h1 class="text-[36px] sm:text-[52px] font-bold tracking-[-1.6px] leading-[1.08] text-[#1D1D1F]">
      Volunteer with us.
    </h1>
    <p class="mt-4 text-[17px] leading-[1.5] text-[#6E6E73]">
      Join a seasonal contributor cohort, research global opportunities, and earn a verifiable TF Unions credential.
    </p>
  </section>

  <section class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-14">
    <!-- Left: Open Tracks -->
    <div>
      <h2 class="text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Open tracks</h2>
      <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70">
        <div class="py-4">
          <div class="text-[16px] font-semibold text-[#1D1D1F]">TF News Researcher</div>
          <div class="text-[14px] text-[#6E6E73] mt-0.5">Verify university scholarships, admissions pathways, and deadlines.</div>
        </div>
        <div class="py-4">
          <div class="text-[16px] font-semibold text-[#1D1D1F]">TF Guides Author</div>
          <div class="text-[14px] text-[#6E6E73] mt-0.5">Write structured STEM, Olympiad, and scientific research roadmaps.</div>
        </div>
        <div class="py-4">
          <div class="text-[16px] font-semibold text-[#1D1D1F]">Engineering &amp; Flutter</div>
          <div class="text-[14px] text-[#6E6E73] mt-0.5">Build minimalist student tools across web and mobile.</div>
        </div>
        <div class="py-4">
          <div class="text-[16px] font-semibold text-[#1D1D1F]">Community &amp; Cohorts</div>
          <div class="text-[14px] text-[#6E6E73] mt-0.5">Coordinate study circles and mentorship sessions on TF Connect.</div>
        </div>
      </div>
    </div>

    <!-- Right: Minimalist Application Form -->
    <div>
      <h2 class="text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Apply</h2>
      <div id="vol-alert" class="hidden mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[14px] font-medium"></div>
      <form id="vol-form" class="mt-4 space-y-3.5">
        <input
          id="vol-name"
          type="text"
          required
          placeholder="Full name"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <input
          id="vol-email"
          type="email"
          required
          placeholder="Email address"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <select
          id="vol-track"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        >
          <option value="TF_News_Researcher">TF News Researcher</option>
          <option value="TF_Guide_Author">TF Guides Author</option>
          <option value="Engineering_Flutter">Engineering &amp; Flutter</option>
          <option value="Community_Ambassador">Community &amp; Cohorts</option>
        </select>
        <input
          id="vol-cv"
          type="url"
          placeholder="Portfolio, LinkedIn, or CV link (https://...)"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <textarea
          id="vol-motivation"
          rows="4"
          required
          placeholder="How would you like to contribute?"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        ></textarea>
        <button
          type="submit"
          class="w-full h-12 rounded-[12px] bg-[#002583] hover:opacity-95 text-white font-semibold text-[15px] transition"
        >
          Submit application
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('vol-form');
    const alertBox = document.getElementById('vol-alert');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.textContent = 'Submitting...';
      alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#6E6E73] text-[14px] font-medium';
      alertBox.classList.remove('hidden');
      try {
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/volunteer-apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name: document.getElementById('vol-name').value.trim(),
            applicant_email: document.getElementById('vol-email').value.trim(),
            season_cohort: 'Winter_2026',
            target_track: document.getElementById('vol-track').value,
            portfolio_or_cv_url: document.getElementById('vol-cv').value.trim(),
            motivation_answer: document.getElementById('vol-motivation').value.trim(),
          }),
        });
        if (!res.ok) throw new Error('Submission failed');
        alertBox.textContent = 'Application received. We will review and follow up by email.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#15803D] text-[14px] font-medium';
        form.reset();
      } catch (err) {
        alertBox.textContent = err.message || 'Could not submit application.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#B91C1C] text-[14px] font-medium';
      }
    });
  </script>
</BaseLayout>
