---
import BaseLayout from '../layouts/BaseLayout.astro';

const tracks = [
  {
    id: 'TF_News_Researcher',
    name: 'TF News Researcher',
    division: 'Admissions & Aid',
    summary: 'Audit global university scholarship rules, full-need aid requirements, and summer fellowship deadlines across verified sources.',
  },
  {
    id: 'TF_Guide_Author',
    name: 'TF Guides Author',
    division: 'Editorial & Roadmaps',
    summary: 'Author structured ISEF research blueprints, Olympiad problem checklists, and LaTeX manuscript templates.',
  },
  {
    id: 'Engineering_Flutter',
    name: 'Engineering & Flutter',
    division: 'Systems Architecture',
    summary: 'Build fast student web portals in Astro, Node/PostgreSQL APIs, and responsive Dart/Flutter clients.',
  },
  {
    id: 'Community_Ambassador',
    name: 'Community & Chapters',
    division: 'Governorate Outreach',
    summary: 'Coordinate STEM school circles, governorate onboarding workshops, and peer review sessions on TF Connect.',
  },
];
---
<BaseLayout title="Volunteer Tracks" backLabel="Home" backHref="/">
  <section class="mt-8 max-w-[900px]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <div class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
          Winter 2026 contributor cohort
        </div>
        <h1 class="font-display mt-2 text-[30px] sm:text-[36px] font-bold leading-[1.1] tracking-[-0.025em] text-[#161A22]">
          Choose a volunteer track
        </h1>
        <p class="mt-2 text-[14.5px] leading-[1.6] text-[#525866] max-w-[60ch]">
          Select any contributor division below to proceed directly to the application form. Approved contributors receive a verifiable TF Unions credential.
        </p>
      </div>
      <a
        href="https://verify.tfunions.com"
        class="font-code text-[12px] px-3 py-1.5 rounded-lg bg-white border border-[#DFDDD6] text-[#525866] hover:border-[#1B365D] transition shrink-0"
      >
        Credential-backed
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {tracks.map((t) => (
        <a
          href={`/volunteer-apply?track=${encodeURIComponent(t.id)}`}
          class="group bg-white border border-[#DFDDD6] hover:border-[#0F766E] rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.03)] flex flex-col justify-between transition"
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="font-code text-[12px] font-medium text-[#0B5F58]">{t.division}</span>
              <span class="text-[#767D8C] group-hover:text-[#0B5F58] transition">Apply →</span>
            </div>
            <h2 class="font-display text-[20px] font-bold text-[#161A22] mt-2">{t.name}</h2>
            <p class="text-[13.5px] text-[#525866] mt-2 leading-[1.6]">{t.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
