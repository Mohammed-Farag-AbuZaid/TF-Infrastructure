---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Live Union Desk" backLabel="Home" backHref="/">
  <section class="mt-8 max-w-[760px]">
    <div data-tf-copy="desk.eyebrow" class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
      Real-time ecosystem feed
    </div>
    <h1 data-tf-copy="desk.headline" class="font-display mt-2 text-[30px] sm:text-[36px] font-bold tracking-[-0.025em] text-[#161A22]">
      Live union desk
    </h1>
    <p data-tf-copy="desk.subtitle" class="mt-2 text-[14.5px] text-[#525866]">
      Inspect synchronized opportunity deadlines, active governorate chapters, and live treasury balance snapshots.
    </p>

    <div class="mt-6 bg-white border border-[#DFDDD6] rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#0F766E]" aria-hidden="true"></span>
          <span class="font-display text-[17px] font-semibold text-[#161A22]">Live status</span>
        </div>
        <span data-tf-copy="desk.season_badge" class="font-code text-[11px] font-medium px-2.5 py-0.5 rounded-md bg-[#EAE8E1] text-[#525866] border border-[#DCD9D0]">
          Season 2
        </span>
      </div>

      <div class="mt-4 p-1 bg-[#EAE8E1] border border-[#DCD9D0] rounded-lg grid grid-cols-3 gap-1">
        <button type="button" data-desk="deadlines" class="desk-tab py-2 px-3 rounded-md text-[13px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition">
          Deadlines
        </button>
        <button type="button" data-desk="chapters" class="desk-tab py-2 px-3 rounded-md text-[13px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">
          Chapters
        </button>
        <button type="button" data-desk="ledger" class="desk-tab py-2 px-3 rounded-md text-[13px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition">
          Treasury
        </button>
      </div>

      <div id="desk-deadlines" class="desk-pane mt-5 divide-y divide-[#EAE8E1]">
        <div class="py-6 text-[13.5px] text-[#767D8C] text-center">Loading live opportunities...</div>
      </div>

      <div id="desk-chapters" class="desk-pane hidden mt-5 divide-y divide-[#EAE8E1]">
        <div class="py-6 text-[13.5px] text-[#767D8C] text-center">Loading active chapters...</div>
      </div>

      <div id="desk-ledger" class="desk-pane hidden mt-5 space-y-3.5">
        <div class="p-4 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] grid grid-cols-3 gap-3 text-center">
          <div>
            <div class="text-[11.5px] text-[#767D8C]">Inflows</div>
            <div id="home-ledger-in" class="font-code text-[15px] font-semibold text-[#0B5F58] mt-0.5">0 EGP</div>
          </div>
          <div>
            <div class="text-[11.5px] text-[#767D8C]">Outflows</div>
            <div id="home-ledger-out" class="font-code text-[15px] font-semibold text-[#161A22] mt-0.5">0 EGP</div>
          </div>
          <div>
            <div class="text-[11.5px] text-[#767D8C]">Reserve</div>
            <div id="home-ledger-net" class="font-code text-[15px] font-semibold text-[#1B365D] mt-0.5">0 EGP</div>
          </div>
        </div>
        <div data-tf-copy="desk.ledger_note" class="text-[13.5px] text-[#525866] leading-[1.6]">
          100% of verified contributions support infrastructure and student academic access. Inspect transaction records publicly on the Open Ledger.
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-[#DFDDD6] flex items-center justify-between text-[13px]">
        <a id="desk-footer-link" href="https://news.tfunions.com" class="font-medium text-[#1B365D] hover:underline">
          Browse scholarships &amp; deadlines →
        </a>
        <a href="/transparency" class="text-[#767D8C] hover:text-[#161A22] font-medium transition">
          Audit ledger
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    function esc(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function decodeFsVal(v) {
      if (!v || typeof v !== 'object') return undefined;
      if ('stringValue' in v) return v.stringValue;
      if ('booleanValue' in v) return v.booleanValue;
      if ('integerValue' in v) return Number(v.integerValue);
      if ('doubleValue' in v) return Number(v.doubleValue);
      return undefined;
    }

    async function fetchFsCol(col, pageSize) {
      const res = await fetch(`https://firestore.googleapis.com/v1/projects/tf-unions/databases/(default)/documents/${col}?pageSize=${pageSize}`, { cache: 'no-store' });
      if (!res.ok) return [];
      const json = await res.json();
      return (json.documents || []).map((doc) => {
        const o = { id: doc.name.split('/').pop() };
        const f = doc.fields || {};
        Object.keys(f).forEach((k) => { o[k] = decodeFsVal(f[k]); });
        return o;
      });
    }

    const footerLinks = {
      deadlines: { text: 'Browse scholarships & deadlines →', href: 'https://news.tfunions.com' },
      chapters: { text: 'Browse all regional chapters →', href: 'https://connect.tfunions.com' },
      ledger: { text: 'Open full audit trail →', href: '/transparency' },
    };
    const deskFooterLink = document.getElementById('desk-footer-link');

    document.querySelectorAll('.desk-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const desk = btn.getAttribute('data-desk');
        document.querySelectorAll('.desk-tab').forEach((b) => {
          b.className = 'desk-tab py-2 px-3 rounded-md text-[13px] font-medium text-[#525866] hover:text-[#161A22] border border-transparent transition';
        });
        btn.className = 'desk-tab py-2 px-3 rounded-md text-[13px] font-medium bg-white text-[#161A22] border border-[#DFDDD6] shadow-[0_1px_1px_rgba(22,26,34,0.04)] transition';
        document.querySelectorAll('.desk-pane').forEach((p) => p.classList.add('hidden'));
        const pane = document.getElementById('desk-' + desk);
        if (pane) pane.classList.remove('hidden');
        if (deskFooterLink && footerLinks[desk]) {
          deskFooterLink.textContent = footerLinks[desk].text;
          deskFooterLink.href = footerLinks[desk].href;
        }
      });
    });

    (async () => {
      const [opps, chapters, ledger] = await Promise.all([
        fetchFsCol('opportunities', 30).catch(() => []),
        fetchFsCol('chapters', 30).catch(() => []),
        fetchFsCol('ledgerEntries', 200).catch(() => []),
      ]);

      const oppsEl = document.getElementById('desk-deadlines');
      const liveOpps = opps.filter((o) => !o.archived).slice(0, 6);
      if (oppsEl) {
        oppsEl.innerHTML = liveOpps.length === 0
          ? '<div class="py-6 text-[13.5px] text-[#767D8C] text-center">No live announcements added yet.</div>'
          : liveOpps.map((o) => `
            <a href="${esc(o.url || 'https://news.tfunions.com')}" class="py-3.5 flex items-center justify-between gap-3 hover:bg-[#F3F2EE]/70 px-2.5 -mx-2.5 rounded-lg transition group">
              <div class="min-w-0">
                <div class="text-[12px] font-medium text-[#0B5F58]">${esc(o.category || 'Opportunity')}</div>
                <div class="text-[14px] font-medium text-[#161A22] group-hover:text-[#1B365D] truncate mt-0.5">${esc(o.title)}</div>
              </div>
              <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-md bg-[#EAE8E1] border border-[#DCD9D0] text-[#525866] shrink-0">${esc(o.deadline || 'Open')}</span>
            </a>`).join('');
      }

      const chEl = document.getElementById('desk-chapters');
      const liveCh = chapters.filter((c) => !c.archived).slice(0, 6);
      if (chEl) {
        chEl.innerHTML = liveCh.length === 0
          ? '<div class="py-6 text-[13.5px] text-[#767D8C] text-center">No regional chapters published yet.</div>'
          : liveCh.map((c) => `
            <a href="https://connect.tfunions.com" class="py-3.5 flex items-center justify-between hover:bg-[#F3F2EE]/70 px-2.5 -mx-2.5 rounded-lg transition">
              <div>
                <div class="text-[14px] font-medium text-[#161A22]">${esc(c.name)}</div>
                <div class="text-[12.5px] text-[#767D8C]">${esc(c.focus || c.type || '')}</div>
              </div>
              <span class="text-[11.5px] font-medium px-2.5 py-0.5 rounded bg-[#EAE8E1] text-[#525866]">${esc(c.gov || 'Egypt')}</span>
            </a>`).join('');
      }

      let inf = 0; let out = 0;
      ledger.forEach((d) => { const a = Number(d.amountEgp) || 0; if (d.entryType === 'outflow') out += a; else inf += a; });
      const fmt = (n) => Number(n || 0).toLocaleString('en-US') + ' EGP';
      document.getElementById('home-ledger-in').textContent = fmt(inf);
      document.getElementById('home-ledger-out').textContent = fmt(out);
      document.getElementById('home-ledger-net').textContent = fmt(inf - out);
    })();
  </script>
</BaseLayout>
