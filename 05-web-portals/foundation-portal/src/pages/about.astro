---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" backLabel="TF Unions" backHref="/">
  <section class="mt-8 sm:mt-12 bg-white border border-[#E2E5EC] rounded-2xl p-7 sm:p-10 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">FOUNDATION MANDATE</div>
    <h1 class="mt-2 text-[32px] sm:text-[46px] font-bold tracking-[-0.03em] leading-[1.08] text-[#11141C]">
      Mission &amp; institutional values.
    </h1>
    <p class="mt-4 text-[16px] sm:text-[17px] leading-[1.55] text-[#525866] max-w-[700px]">
      TF Unions (formerly Altafawwoq Union) is an independent non-profit educational initiative founded by <strong class="text-[#11141C]">Mohammed Farag</strong> and <strong class="text-[#11141C]">Mohammed Abdelghany</strong>.
    </p>
  </section>

  <section class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">MISSION</div>
      <h2 class="mt-2 text-[22px] font-bold tracking-[-0.02em] text-[#11141C]">Answer before they ask</h2>
      <p class="mt-2.5 text-[15px] leading-[1.6] text-[#525866]">
        Give standout students across all 27 Egyptian governorates the tools, university pathways, and research roadmaps they need—before they even know which questions to ask.
      </p>
    </div>
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#D99B00]">CORE ETHOS</div>
      <h2 class="mt-2 text-[22px] font-bold tracking-[-0.02em] text-[#11141C]">Sharing knowledge is a responsibility</h2>
      <p class="mt-2.5 text-[15px] leading-[1.6] text-[#525866]">
        Built by students and alumni for students. Every tool is free of charge, free of advertisements, and open to every educational system in Egypt.
      </p>
    </div>
  </section>

  <section class="mt-8 bg-white border border-[#E2E5EC] rounded-2xl p-7 sm:p-8 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">OPERATING STANDARDS</div>
    <h2 class="mt-1 text-[24px] font-bold tracking-[-0.02em] text-[#11141C]">Core Principles</h2>
    <div class="mt-4 border-t border-[#E2E5EC] divide-y divide-[#E2E5EC]">
      <div class="py-5 flex items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-[16px] font-semibold text-[#11141C]">Open to every educational system</div>
          <div class="text-[14px] text-[#525866] mt-1">Thanaweya Amma, STEM schools, IGCSE, American Diploma, Azhar, Prep, and universities.</div>
        </div>
        <span class="font-mono text-[12px] font-semibold text-[#002583] bg-[#F3F5F8] border border-[#E2E5EC] px-2.5 py-1 rounded-md shrink-0">01</span>
      </div>
      <div class="py-5 flex items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-[16px] font-semibold text-[#11141C]">Ambition over grades</div>
          <div class="text-[14px] text-[#525866] mt-1">Standout students are defined by curiosity, initiative, and meaningful goals.</div>
        </div>
        <span class="font-mono text-[12px] font-semibold text-[#002583] bg-[#F3F5F8] border border-[#E2E5EC] px-2.5 py-1 rounded-md shrink-0">02</span>
      </div>
      <div class="py-5 flex items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-[16px] font-semibold text-[#11141C]">Zero recurring SaaS overhead</div>
          <div class="text-[14px] text-[#525866] mt-1">Self-hosted infrastructure and 100% open-book financial transparency.</div>
        </div>
        <span class="font-mono text-[12px] font-semibold text-[#002583] bg-[#F3F5F8] border border-[#E2E5EC] px-2.5 py-1 rounded-md shrink-0">03</span>
      </div>
    </div>
  </section>
</BaseLayout>
