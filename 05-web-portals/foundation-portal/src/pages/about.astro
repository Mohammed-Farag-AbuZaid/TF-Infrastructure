---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" backLabel="TF Unions" backHref="/">
  <section class="mt-14 sm:mt-20 max-w-[720px]">
    <h1 class="text-[36px] sm:text-[52px] font-bold tracking-[-1.6px] leading-[1.08] text-[#1D1D1F]">
      Mission &amp; values.
    </h1>
    <p class="mt-4 text-[17px] leading-[1.5] text-[#6E6E73]">
      TF Unions (formerly Altafawwoq Union) is an independent non-profit educational initiative founded by Mohammed Farag and Mohammed Abdelghany.
    </p>
  </section>

  <section class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-[#F5F5F7] rounded-[20px] p-7">
      <div class="text-[13px] text-[#6E6E73]">Mission</div>
      <h2 class="mt-2 text-[22px] font-bold tracking-[-0.4px] text-[#1D1D1F]">Answer before they ask</h2>
      <p class="mt-2 text-[15px] leading-[1.5] text-[#6E6E73]">
        Give standout students across all 27 Egyptian governorates the tools, university pathways, and research roadmaps they need—before they even know which questions to ask.
      </p>
    </div>
    <div class="bg-[#F5F5F7] rounded-[20px] p-7">
      <div class="text-[13px] text-[#6E6E73]">Core Ethos</div>
      <h2 class="mt-2 text-[22px] font-bold tracking-[-0.4px] text-[#1D1D1F]">Sharing knowledge is a responsibility</h2>
      <p class="mt-2 text-[15px] leading-[1.5] text-[#6E6E73]">
        Built by students and alumni for students. Every tool is free of charge, free of advertisements, and open to every educational system in Egypt.
      </p>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-[28px] font-bold tracking-[-0.6px] text-[#1D1D1F]">Principles</h2>
    <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70">
      <div class="py-4 flex items-center justify-between">
        <div>
          <div class="text-[16px] font-semibold text-[#1D1D1F]">Open to every educational system</div>
          <div class="text-[14px] text-[#6E6E73] mt-0.5">Thanaweya Amma, STEM schools, IGCSE, American Diploma, Azhar, Prep, and universities.</div>
        </div>
        <span class="text-[13px] text-[#6E6E73] shrink-0">01</span>
      </div>
      <div class="py-4 flex items-center justify-between">
        <div>
          <div class="text-[16px] font-semibold text-[#1D1D1F]">Ambition over grades</div>
          <div class="text-[14px] text-[#6E6E73] mt-0.5">Standout students are defined by curiosity, initiative, and meaningful goals.</div>
        </div>
        <span class="text-[13px] text-[#6E6E73] shrink-0">02</span>
      </div>
      <div class="py-4 flex items-center justify-between">
        <div>
          <div class="text-[16px] font-semibold text-[#1D1D1F]">Zero recurring SaaS overhead</div>
          <div class="text-[14px] text-[#6E6E73] mt-0.5">Self-hosted infrastructure and 100% open-book financial transparency.</div>
        </div>
        <span class="text-[13px] text-[#6E6E73] shrink-0">03</span>
      </div>
    </div>
  </section>
</BaseLayout>
