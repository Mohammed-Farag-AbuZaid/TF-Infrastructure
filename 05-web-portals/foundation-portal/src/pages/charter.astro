---
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = [
  {
    id: 'article-1',
    num: '01',
    title: 'Independent non-profit mandate',
    body: 'TF Unions operates strictly as a non-profit student educational foundation. Core student access to university admission data, scholarships, roadmaps, and study circles will never be paywalled or monetized with third-party advertising.',
  },
  {
    id: 'article-2',
    num: '02',
    title: 'Student data sovereignty & single TF Passport',
    body: 'Student identity records reside in our self-hosted PostgreSQL database rather than commercial tracking networks. One session cookie scoped to *.tfunions.com grants access across portals and is never sold or shared.',
  },
  {
    id: 'article-3',
    num: '03',
    title: 'Cryptographically verifiable contributor credentials',
    body: 'Every volunteer, research author, and officer certificate issued by TF Unions carries a permanent serial code verifiable publicly at verify.tfunions.com.',
    linkLabel: 'Open credential registry →',
    linkHref: 'https://verify.tfunions.com',
  },
  {
    id: 'article-4',
    num: '04',
    title: 'Open-book treasury & infrastructure accountability',
    body: 'Every incoming community contribution, hardware grant, and server expenditure is published with verification status and channel provenance on the public Open Financial Ledger.',
    linkLabel: 'Inspect open financial ledger →',
    linkHref: '/transparency',
  },
];
---
<BaseLayout title="Charter" backLabel="TF Unions" backHref="/">
  <section class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left 4 Cols: Calm White Index Panel -->
    <aside class="lg:col-span-4 bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-7 lg:sticky lg:top-24 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <div data-tf-copy="charter.eyebrow" class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
        Governance framework
      </div>
      <h1 data-tf-copy="charter.headline" class="font-display mt-2.5 text-[30px] font-bold leading-[1.1] tracking-[-0.025em] text-[#161A22]">
        Non-Profit Charter
      </h1>
      <p data-tf-copy="charter.subtitle" class="mt-3 text-[14px] leading-[1.6] text-[#525866]">
        Binding institutional rules covering free student access, data sovereignty, verifiable service records, and open finances.
      </p>

      <nav class="mt-6 pt-5 border-t border-[#DFDDD6] space-y-1.5 text-[13px]" aria-label="Charter Articles">
        {articles.map((art) => (
          <a href={`#${art.id}`} class="flex items-start gap-2.5 px-3 py-2 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] hover:border-[#1B365D]/40 text-[#161A22] transition">
            <span class="font-code text-[11.5px] text-[#0B5F58] font-medium pt-0.5">{art.num}</span>
            <span class="font-medium leading-snug">{art.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- Right 8 Cols: Crisp Paper Charter Document -->
    <div class="lg:col-span-8 bg-white border border-[#DFDDD6] rounded-xl divide-y divide-[#DFDDD6] shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      {articles.map((art, idx) => (
        <article id={art.id} class="p-7 sm:p-8 scroll-mt-24">
          <div class="font-code text-[12px] font-medium text-[#0B5F58]">Article {art.num}</div>
          <h2 data-tf-copy={`charter.art_${idx}_title`} class="font-display mt-1.5 text-[23px] font-bold text-[#161A22] leading-snug">{art.title}</h2>
          <p data-tf-copy={`charter.art_${idx}_body`} class="mt-3 text-[15px] leading-[1.7] text-[#525866] max-w-[65ch]">{art.body}</p>
          {art.linkHref && (
            <div class="mt-5">
              <a href={art.linkHref} class="inline-flex items-center h-9 px-4 rounded-lg bg-[#EAE8E1] hover:bg-[#DFDDD6] border border-[#DCD9D0] text-[13px] font-medium text-[#161A22] transition">
                {art.linkLabel}
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
