---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support" backLabel="TF Unions" backHref="/">
  <section class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left 5 Cols: Calm Zero-Overhead Pledge Card -->
    <aside class="lg:col-span-5 bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
      <div class="inline-block pl-2.5 border-l-2 border-[#0F766E] text-[13px] font-medium text-[#525866]">
        Community infrastructure funding
      </div>
      <h1 class="font-display mt-2.5 text-[30px] font-bold leading-[1.1] tracking-[-0.025em] text-[#161A22]">
        Support the mission
      </h1>
      <p class="mt-3 text-[14px] leading-[1.6] text-[#525866]">
        Every contribution directly pays for Linux server hosting, domain renewals, and student competition grants. Every transfer appears on our public Open Ledger.
      </p>

      <div class="mt-6 pt-5 border-t border-[#DFDDD6] space-y-3.5">
        <div class="p-4 rounded-lg bg-[#EDF7F5] border border-[#BCE3DC]">
          <div class="text-[12.5px] font-semibold text-[#0F766E]">100% infrastructure allocation</div>
          <div class="text-[13px] text-[#525866] mt-1">Zero executive salaries and zero recurring commercial SaaS fees.</div>
        </div>
        <div class="p-4 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] flex items-center justify-between gap-3">
          <div>
            <div class="text-[13px] font-semibold text-[#161A22]">Inspect public audit trail</div>
            <div class="text-[12px] text-[#767D8C]">Live EGP inflows, outflows, and reserve</div>
          </div>
          <a href="/transparency" class="px-3 py-1.5 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[12px] font-medium shrink-0 transition">
            Open ledger →
          </a>
        </div>
      </div>
    </aside>

    <!-- Right 7 Cols: Crisp Paper Direct Channels & Receipt Form -->
    <div class="lg:col-span-7 space-y-6">
      <section class="bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
        <h2 class="font-display text-[22px] font-bold text-[#161A22] pb-3.5 border-b border-[#DFDDD6]">
          Direct contribution channels
        </h2>
        <div class="divide-y divide-[#EAE8E1]">
          <div class="py-4 flex flex-wrap items-center justify-between gap-3">
            <div>
              <div class="text-[15px] font-semibold text-[#161A22]">InstaPay (Egypt Instant Network)</div>
              <div class="text-[12.5px] text-[#767D8C]">Instant EGP settlement</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-code text-[12.5px] font-medium text-[#161A22] bg-[#EAE8E1] border border-[#DCD9D0] px-3 py-1.5 rounded-lg">
                tfunions@instapay
              </span>
              <button
                type="button"
                data-copy="tfunions@instapay"
                class="copy-handle h-9 px-3 rounded-lg bg-[#F3F2EE] hover:bg-[#EAE8E1] border border-[#DFDDD6] text-[12px] font-medium text-[#161A22] transition"
              >
                Copy
              </button>
            </div>
          </div>
          <div class="py-4 flex flex-wrap items-center justify-between gap-3">
            <div>
              <div class="text-[15px] font-semibold text-[#161A22]">Vodafone Cash Wallet</div>
              <div class="text-[12.5px] text-[#767D8C]">Mobile wallet transfer</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-code text-[12.5px] font-medium text-[#161A22] bg-[#EAE8E1] border border-[#DCD9D0] px-3 py-1.5 rounded-lg">
                +20 10 0000 0000
              </span>
              <button
                type="button"
                data-copy="+20 10 0000 0000"
                class="copy-handle h-9 px-3 rounded-lg bg-[#F3F2EE] hover:bg-[#EAE8E1] border border-[#DFDDD6] text-[12px] font-medium text-[#161A22] transition"
              >
                Copy
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white border border-[#DFDDD6] rounded-xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
        <div class="pb-3.5 border-b border-[#DFDDD6]">
          <h2 class="font-display text-[22px] font-bold text-[#161A22]">Log transfer receipt</h2>
          <p class="text-[13px] text-[#525866] mt-0.5">Submit your transfer details so our treasury team can verify and post it to the Open Ledger.</p>
        </div>

        <div id="don-alert" class="hidden mt-4 px-4 py-3 rounded-lg border text-[13.5px] font-medium"></div>

        <form id="don-form" class="mt-5 space-y-4">
          <div>
            <label for="don-name" class="block text-[13px] font-medium text-[#161A22] mb-1">Contributor name (optional)</label>
            <input
              id="don-name"
              type="text"
              placeholder="Leave blank to post anonymously"
              class="w-full h-10 px-3.5 rounded-lg bg-[#EAE8E1]/60 text-[14px] text-[#161A22] placeholder-[#767D8C] border border-[#DFDDD6] focus:border-[#1B365D] focus:bg-white focus:outline-none transition"
            />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="don-channel" class="block text-[13px] font-medium text-[#161A22] mb-1">Channel</label>
              <select
                id="don-channel"
                class="w-full h-10 px-3.5 rounded-lg bg-[#EAE8E1]/60 text-[14px] text-[#161A22] border border-[#DFDDD6] focus:border-[#1B365D] focus:bg-white focus:outline-none transition"
              >
                <option value="InstaPay">InstaPay</option>
                <option value="Vodafone_Cash">Vodafone Cash</option>
                <option value="Bank_Transfer">Bank Transfer</option>
              </select>
            </div>
            <div>
              <label for="don-amount" class="block text-[13px] font-medium text-[#161A22] mb-1">Amount (EGP)</label>
              <input
                id="don-amount"
                type="number"
                required
                min="10"
                placeholder="e.g. 250"
                class="w-full h-10 px-3.5 rounded-lg bg-[#EAE8E1]/60 text-[14px] text-[#161A22] placeholder-[#767D8C] border border-[#DFDDD6] focus:border-[#1B365D] focus:bg-white focus:outline-none transition"
              />
            </div>
          </div>
          <div>
            <label for="don-proof" class="block text-[13px] font-medium text-[#161A22] mb-1">Receipt reference or image link (optional)</label>
            <input
              id="don-proof"
              type="url"
              placeholder="https://..."
              class="w-full h-10 px-3.5 rounded-lg bg-[#EAE8E1]/60 text-[14px] text-[#161A22] placeholder-[#767D8C] border border-[#DFDDD6] focus:border-[#1B365D] focus:bg-white focus:outline-none transition"
            />
          </div>
          <button
            type="submit"
            class="w-full h-10 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white font-medium text-[14px] transition"
          >
            Submit receipt for audit
          </button>
        </form>
      </section>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.copy-handle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-copy');
        if (val && navigator.clipboard) {
          navigator.clipboard.writeText(val).then(() => {
            btn.textContent = 'Copied';
            setTimeout(() => { btn.textContent = 'Copy'; }, 1400);
          });
        }
      });
    });

    const form = document.getElementById('don-form');
    const alertBox = document.getElementById('don-alert');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.textContent = 'Recording receipt...';
      alertBox.className = 'mt-4 px-4 py-3 rounded-lg bg-[#EAE8E1] border border-[#DFDDD6] text-[#161A22] text-[13.5px] font-medium';
      alertBox.classList.remove('hidden');
      try {
        const nameVal = document.getElementById('don-name').value.trim();
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/submit-donation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            donorName: nameVal || 'Anonymous Supporter',
            isAnonymous: !nameVal,
            paymentChannel: document.getElementById('don-channel').value,
            amountEgp: Number(document.getElementById('don-amount').value),
            proofUrl: document.getElementById('don-proof').value.trim(),
          }),
        });
        if (!res.ok) throw new Error('Receipt log failed');
        alertBox.textContent = 'Thank you. Your receipt has been logged for verification.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-lg bg-[#EDF7F5] border border-[#BCE3DC] text-[#0F766E] text-[13.5px] font-medium';
        form.reset();
      } catch {
        alertBox.textContent = 'Could not submit receipt.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-lg bg-[#FEF2F2] border border-[#FECACA] text-[#B91C1C] text-[13.5px] font-medium';
      }
    });
  </script>
</BaseLayout>
