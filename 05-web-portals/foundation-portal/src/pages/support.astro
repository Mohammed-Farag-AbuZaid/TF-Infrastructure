---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support" backLabel="TF Unions" backHref="/">
  <section class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left 5 Cols: Deep Oxford Navy Zero-Overhead Pledge -->
    <aside class="lg:col-span-5 bg-[#0A1931] text-white border border-[#1E3A6D] rounded-lg p-7 sm:p-8 shadow-[0_3px_12px_rgba(10,25,49,0.08)]">
      <div class="inline-block pl-3 border-l-2 border-[#C88A14] text-[13px] font-medium text-[#E2E8F0]">
        Community infrastructure funding
      </div>
      <h1 class="font-display mt-3 text-[34px] font-bold leading-[1.08] text-white">
        Support the mission
      </h1>
      <p class="mt-3 text-[14.5px] leading-[1.6] text-[#CBD5E1]">
        Every contribution directly pays for Linux server hosting, domain renewals, and student competition grants. Every transfer appears on our public Open Ledger.
      </p>

      <div class="mt-6 pt-5 border-t border-[#1E3A6D] space-y-4">
        <div class="p-4 rounded-md bg-[#102447] border border-[#1E3A6D]">
          <div class="text-[12px] font-semibold text-[#C88A14]">100% Infrastructure Allocation</div>
          <div class="text-[13.5px] text-[#CBD5E1] mt-1">Zero executive salaries and zero recurring commercial SaaS fees.</div>
        </div>
        <div class="p-4 rounded-md bg-[#102447] border border-[#1E3A6D] flex items-center justify-between gap-3">
          <div>
            <div class="text-[13px] font-semibold text-white">Inspect public audit trail</div>
            <div class="text-[12px] text-[#94A3B8]">Live EGP inflows, outflows, and reserve</div>
          </div>
          <a href="/transparency" class="px-3 py-1.5 rounded bg-[#C88A14] text-[#0A1931] text-[12px] font-bold shrink-0">
            Open Ledger ›
          </a>
        </div>
      </div>
    </aside>

    <!-- Right 7 Cols: Crisp Paper Direct Channels & Receipt Form -->
    <div class="lg:col-span-7 space-y-6">
      <section class="bg-white border border-[#CFCBC2] rounded-lg p-6 sm:p-7 shadow-[0_2px_6px_rgba(10,25,49,0.04)]">
        <h2 class="font-display text-[24px] font-bold text-[#12161F] pb-3 border-b border-[#CFCBC2]">
          Direct contribution channels
        </h2>
        <div class="divide-y divide-[#E2DFD7]">
          <div class="py-4 flex flex-wrap items-center justify-between gap-3">
            <div>
              <div class="text-[15.5px] font-semibold text-[#12161F]">InstaPay (Egypt Instant Network)</div>
              <div class="text-[13px] text-[#4A5262]">Instant EGP settlement</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-code text-[13px] font-semibold text-[#12161F] bg-[#ECEAE4] border border-[#CFCBC2] px-3 py-1.5 rounded">
                tfunions@instapay
              </span>
              <button
                type="button"
                data-copy="tfunions@instapay"
                class="copy-handle h-9 px-3 rounded bg-[#E2DFD7] hover:bg-[#D5D1C7] border border-[#C8C3B8] text-[12px] font-semibold text-[#12161F] transition"
              >
                Copy
              </button>
            </div>
          </div>
          <div class="py-4 flex flex-wrap items-center justify-between gap-3">
            <div>
              <div class="text-[15.5px] font-semibold text-[#12161F]">Vodafone Cash Wallet</div>
              <div class="text-[13px] text-[#4A5262]">Mobile wallet transfer</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-code text-[13px] font-semibold text-[#12161F] bg-[#ECEAE4] border border-[#CFCBC2] px-3 py-1.5 rounded">
                +20 10 0000 0000
              </span>
              <button
                type="button"
                data-copy="+20 10 0000 0000"
                class="copy-handle h-9 px-3 rounded bg-[#E2DFD7] hover:bg-[#D5D1C7] border border-[#C8C3B8] text-[12px] font-semibold text-[#12161F] transition"
              >
                Copy
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white border border-[#CFCBC2] rounded-lg p-6 sm:p-7 shadow-[0_2px_6px_rgba(10,25,49,0.04)]">
        <div class="pb-3 border-b border-[#CFCBC2]">
          <h2 class="font-display text-[24px] font-bold text-[#12161F]">Log transfer receipt</h2>
          <p class="text-[13px] text-[#4A5262] mt-0.5">Submit your transfer details so our treasury team can verify and post it to the Open Ledger.</p>
        </div>

        <div id="don-alert" class="hidden mt-4 px-4 py-3 rounded-md border text-[13.5px] font-medium"></div>

        <form id="don-form" class="mt-5 space-y-4">
          <div>
            <label for="don-name" class="block text-[13px] font-semibold text-[#12161F] mb-1">Contributor name (optional)</label>
            <input
              id="don-name"
              type="text"
              placeholder="Leave blank to post anonymously"
              class="w-full h-11 px-3.5 rounded-md bg-[#ECEAE4] text-[14.5px] text-[#12161F] placeholder-[#687082] border border-[#CFCBC2] focus:border-[#14388C] focus:bg-white focus:outline-none transition"
            />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="don-channel" class="block text-[13px] font-semibold text-[#12161F] mb-1">Channel</label>
              <select
                id="don-channel"
                class="w-full h-11 px-3.5 rounded-md bg-[#ECEAE4] text-[14.5px] text-[#12161F] border border-[#CFCBC2] focus:border-[#14388C] focus:bg-white focus:outline-none transition"
              >
                <option value="InstaPay">InstaPay</option>
                <option value="Vodafone_Cash">Vodafone Cash</option>
                <option value="Bank_Transfer">Bank Transfer</option>
              </select>
            </div>
            <div>
              <label for="don-amount" class="block text-[13px] font-semibold text-[#12161F] mb-1">Amount (EGP)</label>
              <input
                id="don-amount"
                type="number"
                required
                min="10"
                placeholder="e.g. 250"
                class="w-full h-11 px-3.5 rounded-md bg-[#ECEAE4] text-[14.5px] text-[#12161F] placeholder-[#687082] border border-[#CFCBC2] focus:border-[#14388C] focus:bg-white focus:outline-none transition"
              />
            </div>
          </div>
          <div>
            <label for="don-proof" class="block text-[13px] font-semibold text-[#12161F] mb-1">Receipt reference or image link (optional)</label>
            <input
              id="don-proof"
              type="url"
              placeholder="https://..."
              class="w-full h-11 px-3.5 rounded-md bg-[#ECEAE4] text-[14.5px] text-[#12161F] placeholder-[#687082] border border-[#CFCBC2] focus:border-[#14388C] focus:bg-white focus:outline-none transition"
            />
          </div>
          <button
            type="submit"
            class="w-full h-11 rounded-md bg-[#14388C] hover:bg-[#0F2C70] text-white font-semibold text-[14.5px] transition"
          >
            Submit Receipt for Audit
          </button>
        </form>
      </section>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.copy-handle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-copy');
        if (val && navigator.clipboard) {
          navigator.clipboard.writeText(val).then(() => {
            btn.textContent = 'Copied';
            setTimeout(() => { btn.textContent = 'Copy'; }, 1400);
          });
        }
      });
    });

    const form = document.getElementById('don-form');
    const alertBox = document.getElementById('don-alert');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.textContent = 'Recording receipt...';
      alertBox.className = 'mt-4 px-4 py-3 rounded-md bg-[#E2DFD7] border border-[#CFCBC2] text-[#12161F] text-[13.5px] font-medium';
      alertBox.classList.remove('hidden');
      try {
        const nameVal = document.getElementById('don-name').value.trim();
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/submit-donation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            donorName: nameVal || 'Anonymous Supporter',
            isAnonymous: !nameVal,
            paymentChannel: document.getElementById('don-channel').value,
            amountEgp: Number(document.getElementById('don-amount').value),
            proofUrl: document.getElementById('don-proof').value.trim(),
          }),
        });
        if (!res.ok) throw new Error('Receipt log failed');
        alertBox.textContent = 'Thank you. Your receipt has been logged for verification.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-md bg-[#F0FDF4] border border-[#BBF7D0] text-[#15803D] text-[13.5px] font-medium';
        form.reset();
      } catch {
        alertBox.textContent = 'Could not submit receipt.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-md bg-[#FEF2F2] border border-[#FECACA] text-[#B91C1C] text-[13.5px] font-medium';
      }
    });
  </script>
</BaseLayout>
