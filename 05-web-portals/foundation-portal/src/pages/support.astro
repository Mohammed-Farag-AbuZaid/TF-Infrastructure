---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support & Sponsor TF Unions">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <span class="text-xs font-bold uppercase tracking-widest text-[#FFB800]">Sustain the Ecosystem</span>
    <h1 class="font-['Exo_2'] font-extrabold text-4xl sm:text-5xl mt-2">Support TF Unions</h1>
    <p class="mt-3 text-slate-300 max-w-2xl text-base leading-relaxed">
      100% of community contributions and sponsorships go directly toward VPS hosting, domain renewals, and seasonal student programs — verified publicly on our <a href="/transparency" class="text-[#FFB800] underline">Open-Book Financial Ledger</a>.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
      <!-- Individual Support Card -->
      <div class="bg-[#0C1636] border border-white/10 rounded-2xl p-7">
        <span class="text-xs font-bold uppercase tracking-wider text-[#FFB800]">Individual Supporters &amp; Alumni</span>
        <h2 class="font-['Exo_2'] font-bold text-2xl mt-2">Instant Transfer Channels</h2>
        <div class="mt-5 space-y-4 text-sm">
          <div class="p-4 rounded-xl bg-[#070E24] border border-white/10">
            <div class="font-bold text-[#FFB800]">1. InstaPay Egypt</div>
            <div class="text-xs text-slate-300 mt-1">InstaPay Address (IPA): <code class="text-white font-mono">tfunions@instapay</code></div>
          </div>
          <div class="p-4 rounded-xl bg-[#070E24] border border-white/10">
            <div class="font-bold text-red-400">2. Vodafone Cash</div>
            <div class="text-xs text-slate-300 mt-1">Wallet Number: <code class="text-white font-mono">+20 100 000 0000</code></div>
          </div>
          <div class="p-4 rounded-xl bg-[#070E24] border border-white/10">
            <div class="font-bold text-cyan-300">3. International / Open Collective</div>
            <div class="text-xs text-slate-300 mt-1">Contribute in USD/EUR via <a href="https://opencollective.com/tfunions" class="underline text-white">opencollective.com/tfunions</a></div>
          </div>
        </div>

        <hr class="my-6 border-white/10" />

        <h3 class="font-['Exo_2'] font-bold text-lg">30-Second Transfer Receipt Verification</h3>
        <p class="text-xs text-slate-400 mt-1 mb-4">
          Submit your transfer reference so the Founders can approve and publish it to the Open-Book Ledger (or mark it Anonymous).
        </p>

        <div id="don-alert" class="hidden mb-3 p-3 rounded-xl text-xs"></div>

        <form id="donation-form" class="space-y-3">
          <input id="d-name" placeholder="Your Name (or leave blank for Anonymous)" class="w-full px-3.5 py-2 rounded-xl bg-[#070E24] border border-white/15 text-xs text-white" />
          <input id="d-email" type="email" required placeholder="Email for Official Receipt" class="w-full px-3.5 py-2 rounded-xl bg-[#070E24] border border-white/15 text-xs text-white" />
          <div class="grid grid-cols-2 gap-3">
            <select id="d-channel" class="px-3 py-2 rounded-xl bg-[#070E24] border border-white/15 text-xs text-white">
              <option value="InstaPay">InstaPay</option>
              <option value="Vodafone_Cash">Vodafone Cash</option>
              <option value="Open_Collective">Open Collective</option>
            </select>
            <input id="d-egp" type="number" step="0.01" required placeholder="Amount (EGP)" class="px-3.5 py-2 rounded-xl bg-[#070E24] border border-white/15 text-xs text-white" />
          </div>
          <input id="d-proof" type="url" placeholder="Link to Receipt Screenshot (Drive / Imgur)" class="w-full px-3.5 py-2 rounded-xl bg-[#070E24] border border-white/15 text-xs text-white" />
          <label class="flex items-center gap-2 text-xs text-slate-300">
            <input id="d-anon" type="checkbox" class="rounded" />
            Mask my name as "Anonymous Supporter" on the public ledger
          </label>
          <button type="submit" class="w-full py-2.5 rounded-xl bg-[#FFB800] text-[#070E24] font-['Exo_2'] font-bold text-xs hover:bg-[#ffc633] transition">
            Submit Transfer Receipt →
          </button>
        </form>
      </div>

      <!-- Corporate & Institutional Sponsors Card -->
      <div class="bg-[#0C1636] border border-[#FFB800]/30 rounded-2xl p-7 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#FFB800]">Corporate &amp; Institutional Partners</span>
          <h2 class="font-['Exo_2'] font-bold text-2xl mt-2">Sponsor Egypt’s STEM Pipeline</h2>
          <p class="mt-2 text-xs text-slate-300 leading-relaxed">
            Partner with TF Unions to sponsor our annual VPS &amp; domain infrastructure, fund Olympiad preparation cohorts, or underwrite student research micro-grants.
          </p>

          <div class="mt-6 space-y-4">
            <div class="p-4 rounded-xl bg-[#070E24] border border-white/10">
              <div class="flex justify-between items-center">
                <span class="font-['Exo_2'] font-bold text-sm text-white">Infrastructure Patron</span>
                <span class="text-xs font-bold text-[#FFB800]">$150 / year</span>
              </div>
              <p class="text-xs text-slate-400 mt-1">Covers 100% of annual VPS hosting &amp; domain renewals with permanent recognition on our Open Ledger.</p>
            </div>

            <div class="p-4 rounded-xl bg-[#070E24] border border-white/10">
              <div class="flex justify-between items-center">
                <span class="font-['Exo_2'] font-bold text-sm text-white">Seasonal Cohort Partner</span>
                <span class="text-xs font-bold text-[#FFB800]">$500 / season</span>
              </div>
              <p class="text-xs text-slate-400 mt-1">Sponsors a full TF Connect / TF Guide seasonal cohort and co-brands official completion certificates.</p>
            </div>
          </div>
        </div>

        <div class="mt-8 space-y-3">
          <a
            href="mailto:founders@tfunions.org?subject=TF%20Unions%20Sponsorship%20Inquiry"
            class="block text-center w-full py-3 rounded-xl bg-white text-[#070E24] font-['Exo_2'] font-bold text-xs hover:bg-slate-100 transition"
          >
            Contact Founders (founders@tfunions.org) →
          </a>
          <a
            href="/transparency"
            class="block text-center w-full py-2.5 rounded-xl bg-white/5 border border-white/15 text-slate-200 font-semibold text-xs hover:bg-white/10 transition"
          >
            Inspect Open-Book Financial Ledger
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('donation-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const alertEl = document.getElementById('don-alert');
      try {
        const res = await fetch('https://auto.tfunions.org/webhook/submit-donation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            txType: 'Incoming_Donation',
            donorName: document.getElementById('d-name').value,
            donorEmail: document.getElementById('d-email').value,
            paymentChannel: document.getElementById('d-channel').value,
            amountEgp: Number(document.getElementById('d-egp').value),
            proofUrl: document.getElementById('d-proof').value,
            isAnonymous: document.getElementById('d-anon').checked,
            category: 'General_Support',
          }),
        });
        if (!res.ok) throw new Error('Failed');
        alertEl.textContent = '💛 Thank you! Your receipt was sent to the Founders for one-tap Telegram verification.';
        alertEl.className = 'mb-3 p-3 rounded-xl text-xs bg-emerald-500/20 text-emerald-200 border border-emerald-500/40';
        alertEl.classList.remove('hidden');
        e.target.reset();
      } catch {
        alertEl.textContent = '⚠️ Could not reach verification webhook. Please try again shortly.';
        alertEl.className = 'mb-3 p-3 rounded-xl text-xs bg-amber-500/20 text-amber-200 border border-amber-500/40';
        alertEl.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
