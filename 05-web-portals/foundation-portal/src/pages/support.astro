---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support" backLabel="TF Unions" backHref="/">
  <section class="mt-14 sm:mt-20 max-w-[640px]">
    <h1 class="text-[36px] sm:text-[52px] font-bold tracking-[-1.6px] leading-[1.08] text-[#1D1D1F]">
      Support the mission.
    </h1>
    <p class="mt-4 text-[17px] leading-[1.5] text-[#6E6E73]">
      100% of contributions fund server infrastructure and student programs, recorded publicly on our <a href="/transparency" class="text-[#002583] font-medium hover:underline">Open Ledger</a>.
    </p>
  </section>

  <section class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-14">
    <div>
      <h2 class="text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Direct channels</h2>
      <div class="mt-3 border-t border-[#D2D2D7]/70 divide-y divide-[#D2D2D7]/70">
        <div class="py-4 flex items-center justify-between">
          <div>
            <div class="text-[12px] text-[#6E6E73]">Egypt Instant Payment Network</div>
            <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">InstaPay</div>
          </div>
          <span class="font-mono text-[14px] text-[#1D1D1F]">tfunions@instapay</span>
        </div>
        <div class="py-4 flex items-center justify-between">
          <div>
            <div class="text-[12px] text-[#6E6E73]">Mobile Wallet</div>
            <div class="text-[16px] font-semibold text-[#1D1D1F] mt-0.5">Vodafone Cash</div>
          </div>
          <span class="font-mono text-[14px] text-[#1D1D1F]">+20 10 0000 0000</span>
        </div>
      </div>
    </div>

    <div>
      <h2 class="text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">Log transfer receipt</h2>
      <div id="don-alert" class="hidden mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[14px] font-medium"></div>
      <form id="don-form" class="mt-4 space-y-3.5">
        <input
          id="don-name"
          type="text"
          placeholder="Name (or leave blank for anonymous)"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <div class="grid grid-cols-2 gap-3">
          <select
            id="don-channel"
            class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
          >
            <option value="InstaPay">InstaPay</option>
            <option value="Vodafone_Cash">Vodafone Cash</option>
            <option value="Bank_Transfer">Bank Transfer</option>
          </select>
          <input
            id="don-amount"
            type="number"
            required
            min="10"
            placeholder="Amount (EGP)"
            class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
          />
        </div>
        <input
          id="don-proof"
          type="url"
          placeholder="Receipt screenshot link (optional)"
          class="w-full px-4 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <button
          type="submit"
          class="w-full h-12 rounded-[12px] bg-[#002583] hover:opacity-95 text-white font-semibold text-[15px] transition"
        >
          Submit receipt
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('don-form');
    const alertBox = document.getElementById('don-alert');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.textContent = 'Recording receipt...';
      alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#6E6E73] text-[14px] font-medium';
      alertBox.classList.remove('hidden');
      try {
        const nameVal = document.getElementById('don-name').value.trim();
        await fetch('https://n8n.tfunions.com/tf-api/api/submit-donation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            donorName: nameVal || 'Anonymous Supporter',
            isAnonymous: !nameVal,
            paymentChannel: document.getElementById('don-channel').value,
            amountEgp: Number(document.getElementById('don-amount').value),
            proofUrl: document.getElementById('don-proof').value.trim(),
          }),
        });
        alertBox.textContent = 'Thank you. Your receipt has been logged for verification.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#15803D] text-[14px] font-medium';
        form.reset();
      } catch {
        alertBox.textContent = 'Could not submit receipt.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-[12px] bg-[#F5F5F7] text-[#B91C1C] text-[14px] font-medium';
      }
    });
  </script>
</BaseLayout>
