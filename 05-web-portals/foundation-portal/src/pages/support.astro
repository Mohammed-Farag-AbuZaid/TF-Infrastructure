---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support" backLabel="TF Unions" backHref="/">
  <section class="mt-8 sm:mt-12 bg-white border border-[#E2E5EC] rounded-2xl p-7 sm:p-10 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
    <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">SUSTAINABILITY</div>
    <h1 class="mt-2 text-[32px] sm:text-[46px] font-bold tracking-[-0.03em] leading-[1.08] text-[#11141C]">
      Support the mission.
    </h1>
    <p class="mt-4 text-[16px] sm:text-[17px] leading-[1.55] text-[#525866] max-w-[660px]">
      100% of contributions fund open server infrastructure and student initiatives, recorded transparently on our <a href="/transparency" class="text-[#002583] font-semibold hover:underline">Open Ledger</a>.
    </p>
  </section>

  <section class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    <!-- Direct Channels Widget -->
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#002583]">PAYMENT RAILS</div>
      <h2 class="mt-1 text-[22px] font-bold tracking-[-0.02em] text-[#11141C]">Direct channels</h2>
      <div class="mt-4 border-t border-[#E2E5EC] divide-y divide-[#E2E5EC]">
        <div class="py-4 flex items-center justify-between gap-4">
          <div>
            <div class="text-[12px] text-[#7A8191]">Egypt Instant Payment Network</div>
            <div class="text-[16px] font-semibold text-[#11141C] mt-0.5">InstaPay</div>
          </div>
          <span class="font-mono text-[13px] font-semibold text-[#11141C] bg-[#F8F9FB] border border-[#E2E5EC] px-3 py-1.5 rounded-lg">tfunions@instapay</span>
        </div>
        <div class="py-4 flex items-center justify-between gap-4">
          <div>
            <div class="text-[12px] text-[#7A8191]">Mobile Wallet</div>
            <div class="text-[16px] font-semibold text-[#11141C] mt-0.5">Vodafone Cash</div>
          </div>
          <span class="font-mono text-[13px] font-semibold text-[#11141C] bg-[#F8F9FB] border border-[#E2E5EC] px-3 py-1.5 rounded-lg">+20 10 0000 0000</span>
        </div>
      </div>
    </div>

    <!-- Log Receipt Widget -->
    <div class="bg-white border border-[#E2E5EC] rounded-2xl p-6 sm:p-7 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#D99B00]">VERIFICATION QUEUE</div>
      <h2 class="mt-1 text-[22px] font-bold tracking-[-0.02em] text-[#11141C]">Log transfer receipt</h2>
      <div id="don-alert" class="hidden mt-4 px-4 py-3 rounded-xl border text-[14px] font-medium"></div>
      <form id="don-form" class="mt-5 space-y-3.5">
        <input
          id="don-name"
          type="text"
          placeholder="Name (or leave blank for anonymous)"
          class="w-full px-4 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] placeholder-[#7A8191] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <div class="grid grid-cols-2 gap-3">
          <select
            id="don-channel"
            class="w-full px-4 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
          >
            <option value="InstaPay">InstaPay</option>
            <option value="Vodafone_Cash">Vodafone Cash</option>
            <option value="Bank_Transfer">Bank Transfer</option>
          </select>
          <input
            id="don-amount"
            type="number"
            required
            min="10"
            placeholder="Amount (EGP)"
            class="w-full px-4 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] placeholder-[#7A8191] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
          />
        </div>
        <input
          id="don-proof"
          type="url"
          placeholder="Receipt screenshot link (optional)"
          class="w-full px-4 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] placeholder-[#7A8191] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
        />
        <button
          type="submit"
          class="w-full h-11 rounded-xl bg-[#002583] hover:bg-[#001B61] text-white font-semibold text-[15px] transition shadow-[0_1px_2px_rgba(15,23,42,0.08)]"
        >
          Submit receipt
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('don-form');
    const alertBox = document.getElementById('don-alert');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.textContent = 'Recording receipt...';
      alertBox.className = 'mt-4 px-4 py-3 rounded-xl bg-[#F3F5F8] border border-[#E2E5EC] text-[#525866] text-[14px] font-medium';
      alertBox.classList.remove('hidden');
      try {
        const nameVal = document.getElementById('don-name').value.trim();
        const res = await fetch('https://n8n.tfunions.com/tf-api/api/submit-donation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            donorName: nameVal || 'Anonymous Supporter',
            isAnonymous: !nameVal,
            paymentChannel: document.getElementById('don-channel').value,
            amountEgp: Number(document.getElementById('don-amount').value),
            proofUrl: document.getElementById('don-proof').value.trim(),
          }),
        });
        if (!res.ok) throw new Error('Receipt log failed');
        alertBox.textContent = 'Thank you. Your receipt has been logged for verification.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-xl bg-[#F0FDF4] border border-[#BBF7D0] text-[#15803D] text-[14px] font-medium';
        form.reset();
      } catch {
        alertBox.textContent = 'Could not submit receipt.';
        alertBox.className = 'mt-4 px-4 py-3 rounded-xl bg-[#FEF2F2] border border-[#FECACA] text-[#B91C1C] text-[14px] font-medium';
      }
    });
  </script>
</BaseLayout>
