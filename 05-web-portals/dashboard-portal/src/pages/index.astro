      const SEED = JSON.parse(document.getElementById('dash-seed').textContent || '{}');
      const BASELINE_MEMBERS = SEED.BASELINE_MEMBERS || [];
      const COPY_CATALOG = SEED.COPY_CATALOG || [];

      const app = initializeApp({
        apiKey: 'AIzaSyB0bILaWHg8QXuwl3Fhfht3BQnYLgTkWUk',
        authDomain: 'tf-unions.firebaseapp.com',
        projectId: 'tf-unions',
        storageBucket: 'tf-unions.firebasestorage.app',
        messagingSenderId: '879703010053',
        appId: '1:879703010053:web:1fe4e4476ab1680a67a56c',
      });
      const auth = getAuth(app);
      const db = getFirestore(app);
      const googleProvider = new GoogleAuthProvider();
      googleProvider.setCustomParameters({ prompt: 'select_account' });

      const ALL_PERMS = [
        { key: 'edit_site_copy', label: 'Edit Website Sentences', desc: 'Inline click-to-edit copy across all 6 TF portals & Global Replace.' },
        { key: 'edit_ledger', label: 'Manage Open Ledger', desc: 'Add, edit, or delete public EGP inflows, outflows & receipts.' },
        { key: 'edit_chapters', label: 'Manage Connect Chapters', desc: 'Create and edit school chapters & project guilds on TF Connect.' },
        { key: 'edit_guides', label: 'Manage Research Guides', desc: 'Publish and edit research & olympiad workbooks on TF Guides.' },
        { key: 'edit_opportunities', label: 'Manage News Opportunities', desc: 'Publish and update live scholarships & deadlines on TF News.' },
        { key: 'manage_certificates', label: 'Issue & Revoke Certificates', desc: 'Mint and manage verifiable serial credentials on TF Verify.' },
        { key: 'edit_team', label: 'Manage Team & HR Roster', desc: 'Edit public team members and view applicant/member profiles.' },
        { key: 'manage_tasks', label: 'Create & Assign Tasks / Awards', desc: 'Create tasks across teams and grant Top Achiever awards.' },
        { key: 'moderate_submissions', label: 'Moderate Submissions', desc: 'Review private volunteer applications & community idea submissions.' },
        { key: 'manage_access', label: 'Manage Access & Role Rules', desc: 'View all logged-in users, create Role Rules, and assign teammates.' },
      ];

      const DEFAULT_ROLE_RULES = [
        {
          id: 'owner',
          name: 'Owner',
          defaultTeam: 'Founders',
          description: 'Full platform ownership, Role Rules builder, financial oversight, and access control.',
          permissions: ALL_PERMS.map((p) => p.key),
        },
        {
          id: 'hr_lead',
          name: 'HR Lead',
          defaultTeam: 'HR Team',
          description: 'Inspect logged-in candidates & applicants, assign teams, and manage tasks.',
          permissions: ['edit_team', 'manage_tasks', 'moderate_submissions', 'manage_access'],
        },
        {
          id: 'marketing_head',
          name: 'Marketing Head',
          defaultTeam: 'Marketing Team',
          description: 'Manage public website messaging, news opportunities, and marketing tasks.',
          permissions: ['edit_site_copy', 'edit_opportunities', 'manage_tasks'],
        },
        {
          id: 'content_editor',
          name: 'Content Editor',
          defaultTeam: 'Research & Guides',
          description: 'Edit portal copy, publish TF Guides workbooks, Connect chapters, and News items.',
          permissions: ['edit_site_copy', 'edit_guides', 'edit_chapters', 'edit_opportunities'],
        },
        {
          id: 'finance_treasurer',
          name: 'Finance Treasurer',
          defaultTeam: 'Finance & Operations',
          description: 'Record verified EGP inflows, infrastructure expenses, memos, and receipt proofs.',
          permissions: ['edit_ledger'],
        },
        {
          id: 'team_member',
          name: 'Team Member',
          defaultTeam: '',
          description: 'Standard dashboard collaborator access: Tasks Board and Work Session Time Logs.',
          permissions: [],
        },
      ];

      const CANONICAL_TEAMS = [
        'Founders',
        'HR Team',
        'PR Team',
        'Marketing Team',
        'Social Media Team',
        'IT Team',
        'Research & Guides',
        'Chapters & Connect',
        'Finance & Operations',
      ];

      function populateCanonicalTeamSelects() {
        document.querySelectorAll('.canonical-team-select').forEach((sel) => {
          const prev = sel.value;
          sel.replaceChildren();
          CANONICAL_TEAMS.forEach((t) => {
            const opt = document.createElement('option');
            opt.value = t;
            opt.textContent = t;
            sel.appendChild(opt);
          });
          if (prev && CANONICAL_TEAMS.includes(prev)) sel.value = prev;
        });
      }
      populateCanonicalTeamSelects();

      function currentYm() {
        return new Date().toISOString().slice(0, 7);
      }

      function safeHttpUrl(raw) {
        const s = String(raw || '').trim();
        if (!s) return '';
        try {
          const u = new URL(s);
          return u.protocol === 'https:' || u.protocol === 'http:' ? u.href : '';
        } catch {
          return '';
        }
      }

      const CONTENT_TABS = [
        { id: 'ledger', label: 'Open Ledger', perm: 'edit_ledger' },
        { id: 'submissions', label: 'Submissions Inbox', perms: ['moderate_submissions', 'edit_ledger', 'edit_chapters', 'manage_access', 'edit_team'] },
        { id: 'chapters', label: 'Chapters', perm: 'edit_chapters' },
        { id: 'guides', label: 'Guides', perm: 'edit_guides' },
        { id: 'opportunities', label: 'Opportunities', perm: 'edit_opportunities' },
        { id: 'certificates', label: 'Certificates', perm: 'manage_certificates' },
      ];

      function canTab(t) {
        if (Array.isArray(t.perms)) return t.perms.some((p) => can(p));
        return can(t.perm);
      }

      let currentUser = null;
      let activeRole = 'member';
      let activePerms = new Set();
      let activeWorkspace = 'home';
      let activeContentTab = 'ledger';
      let activeTeamTab = 'tasks';
      let timerStartedAt = null;
      let timerInterval = null;

      function esc(s) {
        return String(s ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function showToast(msg) {
        const el = document.getElementById('dash-toast');
        el.textContent = msg;
        el.classList.remove('hidden');
        clearTimeout(window.__t);
        window.__t = setTimeout(() => el.classList.add('hidden'), 3200);
      }

      function showGate(name) {
        ['gate-loading', 'gate-signin', 'gate-unverified', 'gate-denied', 'dash-shell'].forEach((id) => {
          const el = document.getElementById(id);
          el.classList.add('hidden');
          if (id === 'dash-shell') el.classList.remove('grid');
        });
        const target = document.getElementById(name);
        target.classList.remove('hidden');
        if (name === 'dash-shell') target.classList.add('grid');
      }

      function can(perm) {
        if (!perm) return true;
        if (['owner', 'admin', 'founder'].includes(activeRole)) return true;
        return activePerms.has(perm);
      }

      async function writeAudit(section, action, targetId, summary) {
        if (!currentUser) return;
        try {
          await addDoc(collection(db, 'auditLogs'), {
            actorUid: currentUser.uid,
            actorEmail: (currentUser.email || '').toLowerCase(),
            section,
            action,
            targetId: String(targetId || ''),
            summary: String(summary || '').slice(0, 220),
            createdAt: serverTimestamp(),
            createdIso: new Date().toISOString(),
          });
        } catch {}
      }

      function getVisibleWorkspaces() {
        const items = [{ id: 'home', label: 'Home' }];
        if (can('edit_site_copy')) items.push({ id: 'copy', label: 'Website Editor' });
        if (CONTENT_TABS.some((t) => canTab(t))) items.push({ id: 'content', label: 'Content & Data' });
        items.push({ id: 'teamwork', label: 'Team & Tasks' });
        if (can('manage_access')) items.push({ id: 'access', label: 'Access & Activity' });
        return items;
      }

      function renderNav() {
        const allowed = getVisibleWorkspaces();
        if (!allowed.some((n) => n.id === activeWorkspace)) activeWorkspace = allowed[0]?.id || 'home';

        const makeLinks = (container, onPick) => {
          container.replaceChildren();
          allowed.forEach((n) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            const sel = n.id === activeWorkspace;
            btn.className =
              'w-full text-left px-3 py-2.5 rounded-lg text-[13.5px] font-medium transition ' +
              (sel ? 'bg-white text-[#0F1D33] font-semibold' : 'text-[#C7D0DE] hover:bg-white/10 hover:text-white');
            btn.textContent = n.label;
            btn.addEventListener('click', () => {
              activeWorkspace = n.id;
              renderNav();
              switchWorkspace(n.id);
              if (onPick) onPick();
            });
            container.appendChild(btn);
          });
        };

        makeLinks(document.getElementById('dash-nav'));
        makeLinks(document.getElementById('mobile-nav-drawer'), () => {
          document.getElementById('mobile-nav-drawer').classList.add('hidden');
        });
        document.getElementById('active-page-title').textContent =
          allowed.find((n) => n.id === activeWorkspace)?.label || 'Home';
      }

      function switchWorkspace(id) {
        document.querySelectorAll('.dash-view').forEach((v) => v.classList.add('hidden'));
        document.getElementById('view-' + id)?.classList.remove('hidden');
        if (id === 'home') loadHome();
        else if (id === 'copy') loadWebsiteEditor();
        else if (id === 'content') initContentWorkspace();
        else if (id === 'teamwork') loadTeamworkPane(activeTeamTab);
        else if (id === 'access') loadAccessAndAudit();
      }

      document.getElementById('btn-go-tasks').addEventListener('click', () => {
        activeWorkspace = 'teamwork';
        activeTeamTab = 'tasks';
        renderNav();
        switchWorkspace('teamwork');
      });

      document.getElementById('kpi-members-btn').addEventListener('click', () => {
        activeWorkspace = 'teamwork';
        activeTeamTab = 'roster';
        renderNav();
        switchWorkspace('teamwork');
      });
      document.getElementById('kpi-tasks-btn').addEventListener('click', () => {
        activeWorkspace = 'teamwork';
        activeTeamTab = 'tasks';
        renderNav();
        switchWorkspace('teamwork');
      });
      document.getElementById('kpi-logs-btn').addEventListener('click', () => {
        activeWorkspace = 'teamwork';
        activeTeamTab = 'timelogs';
        renderNav();
        switchWorkspace('teamwork');
      });
      document.getElementById('kpi-submissions-btn').addEventListener('click', () => {
        if (!CONTENT_TABS.some((t) => canTab(t))) return;
        activeWorkspace = 'content';
        activeContentTab = 'submissions';
        renderNav();
        switchWorkspace('content');
      });
      document.getElementById('kpi-ledger-btn').addEventListener('click', () => {
        if (!can('edit_ledger')) return;
        activeWorkspace = 'content';
        activeContentTab = 'ledger';
        renderNav();
        switchWorkspace('content');
      });

      // ---- LIVE TIMER & WORK LOG ----
      function fmtSecs(sec) {
        const h = String(Math.floor(sec / 3600)).padStart(2, '0');
        const m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        return `${h}:${m}:${s}`;
      }

      document.getElementById('timer-toggle-btn').addEventListener('click', async () => {
        const btn = document.getElementById('timer-toggle-btn');
        if (!timerStartedAt) {
          timerStartedAt = Date.now();
          btn.textContent = 'Stop & log';
          btn.className = 'ml-1 h-7 px-2.5 rounded bg-[#B42318] text-white text-[12px] font-medium transition';
          timerInterval = setInterval(() => {
            document.getElementById('timer-readout').textContent = fmtSecs(Math.floor((Date.now() - timerStartedAt) / 1000));
          }, 1000);
        } else {
          const mins = Math.max(1, Math.round((Date.now() - timerStartedAt) / 60000));
          clearInterval(timerInterval);
          timerStartedAt = null;
          document.getElementById('timer-readout').textContent = '00:00:00';
          btn.textContent = 'Start session';
          btn.className = 'ml-1 h-7 px-2.5 rounded bg-[#1B365D] hover:bg-[#132847] text-white text-[12px] font-medium transition';
          await logWorkTime('Dashboard shift session', 'Founders', mins);
        }
      });

      async function logWorkTime(summary, division, minutes) {
        await addDoc(collection(db, 'timeLogs'), {
          actorUid: currentUser.uid,
          actorEmail: (currentUser.email || '').toLowerCase(),
          actorName: currentUser.displayName || currentUser.email.split('@')[0],
          summary,
          division,
          minutes,
          createdIso: new Date().toISOString(),
        });
        await writeAudit('time', 'log', minutes + 'm', `${summary} (${minutes}m)`);
        showToast(`Logged ${minutes} mins`);
        if (activeWorkspace === 'home') loadHome();
        else if (activeWorkspace === 'teamwork' && activeTeamTab === 'timelogs') loadTimeLogs();
      }

      document.getElementById('time-log-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        await logWorkTime(
          document.getElementById('tl-summary').value.trim(),
          document.getElementById('tl-division').value,
          Number(document.getElementById('tl-minutes').value),
        );
        e.target.reset();
        document.getElementById('tl-minutes').value = 30;
      });

      // ---- 1. HOME WORKSPACE ----
      async function loadHome() {
        const [memSnap, taskSnap, logSnap, ledSnap, donSnap, volSnap, ideaSnap, photoSnap] = await Promise.all([
          getDocs(collection(db, 'teamMembers')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'tasks')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'timeLogs')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'ledgerEntries')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'donations')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'volunteers')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'ideas')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'photoSubmissions')).catch(() => ({ docs: [] })),
        ]);

        const byId = new Map(BASELINE_MEMBERS.map((m) => [m.id, { ...m }]));
        memSnap.docs.forEach((d) => {
          const v = d.data();
          if (v.archived) byId.delete(d.id);
          else byId.set(d.id, { id: d.id, ...v });
        });
        const orgAll = Array.from(byId.values());
        const activeOrg = orgAll.filter((m) => !m.endDate && m.status !== 'alumni');
        const alumniOrg = orgAll.length - activeOrg.length;

        const tasks = taskSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
        const openTasks = tasks.filter((t) => t.status !== 'done');

        const pendingDon = donSnap.docs.filter((d) => (d.data().status || 'pending') === 'pending').length;
        const pendingVol = volSnap.docs.filter((d) => (d.data().status || 'pending') === 'pending').length;
        const openIdeas = ideaSnap.docs.filter((d) => (d.data().status || 'open') === 'open').length;
        const pendingPhotos = photoSnap.docs.filter((d) => (d.data().status || 'pending') === 'pending').length;
        const totalPending = pendingDon + pendingVol + openIdeas + pendingPhotos;

        let totalMins = 0;
        const logs = logSnap.docs.map((d) => {
          const v = d.data();
          totalMins += Number(v.minutes) || 0;
          return { id: d.id, ...v };
        });
        logs.sort((a, b) => String(b.createdIso || '').localeCompare(String(a.createdIso || '')));

        let inf = 0;
        let out = 0;
        ledSnap.docs.forEach((d) => {
          const v = d.data();
          const a = Number(v.amountEgp) || 0;
          if (v.entryType === 'outflow') out += a;
          else inf += a;
        });

        document.getElementById('stat-members').textContent = String(activeOrg.length);
        document.getElementById('stat-members-sub').textContent = alumniOrg > 0 ? `${alumniOrg} alumni recorded` : 'Live on tfunions.com/team';
        document.getElementById('stat-tasks').textContent = String(openTasks.length);
        document.getElementById('stat-submissions').textContent = String(totalPending);
        document.getElementById('stat-hours').textContent = `${Math.round((totalMins / 60) * 10) / 10}h`;
        document.getElementById('stat-ledger').textContent = `${(inf - out).toLocaleString('en-US')} EGP`;

        const hTasks = document.getElementById('home-tasks-list');
        hTasks.replaceChildren();
        if (!openTasks.length) {
          hTasks.innerHTML = '<div class="py-3 text-[#767D8C]">No open tasks right now.</div>';
        } else {
          openTasks.slice(0, 4).forEach((t) => {
            const row = document.createElement('div');
            row.className = 'py-2.5 flex items-center justify-between gap-2';
            const who = t.assigneeEmail ? lookupPersonName(t.assigneeEmail) : '';
            row.innerHTML = `<div class="min-w-0"><div class="font-medium truncate">${esc(t.title)}</div><div class="text-[11.5px] text-[#767D8C]">${esc(t.division || '')}${who ? ' · ' + esc(who) : ''}</div></div><span class="font-code text-[11px] px-2 py-0.5 rounded bg-[#EAE8E1] shrink-0">${esc(t.status || 'todo')}</span>`;
            hTasks.appendChild(row);
          });
        }

        const hLogs = document.getElementById('home-logs-list');
        hLogs.replaceChildren();
        if (!logs.length) {
          hLogs.innerHTML = '<div class="py-3 text-[#767D8C]">No work sessions logged yet.</div>';
        } else {
          logs.slice(0, 4).forEach((l) => {
            const row = document.createElement('div');
            row.className = 'py-2 flex items-center justify-between gap-2';
            row.innerHTML = `<div class="min-w-0 truncate"><strong>${esc(l.actorName || '')}</strong> · ${esc(l.summary || '')}</div><span class="font-code text-[11.5px] text-[#0B5F58] shrink-0">${Number(l.minutes || 0)}m</span>`;
            hLogs.appendChild(row);
          });
        }
      }

      // ---- 2. UNIVERSAL WEBSITE TEXT EDITOR (ALL 6 PORTALS) ----
      let liveCopyMap = {};
      let globalRules = [];
      let selectedPortal = 'all';
      let selectedPageKey = COPY_CATALOG[0]?.pageKey || 'home';
      let selectedFieldKey = '';

      async function loadWebsiteEditor() {
        const snap = await getDocs(collection(db, 'siteCopy'));
        liveCopyMap = {};
        globalRules = [];
        snap.forEach((d) => {
          if (d.id === '_global') {
            try {
              const parsed = JSON.parse(d.data().replacementsJson || '[]');
              if (Array.isArray(parsed)) globalRules = parsed;
            } catch {}
            return;
          }
          liveCopyMap[d.id] = d.data() || {};
        });
        renderPortalTabs();
        renderPageList();
        renderVisualCanvas(false);
        renderGlobalRules();
      }

      function renderPortalTabs() {
        const counts = { all: COPY_CATALOG.length };
        const labels = { all: 'All Portals' };
        COPY_CATALOG.forEach((p) => {
          counts[p.portal] = (counts[p.portal] || 0) + 1;
          labels[p.portal] = p.portalLabel;
        });

        const wrap = document.getElementById('copy-portal-tabs');
        wrap.replaceChildren();
        Object.keys(counts).forEach((key) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const act = selectedPortal === key;
          btn.className = act
            ? 'px-3 py-1.5 rounded-lg bg-[#1B365D] text-white text-[12.5px] font-semibold transition'
            : 'px-3 py-1.5 rounded-lg bg-[#F3F2EE] text-[#525866] hover:text-[#161A22] border border-[#DFDDD6] text-[12.5px] font-medium transition';
          btn.textContent = `${labels[key]} (${counts[key]})`;
          btn.addEventListener('click', () => {
            selectedPortal = key;
            const visible = COPY_CATALOG.filter((p) => selectedPortal === 'all' || p.portal === selectedPortal);
            if (!visible.some((p) => p.pageKey === selectedPageKey) && visible[0]) {
              selectedPageKey = visible[0].pageKey;
              selectedFieldKey = '';
            }
            renderPortalTabs();
            renderPageList();
            renderVisualCanvas(false);
          });
          wrap.appendChild(btn);
        });
      }

      function renderPageList() {
        const wrap = document.getElementById('copy-page-list');
        const selEl = document.getElementById('copy-page-select');
        wrap.replaceChildren();
        selEl.replaceChildren();
        const filtered = COPY_CATALOG.filter((p) => selectedPortal === 'all' || p.portal === selectedPortal);
        filtered.forEach((pg) => {
          const ovCount = Object.keys(liveCopyMap[pg.pageKey] || {}).filter((k) => pg.fields.some((f) => f.key === k)).length;
          const opt = document.createElement('option');
          opt.value = pg.pageKey;
          opt.textContent = `${pg.label} (${pg.fields.length})`;
          if (pg.pageKey === selectedPageKey) opt.selected = true;
          selEl.appendChild(opt);

          const btn = document.createElement('button');
          btn.type = 'button';
          const sel = pg.pageKey === selectedPageKey;
          btn.className = sel
            ? 'w-full text-left px-3 py-2 rounded-lg bg-[#1B365D] text-white text-[12.5px] transition flex items-center justify-between gap-2'
            : 'w-full text-left px-3 py-2 rounded-lg text-[#161A22] hover:bg-[#F3F2EE] text-[12.5px] transition flex items-center justify-between gap-2';
          btn.innerHTML = `<span class="truncate font-medium">${esc(pg.label)}</span><span class="font-code text-[10.5px] shrink-0 ${sel ? 'text-[#7DD3C8]' : 'text-[#767D8C]'}">${ovCount > 0 ? ovCount + '/' : ''}${pg.fields.length}</span>`;
          btn.addEventListener('click', () => {
            selectedPageKey = pg.pageKey;
            selectedFieldKey = '';
            renderPageList();
            renderVisualCanvas(false);
          });
          wrap.appendChild(btn);
        });
      }

      document.getElementById('copy-page-select').addEventListener('change', (e) => {
        selectedPageKey = e.target.value;
        selectedFieldKey = '';
        renderPageList();
        renderVisualCanvas(false);
      });

      function renderVisualCanvas(focusInline) {
        const pg = COPY_CATALOG.find((x) => x.pageKey === selectedPageKey);
        if (!pg) return;
        document.getElementById('copy-preview-portal').textContent = pg.portalLabel;
        document.getElementById('copy-preview-url').textContent = pg.url;
        document.getElementById('copy-open-live').href = pg.url;

        const canvas = document.getElementById('copy-canvas');
        canvas.setAttribute('dir', pg.rtl ? 'rtl' : 'ltr');
        canvas.replaceChildren();

        const overrides = liveCopyMap[pg.pageKey] || {};
        pg.fields.forEach((f) => {
          const val = overrides[f.key] || f.def;
          const modified = Boolean(overrides[f.key] && overrides[f.key] !== f.def);
          const isEditing = f.key === selectedFieldKey;
          const box = document.createElement('div');
          box.className = 'copy-hot' + (isEditing ? ' is-selected' : '');

          const badge = f.kind.toUpperCase() + (modified ? ' · LIVE EDITED' : '');
          if (!isEditing) {
            const typCls =
              f.kind === 'h1' ? 'font-display font-bold text-[22px] text-[#161A22] leading-snug'
                : f.kind === 'h2' ? 'font-display font-semibold text-[17px] text-[#161A22]'
                : f.kind === 'btn' ? 'inline-block px-3.5 py-1.5 rounded-lg bg-[#1B365D] text-white text-[13px] font-medium'
                : f.kind === 'link' ? 'text-[13.5px] font-medium text-[#1B365D] underline'
                : f.kind === 'input' ? 'px-3 py-1.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px] text-[#767D8C] font-code'
                : 'text-[13.5px] text-[#525866] leading-relaxed';

            box.innerHTML = `<div class="flex items-center justify-between gap-2 mb-1"><span class="text-[11px] font-medium text-[#767D8C]">${esc(f.label)}</span><span class="font-code text-[10px] ${modified ? 'text-[#0B5F58] font-semibold' : 'text-[#767D8C]'}">${esc(badge)} · Click to edit</span></div><div class="${typCls}">${esc(val)}</div>`;
            box.addEventListener('click', () => {
              selectedFieldKey = f.key;
              renderVisualCanvas(true);
            });
          } else {
            box.innerHTML = `
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-code text-[11px] font-semibold text-[#1B365D]">${esc(pg.pageKey)}.${esc(f.key)}</span>
                <button type="button" class="inline-close text-[12px] text-[#525866] hover:text-[#161A22] px-2 py-0.5 rounded bg-white border border-[#DFDDD6]">Close ×</button>
              </div>
              <textarea dir="${pg.rtl ? 'rtl' : 'ltr'}" rows="3" class="inline-ta w-full p-2.5 rounded-lg bg-white border border-[#1B365D] focus:outline-none text-[14px] text-[#161A22] leading-relaxed"></textarea>
              <div class="mt-2 text-[11.5px] text-[#525866]"><strong>Default:</strong> ${esc(f.def)}</div>
              <div class="mt-2.5 flex flex-wrap gap-2">
                <button type="button" class="inline-save h-9 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition">Save live</button>
                <button type="button" class="inline-revert h-9 px-3 rounded-lg bg-white border border-[#DFDDD6] text-[12.5px] font-medium text-[#525866] hover:text-[#161A22]">Revert to default</button>
              </div>`;
            const ta = box.querySelector('.inline-ta');
            ta.value = val;
            box.querySelector('.inline-close').addEventListener('click', (ev) => {
              ev.stopPropagation();
              selectedFieldKey = '';
              renderVisualCanvas(false);
            });
            box.querySelector('.inline-save').addEventListener('click', async (ev) => {
              ev.stopPropagation();
              const nextVal = ta.value.trim();
              if (!nextVal) return;
              const existing = { ...(liveCopyMap[pg.pageKey] || {}), [f.key]: nextVal, updatedAt: new Date().toISOString() };
              await setDoc(doc(db, 'siteCopy', pg.pageKey), existing);
              liveCopyMap[pg.pageKey] = existing;
              await writeAudit('siteCopy', 'edit', `${pg.pageKey}.${f.key}`, nextVal.slice(0, 80));
              selectedFieldKey = '';
              showToast(`Saved live to ${pg.url}`);
              renderPageList();
              renderVisualCanvas(false);
            });
            box.querySelector('.inline-revert').addEventListener('click', async (ev) => {
              ev.stopPropagation();
              const existing = { ...(liveCopyMap[pg.pageKey] || {}) };
              delete existing[f.key];
              existing.updatedAt = new Date().toISOString();
              await setDoc(doc(db, 'siteCopy', pg.pageKey), existing);
              liveCopyMap[pg.pageKey] = existing;
              await writeAudit('siteCopy', 'revert', `${pg.pageKey}.${f.key}`, 'Reverted field');
              selectedFieldKey = '';
              showToast('Reverted sentence to default');
              renderPageList();
              renderVisualCanvas(false);
            });
            if (focusInline) {
              setTimeout(() => {
                ta.focus();
                box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }, 20);
            }
          }
          canvas.appendChild(box);
        });
      }

      document.getElementById('copy-global-search').addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        const box = document.getElementById('copy-search-results');
        box.replaceChildren();
        if (q.length < 2) {
          box.classList.add('hidden');
          return;
        }
        const hits = [];
        COPY_CATALOG.forEach((pg) => {
          const ov = liveCopyMap[pg.pageKey] || {};
          pg.fields.forEach((f) => {
            const val = ov[f.key] || f.def;
            if (val.toLowerCase().includes(q) || f.label.toLowerCase().includes(q) || pg.label.toLowerCase().includes(q)) {
              hits.push({ pg, f, val });
            }
          });
        });
        box.classList.remove('hidden');
        if (!hits.length) {
          box.innerHTML = '<div class="text-[12.5px] text-[#525866]">No matching tagged field found — use Global Find &amp; Replace below to change any word globally.</div>';
          return;
        }
        hits.slice(0, 20).forEach((h) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-full text-left px-3 py-2 rounded-lg bg-white hover:bg-[#F3F2EE] border border-[#DFDDD6] flex items-center justify-between gap-3 text-[12.5px]';
          btn.innerHTML = `<span class="truncate"><strong>${esc(h.pg.portalLabel)} · ${esc(h.pg.label)}:</strong> ${esc(h.val)}</span><span class="font-code text-[11px] text-[#0B5F58] shrink-0">Edit →</span>`;
          btn.addEventListener('click', () => {
            selectedPortal = h.pg.portal;
            selectedPageKey = h.pg.pageKey;
            selectedFieldKey = h.f.key;
            box.classList.add('hidden');
            renderPortalTabs();
            renderPageList();
            renderVisualCanvas(true);
          });
          box.appendChild(btn);
        });
      });

      document.getElementById('copy-reset-page-btn').addEventListener('click', async () => {
        await deleteDoc(doc(db, 'siteCopy', selectedPageKey));
        delete liveCopyMap[selectedPageKey];
        await writeAudit('siteCopy', 'reset_page', selectedPageKey, 'Reset page copy');
        selectedFieldKey = '';
        showToast('Reset page copy to defaults');
        renderPageList();
        renderVisualCanvas(false);
      });

      function renderGlobalRules() {
        const list = document.getElementById('global-replace-list');
        list.replaceChildren();
        if (!globalRules.length) {
          list.innerHTML = '<div class="py-3 text-[#767D8C]">No global find-and-replace rules active.</div>';
          return;
        }
        globalRules.forEach((r, idx) => {
          const row = document.createElement('div');
          row.className = 'py-2.5 flex flex-wrap items-center justify-between gap-2';
          row.innerHTML = `<div><span class="font-code bg-[#F3F2EE] px-2 py-0.5 rounded border border-[#DFDDD6]">${esc(r.from)}</span> <span class="mx-1.5 text-[#767D8C]">→</span> <span class="font-code bg-[#EDF7F5] px-2 py-0.5 rounded border border-[#BCE3DC] text-[#0B5F58]">${esc(r.to)}</span></div><button type="button" class="text-[12px] text-[#B42318] hover:underline">Remove</button>`;
          row.querySelector('button').addEventListener('click', async () => {
            globalRules.splice(idx, 1);
            await setDoc(doc(db, 'siteCopy', '_global'), { replacementsJson: JSON.stringify(globalRules), updatedAt: new Date().toISOString() });
            showToast('Removed global replacement rule');
            renderGlobalRules();
          });
          list.appendChild(row);
        });
      }

      document.getElementById('global-replace-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const from = document.getElementById('gr-from').value.trim();
        const to = document.getElementById('gr-to').value.trim();
        if (!from) return;
        globalRules = globalRules.filter((r) => r.from !== from);
        globalRules.push({ from, to });
        await setDoc(doc(db, 'siteCopy', '_global'), { replacementsJson: JSON.stringify(globalRules), updatedAt: new Date().toISOString() });
        await writeAudit('siteCopy', 'global_rule', from, `${from} -> ${to}`);
        e.target.reset();
        showToast('Saved global find-and-replace rule');
        renderGlobalRules();
      });

      // ---- 3. CONTENT & DATA WORKSPACE ----
      function initContentWorkspace() {
        const allowedTabs = CONTENT_TABS.filter((t) => canTab(t));
        if (!allowedTabs.some((t) => t.id === activeContentTab)) activeContentTab = allowedTabs[0]?.id || 'ledger';

        const wrap = document.getElementById('content-subtabs');
        wrap.replaceChildren();
        allowedTabs.forEach((t) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = t.id === activeContentTab
            ? 'px-3.5 py-1.5 rounded-lg text-[13px] font-semibold bg-[#1B365D] text-white'
            : 'px-3.5 py-1.5 rounded-lg text-[13px] font-medium text-[#525866] hover:text-[#161A22]';
          btn.textContent = t.label;
          btn.addEventListener('click', () => {
            activeContentTab = t.id;
            initContentWorkspace();
          });
          wrap.appendChild(btn);
        });

        document.querySelectorAll('.content-pane').forEach((p) => p.classList.add('hidden'));
        document.getElementById('sub-' + activeContentTab)?.classList.remove('hidden');
        if (activeContentTab === 'ledger') loadLedger();
        else if (activeContentTab === 'submissions') loadSubmissions();
        else if (activeContentTab === 'chapters') loadChapters();
        else if (activeContentTab === 'guides') loadGuides();
        else if (activeContentTab === 'opportunities') loadOpportunities();
        else if (activeContentTab === 'certificates') loadCertificates();
      }

      // 3F. UNIFIED SUBMISSIONS INBOX (Donations -> Ledger, Volunteers -> People Modal, Ideas -> Chapters, Photos)
      async function loadSubmissions() {
        const [donSnap, volSnap, ideaSnap, photoSnap] = await Promise.all([
          getDocs(collection(db, 'donations')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'volunteers')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'ideas')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'photoSubmissions')).catch(() => ({ docs: [] })),
        ]);

        // 1) Donation Receipts
        const donations = donSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
        donations.sort((a, b) => String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
        document.getElementById('sub-don-count').textContent = `${donations.filter((d) => (d.status || 'pending') === 'pending').length} pending / ${donations.length}`;
        const donList = document.getElementById('sub-don-list');
        donList.replaceChildren();
        if (!donations.length) {
          donList.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No supporter receipts submitted yet.</div>';
        } else {
          donations.forEach((d) => {
            const st = d.status || 'pending';
            const proof = safeHttpUrl(d.proofUrl);
            const row = document.createElement('div');
            row.className = 'p-4 space-y-2 text-[13px]';
            row.innerHTML = `
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div><strong>${esc(d.donorName || 'Anonymous Supporter')}</strong> · <span class="text-[#525866]">${esc(d.paymentChannel || '')}</span></div>
                <span class="font-code font-semibold text-[#0B5F58]">+${Number(d.amountEgp || 0).toLocaleString('en-US')} EGP</span>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2 text-[11.5px] text-[#767D8C]">
                <span>${esc(String(d.createdAt || '').slice(0, 10))} · <span class="font-code px-1.5 py-0.5 rounded bg-[#EAE8E1] text-[#161A22]">${esc(st)}</span>${proof ? ` · <a href="${esc(proof)}" target="_blank" rel="noopener noreferrer" class="text-[#1B365D] underline">Receipt ↗</a>` : ''}</span>
                <div class="flex gap-2">
                  ${(st === 'pending' && (can('edit_ledger') || can('moderate_submissions'))) ? '<button type="button" class="don-approve px-2.5 py-1 rounded bg-[#0F766E] text-white text-[11.5px] font-medium">Approve &amp; Post to Ledger</button>' : ''}
                  ${(st === 'pending' && (can('edit_ledger') || can('moderate_submissions'))) ? '<button type="button" class="don-reject text-[#B42318] hover:underline">Reject</button>' : ''}
                </div>
              </div>
            `;
            row.querySelector('.don-approve')?.addEventListener('click', async () => {
              const today = new Date().toISOString().slice(0, 10);
              if (can('edit_ledger')) {
                await addDoc(collection(db, 'ledgerEntries'), {
                  txDate: String(d.createdAt || today).slice(0, 10) || today,
                  donorOrVendor: d.donorName || 'Verified Supporter',
                  paymentChannel: d.paymentChannel || 'InstaPay',
                  entryType: 'inflow',
                  category: 'Donations',
                  memo: 'Verified supporter transfer receipt',
                  receiptUrl: proof,
                  notes: 'Approved via Dashboard Submissions Inbox',
                  verificationStatus: 'Verified',
                  amountEgp: Number(d.amountEgp || 0),
                  updatedAt: new Date().toISOString(),
                });
              }
              await updateDoc(doc(db, 'donations', d.id), { status: 'verified', reviewedAt: new Date().toISOString() });
              await writeAudit('submissions', 'approve_donation', d.id, `Verified +${d.amountEgp} EGP -> Open Ledger`);
              showToast(`Verified +${d.amountEgp} EGP & posted live to /transparency`);
              loadSubmissions();
            });
            row.querySelector('.don-reject')?.addEventListener('click', async () => {
              await updateDoc(doc(db, 'donations', d.id), { status: 'rejected', reviewedAt: new Date().toISOString() });
              await writeAudit('submissions', 'reject_donation', d.id, `Rejected receipt ${d.donorName}`);
              showToast('Marked receipt rejected');
              loadSubmissions();
            });
            donList.appendChild(row);
          });
        }

        // 2) Volunteer Applications
        const vols = volSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
        vols.sort((a, b) => String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
        document.getElementById('sub-vol-count').textContent = `${vols.filter((v) => (v.status || 'pending') === 'pending').length} pending / ${vols.length}`;
        const volList = document.getElementById('sub-vol-list');
        volList.replaceChildren();
        if (!vols.length) {
          volList.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No volunteer applications received yet.</div>';
        } else {
          vols.forEach((v) => {
            const st = v.status || 'pending';
            const email = String(v.email || v.applicant_email || '').trim().toLowerCase();
            const name = v.fullName || v.name || v.full_name || email.split('@')[0] || 'Applicant';
            const cv = safeHttpUrl(v.cvUrl || v.portfolio_or_cv_url);
            const row = document.createElement('div');
            row.className = 'p-4 space-y-1.5 text-[13px]';
            row.innerHTML = `
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div><strong>${esc(name)}</strong> <span class="font-code text-[11px] px-1.5 py-0.5 rounded bg-[#E4EAF2] text-[#1B365D] ml-1">${esc(v.track || v.target_track || 'Volunteer')}</span></div>
                <span class="font-code text-[11px] px-1.5 py-0.5 rounded bg-[#EAE8E1]">${esc(st)}</span>
              </div>
              <div class="text-[12px] text-[#525866]">${esc(email)}${v.phone ? ' · ' + esc(v.phone) : ''}${v.school ? ' · ' + esc(v.school) : ''}${v.governorate ? ' · ' + esc(v.governorate) : ''}</div>
              <p class="text-[12px] text-[#525866] line-clamp-2">${esc(v.motivation || v.motivation_answer || '')}</p>
              <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-[11.5px]">
                <span>${cv ? `<a href="${esc(cv)}" target="_blank" rel="noopener noreferrer" class="text-[#1B365D] underline">Portfolio/CV ↗</a>` : ''}</span>
                <div class="flex gap-2">
                  ${can('manage_access') ? '<button type="button" class="vol-onboard px-2.5 py-1 rounded bg-[#1B365D] text-white font-medium">Inspect &amp; Onboard →</button>' : ''}
                  ${(st === 'pending' && (can('moderate_submissions') || can('manage_access'))) ? '<button type="button" class="vol-review px-2.5 py-1 rounded border border-[#DFDDD6] bg-[#F3F2EE]">Mark Reviewed</button>' : ''}
                </div>
              </div>
            `;
            row.querySelector('.vol-onboard')?.addEventListener('click', async () => {
              await loadUnifiedDirectoryData();
              const matched = peopleDirectoryCache.find((p) => p.email === email) || {
                email,
                name,
                phone: v.phone || '',
                uid: v.uid || '',
                school: v.school || '',
                grade: v.grade || '',
                gov: v.governorate || '',
                track: v.track || v.target_track || '',
                bio: v.motivation || v.motivation_answer || '',
                createdAt: fmtDate(v.createdAt),
                lastLoginAt: '—',
                team: '',
                rank: 'Member',
                roleId: 'team_member',
                roleName: 'Team Member',
                permissions: [],
                customPermissions: false,
                active: true,
                hasStaff: false,
                hasUser: false,
                hasApplicant: true,
              };
              await updateDoc(doc(db, 'volunteers', v.id), { status: 'reviewed', reviewedAt: new Date().toISOString() }).catch(() => {});
              openPersonModal(matched);
            });
            row.querySelector('.vol-review')?.addEventListener('click', async () => {
              await updateDoc(doc(db, 'volunteers', v.id), { status: 'reviewed', reviewedAt: new Date().toISOString() });
              showToast(`Marked ${name} reviewed`);
              loadSubmissions();
            });
            volList.appendChild(row);
          });
        }

        // 3) Ideas & Chapter Proposals
        const ideas = ideaSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
        ideas.sort((a, b) => String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
        document.getElementById('sub-idea-count').textContent = `${ideas.filter((i) => (i.status || 'open') === 'open').length} open / ${ideas.length}`;
        const ideaList = document.getElementById('sub-idea-list');
        ideaList.replaceChildren();
        if (!ideas.length) {
          ideaList.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No ideas or chapter proposals submitted yet.</div>';
        } else {
          ideas.forEach((it) => {
            const isChapterProp = it.submissionType === 'Chapter_Proposal' || String(it.service || '').includes('Connect');
            const st = it.status || 'open';
            const row = document.createElement('div');
            row.className = 'p-4 space-y-2 text-[13px]';
            row.innerHTML = `
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div><strong>${esc(it.title || 'Proposal')}</strong> <span class="font-code text-[10.5px] px-1.5 py-0.5 rounded bg-[#EAE8E1] ml-1">${esc(it.service || 'TF Unions')}</span></div>
                <select class="idea-st h-7 px-2 rounded border border-[#DFDDD6] bg-[#F3F2EE] font-code text-[11px]">
                  <option value="open" ${st === 'open' ? 'selected' : ''}>open</option>
                  <option value="planned" ${st === 'planned' ? 'selected' : ''}>planned</option>
                  <option value="shipped" ${st === 'shipped' ? 'selected' : ''}>shipped</option>
                </select>
              </div>
              <p class="text-[12px] text-[#525866]">${esc(it.description || '')}</p>
              <div class="flex flex-wrap justify-end gap-2 text-[11.5px]">
                ${(isChapterProp && can('edit_chapters') && st !== 'shipped') ? '<button type="button" class="pub-ch px-2.5 py-1 rounded bg-[#0F766E] text-white font-medium">Approve &amp; Publish to TF Connect</button>' : ''}
                ${(can('moderate_submissions') || can('edit_chapters')) ? '<button type="button" class="del-idea text-[#B42318] hover:underline">Delete</button>' : ''}
              </div>
            `;
            row.querySelector('.idea-st').addEventListener('change', async (ev) => {
              await updateDoc(doc(db, 'ideas', it.id), { status: ev.target.value });
              await writeAudit('ideas', 'status', it.id, `${it.title} -> ${ev.target.value}`);
              showToast('Updated proposal status');
            });
            row.querySelector('.pub-ch')?.addEventListener('click', async () => {
              const chName = it.chapterName || String(it.title || '').replace(/^\[[^\]]+\]\s*/, '').trim() || 'Regional Chapter';
              await addDoc(collection(db, 'chapters'), {
                name: chName,
                type: it.chapterType || 'School Chapter',
                gov: it.governorate || 'Nationwide',
                focus: 'Student Study Circle',
                desc: it.description || '',
                archived: false,
                updatedAt: new Date().toISOString(),
              });
              await updateDoc(doc(db, 'ideas', it.id), { status: 'shipped' });
              await writeAudit('chapters', 'publish_proposal', it.id, `Published ${chName} to TF Connect`);
              showToast(`Published "${chName}" live to connect.tfunions.com`);
              loadSubmissions();
            });
            row.querySelector('.del-idea')?.addEventListener('click', async () => {
              await deleteDoc(doc(db, 'ideas', it.id));
              showToast('Deleted proposal');
              loadSubmissions();
            });
            ideaList.appendChild(row);
          });
        }

        // 4) Photo Archive Submissions
        const photos = photoSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
        photos.sort((a, b) => String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
        document.getElementById('sub-photo-count').textContent = `${photos.filter((p) => (p.status || 'pending') === 'pending').length} pending / ${photos.length}`;
        const photoList = document.getElementById('sub-photo-list');
        photoList.replaceChildren();
        if (!photos.length) {
