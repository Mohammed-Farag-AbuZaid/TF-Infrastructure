    <script id="dash-seed" type="application/json" set:html={seedPayload}></script>
    <script src="/js/tf-chrome.js?v=20261126b" defer></script>
    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js';
      import {
        getAuth,
        GoogleAuthProvider,
        signInWithPopup,
        signInWithEmailAndPassword,
        sendEmailVerification,
        signOut,
        onAuthStateChanged,
      } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js';
      import {
        getFirestore,
        collection,
        doc,
        getDoc,
        getDocs,
        setDoc,
        addDoc,
        updateDoc,
        deleteDoc,
        query,
        orderBy,
        limit,
        serverTimestamp,
      } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js';

      const SEED = JSON.parse(document.getElementById('dash-seed').textContent || '{}');
      const BASELINE_MEMBERS = SEED.BASELINE_MEMBERS || [];
      const COPY_CATALOG = SEED.COPY_CATALOG || [];

      const app = initializeApp({
        apiKey: 'AIzaSyB0bILaWHg8QXuwl3Fhfht3BQnYLgTkWUk',
        authDomain: 'tf-unions.firebaseapp.com',
        projectId: 'tf-unions',
        storageBucket: 'tf-unions.firebasestorage.app',
        messagingSenderId: '879703010053',
        appId: '1:879703010053:web:1fe4e4476ab1680a67a56c',
      });
      const auth = getAuth(app);
      const db = getFirestore(app);
      const googleProvider = new GoogleAuthProvider();
      googleProvider.setCustomParameters({ prompt: 'select_account' });

      const ALL_PERMS = [
        { key: 'edit_site_copy', label: 'Edit Website Sentences (All 6 portals)' },
        { key: 'edit_ledger', label: 'Manage Open Ledger' },
        { key: 'edit_chapters', label: 'Manage Connect Chapters' },
        { key: 'edit_guides', label: 'Manage Research Guides' },
        { key: 'edit_opportunities', label: 'Manage News Opportunities' },
        { key: 'manage_certificates', label: 'Issue & Revoke Certificates' },
        { key: 'edit_team', label: 'Manage Team & HR Roster' },
        { key: 'manage_tasks', label: 'Create & Assign Tasks / Awards' },
        { key: 'moderate_submissions', label: 'Moderate Submissions' },
        { key: 'manage_access', label: 'Manage Access & Audit Log' },
      ];

      const ROLE_PRESETS = {
        owner: ALL_PERMS.map((p) => p.key),
        admin: ALL_PERMS.map((p) => p.key),
        hr_lead: ['edit_team', 'moderate_submissions', 'manage_tasks'],
        finance_lead: ['edit_ledger'],
        copy_editor: ['edit_site_copy'],
        chapters_lead: ['edit_chapters'],
        guides_lead: ['edit_guides'],
        news_editor: ['edit_opportunities'],
        registrar: ['manage_certificates'],
        member: [],
      };

      const CONTENT_TABS = [
        { id: 'ledger', label: 'Open Ledger', perm: 'edit_ledger' },
        { id: 'chapters', label: 'Chapters', perm: 'edit_chapters' },
        { id: 'guides', label: 'Guides', perm: 'edit_guides' },
        { id: 'opportunities', label: 'Opportunities', perm: 'edit_opportunities' },
        { id: 'certificates', label: 'Certificates', perm: 'manage_certificates' },
      ];

      let currentUser = null;
      let activeRole = 'member';
      let activePerms = new Set();
      let activeWorkspace = 'home';
      let activeContentTab = 'ledger';
      let activeTeamTab = 'tasks';
      let timerStartedAt = null;
      let timerInterval = null;

      function esc(s) {
        return String(s ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function showToast(msg) {
        const el = document.getElementById('dash-toast');
        el.textContent = msg;
        el.classList.remove('hidden');
        clearTimeout(window.__t);
        window.__t = setTimeout(() => el.classList.add('hidden'), 3200);
      }

      function showGate(name) {
        ['gate-loading', 'gate-signin', 'gate-unverified', 'gate-denied', 'dash-shell'].forEach((id) => {
          const el = document.getElementById(id);
          el.classList.add('hidden');
          if (id === 'dash-shell') el.classList.remove('grid');
        });
        const target = document.getElementById(name);
        target.classList.remove('hidden');
        if (name === 'dash-shell') target.classList.add('grid');
      }

      function can(perm) {
        if (!perm) return true;
        if (['owner', 'admin', 'founder'].includes(activeRole)) return true;
        return activePerms.has(perm);
      }

      async function writeAudit(section, action, targetId, summary) {
        if (!currentUser) return;
        try {
          await addDoc(collection(db, 'auditLogs'), {
            actorUid: currentUser.uid,
            actorEmail: (currentUser.email || '').toLowerCase(),
            section,
            action,
            targetId: String(targetId || ''),
            summary: String(summary || '').slice(0, 220),
            createdAt: serverTimestamp(),
            createdIso: new Date().toISOString(),
          });
        } catch {}
      }

      function getVisibleWorkspaces() {
        const items = [{ id: 'home', label: 'Home' }];
        if (can('edit_site_copy')) items.push({ id: 'copy', label: 'Website Editor' });
        if (CONTENT_TABS.some((t) => can(t.perm))) items.push({ id: 'content', label: 'Content & Data' });
        items.push({ id: 'teamwork', label: 'Team & Tasks' });
        if (can('manage_access')) items.push({ id: 'access', label: 'Access & Activity' });
        return items;
      }

      function renderNav() {
        const allowed = getVisibleWorkspaces();
        if (!allowed.some((n) => n.id === activeWorkspace)) activeWorkspace = allowed[0]?.id || 'home';

        const makeLinks = (container, onPick) => {
          container.replaceChildren();
          allowed.forEach((n) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            const sel = n.id === activeWorkspace;
            btn.className =
              'w-full text-left px-3 py-2.5 rounded-lg text-[13.5px] font-medium transition ' +
              (sel ? 'bg-white text-[#0F1D33] font-semibold' : 'text-[#C7D0DE] hover:bg-white/10 hover:text-white');
            btn.textContent = n.label;
            btn.addEventListener('click', () => {
              activeWorkspace = n.id;
              renderNav();
              switchWorkspace(n.id);
              if (onPick) onPick();
            });
            container.appendChild(btn);
          });
        };

        makeLinks(document.getElementById('dash-nav'));
        makeLinks(document.getElementById('mobile-nav-drawer'), () => {
          document.getElementById('mobile-nav-drawer').classList.add('hidden');
        });
        document.getElementById('active-page-title').textContent =
          allowed.find((n) => n.id === activeWorkspace)?.label || 'Home';
      }

      function switchWorkspace(id) {
        document.querySelectorAll('.dash-view').forEach((v) => v.classList.add('hidden'));
        document.getElementById('view-' + id)?.classList.remove('hidden');
        if (id === 'home') loadHome();
        else if (id === 'copy') loadWebsiteEditor();
        else if (id === 'content') initContentWorkspace();
        else if (id === 'teamwork') loadTeamworkPane(activeTeamTab);
        else if (id === 'access') loadAccessAndAudit();
      }

      document.getElementById('btn-go-tasks').addEventListener('click', () => {
        activeWorkspace = 'teamwork';
        activeTeamTab = 'tasks';
        renderNav();
        switchWorkspace('teamwork');
      });

      // ---- LIVE TIMER & WORK LOG ----
      function fmtSecs(sec) {
        const h = String(Math.floor(sec / 3600)).padStart(2, '0');
        const m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        return `${h}:${m}:${s}`;
      }

      document.getElementById('timer-toggle-btn').addEventListener('click', async () => {
        const btn = document.getElementById('timer-toggle-btn');
        if (!timerStartedAt) {
          timerStartedAt = Date.now();
          btn.textContent = 'Stop & log';
          btn.className = 'ml-1 h-7 px-2.5 rounded bg-[#B42318] text-white text-[12px] font-medium transition';
          timerInterval = setInterval(() => {
            document.getElementById('timer-readout').textContent = fmtSecs(Math.floor((Date.now() - timerStartedAt) / 1000));
          }, 1000);
        } else {
          const mins = Math.max(1, Math.round((Date.now() - timerStartedAt) / 60000));
          clearInterval(timerInterval);
          timerStartedAt = null;
          document.getElementById('timer-readout').textContent = '00:00:00';
          btn.textContent = 'Start session';
          btn.className = 'ml-1 h-7 px-2.5 rounded bg-[#1B365D] hover:bg-[#132847] text-white text-[12px] font-medium transition';
          await logWorkTime('Dashboard shift session', 'Founders', mins);
        }
      });

      async function logWorkTime(summary, division, minutes) {
        await addDoc(collection(db, 'timeLogs'), {
          actorUid: currentUser.uid,
          actorEmail: (currentUser.email || '').toLowerCase(),
          actorName: currentUser.displayName || currentUser.email.split('@')[0],
          summary,
          division,
          minutes,
          createdIso: new Date().toISOString(),
        });
        await writeAudit('time', 'log', minutes + 'm', `${summary} (${minutes}m)`);
        showToast(`Logged ${minutes} mins`);
        if (activeWorkspace === 'home') loadHome();
        else if (activeWorkspace === 'teamwork' && activeTeamTab === 'timelogs') loadTimeLogs();
      }

      document.getElementById('time-log-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        await logWorkTime(
          document.getElementById('tl-summary').value.trim(),
          document.getElementById('tl-division').value,
          Number(document.getElementById('tl-minutes').value),
        );
        e.target.reset();
        document.getElementById('tl-minutes').value = 30;
      });

      // ---- 1. HOME WORKSPACE ----
      async function loadHome() {
        const [memSnap, taskSnap, logSnap, ledSnap] = await Promise.all([
          getDocs(collection(db, 'teamMembers')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'tasks')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'timeLogs')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'ledgerEntries')).catch(() => ({ docs: [] })),
        ]);

        const memCount = memSnap.docs.length > 0 ? memSnap.docs.filter((d) => !d.data().archived).length : BASELINE_MEMBERS.length;
        const tasks = taskSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
        const openTasks = tasks.filter((t) => t.status !== 'done');

        let totalMins = 0;
        const logs = logSnap.docs.map((d) => {
          const v = d.data();
          totalMins += Number(v.minutes) || 0;
          return { id: d.id, ...v };
        });
        logs.sort((a, b) => String(b.createdIso || '').localeCompare(String(a.createdIso || '')));

        let inf = 0;
        let out = 0;
        ledSnap.docs.forEach((d) => {
          const v = d.data();
          const a = Number(v.amountEgp) || 0;
          if (v.entryType === 'outflow') out += a;
          else inf += a;
        });

        document.getElementById('stat-members').textContent = String(memCount);
        document.getElementById('stat-tasks').textContent = String(openTasks.length);
        document.getElementById('stat-hours').textContent = `${Math.round((totalMins / 60) * 10) / 10}h`;
        document.getElementById('stat-ledger').textContent = `${(inf - out).toLocaleString('en-US')} EGP`;

        const hTasks = document.getElementById('home-tasks-list');
        hTasks.replaceChildren();
        if (!openTasks.length) {
          hTasks.innerHTML = '<div class="py-3 text-[#767D8C]">No open tasks right now.</div>';
        } else {
          openTasks.slice(0, 4).forEach((t) => {
            const row = document.createElement('div');
            row.className = 'py-2.5 flex items-center justify-between gap-2';
            row.innerHTML = `<div class="min-w-0"><div class="font-medium truncate">${esc(t.title)}</div><div class="text-[11.5px] text-[#767D8C]">${esc(t.division || '')}${t.assigneeEmail ? ' · ' + esc(t.assigneeEmail) : ''}</div></div><span class="font-code text-[11px] px-2 py-0.5 rounded bg-[#EAE8E1] shrink-0">${esc(t.status || 'todo')}</span>`;
            hTasks.appendChild(row);
          });
        }

        const hLogs = document.getElementById('home-logs-list');
        hLogs.replaceChildren();
        if (!logs.length) {
          hLogs.innerHTML = '<div class="py-3 text-[#767D8C]">No work sessions logged yet.</div>';
        } else {
          logs.slice(0, 4).forEach((l) => {
            const row = document.createElement('div');
            row.className = 'py-2 flex items-center justify-between gap-2';
            row.innerHTML = `<div class="min-w-0 truncate"><strong>${esc(l.actorName || '')}</strong> · ${esc(l.summary || '')}</div><span class="font-code text-[11.5px] text-[#0B5F58] shrink-0">${Number(l.minutes || 0)}m</span>`;
            hLogs.appendChild(row);
          });
        }
      }

      // ---- 2. UNIVERSAL WEBSITE TEXT EDITOR (ALL 6 PORTALS) ----
      let liveCopyMap = {};
      let globalRules = [];
      let selectedPortal = 'all';
      let selectedPageKey = COPY_CATALOG[0]?.pageKey || 'home';
      let selectedFieldKey = '';

      async function loadWebsiteEditor() {
        const snap = await getDocs(collection(db, 'siteCopy'));
        liveCopyMap = {};
        globalRules = [];
        snap.forEach((d) => {
          if (d.id === '_global') {
            try {
              const parsed = JSON.parse(d.data().replacementsJson || '[]');
              if (Array.isArray(parsed)) globalRules = parsed;
            } catch {}
            return;
          }
          liveCopyMap[d.id] = d.data() || {};
        });
        renderPortalTabs();
        renderPageList();
        renderVisualCanvas(false);
        renderGlobalRules();
      }

      function renderPortalTabs() {
        const counts = { all: COPY_CATALOG.length };
        const labels = { all: 'All Portals' };
        COPY_CATALOG.forEach((p) => {
          counts[p.portal] = (counts[p.portal] || 0) + 1;
          labels[p.portal] = p.portalLabel;
        });

        const wrap = document.getElementById('copy-portal-tabs');
        wrap.replaceChildren();
        Object.keys(counts).forEach((key) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const act = selectedPortal === key;
          btn.className = act
            ? 'px-3 py-1.5 rounded-lg bg-[#1B365D] text-white text-[12.5px] font-semibold transition'
            : 'px-3 py-1.5 rounded-lg bg-[#F3F2EE] text-[#525866] hover:text-[#161A22] border border-[#DFDDD6] text-[12.5px] font-medium transition';
          btn.textContent = `${labels[key]} (${counts[key]})`;
          btn.addEventListener('click', () => {
            selectedPortal = key;
            const visible = COPY_CATALOG.filter((p) => selectedPortal === 'all' || p.portal === selectedPortal);
            if (!visible.some((p) => p.pageKey === selectedPageKey) && visible[0]) {
              selectedPageKey = visible[0].pageKey;
              selectedFieldKey = '';
            }
            renderPortalTabs();
            renderPageList();
            renderVisualCanvas(false);
          });
          wrap.appendChild(btn);
        });
      }

      function renderPageList() {
        const wrap = document.getElementById('copy-page-list');
        const selEl = document.getElementById('copy-page-select');
        wrap.replaceChildren();
        selEl.replaceChildren();
        const filtered = COPY_CATALOG.filter((p) => selectedPortal === 'all' || p.portal === selectedPortal);
        filtered.forEach((pg) => {
          const ovCount = Object.keys(liveCopyMap[pg.pageKey] || {}).filter((k) => pg.fields.some((f) => f.key === k)).length;
          const opt = document.createElement('option');
          opt.value = pg.pageKey;
          opt.textContent = `${pg.label} (${pg.fields.length})`;
          if (pg.pageKey === selectedPageKey) opt.selected = true;
          selEl.appendChild(opt);

          const btn = document.createElement('button');
          btn.type = 'button';
          const sel = pg.pageKey === selectedPageKey;
          btn.className = sel
            ? 'w-full text-left px-3 py-2 rounded-lg bg-[#1B365D] text-white text-[12.5px] transition flex items-center justify-between gap-2'
            : 'w-full text-left px-3 py-2 rounded-lg text-[#161A22] hover:bg-[#F3F2EE] text-[12.5px] transition flex items-center justify-between gap-2';
          btn.innerHTML = `<span class="truncate font-medium">${esc(pg.label)}</span><span class="font-code text-[10.5px] shrink-0 ${sel ? 'text-[#7DD3C8]' : 'text-[#767D8C]'}">${ovCount > 0 ? ovCount + '/' : ''}${pg.fields.length}</span>`;
          btn.addEventListener('click', () => {
            selectedPageKey = pg.pageKey;
            selectedFieldKey = '';
            renderPageList();
            renderVisualCanvas(false);
          });
          wrap.appendChild(btn);
        });
      }

      document.getElementById('copy-page-select').addEventListener('change', (e) => {
        selectedPageKey = e.target.value;
        selectedFieldKey = '';
        renderPageList();
        renderVisualCanvas(false);
      });

      function renderVisualCanvas(focusInline) {
        const pg = COPY_CATALOG.find((x) => x.pageKey === selectedPageKey);
        if (!pg) return;
        document.getElementById('copy-preview-portal').textContent = pg.portalLabel;
        document.getElementById('copy-preview-url').textContent = pg.url;
        document.getElementById('copy-open-live').href = pg.url;

        const canvas = document.getElementById('copy-canvas');
        canvas.setAttribute('dir', pg.rtl ? 'rtl' : 'ltr');
        canvas.replaceChildren();

        const overrides = liveCopyMap[pg.pageKey] || {};
        pg.fields.forEach((f) => {
          const val = overrides[f.key] || f.def;
          const modified = Boolean(overrides[f.key] && overrides[f.key] !== f.def);
          const isEditing = f.key === selectedFieldKey;
          const box = document.createElement('div');
          box.className = 'copy-hot' + (isEditing ? ' is-selected' : '');

          const badge = f.kind.toUpperCase() + (modified ? ' · LIVE EDITED' : '');
          if (!isEditing) {
            const typCls =
              f.kind === 'h1' ? 'font-display font-bold text-[22px] text-[#161A22] leading-snug'
                : f.kind === 'h2' ? 'font-display font-semibold text-[17px] text-[#161A22]'
                : f.kind === 'btn' ? 'inline-block px-3.5 py-1.5 rounded-lg bg-[#1B365D] text-white text-[13px] font-medium'
                : f.kind === 'link' ? 'text-[13.5px] font-medium text-[#1B365D] underline'
                : f.kind === 'input' ? 'px-3 py-1.5 rounded-lg bg-white border border-[#DFDDD6] text-[13px] text-[#767D8C] font-code'
                : 'text-[13.5px] text-[#525866] leading-relaxed';

            box.innerHTML = `<div class="flex items-center justify-between gap-2 mb-1"><span class="text-[11px] font-medium text-[#767D8C]">${esc(f.label)}</span><span class="font-code text-[10px] ${modified ? 'text-[#0B5F58] font-semibold' : 'text-[#767D8C]'}">${esc(badge)} · Click to edit</span></div><div class="${typCls}">${esc(val)}</div>`;
            box.addEventListener('click', () => {
              selectedFieldKey = f.key;
              renderVisualCanvas(true);
            });
          } else {
            box.innerHTML = `
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-code text-[11px] font-semibold text-[#1B365D]">${esc(pg.pageKey)}.${esc(f.key)}</span>
                <button type="button" class="inline-close text-[12px] text-[#525866] hover:text-[#161A22] px-2 py-0.5 rounded bg-white border border-[#DFDDD6]">Close ×</button>
              </div>
              <textarea dir="${pg.rtl ? 'rtl' : 'ltr'}" rows="3" class="inline-ta w-full p-2.5 rounded-lg bg-white border border-[#1B365D] focus:outline-none text-[14px] text-[#161A22] leading-relaxed"></textarea>
              <div class="mt-2 text-[11.5px] text-[#525866]"><strong>Default:</strong> ${esc(f.def)}</div>
              <div class="mt-2.5 flex flex-wrap gap-2">
                <button type="button" class="inline-save h-9 px-4 rounded-lg bg-[#1B365D] hover:bg-[#132847] text-white text-[13px] font-medium transition">Save live</button>
                <button type="button" class="inline-revert h-9 px-3 rounded-lg bg-white border border-[#DFDDD6] text-[12.5px] font-medium text-[#525866] hover:text-[#161A22]">Revert to default</button>
              </div>`;
            const ta = box.querySelector('.inline-ta');
            ta.value = val;
            box.querySelector('.inline-close').addEventListener('click', (ev) => {
              ev.stopPropagation();
              selectedFieldKey = '';
              renderVisualCanvas(false);
            });
            box.querySelector('.inline-save').addEventListener('click', async (ev) => {
              ev.stopPropagation();
              const nextVal = ta.value.trim();
              if (!nextVal) return;
              const existing = { ...(liveCopyMap[pg.pageKey] || {}), [f.key]: nextVal, updatedAt: new Date().toISOString() };
              await setDoc(doc(db, 'siteCopy', pg.pageKey), existing);
              liveCopyMap[pg.pageKey] = existing;
              await writeAudit('siteCopy', 'edit', `${pg.pageKey}.${f.key}`, nextVal.slice(0, 80));
              selectedFieldKey = '';
              showToast(`Saved live to ${pg.url}`);
              renderPageList();
              renderVisualCanvas(false);
            });
            box.querySelector('.inline-revert').addEventListener('click', async (ev) => {
              ev.stopPropagation();
              const existing = { ...(liveCopyMap[pg.pageKey] || {}) };
              delete existing[f.key];
              existing.updatedAt = new Date().toISOString();
              await setDoc(doc(db, 'siteCopy', pg.pageKey), existing);
              liveCopyMap[pg.pageKey] = existing;
              await writeAudit('siteCopy', 'revert', `${pg.pageKey}.${f.key}`, 'Reverted field');
              selectedFieldKey = '';
              showToast('Reverted sentence to default');
              renderPageList();
              renderVisualCanvas(false);
            });
            if (focusInline) {
              setTimeout(() => {
                ta.focus();
                box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }, 20);
            }
          }
          canvas.appendChild(box);
        });
      }

      document.getElementById('copy-global-search').addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        const box = document.getElementById('copy-search-results');
        box.replaceChildren();
        if (q.length < 2) {
          box.classList.add('hidden');
          return;
        }
        const hits = [];
        COPY_CATALOG.forEach((pg) => {
          const ov = liveCopyMap[pg.pageKey] || {};
          pg.fields.forEach((f) => {
            const val = ov[f.key] || f.def;
            if (val.toLowerCase().includes(q) || f.label.toLowerCase().includes(q) || pg.label.toLowerCase().includes(q)) {
              hits.push({ pg, f, val });
            }
          });
        });
        box.classList.remove('hidden');
        if (!hits.length) {
          box.innerHTML = '<div class="text-[12.5px] text-[#525866]">No matching tagged field found — use Global Find &amp; Replace below to change any word globally.</div>';
          return;
        }
        hits.slice(0, 20).forEach((h) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-full text-left px-3 py-2 rounded-lg bg-white hover:bg-[#F3F2EE] border border-[#DFDDD6] flex items-center justify-between gap-3 text-[12.5px]';
          btn.innerHTML = `<span class="truncate"><strong>${esc(h.pg.portalLabel)} · ${esc(h.pg.label)}:</strong> ${esc(h.val)}</span><span class="font-code text-[11px] text-[#0B5F58] shrink-0">Edit →</span>`;
          btn.addEventListener('click', () => {
            selectedPortal = h.pg.portal;
            selectedPageKey = h.pg.pageKey;
            selectedFieldKey = h.f.key;
            box.classList.add('hidden');
            renderPortalTabs();
            renderPageList();
            renderVisualCanvas(true);
          });
          box.appendChild(btn);
        });
      });

      document.getElementById('copy-reset-page-btn').addEventListener('click', async () => {
        await deleteDoc(doc(db, 'siteCopy', selectedPageKey));
        delete liveCopyMap[selectedPageKey];
        await writeAudit('siteCopy', 'reset_page', selectedPageKey, 'Reset page copy');
        selectedFieldKey = '';
        showToast('Reset page copy to defaults');
        renderPageList();
        renderVisualCanvas(false);
      });

      function renderGlobalRules() {
        const list = document.getElementById('global-replace-list');
        list.replaceChildren();
        if (!globalRules.length) {
          list.innerHTML = '<div class="py-3 text-[#767D8C]">No global find-and-replace rules active.</div>';
          return;
        }
        globalRules.forEach((r, idx) => {
          const row = document.createElement('div');
          row.className = 'py-2.5 flex flex-wrap items-center justify-between gap-2';
          row.innerHTML = `<div><span class="font-code bg-[#F3F2EE] px-2 py-0.5 rounded border border-[#DFDDD6]">${esc(r.from)}</span> <span class="mx-1.5 text-[#767D8C]">→</span> <span class="font-code bg-[#EDF7F5] px-2 py-0.5 rounded border border-[#BCE3DC] text-[#0B5F58]">${esc(r.to)}</span></div><button type="button" class="text-[12px] text-[#B42318] hover:underline">Remove</button>`;
          row.querySelector('button').addEventListener('click', async () => {
            globalRules.splice(idx, 1);
            await setDoc(doc(db, 'siteCopy', '_global'), { replacementsJson: JSON.stringify(globalRules), updatedAt: new Date().toISOString() });
            showToast('Removed global replacement rule');
            renderGlobalRules();
          });
          list.appendChild(row);
        });
      }

      document.getElementById('global-replace-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const from = document.getElementById('gr-from').value.trim();
        const to = document.getElementById('gr-to').value.trim();
        if (!from) return;
        globalRules = globalRules.filter((r) => r.from !== from);
        globalRules.push({ from, to });
        await setDoc(doc(db, 'siteCopy', '_global'), { replacementsJson: JSON.stringify(globalRules), updatedAt: new Date().toISOString() });
        await writeAudit('siteCopy', 'global_rule', from, `${from} -> ${to}`);
        e.target.reset();
        showToast('Saved global find-and-replace rule');
        renderGlobalRules();
      });

      // ---- 3. CONTENT & DATA WORKSPACE ----
      function initContentWorkspace() {
        const allowedTabs = CONTENT_TABS.filter((t) => can(t.perm));
        if (!allowedTabs.some((t) => t.id === activeContentTab)) activeContentTab = allowedTabs[0]?.id || 'ledger';

        const wrap = document.getElementById('content-subtabs');
        wrap.replaceChildren();
        allowedTabs.forEach((t) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = t.id === activeContentTab
            ? 'px-3.5 py-1.5 rounded-lg text-[13px] font-semibold bg-[#1B365D] text-white'
            : 'px-3.5 py-1.5 rounded-lg text-[13px] font-medium text-[#525866] hover:text-[#161A22]';
          btn.textContent = t.label;
          btn.addEventListener('click', () => {
            activeContentTab = t.id;
            initContentWorkspace();
          });
          wrap.appendChild(btn);
        });

        document.querySelectorAll('.content-pane').forEach((p) => p.classList.add('hidden'));
        document.getElementById('sub-' + activeContentTab)?.classList.remove('hidden');
        if (activeContentTab === 'ledger') loadLedger();
        else if (activeContentTab === 'chapters') loadChapters();
        else if (activeContentTab === 'guides') loadGuides();
        else if (activeContentTab === 'opportunities') loadOpportunities();
        else if (activeContentTab === 'certificates') loadCertificates();
      }

      // 3A. LEDGER (ZERO FAKE SEEDS)
      async function loadLedger() {
        const snap = await getDocs(collection(db, 'ledgerEntries'));
        const rows = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
        rows.sort((a, b) => String(b.txDate || '').localeCompare(String(a.txDate || '')));

        let inf = 0; let out = 0;
        rows.forEach((r) => { const a = Number(r.amountEgp) || 0; if (r.entryType === 'outflow') out += a; else inf += a; });
        const fmt = (n) => Number(n || 0).toLocaleString('en-US') + ' EGP';
        document.getElementById('ld-in').textContent = fmt(inf);
        document.getElementById('ld-out').textContent = fmt(out);
        document.getElementById('ld-net').textContent = fmt(inf - out);

        const list = document.getElementById('ld-list');
        list.replaceChildren();
        if (!rows.length) {
          list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No ledger entries recorded. Public /transparency currently displays 0 EGP.</div>';
          return;
        }
        rows.forEach((e) => {
          const row = document.createElement('div');
          row.className = 'p-4 flex flex-wrap items-center justify-between gap-2 text-[13.5px]';
          row.innerHTML = `<div><span class="font-code text-[12px] text-[#767D8C]">${esc(e.txDate)}</span> <strong class="ml-2">${esc(e.donorOrVendor)}</strong> <span class="text-[#525866] ml-1">(${esc(e.paymentChannel)})</span></div><div class="flex items-center gap-3"><span class="font-code font-semibold ${e.entryType === 'outflow' ? 'text-[#161A22]' : 'text-[#0B5F58]'}">${e.entryType === 'outflow' ? '-' : '+'}${fmt(e.amountEgp)}</span><button type="button" class="edit-btn text-[12px] text-[#1B365D] hover:underline">Edit</button><button type="button" class="del-btn text-[12px] text-[#B42318] hover:underline">Delete</button></div>`;
          row.querySelector('.edit-btn').addEventListener('click', () => {
            document.getElementById('ld-id').value = e.id;
            document.getElementById('ld-date').value = e.txDate || '';
            document.getElementById('ld-vendor').value = e.donorOrVendor || '';
            document.getElementById('ld-channel').value = e.paymentChannel || '';
            document.getElementById('ld-type').value = e.entryType || 'inflow';
            document.getElementById('ld-status').value = e.verificationStatus || 'Verified';
            document.getElementById('ld-amount').value = e.amountEgp || 0;
          });
          row.querySelector('.del-btn').addEventListener('click', async () => {
            await deleteDoc(doc(db, 'ledgerEntries', e.id));
            await writeAudit('ledger', 'delete', e.id, `Deleted ${e.donorOrVendor}`);
            showToast('Deleted ledger entry');
            loadLedger();
          });
          list.appendChild(row);
        });
      }

