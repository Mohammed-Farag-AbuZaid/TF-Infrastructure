      async function loadAchievers() {
        document.getElementById('rec-form').classList.toggle('hidden', !can('manage_tasks') && !can('edit_team'));
        await loadUnifiedDirectoryData();
        const [taskSnap, logSnap, recSnap] = await Promise.all([
          getDocs(collection(db, 'tasks')),
          getDocs(collection(db, 'timeLogs')),
          getDocs(collection(db, 'recognitions')),
        ]);

        const scores = new Map();
        const addScore = (key, name, pts, mins) => {
          if (!key) return;
          const prev = scores.get(key) || { name: name || key.split('@')[0], email: key, pts: 0, mins: 0 };
          if (name) prev.name = name;
          prev.pts += pts;
          prev.mins += mins;
          scores.set(key, prev);
        };

        taskSnap.docs.forEach((d) => {
          const t = d.data();
          if (t.status === 'done') {
            const who = t.completedByEmail || t.assigneeEmail;
            if (who) addScore(who, t.completedByName, Number(t.points || 25), 0);
          }
        });
        logSnap.docs.forEach((d) => {
          const l = d.data();
          addScore(l.actorEmail, l.actorName, Math.round((Number(l.minutes || 0) / 30) * 10), Number(l.minutes || 0));
        });
        const recs = [];
        recSnap.docs.forEach((d) => {
          const r = d.data();
          recs.push({ id: d.id, ...r });
          addScore((r.email || '').toLowerCase(), r.name, Number(r.points || 50), 0);
        });

        const ranked = Array.from(scores.values()).sort((a, b) => b.pts - a.pts);
        const lb = document.getElementById('lb-list');
        lb.replaceChildren();
        if (!ranked.length) {
          lb.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">Complete tasks, log hours, or award recognitions to build the live leaderboard.</div>';
        } else {
          ranked.forEach((u, i) => {
            const row = document.createElement('div');
            row.className = 'p-4 flex items-center justify-between gap-3';
            row.innerHTML = `<div class="flex items-center gap-3"><span class="font-code w-7 h-7 rounded-full flex items-center justify-center text-[12px] font-bold ${i === 0 ? 'bg-[#1B365D] text-white' : 'bg-[#EAE8E1] text-[#525866]'}">#${i + 1}</span><div><div class="font-semibold text-[14px]">${esc(u.name)}</div><div class="font-code text-[11px] text-[#767D8C]">${Math.round((u.mins / 60) * 10) / 10} hrs logged</div></div></div><div class="font-code font-bold text-[15px] text-[#0B5F58]">${u.pts} pts</div>`;
            lb.appendChild(row);
          });
        }

        const rList = document.getElementById('rec-list');
        rList.replaceChildren();
        if (!recs.length) {
          rList.innerHTML = '<div class="p-5 text-center text-[12.5px] text-[#767D8C]">No awards granted yet.</div>';
        } else {
          recs.forEach((r) => {
            const row = document.createElement('div');
            row.className = 'p-3.5 text-[13px] flex items-center justify-between gap-2';
            row.innerHTML = `<div><strong>${esc(r.name)}</strong> · <span class="text-[#0B5F58] font-medium">${esc(r.badge)}</span> (+${Number(r.points || 50)} pts)</div>`;
            rList.appendChild(row);
          });
        }
      }

