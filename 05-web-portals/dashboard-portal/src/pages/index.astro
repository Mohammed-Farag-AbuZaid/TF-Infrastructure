        if (!email) return;
        await deleteDoc(doc(db, 'staffAccess', email));
        if (uid) {
          await updateDoc(doc(db, 'users', uid), {
            team: '',
            rank: 'Normal User',
            roleId: 'normal_user',
            roleName: 'Normal User',
            updatedAt: serverTimestamp(),
