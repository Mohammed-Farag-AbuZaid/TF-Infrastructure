              <div id="audit-list" class="divide-y divide-[#EAE8E1] max-h-[360px] overflow-y-auto"></div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <script src="/js/tf-chrome.js" defer></script>
    <script
      type="module"
      define:vars={{
        BASELINE_MEMBERS,
        BASELINE_CHAPTERS,
        BASELINE_GUIDES,
        BASELINE_LEDGER,
        SITE_COPY_PAGES,
        STARTER_TASKS,
      }}
    >
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js';
      import {
        getAuth,
        GoogleAuthProvider,
        signInWithPopup,
        signInWithEmailAndPassword,
        sendEmailVerification,
        signOut,
        onAuthStateChanged,
      } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js';
      import {
        getFirestore,
        collection,
        doc,
        getDoc,
        getDocs,
        setDoc,
        addDoc,
        updateDoc,
        deleteDoc,
        query,
        orderBy,
        limit,
        serverTimestamp,
      } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js';

      const app = initializeApp({
        apiKey: 'AIzaSyB0bILaWHg8QXuwl3Fhfht3BQnYLgTkWUk',
        authDomain: 'tf-unions.firebaseapp.com',
        projectId: 'tf-unions',
        storageBucket: 'tf-unions.firebasestorage.app',
        messagingSenderId: '879703010053',
        appId: '1:879703010053:web:1fe4e4476ab1680a67a56c',
      });
      const auth = getAuth(app);
      const db = getFirestore(app);
      const googleProvider = new GoogleAuthProvider();
      googleProvider.setCustomParameters({ prompt: 'select_account' });

      const ALL_PERMS = [
        { key: 'edit_site_copy', label: 'Visual Click-to-Edit Copy' },
        { key: 'edit_team', label: 'Team & HR Roster' },
        { key: 'manage_tasks', label: 'Create & Assign Tasks' },
        { key: 'edit_ledger', label: 'Open Financial Ledger' },
        { key: 'edit_chapters', label: 'Connect Chapters' },
        { key: 'edit_guides', label: 'Research Guides' },
        { key: 'edit_opportunities', label: 'News Opportunities' },
        { key: 'manage_certificates', label: 'Verify Certificates' },
        { key: 'moderate_submissions', label: 'Moderate Submissions' },
        { key: 'manage_access', label: 'Access Matrix & Audit Log' },
      ];

      const ROLE_PRESETS = {
        owner: ALL_PERMS.map((p) => p.key),
        admin: ALL_PERMS.map((p) => p.key),
        hr_lead: ['edit_team', 'moderate_submissions', 'manage_tasks'],
        finance_lead: ['edit_ledger'],
        copy_editor: ['edit_site_copy'],
        chapters_lead: ['edit_chapters'],
        guides_lead: ['edit_guides'],
        news_editor: ['edit_opportunities'],
        registrar: ['manage_certificates'],
        member: [],
      };

      const NAV_ITEMS = [
        { id: 'overview', label: 'Overview & Time', perm: null },
        { id: 'tasks', label: 'Tasks & To-Dos', perm: null },
        { id: 'leaderboard', label: 'Top Achievers', perm: null },
        { id: 'copy', label: 'Click-to-Edit Copy', perm: 'edit_site_copy' },
        { id: 'team', label: 'Team & HR Hub', perm: 'edit_team' },
        { id: 'ledger', label: 'Open Ledger', perm: 'edit_ledger' },
        { id: 'chapters', label: 'Chapters', perm: 'edit_chapters' },
        { id: 'guides', label: 'Guides', perm: 'edit_guides' },
        { id: 'certificates', label: 'Certificates', perm: 'manage_certificates' },
        { id: 'opportunities', label: 'Opportunities', perm: 'edit_opportunities' },
        { id: 'access', label: 'Access & Audit', perm: 'manage_access' },
      ];

      let currentUser = null;
      let activeRole = 'member';
      let activePerms = new Set();
      let activeView = 'overview';
      let timerStartedAt = null;
      let timerInterval = null;

      function esc(s) {
        return String(s ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function showToast(msg) {
        const el = document.getElementById('dash-toast');
        el.textContent = msg;
        el.classList.remove('hidden');
        clearTimeout(window.__t);
        window.__t = setTimeout(() => el.classList.add('hidden'), 3200);
      }

      function showGate(name) {
        ['gate-loading', 'gate-signin', 'gate-unverified', 'gate-denied', 'dash-shell'].forEach((id) => {
          const el = document.getElementById(id);
          el.classList.add('hidden');
          if (id === 'dash-shell') el.classList.remove('grid');
        });
        const target = document.getElementById(name);
        target.classList.remove('hidden');
        if (name === 'dash-shell') target.classList.add('grid');
      }

      function can(perm) {
        if (!perm) return true;
        if (['owner', 'admin', 'founder'].includes(activeRole)) return true;
        return activePerms.has(perm);
      }

      async function writeAudit(section, action, targetId, summary) {
        if (!currentUser) return;
        try {
          await addDoc(collection(db, 'auditLogs'), {
            actorUid: currentUser.uid,
            actorEmail: (currentUser.email || '').toLowerCase(),
            section,
            action,
            targetId: String(targetId || ''),
            summary: String(summary || '').slice(0, 220),
            createdAt: serverTimestamp(),
            createdIso: new Date().toISOString(),
          });
        } catch {}
      }

      function renderNav() {
        const allowed = NAV_ITEMS.filter((n) => can(n.perm));
        if (!allowed.some((n) => n.id === activeView)) activeView = allowed[0]?.id || 'overview';

        const makeLinks = (container, onPick) => {
          container.replaceChildren();
          allowed.forEach((n) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            const sel = n.id === activeView;
            btn.className =
              'w-full text-left px-3 py-2 rounded-lg text-[13.5px] font-medium transition ' +
              (sel ? 'bg-white text-[#0F1D33] font-semibold' : 'text-[#C7D0DE] hover:bg-white/10 hover:text-white');
            btn.textContent = n.label;
            btn.addEventListener('click', () => {
              activeView = n.id;
              renderNav();
              switchView(n.id);
              if (onPick) onPick();
            });
            container.appendChild(btn);
          });
        };

        makeLinks(document.getElementById('dash-nav'));
        makeLinks(document.getElementById('mobile-nav-drawer'), () => {
          document.getElementById('mobile-nav-drawer').classList.add('hidden');
        });
        document.getElementById('active-page-title').textContent =
          allowed.find((n) => n.id === activeView)?.label || 'Dashboard';
      }

      function switchView(id) {
        document.querySelectorAll('.dash-view').forEach((v) => v.classList.add('hidden'));
        document.getElementById('view-' + id)?.classList.remove('hidden');
        if (id === 'overview') loadOverview();
        else if (id === 'tasks') loadTasks();
        else if (id === 'leaderboard') loadLeaderboard();
        else if (id === 'copy') loadCopyEditor();
        else if (id === 'team') loadTeam();
        else if (id === 'ledger') loadLedger();
        else if (id === 'chapters') loadChapters();
        else if (id === 'guides') loadGuides();
        else if (id === 'certificates') loadCertificates();
        else if (id === 'opportunities') loadOpportunities();
        else if (id === 'access') loadAccessAndAudit();
      }

      // ---- 1. LIVE SESSION TIMER & TIME LOGS ----
      function formatSeconds(sec) {
        const h = String(Math.floor(sec / 3600)).padStart(2, '0');
        const m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        return `${h}:${m}:${s}`;
      }

      document.getElementById('timer-toggle-btn').addEventListener('click', async () => {
        const btn = document.getElementById('timer-toggle-btn');
        if (!timerStartedAt) {
          timerStartedAt = Date.now();
          btn.textContent = 'Stop & log';
          btn.className = 'h-7 px-2.5 rounded bg-[#B42318] text-white text-[12px] font-medium transition';
          timerInterval = setInterval(() => {
            document.getElementById('timer-readout').textContent = formatSeconds(Math.floor((Date.now() - timerStartedAt) / 1000));
          }, 1000);
        } else {
          const mins = Math.max(1, Math.round((Date.now() - timerStartedAt) / 60000));
          clearInterval(timerInterval);
          timerStartedAt = null;
          document.getElementById('timer-readout').textContent = '00:00:00';
          btn.textContent = 'Start session';
          btn.className = 'h-7 px-2.5 rounded bg-[#1B365D] hover:bg-[#132847] text-white text-[12px] font-medium transition';
          await logWorkTime('Dashboard live work session', 'Founders', mins);
        }
      });

      async function logWorkTime(summary, division, minutes) {
        await addDoc(collection(db, 'timeLogs'), {
          actorUid: currentUser.uid,
          actorEmail: (currentUser.email || '').toLowerCase(),
          actorName: currentUser.displayName || currentUser.email.split('@')[0],
          summary,
          division,
          minutes,
          createdIso: new Date().toISOString(),
        });
        await writeAudit('time', 'log', minutes + 'm', `${summary} (${minutes}m)`);
        showToast(`Logged ${minutes} mins`);
        loadOverview();
      }

      document.getElementById('time-log-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        await logWorkTime(
          document.getElementById('tl-summary').value.trim(),
          document.getElementById('tl-division').value,
          Number(document.getElementById('tl-minutes').value),
        );
        document.getElementById('tl-summary').value = '';
      });

      async function loadOverview() {
        const [logsSnap, tasksSnap] = await Promise.all([
          getDocs(collection(db, 'timeLogs')),
          getDocs(collection(db, 'tasks')),
        ]);
        const myEmail = (currentUser?.email || '').toLowerCase();
        let myMins = 0;
        let teamMins = 0;
        const logs = [];
        logsSnap.forEach((d) => {
          const x = d.data();
          const m = Number(x.minutes) || 0;
          teamMins += m;
          if ((x.actorEmail || '').toLowerCase() === myEmail || x.actorUid === currentUser?.uid) myMins += m;
          logs.push({ id: d.id, ...x });
        });
        logs.sort((a, b) => String(b.createdIso || '').localeCompare(String(a.createdIso || '')));

        let openTasks = 0;
        tasksSnap.forEach((d) => { if (d.data().status !== 'done') openTasks++; });

        document.getElementById('kpi-my-hours').textContent = (myMins / 60).toFixed(1) + 'h';
        document.getElementById('kpi-team-hours').textContent = (teamMins / 60).toFixed(1) + 'h';
        document.getElementById('kpi-open-tasks').textContent = String(openTasks);
        document.getElementById('timelog-count').textContent = `${logs.length} log${logs.length === 1 ? '' : 's'}`;

        const list = document.getElementById('timelog-list');
        list.replaceChildren();
        if (logs.length === 0) {
          list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No time logged yet. Start the session timer or add a manual entry.</div>';
          return;
        }
        logs.slice(0, 25).forEach((l) => {
          const row = document.createElement('div');
          row.className = 'px-5 py-3 flex items-center justify-between gap-3';
          row.innerHTML = `
            <div class="min-w-0">
              <div class="text-[13.5px] font-medium text-[#161A22] truncate">${esc(l.summary)}</div>
              <div class="text-[12px] text-[#525866]">${esc(l.actorName || l.actorEmail)} · ${esc(l.division || 'Team')}</div>
            </div>
            <span class="font-code text-[12px] font-semibold text-[#0B5F58] shrink-0">${Number(l.minutes)} min</span>
          `;
          list.appendChild(row);
        });
      }

      // ---- 2. TASKS & TO-DOS ----
      async function loadTasks() {
        const manager = can('manage_tasks') || can('moderate_submissions');
        document.getElementById('task-create-form').classList.toggle('hidden', !manager);
        document.getElementById('task-seed-btn').classList.toggle('hidden', !manager);

        const snap = await getDocs(collection(db, 'tasks'));
        const divFilter = document.getElementById('task-filter-div').value;
        const onlyMine = document.getElementById('task-only-mine').checked;
        const myEmail = (currentUser?.email || '').toLowerCase();

        const cols = { todo: [], doing: [], done: [] };
        snap.forEach((d) => {
          const t = { id: d.id, ...d.data() };
          if (divFilter !== 'All' && t.division !== divFilter) return;
          if (onlyMine && (t.assigneeEmail || '').toLowerCase() !== myEmail) return;
          const st = cols[t.status] ? t.status : 'todo';
          cols[st].push(t);
        });

        ['todo', 'doing', 'done'].forEach((st) => {
          document.getElementById('cnt-' + st).textContent = String(cols[st].length);
          const container = document.getElementById('col-' + st);
          container.replaceChildren();
          if (cols[st].length === 0) {
            container.innerHTML = '<div class="py-6 text-center text-[12.5px] text-[#767D8C]">Empty</div>';
            return;
          }
          cols[st].forEach((t) => {
            const card = document.createElement('div');
            card.className = 'p-3.5 rounded-lg bg-[#F3F2EE] border border-[#DFDDD6] space-y-2';
            const nextStatus = st === 'todo' ? 'doing' : st === 'doing' ? 'done' : 'todo';
            const nextLabel = st === 'todo' ? 'Start →' : st === 'doing' ? 'Complete ✓' : 'Reopen';
            card.innerHTML = `
              <div class="flex items-center justify-between gap-2 text-[11px]">
                <span class="font-medium px-2 py-0.5 rounded bg-white border border-[#DFDDD6] text-[#1B365D]">${esc(t.division || 'General')}</span>
                <span class="font-code text-[#767D8C]">${esc(t.dueDate || '')}</span>
              </div>
              <div class="text-[13.5px] font-semibold text-[#161A22] leading-snug">${esc(t.title)}</div>
              <div class="text-[11.5px] text-[#525866]">${t.assigneeEmail ? 'Assigned: ' + esc(t.assigneeEmail) : 'Open to division'}</div>
              <div class="flex items-center justify-between pt-1">
                <button type="button" class="move-btn text-[12px] font-semibold text-[#0B5F58] hover:underline">${nextLabel}</button>
                ${manager ? '<button type="button" class="del-btn text-[12px] text-[#B42318] hover:underline">Delete</button>' : ''}
              </div>
            `;
            card.querySelector('.move-btn').addEventListener('click', async () => {
              await updateDoc(doc(db, 'tasks', t.id), {
                status: nextStatus,
                completedByUid: nextStatus === 'done' ? currentUser.uid : null,
                completedByEmail: nextStatus === 'done' ? (currentUser.email || '').toLowerCase() : null,
                completedByName: nextStatus === 'done' ? (currentUser.displayName || currentUser.email.split('@')[0]) : null,
              });
              await writeAudit('tasks', nextStatus, t.id, t.title);
              showToast(`Moved "${t.title.slice(0, 28)}"`);
              loadTasks();
            });
            card.querySelector('.del-btn')?.addEventListener('click', async () => {
              await deleteDoc(doc(db, 'tasks', t.id));
              await writeAudit('tasks', 'delete', t.id, t.title);
              loadTasks();
            });
            container.appendChild(card);
          });
        });
      }

      document.getElementById('task-filter-div').addEventListener('change', loadTasks);
      document.getElementById('task-only-mine').addEventListener('change', loadTasks);
      document.getElementById('task-seed-btn').addEventListener('click', async () => {
        for (const t of STARTER_TASKS) {
          await setDoc(doc(db, 'tasks', t.id), { ...t, updatedAt: new Date().toISOString() }, { merge: true });
        }
        await writeAudit('tasks', 'seed', 'starter', 'Loaded 5 starter TF tasks');
        showToast('Loaded starter tasks');
        loadTasks();
      });
      document.getElementById('task-create-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = 'task-' + Date.now();
        const payload = {
          title: document.getElementById('tk-title').value.trim(),
          division: document.getElementById('tk-div').value,
          assigneeEmail: document.getElementById('tk-assignee').value.trim().toLowerCase(),
          dueDate: document.getElementById('tk-due').value,
          status: 'todo',
          points: 25,
          createdAt: new Date().toISOString(),
        };
        await setDoc(doc(db, 'tasks', id), payload);
        await writeAudit('tasks', 'create', id, payload.title);
        document.getElementById('task-create-form').reset();
        showToast('Task created');
        loadTasks();
      });

      // ---- 3. TOP ACHIEVERS LEADERBOARD ----
      async function loadLeaderboard() {
        document.getElementById('recog-form').classList.toggle('hidden', !(can('edit_team') || can('manage_tasks')));

        const [logsSnap, tasksSnap, recSnap] = await Promise.all([
          getDocs(collection(db, 'timeLogs')),
          getDocs(collection(db, 'tasks')),
          getDocs(collection(db, 'recognitions')),
        ]);

        const scores = new Map();
        const touch = (email, name) => {
          const key = (email || name || 'unknown').toLowerCase();
          if (!scores.has(key)) scores.set(key, { key, name: name || email, mins: 0, tasks: 0, bonus: 0, badge: '' });
          const cur = scores.get(key);
          if (name && cur.name.includes('@')) cur.name = name;
          return cur;
        };

        logsSnap.forEach((d) => {
          const l = d.data();
          touch(l.actorEmail, l.actorName).mins += Number(l.minutes) || 0;
        });
        tasksSnap.forEach((d) => {
          const t = d.data();
          if (t.status === 'done' && (t.completedByEmail || t.assigneeEmail)) {
            touch(t.completedByEmail || t.assigneeEmail, t.completedByName).tasks += 1;
          }
        });
        recSnap.forEach((d) => {
          const r = d.data();
          const row = touch(r.email, r.name);
          row.bonus += Number(r.points) || 50;
          row.badge = r.reason || row.badge;
        });

        const ranked = Array.from(scores.values())
          .map((r) => ({ ...r, total: Math.round((r.mins / 60) * 10 + r.tasks * 25 + r.bonus) }))
          .sort((a, b) => b.total - a.total);

        const podium = document.getElementById('podium-grid');
        podium.replaceChildren();
        [0, 1, 2].forEach((idx) => {
          const p = ranked[idx];
          const card = document.createElement('div');
          card.className = idx === 0
            ? 'rounded-xl p-5 bg-[#0F1D33] text-[#F3F2EE] border border-[#1B365D]'
            : 'rounded-xl p-5 bg-white text-[#161A22] border border-[#DFDDD6]';
          if (!p) {
            card.innerHTML = `<div class="font-code text-[12px] opacity-60">#${idx + 1} Spot Open</div><div class="mt-2 text-[14px] opacity-75">Log time or complete tasks to claim rank #${idx + 1}.</div>`;
          } else {
            card.innerHTML = `
              <div class="flex justify-between items-center text-[12px]">
                <span class="font-code font-bold ${idx === 0 ? 'text-[#5EC4B8]' : 'text-[#0B5F58]'}">#${idx + 1} Top Achiever</span>
                <span class="font-code font-bold">${p.total} pts</span>
              </div>
              <div class="font-display font-bold text-[20px] mt-2 truncate">${esc(p.name)}</div>
              <div class="text-[12.5px] mt-1 ${idx === 0 ? 'text-[#C7D0DE]' : 'text-[#525866]'}">${(p.mins / 60).toFixed(1)}h logged · ${p.tasks} tasks${p.badge ? ' · ' + esc(p.badge) : ''}</div>
            `;
          }
          podium.appendChild(card);
        });

        const tbody = document.getElementById('leaderboard-rows');
        tbody.replaceChildren();
        if (ranked.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-[#767D8C]">No activity scored yet. Log work time or complete tasks!</td></tr>';
          return;
        }
        ranked.forEach((r, idx) => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="py-3 px-5 font-code font-semibold">#${idx + 1}</td>
            <td class="py-3 px-4 font-medium">${esc(r.name)}</td>
            <td class="py-3 px-4 font-code">${(r.mins / 60).toFixed(1)}h</td>
            <td class="py-3 px-4 font-code">${r.tasks}</td>
            <td class="py-3 px-4 font-code text-[#0B5F58]">+${r.bonus}</td>
            <td class="py-3 px-5 text-right font-code font-bold">${r.total} pts</td>
          `;
          tbody.appendChild(tr);
        });
      }

      document.getElementById('recog-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = 'rec-' + Date.now();
        const payload = {
          email: document.getElementById('rc-email').value.trim().toLowerCase(),
          name: document.getElementById('rc-name').value.trim(),
          reason: document.getElementById('rc-reason').value.trim(),
          points: 50,
          createdAt: new Date().toISOString(),
        };
        await setDoc(doc(db, 'recognitions', id), payload);
        await writeAudit('recognitions', 'award', payload.email, payload.reason);
        document.getElementById('recog-form').reset();
        showToast('Awarded +50 pts');
        loadLeaderboard();
      });

      // ---- 4. VISUAL CLICK-TO-EDIT SITE COPY CMS ----
      let liveCopyByPage = {};
      let selectedCopyPage = SITE_COPY_PAGES[0].pageKey;
      let selectedFieldKey = SITE_COPY_PAGES[0].fields[0].key;

      async function loadCopyEditor() {
        const snap = await getDocs(collection(db, 'siteCopy'));
        liveCopyByPage = {};
        snap.forEach((d) => { liveCopyByPage[d.id] = d.data(); });

        const select = document.getElementById('copy-page-select');
        select.replaceChildren();
        SITE_COPY_PAGES.forEach((p) => {
          const opt = document.createElement('option');
          opt.value = p.pageKey;
          opt.textContent = p.label;
          if (p.pageKey === selectedCopyPage) opt.selected = true;
          select.appendChild(opt);
        });
        renderCopyCanvas();
      }

      function currentPageSchema() {
        return SITE_COPY_PAGES.find((p) => p.pageKey === selectedCopyPage) || SITE_COPY_PAGES[0];
      }

      function valForField(pageKey, f) {
        return liveCopyByPage[pageKey]?.[f.key] || f.def;
      }

      function selectCopyField(fieldKey) {
        selectedFieldKey = fieldKey;
        const page = currentPageSchema();
        const field = page.fields.find((f) => f.key === fieldKey) || page.fields[0];
        if (!field) return;

        const isCustom = Boolean(liveCopyByPage[page.pageKey]?.[field.key]);
        document.getElementById('ce-field-label').textContent = field.label;
        document.getElementById('ce-field-key').textContent = `${page.pageKey}.${field.key}`;
        document.getElementById('ce-live-badge').classList.toggle('hidden', !isCustom);
        const ta = document.getElementById('ce-textarea');
        ta.dir = page.rtl ? 'rtl' : 'ltr';
        ta.value = valForField(page.pageKey, field);
        document.getElementById('ce-char-count').textContent = `${ta.value.length} chars`;
        renderCopyCanvas();
      }

      function renderCopyCanvas() {
        const page = currentPageSchema();
        document.getElementById('copy-live-link').href = page.url;
        const canvas = document.getElementById('copy-canvas');
        canvas.replaceChildren();
        canvas.dir = page.rtl ? 'rtl' : 'ltr';

        page.fields.forEach((f) => {
          const val = valForField(page.pageKey, f);
          const wrap = document.createElement('div');
          wrap.className = 'copy-hot ' + (f.key === selectedFieldKey ? 'is-selected' : '');
          wrap.dataset.copyField = f.key;

          const tag = document.createElement('div');
          tag.className = 'text-[10.5px] font-code text-[#767D8C] mb-1 flex items-center justify-between';
          tag.innerHTML = `<span>${esc(f.label)}</span>${liveCopyByPage[page.pageKey]?.[f.key] ? '<span class="text-[#0B5F58]">live custom</span>' : ''}`;

          const content = document.createElement('div');
          content.dataset.previewText = f.key;
          if (f.kind === 'h1') content.className = 'font-display font-bold text-[26px] leading-[1.15] text-[#161A22]';
          else if (f.kind === 'h2') content.className = 'font-display font-semibold text-[18px] text-[#161A22]';
          else if (f.kind === 'btn') content.className = 'inline-block px-4 py-2 rounded-lg bg-[#1B365D] text-white text-[13.5px] font-medium';
          else if (f.kind === 'link') content.className = 'text-[14px] font-medium text-[#1B365D] underline';
          else content.className = 'text-[14.5px] leading-[1.6] text-[#525866]';
          content.textContent = val;

          wrap.append(tag, content);
          wrap.addEventListener('click', () => selectCopyField(f.key));
          canvas.appendChild(wrap);
        });
      }

