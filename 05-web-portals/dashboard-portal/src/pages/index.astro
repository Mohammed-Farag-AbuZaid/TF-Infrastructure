      document.getElementById('person-assign-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('pa-email').value.trim().toLowerCase();
        if (!email) return;
        const uid = document.getElementById('pa-uid').value.trim();
        const hadStaff = document.getElementById('pa-existing-staff').value === '1';
        const displayName = document.getElementById('pa-name').value.trim() || email.split('@')[0];
        const phone = document.getElementById('pa-phone').value.trim();
        const rawTeam = document.getElementById('pa-team').value;
        const team = rawTeam === '__custom__' ? document.getElementById('pa-team-custom').value.trim() : rawTeam;
        const rank = document.getElementById('pa-rank').value;
        const roleId = document.getElementById('pa-role').value;
        const chosenLinkId = document.getElementById('pa-tree-link').value.trim();

        if (roleId === 'normal_user') {
          if (hadStaff) await deleteDoc(doc(db, 'staffAccess', email)).catch(() => {});
          if (uid) {
            await updateDoc(doc(db, 'users', uid), {
              team,
              rank: 'Normal User',
              roleId: 'normal_user',
              roleName: 'Normal User',
              updatedAt: serverTimestamp(),
            }).catch(() => {});
          }
          if (chosenLinkId && can('edit_team')) {
            const existing = rosterCache.find((x) => x.id === chosenLinkId);
            if (existing) {
              await setDoc(doc(db, 'teamMembers', chosenLinkId), {
                id: chosenLinkId,
                name: existing.name,
                role: existing.role,
                team: existing.team,
                endDate: currentYm(),
                status: 'alumni',
                archived: false,
              }, { merge: true }).catch(() => {});
            }
          }
          await writeAudit('access', 'demote', email, `Set ${email} as Normal User`);
          closePersonModal();
          showToast(`Saved ${displayName} as Normal User`);
          loadAccessAndAudit();
          return;
        }

        const rule = getRoleRule(roleId);
        const roleName = rule ? rule.name : roleId;
        const isCustom = document.getElementById('pa-custom-toggle').checked;
        let permissions = isCustom
          ? Array.from(document.querySelectorAll('.pa-cb')).filter((c) => c.checked).map((c) => c.value)
          : (rule ? [...(rule.permissions || [])] : []);
        if (['owner', 'admin', 'founder'].includes(roleId) && !isCustom) {
          permissions = ALL_PERMS.map((p) => p.key);
        }

        const syncToTree = document.getElementById('pa-sync-tree').checked && can('edit_team');
        const startDate = document.getElementById('pa-start-date').value.trim() || currentYm();
        const endDate = document.getElementById('pa-end-date').value.trim();
        let publicMemberId = chosenLinkId;

        if (syncToTree && displayName.length >= 2) {
          publicMemberId = chosenLinkId || ('m_' + Date.now());
          const existingOrg = chosenLinkId ? rosterCache.find((x) => x.id === chosenLinkId) : null;
          const personObj = peopleDirectoryCache.find((x) => x.email === email) || {};
          const safeTeam = team || existingOrg?.team || rule?.defaultTeam || 'Founders';
          const safeRoleTitle = formatPublicRoleTitle(safeTeam, rank, roleName, existingOrg);
          // Write ONLY PII-free fields to /teamMembers (never email, phone, or age)
          await setDoc(doc(db, 'teamMembers', publicMemberId), {
            id: publicMemberId,
            name: displayName,
            role: safeRoleTitle,
            team: safeTeam,
            tier: existingOrg && existingOrg.tier !== undefined && rank === 'Member' ? existingOrg.tier : rankToTier(rank),
            school: existingOrg?.school || personObj.school || 'TF Unions',
            startDate,
            cohortDate: startDate,
            endDate,
            status: endDate ? 'alumni' : 'active',
            parent: document.getElementById('pa-parent').value || existingOrg?.parent || null,
            bio: existingOrg?.bio || personObj.bio || `${safeRoleTitle} in ${safeTeam}.`,
            archived: false,
          }, { merge: true });
        }

        await setDoc(doc(db, 'staffAccess', email), {
          email,
          displayName,
          phone,
          team,
          rank,
          role: roleId,
          roleName,
          customPermissions: isCustom,
          permissions,
          active: document.getElementById('pa-active').checked,
          ...(publicMemberId ? { publicMemberId } : {}),
          startDate,
          endDate,
          updatedBy: (currentUser?.email || '').toLowerCase(),
          updatedAt: new Date().toISOString(),
        }, { merge: true });

        if (uid) {
          await updateDoc(doc(db, 'users', uid), {
            team,
            rank,
            roleId,
            roleName,
            ...(publicMemberId ? { publicMemberId } : {}),
            updatedAt: serverTimestamp(),
          }).catch(() => {});
        }

        await writeAudit('access', 'assign', email, `${displayName} -> ${team || 'No team'} / ${rank} (${roleName})${syncToTree ? ' + synced org tree' : ''}`);
        closePersonModal();
        showToast(`Assigned ${displayName}${syncToTree ? ' & synced public org tree' : ''}`);
        if (activeWorkspace === 'teamwork' && activeTeamTab === 'roster') loadRoster();
        else if (activeWorkspace === 'content' && activeContentTab === 'submissions') loadSubmissions();
        else loadAccessAndAudit();
      });

      function renderPeopleDirectory() {
        const q = (document.getElementById('people-search').value || '').trim().toLowerCase();
        const filtered = peopleDirectoryCache.filter((p) => {
          if (peopleFilter === 'staff' && !p.hasStaff) return false;
          if (peopleFilter === 'normal' && p.hasStaff) return false;
          if (peopleFilter === 'applicant' && !p.hasApplicant) return false;
          if (q) {
            const hay = `${p.name} ${p.phone} ${p.email} ${p.team} ${p.rank} ${p.roleName} ${p.school}`.toLowerCase();
            if (!hay.includes(q)) return false;
          }
          return true;
        });

        document.getElementById('people-count').textContent = `${filtered.length} of ${peopleDirectoryCache.length} accounts`;
        const tbody = document.getElementById('people-list');
        tbody.replaceChildren();
        if (!filtered.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="py-8 px-5 text-center text-[13px] text-[#767D8C]">No members or logged-in accounts match this filter.</td></tr>';
          return;
        }

        filtered.forEach((p) => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[#FAF9F6] transition cursor-pointer';
          const roleBadge = p.hasStaff
            ? `<span class="inline-block px-2 py-0.5 rounded-md text-[11px] font-medium ${p.active ? 'bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58]' : 'bg-[#FEF3F2] border border-[#FECDCA] text-[#B42318]'}">${esc(p.roleName || p.roleId)}</span>`
            : '<span class="inline-block px-2 py-0.5 rounded-md text-[11px] font-medium bg-[#F3F2EE] border border-[#DFDDD6] text-[#525866]">Normal User</span>';
          const teamLine = p.team
            ? `<div class="text-[11.5px] font-medium text-[#1B365D] mb-0.5">${esc(p.team)}${p.rank && p.rank !== 'Normal User' ? ' · ' + esc(p.rank) : ''}</div>`
            : '';

          tr.innerHTML = `
            <td class="py-3 px-5 font-medium text-[#161A22]">${esc(p.name || 'Unnamed account')}</td>
            <td class="py-3 px-4 font-code text-[12.5px] text-[#525866] whitespace-nowrap">${esc(p.phone || '—')}</td>
            <td class="py-3 px-4 font-code text-[12.5px] text-[#161A22]">${esc(p.email)}</td>
            <td class="py-3 px-4">${teamLine}${roleBadge}${p.hasApplicant && !p.hasStaff ? ' <span class="ml-1 font-code text-[10.5px] px-1.5 py-0.5 rounded bg-[#E4EAF2] text-[#1B365D]">Applicant</span>' : ''}</td>
            <td class="py-3 px-5 text-right whitespace-nowrap">
              <button type="button" class="inspect-btn h-8 px-3 rounded-lg border border-[#DFDDD6] bg-white hover:bg-[#F3F2EE] text-[12px] font-medium text-[#1B365D]">Inspect &amp; Assign</button>
            </td>
          `;
          tr.addEventListener('click', () => openPersonModal(p));
          tbody.appendChild(tr);
        });
      }

      document.getElementById('people-search').addEventListener('input', renderPeopleDirectory);
      document.querySelectorAll('#people-filter-bar .pf-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          peopleFilter = btn.getAttribute('data-pf') || 'all';
          document.querySelectorAll('#people-filter-bar .pf-btn').forEach((b) => {
            b.className = b.getAttribute('data-pf') === peopleFilter
              ? 'pf-btn px-3 py-1 rounded-lg text-[12px] font-semibold bg-[#1B365D] text-white'
              : 'pf-btn px-3 py-1 rounded-lg text-[12px] font-medium bg-[#F3F2EE] text-[#525866] hover:text-[#161A22]';
          });
          renderPeopleDirectory();
        });
      });

      // ---- ROLE RULES BUILDER ----
      function resetRoleRuleForm() {
        document.getElementById('role-rule-form').reset();
        document.getElementById('rr-original-id').value = '';
        document.getElementById('rr-form-title').textContent = 'Create or edit role rule';
        const idInput = document.getElementById('rr-id');
        idInput.readOnly = false;
        idInput.classList.remove('opacity-70');
        document.querySelectorAll('.rr-cb').forEach((c) => { c.checked = false; });
      }

      document.getElementById('rr-new-btn').addEventListener('click', resetRoleRuleForm);
      document.getElementById('rr-cancel-btn').addEventListener('click', resetRoleRuleForm);
      document.getElementById('rr-name').addEventListener('input', (e) => {
        if (!document.getElementById('rr-original-id').value) {
          document.getElementById('rr-id').value = slugifyRole(e.target.value);
        }
      });

      function renderRoleRulesList() {
        document.getElementById('rr-count').textContent = `${roleDefinitionsCache.length} role rules`;
        const box = document.getElementById('role-rules-list');
        box.replaceChildren();
        if (!roleDefinitionsCache.length) {
          box.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No role rules defined yet. Create one on the left.</div>';
          return;
        }

        roleDefinitionsCache.forEach((r) => {
          const assignedCount = staffAccessCache.filter((s) => s.role === r.id && s.active !== false).length;
          const perms = Array.isArray(r.permissions) ? r.permissions : [];
          const permChips = perms.length
            ? perms.map((k) => `<span class="font-code text-[10.5px] px-2 py-0.5 rounded bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58]">${esc(permLabel(k))}</span>`).join('')
            : '<span class="font-code text-[10.5px] px-2 py-0.5 rounded bg-[#F3F2EE] border border-[#DFDDD6] text-[#525866]">Tasks Board & Time Logs only</span>';

          const card = document.createElement('div');
          card.className = 'p-4 sm:p-5 space-y-2.5';
          card.innerHTML = `
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <strong class="text-[15px] text-[#161A22]">${esc(r.name)}</strong>
                  <span class="font-code text-[11px] px-2 py-0.5 rounded bg-[#EAE8E1] text-[#525866]">${esc(r.id)}</span>
                  ${r.defaultTeam ? `<span class="text-[11px] font-medium px-2 py-0.5 rounded bg-[#E4EAF2] text-[#1B365D]">${esc(r.defaultTeam)}</span>` : ''}
                  <span class="font-code text-[11px] text-[#767D8C]">${assignedCount} assigned</span>
                </div>
                ${r.description ? `<p class="text-[12.5px] text-[#525866] mt-1">${esc(r.description)}</p>` : ''}
              </div>
              <div class="flex gap-3 shrink-0">
                <button type="button" class="edit-rule-btn text-[12px] font-medium text-[#1B365D] hover:underline">Edit rule</button>
                ${r.id !== 'owner' ? '<button type="button" class="del-rule-btn text-[12px] font-medium text-[#B42318] hover:underline">Delete</button>' : ''}
              </div>
            </div>
            <div class="flex flex-wrap gap-1.5">${permChips}</div>
          `;

          card.querySelector('.edit-rule-btn').addEventListener('click', () => {
            document.getElementById('rr-original-id').value = r.id;
            document.getElementById('rr-form-title').textContent = `Editing rule: ${r.name}`;
            document.getElementById('rr-name').value = r.name || '';
            const idInput = document.getElementById('rr-id');
            idInput.value = r.id;
            idInput.readOnly = true;
            idInput.classList.add('opacity-70');
            document.getElementById('rr-team').value = r.defaultTeam || '';
            document.getElementById('rr-desc').value = r.description || '';
            const set = new Set(perms);
            document.querySelectorAll('.rr-cb').forEach((c) => { c.checked = set.has(c.value); });
          });

          card.querySelector('.del-rule-btn')?.addEventListener('click', async () => {
            const countUsing = staffAccessCache.filter((s) => s.role === r.id).length;
            if (countUsing > 0) {
              showToast(`Cannot delete "${r.name}": ${countUsing} teammate(s) are still assigned to it. Reassign them first.`);
              return;
            }
            await deleteDoc(doc(db, 'roleDefinitions', r.id));
            await writeAudit('roles', 'delete', r.id, `Deleted role rule ${r.name}`);
            showToast(`Deleted role rule "${r.name}"`);
            loadAccessAndAudit();
          });

          box.appendChild(card);
        });
      }

      document.getElementById('role-rule-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('rr-name').value.trim();
        const originalId = document.getElementById('rr-original-id').value.trim();
        const ruleId = originalId || slugifyRole(document.getElementById('rr-id').value || name);
        if (!ruleId || ruleId.length < 2) {
          showToast('Role Rule ID must be at least 2 alphanumeric characters.');
          return;
        }
        const defaultTeam = document.getElementById('rr-team').value.trim();
        const description = document.getElementById('rr-desc').value.trim();
        let permissions = Array.from(document.querySelectorAll('.rr-cb')).filter((c) => c.checked).map((c) => c.value);
        if (ruleId === 'owner' && permissions.length < ALL_PERMS.length) {
          permissions = ALL_PERMS.map((p) => p.key);
        }

        await setDoc(doc(db, 'roleDefinitions', ruleId), {
          id: ruleId,
          name,
          defaultTeam,
          description,
          permissions,
          updatedBy: (currentUser?.email || '').toLowerCase(),
          updatedAt: new Date().toISOString(),
        }, { merge: true });

        // Live propagate rule capabilities to all non-overridden teammates holding this role
        const affected = staffAccessCache.filter((s) => s.role === ruleId && !s.customPermissions);
        await Promise.all(
          affected.map((s) =>
            setDoc(doc(db, 'staffAccess', s.email), {
              role: ruleId,
              roleName: name,
              permissions,
              active: s.active !== false,
              updatedBy: (currentUser?.email || '').toLowerCase(),
              updatedAt: new Date().toISOString(),
            }, { merge: true })
          )
        );

        await writeAudit('roles', originalId ? 'update' : 'create', ruleId, `${name} (${permissions.length} perms) -> synced ${affected.length}`);
        showToast(`Saved "${name}" & synced ${affected.length} teammate(s)`);
        resetRoleRuleForm();
        loadAccessAndAudit();
      });

      async function loadAccessAndAudit() {
        await loadUnifiedDirectoryData();
        const auSnap = await getDocs(query(collection(db, 'auditLogs'), orderBy('createdIso', 'desc'), limit(60))).catch(() => getDocs(collection(db, 'auditLogs')).catch(() => ({ docs: [] })));

        renderPeopleDirectory();
        renderRoleRulesList();

        const auList = document.getElementById('audit-list');
        auList.replaceChildren();
        if (!auSnap.docs.length) {
          auList.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No dashboard activity recorded yet.</div>';
        } else {
          auSnap.docs.forEach((d) => {
            const a = d.data();
            const row = document.createElement('div');
            row.className = 'p-3.5 flex flex-wrap justify-between gap-2 text-[13px]';
            row.innerHTML = `<div><span class="font-code text-[11px] px-2 py-0.5 rounded bg-[#EAE8E1]">${esc(a.section)}:${esc(a.action)}</span> <strong class="ml-1.5">${esc(a.summary)}</strong> <span class="text-[#525866] ml-1.5">by ${esc(a.actorEmail)}</span></div><span class="font-code text-[11px] text-[#767D8C]">${esc(String(a.createdIso || '').slice(0, 19).replace('T', ' '))}</span>`;
            auList.appendChild(row);
          });
        }
      }

      // ---- AUTH & BOOTSTRAP ----
      document.getElementById('mobile-nav-btn').addEventListener('click', () => {
        document.getElementById('mobile-nav-drawer').classList.toggle('hidden');
      });
      document.getElementById('btn-google').addEventListener('click', async () => {
        document.getElementById('auth-err').classList.add('hidden');
        try { await signInWithPopup(auth, googleProvider); } catch (err) {
          document.getElementById('auth-err').textContent = err?.message || 'Google sign-in failed';
          document.getElementById('auth-err').classList.remove('hidden');
        }
      });
      document.getElementById('email-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        document.getElementById('auth-err').classList.add('hidden');
        try {
          await signInWithEmailAndPassword(auth, document.getElementById('auth-email').value.trim(), document.getElementById('auth-pass').value);
        } catch (err) {
          document.getElementById('auth-err').textContent = err?.message || 'Invalid credentials';
          document.getElementById('auth-err').classList.remove('hidden');
        }
      });
      document.getElementById('btn-send-verify').addEventListener('click', async () => {
        if (auth.currentUser) {
          await sendEmailVerification(auth.currentUser);
          const m = document.getElementById('verify-msg');
          m.textContent = 'Verification link sent to your inbox.';
          m.classList.remove('hidden');
        }
      });
      document.getElementById('btn-check-verify').addEventListener('click', async () => {
        if (auth.currentUser) { await auth.currentUser.reload(); resolveSession(auth.currentUser); }
      });
      ['btn-signout', 'mobile-signout-btn', 'btn-unverified-out', 'btn-denied-out'].forEach((id) => {
        document.getElementById(id).addEventListener('click', () => signOut(auth));
      });

      async function ensureLoggedInUserRecord(user) {
        if (!user || !user.uid || !user.email) return;
        try {
          const userRef = doc(db, 'users', user.uid);
          const nowIso = new Date().toISOString();
          const emailLower = user.email.toLowerCase();
          const fallbackName = (user.displayName || emailLower.split('@')[0] || 'Member').trim().slice(0, 150);
          const snap = await getDoc(userRef);
          if (!snap.exists()) {
            const parts = fallbackName.split(/\s+/);
            await setDoc(userRef, {
              uid: user.uid,
              email: emailLower,
              fullName: fallbackName,
              firstName: (parts[0] || '').slice(0, 80),
              lastName: parts.slice(1).join(' ').slice(0, 80),
              phone: (user.phoneNumber || '').slice(0, 40),
              role: 'student',
              createdAt: nowIso,
              lastLoginAt: nowIso,
              registrationDate: serverTimestamp(),
              updatedAt: serverTimestamp(),
            });
          } else {
            const existing = snap.data() || {};
            const patch = {
              email: existing.email || emailLower,
              lastLoginAt: nowIso,
              updatedAt: serverTimestamp(),
            };
            if (!existing.fullName && fallbackName) patch.fullName = fallbackName;
            if (!existing.phone && user.phoneNumber) patch.phone = user.phoneNumber;
            await updateDoc(userRef, patch);
          }
        } catch {}
      }

      async function resolveSession(user) {
        currentUser = user;
        if (!user) { showGate('gate-signin'); return; }
        await ensureLoggedInUserRecord(user);
        if (!user.email || !user.emailVerified) {
          document.getElementById('unverified-email').textContent = user.email || '';
          showGate('gate-unverified');
          return;
        }

        const email = user.email.toLowerCase();
        let authorized = false;
        let rolePillLabel = 'MEMBER';
        activeRole = 'member';
        activePerms = new Set();

        try {
          const staffRef = doc(db, 'staffAccess', email);
          const snap = await getDoc(staffRef);
          if (snap.exists()) {
            const d = snap.data();
            if (d.active === true) {
              authorized = true;
              activeRole = d.role || 'member';
              const perms = ['owner', 'admin', 'founder'].includes(activeRole) ? ALL_PERMS.map((p) => p.key) : (Array.isArray(d.permissions) ? d.permissions : []);
              activePerms = new Set(perms);
              rolePillLabel = (d.team ? `${d.team} · ` : '') + (d.roleName || activeRole);
            }
          } else {
            // Server-enforced bootstrap: firestore.rules allows only configured owner emails
            const boot = {
              email,
              displayName: user.displayName || 'Foundation Owner',
              role: 'owner',
              roleName: 'Owner',
              team: 'Founders',
              rank: 'Owner',
              permissions: ALL_PERMS.map((p) => p.key),
              active: true,
              updatedAt: new Date().toISOString(),
            };
            await setDoc(staffRef, boot);
            authorized = true;
            activeRole = 'owner';
            activePerms = new Set(boot.permissions);
            rolePillLabel = 'Founders · Owner';
          }
        } catch {}

        if (!authorized) {
          document.getElementById('denied-email').textContent = email;
          showGate('gate-denied');
          return;
        }

        document.getElementById('sb-role-pill').textContent = rolePillLabel.toUpperCase();
        document.getElementById('sb-user-name').textContent = user.displayName || email.split('@')[0];
        document.getElementById('sb-user-email').textContent = email;
        showGate('dash-shell');
        renderNav();
        switchWorkspace(activeWorkspace);
      }

      onAuthStateChanged(auth, resolveSession);
    </script>
  </body>
</html>
