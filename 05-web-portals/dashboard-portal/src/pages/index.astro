        if (roleId === 'normal_user') {
          activeCb.disabled = true;
          activeWrap.classList.add('opacity-70');
          customToggle.checked = false;
          customToggle.disabled = true;
          permsWrap.classList.add('hidden');
          preview.innerHTML = '<span class="text-[11.5px] text-[#767D8C]">Public student / user account — no dashboard workspaces unlocked.</span>';
          return;
        }

        activeCb.disabled = false;
        activeWrap.classList.remove('opacity-70');
        customToggle.disabled = false;
        permsWrap.classList.toggle('hidden', !customToggle.checked);

        const rule = getRoleRule(roleId);
        const rulePerms = rule ? (rule.permissions || []) : [];
        if (!customToggle.checked) {
          const set = new Set(rulePerms);
          document.querySelectorAll('.pa-cb').forEach((c) => { c.checked = set.has(c.value); });
        }

        if (!rulePerms.length) {
          preview.innerHTML = '<span class="font-code text-[11px] px-2 py-0.5 rounded bg-[#EAE8E1] text-[#525866]">Tasks Board & Time Logs</span>';
