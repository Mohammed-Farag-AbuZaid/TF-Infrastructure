      // ---- 6. OPEN LEDGER (FULLY SOLVES HARDCODED EXAMPLES) ----
      let ledgerManaged = false;
      let currentLedgerItems = [];

      async function ensureLedgerManagedExcluding(skipId) {
        if (!ledgerManaged) {
          for (const item of BASELINE_LEDGER) {
            if (item.id === skipId) continue;
            const { id, ...fields } = item;
            await setDoc(doc(db, 'ledgerEntries', id), fields);
          }
          await setDoc(doc(db, 'siteConfig', 'ledger'), { managed: true, updatedAt: new Date().toISOString() }, { merge: true });
          ledgerManaged = true;
        }
      }

      async function loadLedger() {
        const [cfgSnap, entriesSnap] = await Promise.all([
          getDoc(doc(db, 'siteConfig', 'ledger')),
          getDocs(collection(db, 'ledgerEntries')),
        ]);
        ledgerManaged = Boolean(cfgSnap.exists() && cfgSnap.data().managed === true);
        const live = [];
        entriesSnap.forEach((d) => live.push({ id: d.id, ...d.data() }));

        currentLedgerItems = ledgerManaged || live.length > 0 ? live : [...BASELINE_LEDGER];
        currentLedgerItems.sort((a, b) => String(b.txDate || '').localeCompare(String(a.txDate || '')));

        let inflows = 0, outflows = 0;
        currentLedgerItems.forEach((e) => {
          const amt = Number(e.amountEgp) || 0;
          if (e.entryType === 'outflow') outflows += amt;
          else inflows += amt;
        });
        document.getElementById('ld-kpi-in').textContent = inflows.toLocaleString('en-US') + ' EGP';
        document.getElementById('ld-kpi-out').textContent = outflows.toLocaleString('en-US') + ' EGP';
        document.getElementById('ld-kpi-net').textContent = (inflows - outflows).toLocaleString('en-US') + ' EGP';
        document.getElementById('ld-status').textContent = ledgerManaged ? 'Managed live in Dashboard' : 'Showing initial baseline examples (click Delete to remove)';

        const list = document.getElementById('ld-list');
        list.replaceChildren();
        if (currentLedgerItems.length === 0) {
          list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">Ledger is clean (0 entries). /transparency now displays 0 EGP.</div>';
          return;
        }
        currentLedgerItems.forEach((item) => {
          const row = document.createElement('div');
          row.className = 'p-4 flex flex-wrap items-center justify-between gap-3';
          const sign = item.entryType === 'outflow' ? '-' : '+';
          row.innerHTML = `
            <div>
              <div class="text-[14px] font-semibold text-[#161A22]">${esc(item.donorOrVendor)}</div>
              <div class="font-code text-[12px] text-[#525866]">${esc(item.txDate)} · ${esc(item.paymentChannel)} · ${sign}${Number(item.amountEgp).toLocaleString('en-US')} EGP</div>
            </div>
            <div class="flex gap-2">
              <button type="button" class="edit-btn h-8 px-3 rounded border border-[#DFDDD6] text-[12px] font-medium">Edit</button>
              <button type="button" class="del-btn h-8 px-3 rounded border border-[#FECDCA] text-[#B42318] text-[12px] font-medium">Delete</button>
            </div>
          `;
          row.querySelector('.edit-btn').addEventListener('click', () => {
            document.getElementById('ld-id').value = item.id;
            document.getElementById('ld-date').value = item.txDate;
            document.getElementById('ld-vendor').value = item.donorOrVendor;
            document.getElementById('ld-channel').value = item.paymentChannel;
            document.getElementById('ld-type').value = item.entryType;
            document.getElementById('ld-amount').value = item.amountEgp;
          });
          row.querySelector('.del-btn').addEventListener('click', async () => {
            if (!ledgerManaged) {
              await ensureLedgerManagedExcluding(item.id);
            } else {
              await deleteDoc(doc(db, 'ledgerEntries', item.id));
            }
            await writeAudit('ledger', 'delete', item.id, item.donorOrVendor);
            showToast(`Removed "${item.donorOrVendor}" from live site`);
            loadLedger();
          });
          list.appendChild(row);
        });
      }

      document.getElementById('ld-reset-btn').addEventListener('click', () => { document.getElementById('ld-form').reset(); document.getElementById('ld-id').value = ''; });
      document.getElementById('ld-clear-examples-btn').addEventListener('click', async () => {
