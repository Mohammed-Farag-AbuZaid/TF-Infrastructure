      // 4A. TASKS BOARD (STARTS EMPTY UNTIL REAL TASKS ARE CREATED)
      async function loadTasks() {
        document.getElementById('task-create-form').classList.toggle('hidden', !can('manage_tasks'));
        const snap = await getDocs(collection(db, 'tasks'));
        const tasks = snap.docs.map((d) => ({ id: d.id, ...d.data() }));

        const cols = {
          todo: document.getElementById('col-todo'),
          doing: document.getElementById('col-doing'),
          done: document.getElementById('col-done'),
        };
        Object.values(cols).forEach((c) => c.replaceChildren());
        const counts = { todo: 0, doing: 0, done: 0 };

        tasks.forEach((t) => {
          const st = ['todo', 'doing', 'done'].includes(t.status) ? t.status : 'todo';
          counts[st]++;
          const card = document.createElement('div');
          card.className = 'p-3.5 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] space-y-2';
          card.innerHTML = `<div class="flex items-center justify-between gap-2 text-[11px]"><span class="font-medium text-[#0B5F58]">${esc(t.division || 'Founders')}</span><span class="font-code px-1.5 py-0.5 rounded bg-white border border-[#DFDDD6]">${Number(t.points || 25)} pts</span></div><div class="text-[13.5px] font-semibold text-[#161A22]">${esc(t.title)}</div><div class="text-[11.5px] text-[#525866]">${t.assigneeEmail ? esc(t.assigneeEmail) : 'Open to division'}${t.dueDate ? ' · Due ' + esc(t.dueDate) : ''}</div><div class="flex flex-wrap gap-1.5 pt-1">${st !== 'doing' ? '<button type="button" data-move="doing" class="px-2 py-1 rounded bg-white border border-[#DFDDD6] text-[11px] font-medium">Start</button>' : ''}${st !== 'done' ? '<button type="button" data-move="done" class="px-2 py-1 rounded bg-[#0F766E] text-white text-[11px] font-medium">Mark done</button>' : '<button type="button" data-move="todo" class="px-2 py-1 rounded bg-white border border-[#DFDDD6] text-[11px] font-medium">Reopen</button>'}${can('manage_tasks') ? '<button type="button" class="del-btn px-2 py-1 text-[11px] text-[#B42318]">Delete</button>' : ''}</div>`;
          card.querySelectorAll('[data-move]').forEach((b) => {
            b.addEventListener('click', async () => {
              const nextStatus = b.getAttribute('data-move');
              await updateDoc(doc(db, 'tasks', t.id), {
                status: nextStatus,
                completedByEmail: nextStatus === 'done' ? (currentUser.email || '').toLowerCase() : '',
                completedByName: nextStatus === 'done' ? (currentUser.displayName || currentUser.email.split('@')[0]) : '',
                updatedAt: new Date().toISOString(),
              });
              await writeAudit('tasks', nextStatus, t.id, `${t.title} -> ${nextStatus}`);
              loadTasks();
            });
          });
          card.querySelector('.del-btn')?.addEventListener('click', async () => {
            await deleteDoc(doc(db, 'tasks', t.id));
            await writeAudit('tasks', 'delete', t.id, t.title || t.id);
            loadTasks();
          });
          cols[st].appendChild(card);
        });

        ['todo', 'doing', 'done'].forEach((k) => {
          document.getElementById('cnt-' + k).textContent = String(counts[k]);
          if (counts[k] === 0) {
            cols[k].innerHTML = '<div class="py-4 text-center text-[12px] text-[#767D8C]">Empty</div>';
          }
        });
      }

      document.getElementById('task-create-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = document.getElementById('tk-title').value.trim();
        await addDoc(collection(db, 'tasks'), {
          title,
          division: document.getElementById('tk-div').value,
          assigneeEmail: document.getElementById('tk-assignee').value.trim().toLowerCase(),
          dueDate: document.getElementById('tk-due').value,
          points: Number(document.getElementById('tk-pts').value || 25),
          status: 'todo',
          createdAt: new Date().toISOString(),
        });
        await writeAudit('tasks', 'create', 'new', title);
        e.target.reset();
        document.getElementById('tk-pts').value = 25;
        showToast('Task assigned');
        loadTasks();
      });

      // 4B. TEAM & HR ROSTER
      let rosterCache = [];
      async function loadRoster() {
        document.getElementById('team-form').classList.toggle('hidden', !can('edit_team'));
        const snap = await getDocs(collection(db, 'teamMembers'));
        const byId = new Map(BASELINE_MEMBERS.map((m) => [m.id, { ...m }]));
        snap.docs.forEach((d) => {
          const v = d.data();
          if (v.archived) byId.delete(d.id);
          else byId.set(d.id, { id: d.id, ...v });
        });
        rosterCache = Array.from(byId.values());
        renderRoster();
      }

      function renderRoster() {
        const q = (document.getElementById('tm-search').value || '').trim().toLowerCase();
        const filtered = rosterCache.filter((m) => !q || `${m.name} ${m.role} ${m.team} ${m.school || ''}`.toLowerCase().includes(q));
        document.getElementById('tm-count').textContent = `${filtered.length} members`;
        const list = document.getElementById('tm-list');
        list.replaceChildren();
        filtered.forEach((m) => {
          const row = document.createElement('div');
          row.className = 'p-4 flex flex-wrap items-center justify-between gap-2 text-[13.5px]';
          row.innerHTML = `<div><strong class="text-[#161A22]">${esc(m.name)}</strong> <span class="text-[#525866]">— ${esc(m.role)}</span><div class="text-[12px] text-[#767D8C]">${esc(m.team)}${m.school ? ' · ' + esc(m.school) : ''} · ${esc(m.cohortDate || '')}</div></div>${can('edit_team') ? '<div class="flex gap-3"><button type="button" class="edit-btn text-[12px] text-[#1B365D] hover:underline">Edit</button><button type="button" class="del-btn text-[12px] text-[#B42318] hover:underline">Remove</button></div>' : ''}`;
          row.querySelector('.edit-btn')?.addEventListener('click', () => {
            document.getElementById('tm-id').value = m.id;
            document.getElementById('tm-name').value = m.name || '';
            document.getElementById('tm-role').value = m.role || '';
            document.getElementById('tm-team').value = m.team || 'Founders';
            document.getElementById('tm-school').value = m.school || '';
            document.getElementById('tm-cohort').value = m.cohortDate || '2026-11';
            document.getElementById('tm-bio').value = m.bio || '';
          });
          row.querySelector('.del-btn')?.addEventListener('click', async () => {
            await setDoc(doc(db, 'teamMembers', m.id), { archived: true, name: m.name || '' }, { merge: true });
            await writeAudit('team', 'archive', m.id, `Removed ${m.name}`);
            showToast(`Removed ${m.name}`);
            loadRoster();
          });
          list.appendChild(row);
        });
      }

      document.getElementById('tm-search').addEventListener('input', renderRoster);
      document.getElementById('tm-sync-roster').addEventListener('click', async () => {
        for (const m of BASELINE_MEMBERS) {
          await setDoc(doc(db, 'teamMembers', m.id), m, { merge: true });
        }
        await writeAudit('team', 'sync', 'roster', `Synced ${BASELINE_MEMBERS.length} org members`);
        showToast('Synced 71-member org roster to Firestore');
        loadRoster();
      });

      document.getElementById('team-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const existingId = document.getElementById('tm-id').value.trim();
        const id = existingId || 'm_' + Date.now();
        await setDoc(doc(db, 'teamMembers', id), {
          id,
          name: document.getElementById('tm-name').value.trim(),
          role: document.getElementById('tm-role').value.trim(),
          team: document.getElementById('tm-team').value,
          school: document.getElementById('tm-school').value.trim(),
          cohortDate: document.getElementById('tm-cohort').value.trim(),
          bio: document.getElementById('tm-bio').value.trim(),
          archived: false,
        }, { merge: true });
        await writeAudit('team', existingId ? 'update' : 'create', id, document.getElementById('tm-name').value.trim());
        e.target.reset();
        document.getElementById('tm-id').value = '';
        showToast('Saved team member');
        loadRoster();
      });

      document.getElementById('tm-cancel').addEventListener('click', () => {
        document.getElementById('team-form').reset();
        document.getElementById('tm-id').value = '';
      });

      // 4C. TIME LOGS
      async function loadTimeLogs() {
        const snap = await getDocs(collection(db, 'timeLogs'));
        const list = document.getElementById('tl-all-list');
        list.replaceChildren();
        const logs = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
        logs.sort((a, b) => String(b.createdIso || '').localeCompare(String(a.createdIso || '')));
        if (!logs.length) {
          list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No work logs yet.</div>';
          return;
        }
        logs.forEach((l) => {
          const row = document.createElement('div');
          row.className = 'p-3.5 flex flex-wrap items-center justify-between gap-2 text-[13px]';
          row.innerHTML = `<div><strong>${esc(l.actorName || l.actorEmail)}</strong> <span class="text-[#767D8C]">(${esc(l.division || '')})</span> — ${esc(l.summary)}</div><div class="flex items-center gap-3"><span class="font-code text-[#0B5F58] font-semibold">${Number(l.minutes || 0)} mins</span>${(can('manage_access') || l.actorUid === currentUser.uid) ? '<button type="button" class="text-[12px] text-[#B42318] hover:underline">Delete</button>' : ''}</div>`;
          row.querySelector('button')?.addEventListener('click', async () => {
            await deleteDoc(doc(db, 'timeLogs', l.id));
            loadTimeLogs();
          });
          list.appendChild(row);
        });
      }

      // 4D. TOP ACHIEVERS
      async function loadAchievers() {
        document.getElementById('rec-form').classList.toggle('hidden', !can('manage_tasks') && !can('edit_team'));
        const [taskSnap, logSnap, recSnap] = await Promise.all([
          getDocs(collection(db, 'tasks')),
          getDocs(collection(db, 'timeLogs')),
          getDocs(collection(db, 'recognitions')),
        ]);

        const scores = new Map();
        const addScore = (key, name, pts, mins) => {
          if (!key) return;
          const prev = scores.get(key) || { name: name || key.split('@')[0], email: key, pts: 0, mins: 0 };
          if (name) prev.name = name;
          prev.pts += pts;
          prev.mins += mins;
          scores.set(key, prev);
        };

        taskSnap.docs.forEach((d) => {
          const t = d.data();
          if (t.status === 'done') {
            const who = t.completedByEmail || t.assigneeEmail;
            if (who) addScore(who, t.completedByName, Number(t.points || 25), 0);
          }
        });
        logSnap.docs.forEach((d) => {
          const l = d.data();
          addScore(l.actorEmail, l.actorName, Math.round((Number(l.minutes || 0) / 30) * 10), Number(l.minutes || 0));
        });
        const recs = [];
        recSnap.docs.forEach((d) => {
          const r = d.data();
          recs.push({ id: d.id, ...r });
          addScore((r.email || '').toLowerCase(), r.name, Number(r.points || 50), 0);
        });

        const ranked = Array.from(scores.values()).sort((a, b) => b.pts - a.pts);
        const lb = document.getElementById('lb-list');
        lb.replaceChildren();
        if (!ranked.length) {
          lb.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">Complete tasks, log hours, or award recognitions to build the live leaderboard.</div>';
        } else {
          ranked.forEach((u, i) => {
            const row = document.createElement('div');
            row.className = 'p-4 flex items-center justify-between gap-3';
            row.innerHTML = `<div class="flex items-center gap-3"><span class="font-code w-7 h-7 rounded-full flex items-center justify-center text-[12px] font-bold ${i === 0 ? 'bg-[#1B365D] text-white' : 'bg-[#EAE8E1] text-[#525866]'}">#${i + 1}</span><div><div class="font-semibold text-[14px]">${esc(u.name)}</div><div class="font-code text-[11px] text-[#767D8C]">${Math.round((u.mins / 60) * 10) / 10} hrs logged</div></div></div><div class="font-code font-bold text-[15px] text-[#0B5F58]">${u.pts} pts</div>`;
            lb.appendChild(row);
          });
        }

        const rList = document.getElementById('rec-list');
        rList.replaceChildren();
        if (!recs.length) {
          rList.innerHTML = '<div class="p-5 text-center text-[12.5px] text-[#767D8C]">No awards granted yet.</div>';
        } else {
          recs.forEach((r) => {
            const row = document.createElement('div');
            row.className = 'p-3.5 text-[13px] flex items-center justify-between gap-2';
            row.innerHTML = `<div><strong>${esc(r.name)}</strong> · <span class="text-[#0B5F58] font-medium">${esc(r.badge)}</span> (+${Number(r.points || 50)} pts)</div>`;
            rList.appendChild(row);
          });
        }
      }

      document.getElementById('rec-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('rec-name').value.trim();
        await addDoc(collection(db, 'recognitions'), {
          email: document.getElementById('rec-email').value.trim().toLowerCase(),
          name,
          badge: document.getElementById('rec-badge').value.trim(),
          points: Number(document.getElementById('rec-pts').value || 50),
          createdIso: new Date().toISOString(),
        });
        await writeAudit('recognitions', 'award', name, `Awarded ${name}`);
        e.target.reset();
        document.getElementById('rec-pts').value = 50;
        showToast(`Recognized ${name}`);
        loadAchievers();
      });

      // ---- 5. ACCESS & ACTIVITY WORKSPACE ----
      document.querySelectorAll('#access-subtabs .ac-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-ac');
          document.querySelectorAll('#access-subtabs .ac-tab').forEach((b) => {
            b.className = b.getAttribute('data-ac') === target
              ? 'ac-tab px-3.5 py-1.5 rounded-lg text-[13px] font-semibold bg-[#1B365D] text-white'
              : 'ac-tab px-3.5 py-1.5 rounded-lg text-[13px] font-medium text-[#525866] hover:text-[#161A22]';
          });
          document.querySelectorAll('.ac-pane').forEach((p) => p.classList.add('hidden'));
          document.getElementById('ac-pane-' + target)?.classList.remove('hidden');
        });
      });

      function renderPermCheckboxes() {
        const box = document.getElementById('ac-perms');
        box.replaceChildren();
        ALL_PERMS.forEach((p) => {
          const lbl = document.createElement('label');
          lbl.className = 'inline-flex items-center gap-2 p-2 rounded-lg border border-[#EAE8E1] cursor-pointer';
          lbl.innerHTML = `<input type="checkbox" class="ac-cb" value="${esc(p.key)}" /><span>${esc(p.label)}</span>`;
          box.appendChild(lbl);
        });
      }
      renderPermCheckboxes();

      document.getElementById('ac-role').addEventListener('change', (e) => {
        const preset = ROLE_PRESETS[e.target.value];
        if (!preset) return;
        const set = new Set(preset);
        document.querySelectorAll('.ac-cb').forEach((c) => { c.checked = set.has(c.value); });
      });

      async function loadAccessAndAudit() {
        const [acSnap, auSnap] = await Promise.all([
          getDocs(collection(db, 'staffAccess')),
          getDocs(query(collection(db, 'auditLogs'), orderBy('createdIso', 'desc'), limit(60))).catch(() => getDocs(collection(db, 'auditLogs'))),
        ]);

        const acList = document.getElementById('ac-list');
        acList.replaceChildren();
        acSnap.docs.forEach((d) => {
          const s = { email: d.id, ...d.data() };
          const row = document.createElement('div');
          row.className = 'p-4 flex flex-wrap items-center justify-between gap-2 text-[13px]';
          row.innerHTML = `<div><strong>${esc(s.email)}</strong> <span class="font-code text-[11px] px-2 py-0.5 rounded bg-[#EAE8E1] ml-1">${esc(s.role)}</span> <span class="text-[#767D8C] ml-1">${s.active ? 'Active' : 'Disabled'}</span><div class="text-[11.5px] text-[#525866] mt-0.5">${esc((s.permissions || []).join(', ') || 'Tasks & Time only')}</div></div><div class="flex gap-3"><button type="button" class="edit-btn text-[12px] text-[#1B365D] hover:underline">Edit</button><button type="button" class="del-btn text-[12px] text-[#B42318] hover:underline">Revoke</button></div>`;
          row.querySelector('.edit-btn').addEventListener('click', () => {
            document.getElementById('ac-email').value = s.email;
            document.getElementById('ac-name').value = s.displayName || '';
            document.getElementById('ac-role').value = ROLE_PRESETS[s.role] ? s.role : 'custom';
            const set = new Set(s.permissions || []);
            document.querySelectorAll('.ac-cb').forEach((c) => { c.checked = set.has(c.value); });
            document.getElementById('ac-active').checked = Boolean(s.active);
          });
          row.querySelector('.del-btn').addEventListener('click', async () => {
            await deleteDoc(doc(db, 'staffAccess', s.email));
            await writeAudit('access', 'revoke', s.email, `Revoked ${s.email}`);
            showToast(`Revoked ${s.email}`);
            loadAccessAndAudit();
          });
          acList.appendChild(row);
        });

        const auList = document.getElementById('audit-list');
        auList.replaceChildren();
        auSnap.docs.forEach((d) => {
          const a = d.data();
          const row = document.createElement('div');
          row.className = 'p-3.5 flex flex-wrap justify-between gap-2 text-[13px]';
          row.innerHTML = `<div><span class="font-code text-[11px] px-2 py-0.5 rounded bg-[#EAE8E1]">${esc(a.section)}:${esc(a.action)}</span> <strong class="ml-1.5">${esc(a.summary)}</strong> <span class="text-[#525866] ml-1.5">by ${esc(a.actorEmail)}</span></div><span class="font-code text-[11px] text-[#767D8C]">${esc(String(a.createdIso || '').slice(0, 19).replace('T', ' '))}</span>`;
          auList.appendChild(row);
        });
      }

      document.getElementById('ac-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('ac-email').value.trim().toLowerCase();
        const role = document.getElementById('ac-role').value;
        const permissions = Array.from(document.querySelectorAll('.ac-cb')).filter((c) => c.checked).map((c) => c.value);
        await setDoc(doc(db, 'staffAccess', email), {
          email,
          displayName: document.getElementById('ac-name').value.trim(),
          role,
          permissions,
          active: document.getElementById('ac-active').checked,
          updatedBy: (currentUser?.email || '').toLowerCase(),
          updatedAt: new Date().toISOString(),
        });
        await writeAudit('access', 'grant', email, `${role}: ${permissions.join(', ')}`);
        showToast(`Saved permissions for ${email}`);
        loadAccessAndAudit();
      });

      // ---- AUTH & BOOTSTRAP ----
      document.getElementById('mobile-nav-btn').addEventListener('click', () => {
        document.getElementById('mobile-nav-drawer').classList.toggle('hidden');
      });
      document.getElementById('btn-google').addEventListener('click', async () => {
        document.getElementById('auth-err').classList.add('hidden');
        try { await signInWithPopup(auth, googleProvider); } catch (err) {
          document.getElementById('auth-err').textContent = err?.message || 'Google sign-in failed';
          document.getElementById('auth-err').classList.remove('hidden');
        }
      });
      document.getElementById('email-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        document.getElementById('auth-err').classList.add('hidden');
        try {
          await signInWithEmailAndPassword(auth, document.getElementById('auth-email').value.trim(), document.getElementById('auth-pass').value);
        } catch (err) {
          document.getElementById('auth-err').textContent = err?.message || 'Invalid credentials';
          document.getElementById('auth-err').classList.remove('hidden');
        }
      });
      document.getElementById('btn-send-verify').addEventListener('click', async () => {
        if (auth.currentUser) {
          await sendEmailVerification(auth.currentUser);
          const m = document.getElementById('verify-msg');
          m.textContent = 'Verification link sent to your inbox.';
          m.classList.remove('hidden');
        }
      });
      document.getElementById('btn-check-verify').addEventListener('click', async () => {
        if (auth.currentUser) { await auth.currentUser.reload(); resolveSession(auth.currentUser); }
      });
      ['btn-signout', 'mobile-signout-btn', 'btn-unverified-out', 'btn-denied-out'].forEach((id) => {
        document.getElementById(id).addEventListener('click', () => signOut(auth));
      });

      async function resolveSession(user) {
        currentUser = user;
        if (!user) { showGate('gate-signin'); return; }
        if (!user.email || !user.emailVerified) {
          document.getElementById('unverified-email').textContent = user.email || '';
          showGate('gate-unverified');
          return;
        }

        const email = user.email.toLowerCase();
        let authorized = false;
        activeRole = 'member';
        activePerms = new Set();

        try {
          const staffRef = doc(db, 'staffAccess', email);
          const snap = await getDoc(staffRef);
          if (snap.exists()) {
            const d = snap.data();
            if (d.active === true) {
              authorized = true;
              activeRole = d.role || 'member';
              const perms = ['owner', 'admin', 'founder'].includes(activeRole) ? ALL_PERMS.map((p) => p.key) : (Array.isArray(d.permissions) ? d.permissions : []);
              activePerms = new Set(perms);
            }
          } else {
            // Server-enforced bootstrap: firestore.rules allows only configured owner emails
            const boot = {
              email,
              displayName: user.displayName || 'Foundation Owner',
              role: 'owner',
              permissions: ALL_PERMS.map((p) => p.key),
              active: true,
              updatedAt: new Date().toISOString(),
            };
            await setDoc(staffRef, boot);
            authorized = true;
            activeRole = 'owner';
            activePerms = new Set(boot.permissions);
          }
        } catch {}

        if (!authorized) {
          document.getElementById('denied-email').textContent = email;
          showGate('gate-denied');
          return;
        }

        document.getElementById('sb-role-pill').textContent = activeRole.toUpperCase();
        document.getElementById('sb-user-name').textContent = user.displayName || email.split('@')[0];
        document.getElementById('sb-user-email').textContent = email;
        showGate('dash-shell');
        renderNav();
        switchWorkspace(activeWorkspace);
      }

      onAuthStateChanged(auth, resolveSession);
    </script>
  </body>
</html>
