      function updatePersonRulePreview() {
        const roleId = document.getElementById('pa-role').value;
        const preview = document.getElementById('pa-rule-preview');
        const activeWrap = document.getElementById('pa-active-wrap');
        const activeCb = document.getElementById('pa-active');
