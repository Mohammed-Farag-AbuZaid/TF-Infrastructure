      // ---- UNIFIED STATE & LOADERS (ROSTER + USERS + STAFF + ROLE RULES) ----
      let rosterCache = [];
      let roleDefinitionsCache = [...DEFAULT_ROLE_RULES];
      let staffAccessCache = [];
      let peopleDirectoryCache = [];
      let peopleFilter = 'all';
      let rosterStatusFilter = 'all';

      const TEAM_OPTIONS = new Set(['', ...CANONICAL_TEAMS]);
      const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

      function fmtMonth(ym) {
        const s = String(ym || '').trim();
        const parts = s.split('-');
        if (parts.length === 2) {
          const m = Number(parts[1]);
          if (m >= 1 && m <= 12) return `${MONTHS[m - 1]} ${parts[0]}`;
        }
        return s || 'Present';
      }

      function fmtTenureLabel(m) {
        const start = m.startDate || m.cohortDate || '2026-11';
        const end = m.endDate || '';
        return `${fmtMonth(start)} – ${end ? fmtMonth(end) : 'Present'}`;
      }

      function fmtDate(val) {
        if (!val) return '—';
        try {
          if (typeof val === 'object' && typeof val.toDate === 'function') {
            return val.toDate().toISOString().slice(0, 16).replace('T', ' ');
          }
          if (typeof val === 'object' && typeof val.seconds === 'number') {
            return new Date(val.seconds * 1000).toISOString().slice(0, 16).replace('T', ' ');
          }
          const s = String(val).trim();
          if (!s) return '—';
          return s.length >= 16 ? s.slice(0, 16).replace('T', ' ') : s;
        } catch {
          return '—';
        }
      }

      function pickStr(...vals) {
        for (const v of vals) {
          if (v !== undefined && v !== null && String(v).trim()) return String(v).trim();
        }
        return '';
      }

      function slugifyRole(str) {
        return String(str || '')
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, '_')
          .replace(/^_+|_+$/g, '')
          .slice(0, 40);
      }

      function getRoleRule(roleId) {
        return roleDefinitionsCache.find((r) => r.id === roleId) || null;
      }

      function permLabel(key) {
        return ALL_PERMS.find((p) => p.key === key)?.label || key;
      }

      function lookupPersonName(email) {
        const clean = String(email || '').trim().toLowerCase();
        if (!clean) return '';
        const p = peopleDirectoryCache.find((x) => x.email === clean);
        return p ? `${p.name}${p.team ? ' (' + p.team + ')' : ''}` : email;
      }

      function buildPeopleDirectory(userDocs, staffDocs, volDocs) {
        const byEmail = new Map();
        const ensureBucket = (key, email) => {
          if (!byEmail.has(key)) {
            byEmail.set(key, { key, email: email || '', user: null, staff: null, vol: null });
          }
          const b = byEmail.get(key);
          if (email && !b.email) b.email = email;
          return b;
        };

        userDocs.forEach((d) => {
          const data = { id: d.id, uid: d.data().uid || d.id, ...d.data() };
          const email = String(data.email || '').trim().toLowerCase();
          const b = ensureBucket(email || `uid:${d.id}`, email);
          b.user = data;
        });

        staffDocs.forEach((d) => {
          const email = String(d.id || d.data().email || '').trim().toLowerCase();
          const b = ensureBucket(email, email);
          b.staff = { email, ...d.data() };
        });

        volDocs.forEach((d) => {
          const data = { id: d.id, ...d.data() };
          const email = String(data.email || data.applicant_email || '').trim().toLowerCase();
          const b = ensureBucket(email || `vol:${d.id}`, email);
          if (!b.vol) b.vol = data;
        });

        const entries = Array.from(byEmail.values()).map((b) => {
          const u = b.user || {};
          const s = b.staff || {};
          const v = b.vol || {};
          const fullNameFromParts = [u.firstName, u.lastName].filter(Boolean).join(' ').trim();
          const emailPrefix = b.email ? b.email.split('@')[0] : '';
          const name = pickStr(s.displayName, u.fullName, fullNameFromParts, v.fullName, v.name, v.full_name, emailPrefix, 'Member');
          const roleId = b.staff ? (s.role || 'team_member') : 'normal_user';
          const matchedRule = getRoleRule(roleId);
          return {
            key: b.key,
            email: b.email,
            name,
            phone: pickStr(s.phone, u.phone, u.phoneNumber, v.phone, v.phoneNumber),
            uid: pickStr(u.uid, u.id, v.uid),
            school: pickStr(u.stemSchool, u.school, v.stemSchool, v.school),
            grade: pickStr(u.grade, u.academicLevel, v.grade, v.academicLevel),
            gov: pickStr(u.governorate, u.gov, v.governorate, v.gov),
            track: pickStr(v.track, v.target_track, v.team, v.division, u.track),
            bio: pickStr(v.motivation, v.motivation_answer, v.notes, v.bio, u.bio),
            createdAt: fmtDate(u.createdAt || u.registrationDate || v.createdAt),
            lastLoginAt: fmtDate(u.lastLoginAt || u.updatedAt),
            team: pickStr(s.team, u.team),
            rank: pickStr(s.rank, u.rank, b.staff ? 'Member' : 'Normal User'),
            roleId,
            roleName: b.staff ? pickStr(s.roleName, matchedRule?.name, roleId) : 'Normal User',
            permissions: b.staff && Array.isArray(s.permissions) ? s.permissions : [],
            customPermissions: Boolean(s.customPermissions),
            active: b.staff ? Boolean(s.active) : false,
            publicMemberId: pickStr(s.publicMemberId, u.publicMemberId),
            startDate: pickStr(s.startDate, u.startDate),
            endDate: pickStr(s.endDate, u.endDate),
            hasStaff: Boolean(b.staff),
            hasUser: Boolean(b.user),
            hasApplicant: Boolean(b.vol),
          };
        });

        entries.sort((a, b) => {
          if (a.hasStaff !== b.hasStaff) return a.hasStaff ? -1 : 1;
          return a.name.localeCompare(b.name);
        });
        return entries;
      }

      function populateUnifiedPickers() {
        const tkSel = document.getElementById('tk-assignee');
        if (tkSel) {
          const prev = tkSel.value;
          tkSel.replaceChildren();
          const defOpt = document.createElement('option');
          defOpt.value = '';
          defOpt.textContent = 'Open to whole division';
          tkSel.appendChild(defOpt);
          peopleDirectoryCache.forEach((p) => {
            if (!p.email) return;
            const opt = document.createElement('option');
            opt.value = p.email;
            opt.textContent = `${p.name}${p.team ? ' — ' + p.team : ''} (${p.email})`;
            tkSel.appendChild(opt);
          });
          if (prev) tkSel.value = prev;
        }

        const recPick = document.getElementById('rec-picker');
        if (recPick) {
          recPick.replaceChildren();
          const def = document.createElement('option');
          def.value = '';
          def.textContent = 'Select teammate from directory (or type below)...';
          recPick.appendChild(def);
          peopleDirectoryCache.forEach((p) => {
            if (!p.email) return;
            const opt = document.createElement('option');
            opt.value = p.email;
            opt.textContent = `${p.name}${p.team ? ' · ' + p.team : ''} (${p.email})`;
            recPick.appendChild(opt);
          });
        }

        const tmParent = document.getElementById('tm-parent');
        if (tmParent) {
          const prev = tmParent.value;
          tmParent.replaceChildren();
          const def = document.createElement('option');
          def.value = '';
          def.textContent = 'None (Top level)';
          tmParent.appendChild(def);
          rosterCache.filter((m) => !m.endDate && m.status !== 'alumni').forEach((m) => {
            const opt = document.createElement('option');
            opt.value = m.id;
            opt.textContent = `${m.name} — ${m.role} (${m.team})`;
            tmParent.appendChild(opt);
          });
          if (prev) tmParent.value = prev;
        }
      }

      async function loadUnifiedDirectoryData() {
        const [roleSnap, acSnap, usrSnap, volSnap, memSnap] = await Promise.all([
          getDocs(collection(db, 'roleDefinitions')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'staffAccess')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'users')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'volunteers')).catch(() => ({ docs: [] })),
          getDocs(collection(db, 'teamMembers')).catch(() => ({ docs: [] })),
        ]);

        if (roleSnap.docs.length === 0 && can('manage_access')) {
          await Promise.all(
            DEFAULT_ROLE_RULES.map((r) =>
              setDoc(doc(db, 'roleDefinitions', r.id), {
                ...r,
                updatedBy: (currentUser?.email || '').toLowerCase(),
                updatedAt: new Date().toISOString(),
              }, { merge: true }).catch(() => {})
            )
          );
          roleDefinitionsCache = [...DEFAULT_ROLE_RULES];
        } else if (roleSnap.docs.length > 0) {
          roleDefinitionsCache = roleSnap.docs
            .map((d) => ({ id: d.id, ...d.data() }))
            .sort((a, b) => String(a.name || a.id).localeCompare(String(b.name || b.id)));
        }

        staffAccessCache = acSnap.docs.map((d) => ({ email: d.id, ...d.data() }));
        peopleDirectoryCache = buildPeopleDirectory(usrSnap.docs, acSnap.docs, volSnap.docs);

        const byId = new Map(BASELINE_MEMBERS.map((m) => [m.id, { ...m }]));
        memSnap.docs.forEach((d) => {
          const v = d.data();
          if (v.archived) byId.delete(d.id);
          else byId.set(d.id, { id: d.id, ...v });
        });
        rosterCache = Array.from(byId.values());
        populateUnifiedPickers();
      }

      function findLinkedAccountForMember(m) {
        const byPublicId = peopleDirectoryCache.find((p) => p.publicMemberId && p.publicMemberId === m.id);
        if (byPublicId) return byPublicId;
        const cleanName = String(m.name || '').trim().toLowerCase();
        if (!cleanName) return null;
        return peopleDirectoryCache.find((p) => String(p.name || '').trim().toLowerCase() === cleanName) || null;
      }

      // 4A. TASKS BOARD
      async function loadTasks() {
        document.getElementById('task-create-form').classList.toggle('hidden', !can('manage_tasks'));
        await loadUnifiedDirectoryData();
        const snap = await getDocs(collection(db, 'tasks'));
        const tasks = snap.docs.map((d) => ({ id: d.id, ...d.data() }));

        const cols = {
          todo: document.getElementById('col-todo'),
          doing: document.getElementById('col-doing'),
          done: document.getElementById('col-done'),
        };
        Object.values(cols).forEach((c) => c.replaceChildren());
        const counts = { todo: 0, doing: 0, done: 0 };

        tasks.forEach((t) => {
          const st = ['todo', 'doing', 'done'].includes(t.status) ? t.status : 'todo';
          counts[st]++;
          const card = document.createElement('div');
          card.className = 'p-3.5 rounded-xl bg-[#F3F2EE] border border-[#DFDDD6] space-y-2';
          const assigneeLabel = t.assigneeEmail ? lookupPersonName(t.assigneeEmail) : 'Open to whole division';
          card.innerHTML = `<div class="flex items-center justify-between gap-2 text-[11px]"><span class="font-medium text-[#0B5F58]">${esc(t.division || 'Founders')}</span><span class="font-code px-1.5 py-0.5 rounded bg-white border border-[#DFDDD6]">${Number(t.points || 25)} pts</span></div><div class="text-[13.5px] font-semibold text-[#161A22]">${esc(t.title)}</div><div class="text-[11.5px] text-[#525866]">${esc(assigneeLabel)}${t.dueDate ? ' · Due ' + esc(t.dueDate) : ''}</div><div class="flex flex-wrap gap-1.5 pt-1">${st !== 'doing' ? '<button type="button" data-move="doing" class="px-2 py-1 rounded bg-white border border-[#DFDDD6] text-[11px] font-medium">Start</button>' : ''}${st !== 'done' ? '<button type="button" data-move="done" class="px-2 py-1 rounded bg-[#0F766E] text-white text-[11px] font-medium">Mark done</button>' : '<button type="button" data-move="todo" class="px-2 py-1 rounded bg-white border border-[#DFDDD6] text-[11px] font-medium">Reopen</button>'}${can('manage_tasks') ? '<button type="button" class="del-btn px-2 py-1 text-[11px] text-[#B42318]">Delete</button>' : ''}</div>`;
          card.querySelectorAll('[data-move]').forEach((b) => {
            b.addEventListener('click', async () => {
              const nextStatus = b.getAttribute('data-move');
              await updateDoc(doc(db, 'tasks', t.id), {
                status: nextStatus,
                completedByEmail: nextStatus === 'done' ? (currentUser.email || '').toLowerCase() : '',
                completedByName: nextStatus === 'done' ? (currentUser.displayName || currentUser.email.split('@')[0]) : '',
                updatedAt: new Date().toISOString(),
              });
              await writeAudit('tasks', nextStatus, t.id, `${t.title} -> ${nextStatus}`);
              loadTasks();
            });
          });
          card.querySelector('.del-btn')?.addEventListener('click', async () => {
            await deleteDoc(doc(db, 'tasks', t.id));
            await writeAudit('tasks', 'delete', t.id, t.title || t.id);
            loadTasks();
          });
          cols[st].appendChild(card);
        });

        ['todo', 'doing', 'done'].forEach((k) => {
          document.getElementById('cnt-' + k).textContent = String(counts[k]);
          if (counts[k] === 0) {
            cols[k].innerHTML = '<div class="py-4 text-center text-[12px] text-[#767D8C]">Empty</div>';
          }
        });
      }

      document.getElementById('task-create-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = document.getElementById('tk-title').value.trim();
        await addDoc(collection(db, 'tasks'), {
          title,
          division: document.getElementById('tk-div').value,
          assigneeEmail: document.getElementById('tk-assignee').value.trim().toLowerCase(),
          dueDate: document.getElementById('tk-due').value,
          points: Number(document.getElementById('tk-pts').value || 25),
          status: 'todo',
          createdAt: new Date().toISOString(),
        });
        await writeAudit('tasks', 'create', 'new', title);
        e.target.reset();
        document.getElementById('tk-pts').value = 25;
        showToast('Task assigned');
        loadTasks();
      });

      // 4B. ORG TREE & TENURE LIFECYCLE
      document.querySelectorAll('#tm-status-filters .tsf-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          rosterStatusFilter = btn.getAttribute('data-tsf') || 'all';
          document.querySelectorAll('#tm-status-filters .tsf-btn').forEach((b) => {
            const act = b.getAttribute('data-tsf') === rosterStatusFilter;
            b.className = act
              ? 'tsf-btn px-2.5 py-1 rounded text-[11.5px] font-semibold bg-[#1B365D] text-white'
              : 'tsf-btn px-2.5 py-1 rounded text-[11.5px] font-medium text-[#525866]';
          });
          renderRoster();
        });
      });

      async function loadRoster() {
        document.getElementById('team-form').classList.toggle('hidden', !can('edit_team'));
        if (!document.getElementById('tm-start').value) document.getElementById('tm-start').value = currentYm();
        await loadUnifiedDirectoryData();
        renderRoster();
      }

      function renderRoster() {
        const q = (document.getElementById('tm-search').value || '').trim().toLowerCase();
        const filtered = rosterCache.filter((m) => {
          const isAlum = Boolean(m.endDate) || m.status === 'alumni';
          const linked = findLinkedAccountForMember(m);
          if (rosterStatusFilter === 'active' && isAlum) return false;
          if (rosterStatusFilter === 'alumni' && !isAlum) return false;
          if (rosterStatusFilter === 'linked' && !linked) return false;
          if (q && !`${m.name} ${m.role} ${m.team} ${m.school || ''}`.toLowerCase().includes(q)) return false;
          return true;
        });

        document.getElementById('tm-count').textContent = `${filtered.length} of ${rosterCache.length} org members`;
        const list = document.getElementById('tm-list');
        list.replaceChildren();
        if (!filtered.length) {
          list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No org tree members match this filter.</div>';
          return;
        }

        const byId = new Map(rosterCache.map((x) => [x.id, x]));
        filtered.forEach((m) => {
          const isAlum = Boolean(m.endDate) || m.status === 'alumni';
          const linked = findLinkedAccountForMember(m);
          const succ = m.replacedBy ? byId.get(m.replacedBy) : null;
          const pred = m.replaces ? byId.get(m.replaces) : null;
          const handoverNote = succ ? ` · Succeeded by ${succ.name}` : pred ? ` · Replaced ${pred.name}` : '';

          const row = document.createElement('div');
          row.className = 'p-4 flex flex-wrap items-center justify-between gap-3 text-[13.5px]';
          row.innerHTML = `
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <strong class="text-[#161A22]">${esc(m.name)}</strong>
                <span class="text-[#525866]">— ${esc(m.role)}</span>
                <span class="font-code text-[10.5px] px-2 py-0.5 rounded ${isAlum ? 'bg-[#EAE8E1] text-[#525866]' : 'bg-[#EDF7F5] border border-[#BCE3DC] text-[#0B5F58]'}">${isAlum ? 'Alumni' : 'Active'}</span>
                ${linked ? `<span class="font-code text-[10.5px] px-2 py-0.5 rounded bg-[#E4EAF2] text-[#1B365D]">Dashboard Account</span>` : ''}
              </div>
              <div class="text-[12px] text-[#767D8C] mt-0.5">
                ${esc(m.team)}${m.school ? ' · ' + esc(m.school) : ''} · <span class="font-code">${esc(fmtTenureLabel(m))}</span>${esc(handoverNote)}
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-3 shrink-0">
              ${(linked && can('manage_access')) ? '<button type="button" class="acc-btn text-[12px] font-medium text-[#0B5F58] hover:underline">Manage Access →</button>' : ''}
              ${can('edit_team') ? '<button type="button" class="edit-btn text-[12px] text-[#1B365D] hover:underline">Edit</button>' : ''}
              ${(can('edit_team') && !isAlum) ? '<button type="button" class="end-btn text-[12px] font-medium text-[#1B365D] hover:underline">End Tenure / Replace</button>' : ''}
              ${can('edit_team') ? '<button type="button" class="del-btn text-[12px] text-[#B42318] hover:underline">Remove</button>' : ''}
            </div>
          `;

          row.querySelector('.acc-btn')?.addEventListener('click', () => {
            if (linked) openPersonModal(linked);
          });
          row.querySelector('.edit-btn')?.addEventListener('click', () => {
            document.getElementById('tm-id').value = m.id;
            document.getElementById('tm-name').value = m.name || '';
            document.getElementById('tm-role').value = m.role || '';
            document.getElementById('tm-team').value = CANONICAL_TEAMS.includes(m.team) ? m.team : 'Founders';
            document.getElementById('tm-tier').value = String(typeof m.tier === 'number' ? m.tier : 4);
            document.getElementById('tm-start').value = m.startDate || m.cohortDate || '2026-11';
            document.getElementById('tm-end').value = m.endDate || '';
            document.getElementById('tm-parent').value = m.parent || '';
            document.getElementById('tm-school').value = m.school || '';
            document.getElementById('tm-bio').value = m.bio || '';
            document.getElementById('team-form').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
          row.querySelector('.end-btn')?.addEventListener('click', () => openTenureModal(m));
          row.querySelector('.del-btn')?.addEventListener('click', async () => {
            await setDoc(doc(db, 'teamMembers', m.id), { archived: true, name: m.name || '', role: m.role || 'Member', team: m.team || 'Founders' }, { merge: true });
            await writeAudit('team', 'archive', m.id, `Removed ${m.name}`);
            showToast(`Removed ${m.name} from public roster`);
            loadRoster();
          });
          list.appendChild(row);
        });
      }

      function openTenureModal(member) {
        const modal = document.getElementById('tenure-modal');
        document.getElementById('tn-old-id').value = member.id;
        document.getElementById('tn-subtitle').textContent = `${member.name} · ${member.role} (${member.team}) — started ${fmtMonth(member.startDate || member.cohortDate)}`;
        const ym = currentYm();
        document.getElementById('tn-end-date').value = ym;
        document.getElementById('tn-appoint-toggle').checked = true;
        document.getElementById('tn-replacement-fields').classList.remove('hidden');

        const pick = document.getElementById('tn-successor-pick');
        pick.replaceChildren();
        const man = document.createElement('option');
        man.value = '';
        man.textContent = 'Type successor manually...';
        pick.appendChild(man);
        peopleDirectoryCache.forEach((p) => {
          const opt = document.createElement('option');
          opt.value = p.email || p.key;
          opt.textContent = `${p.name}${p.email ? ' (' + p.email + ')' : ''}`;
          pick.appendChild(opt);
        });

        document.getElementById('tn-new-name').value = '';
        document.getElementById('tn-new-role').value = member.role || '';
        document.getElementById('tn-new-school').value = '';
        document.getElementById('tn-new-start').value = ym;
        document.getElementById('tn-reassign-reports').checked = true;
        modal.classList.remove('hidden');
        document.getElementById('tn-end-date').focus();
      }

      document.getElementById('tn-appoint-toggle').addEventListener('change', (e) => {
        document.getElementById('tn-replacement-fields').classList.toggle('hidden', !e.target.checked);
      });

      document.getElementById('tn-successor-pick').addEventListener('change', (e) => {
        const val = e.target.value;
        const p = peopleDirectoryCache.find((x) => (x.email || x.key) === val);
        if (p) {
          document.getElementById('tn-new-name').value = p.name || '';
          document.getElementById('tn-new-school').value = p.school || '';
        }
      });

      function closeTenureModal() {
        document.getElementById('tenure-modal').classList.add('hidden');
      }
      document.getElementById('tn-close').addEventListener('click', closeTenureModal);
      document.getElementById('tn-cancel').addEventListener('click', closeTenureModal);
      document.getElementById('tenure-modal').addEventListener('click', (e) => {
        if (e.target.id === 'tenure-modal') closeTenureModal();
      });

      document.getElementById('tenure-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const oldId = document.getElementById('tn-old-id').value.trim();
        const oldMember = rosterCache.find((x) => x.id === oldId);
        if (!oldMember) return;
        const endDate = document.getElementById('tn-end-date').value || currentYm();
        const appoint = document.getElementById('tn-appoint-toggle').checked;
        const newName = document.getElementById('tn-new-name').value.trim();

        let newId = '';
        if (appoint && newName.length >= 2) {
          newId = 'm_' + Date.now();
          const pickKey = document.getElementById('tn-successor-pick').value;
          const succAccount = peopleDirectoryCache.find((x) => (x.email || x.key) === pickKey);
          const newStart = document.getElementById('tn-new-start').value || endDate;
          const newRole = document.getElementById('tn-new-role').value.trim() || oldMember.role || 'Member';
          const newSchool = document.getElementById('tn-new-school').value.trim() || 'TF Unions';

          await setDoc(doc(db, 'teamMembers', newId), {
            id: newId,
            name: newName,
            role: newRole,
            team: oldMember.team || 'Founders',
            tier: typeof oldMember.tier === 'number' ? oldMember.tier : 4,
            parent: oldMember.parent || null,
            school: newSchool,
            cohortDate: newStart,
            startDate: newStart,
            endDate: '',
            status: 'active',
            replaces: oldId,
            bio: succAccount?.bio || `${newRole} in ${oldMember.team || 'TF Unions'}.`,
            archived: false,
          }, { merge: true });

          if (succAccount?.email && succAccount.hasStaff) {
            await setDoc(doc(db, 'staffAccess', succAccount.email), {
              publicMemberId: newId,
              startDate: newStart,
              endDate: '',
              team: oldMember.team || '',
            }, { merge: true }).catch(() => {});
          }
          if (succAccount?.uid && can('manage_access')) {
            await updateDoc(doc(db, 'users', succAccount.uid), { publicMemberId: newId }).catch(() => {});
          }

          if (document.getElementById('tn-reassign-reports').checked) {
            const directReports = rosterCache.filter((r) => r.parent === oldId && !r.endDate && r.status !== 'alumni');
            await Promise.all(
              directReports.map((r) =>
                setDoc(doc(db, 'teamMembers', r.id), {
                  id: r.id,
                  name: r.name,
                  role: r.role,
                  team: r.team,
                  parent: newId,
                }, { merge: true })
              )
            );
          }
        }

        await setDoc(doc(db, 'teamMembers', oldId), {
          id: oldId,
          name: oldMember.name,
          role: oldMember.role,
          team: oldMember.team,
          startDate: oldMember.startDate || oldMember.cohortDate || '2026-11',
          endDate,
          status: 'alumni',
          ...(newId ? { replacedBy: newId } : {}),
          archived: false,
        }, { merge: true });

        await writeAudit('team', 'tenure_end', oldId, newId ? `${oldMember.name} ended ${endDate} -> replaced by ${newName}` : `${oldMember.name} ended tenure ${endDate}`);
        closeTenureModal();
        showToast(newId ? `Moved ${oldMember.name} to Alumni & appointed ${newName}` : `Ended ${oldMember.name}'s tenure (Alumni)`);
        loadRoster();
      });

      document.getElementById('tm-search').addEventListener('input', renderRoster);
      document.getElementById('tm-sync-roster').addEventListener('click', async () => {
        for (const m of BASELINE_MEMBERS) {
          await setDoc(doc(db, 'teamMembers', m.id), m, { merge: true });
        }
        await writeAudit('team', 'sync', 'roster', `Synced ${BASELINE_MEMBERS.length} org members`);
        showToast('Synced baseline org roster to Firestore');
        loadRoster();
      });

      document.getElementById('team-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const existingId = document.getElementById('tm-id').value.trim();
        const id = existingId || 'm_' + Date.now();
        const startDate = document.getElementById('tm-start').value.trim() || currentYm();
        const endDate = document.getElementById('tm-end').value.trim();
        await setDoc(doc(db, 'teamMembers', id), {
          id,
          name: document.getElementById('tm-name').value.trim(),
          role: document.getElementById('tm-role').value.trim(),
          team: document.getElementById('tm-team').value,
          tier: Number(document.getElementById('tm-tier').value || 4),
          startDate,
          cohortDate: startDate,
          endDate,
          status: endDate ? 'alumni' : 'active',
          parent: document.getElementById('tm-parent').value || null,
          school: document.getElementById('tm-school').value.trim(),
          bio: document.getElementById('tm-bio').value.trim(),
          archived: false,
        }, { merge: true });
        await writeAudit('team', existingId ? 'update' : 'create', id, document.getElementById('tm-name').value.trim());
        e.target.reset();
        document.getElementById('tm-id').value = '';
        document.getElementById('tm-start').value = currentYm();
        showToast('Saved org member & tenure');
        loadRoster();
      });

      document.getElementById('tm-cancel').addEventListener('click', () => {
        document.getElementById('team-form').reset();
        document.getElementById('tm-id').value = '';
        document.getElementById('tm-start').value = currentYm();
      });

      // 4C. TIME LOGS
      async function loadTimeLogs() {
        const snap = await getDocs(collection(db, 'timeLogs'));
        const list = document.getElementById('tl-all-list');
        list.replaceChildren();
        const logs = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
        logs.sort((a, b) => String(b.createdIso || '').localeCompare(String(a.createdIso || '')));
        if (!logs.length) {
          list.innerHTML = '<div class="p-6 text-center text-[13px] text-[#767D8C]">No work logs yet.</div>';
          return;
        }
        logs.forEach((l) => {
          const row = document.createElement('div');
          row.className = 'p-3.5 flex flex-wrap items-center justify-between gap-2 text-[13px]';
