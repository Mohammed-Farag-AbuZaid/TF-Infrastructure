      function rankToTier(rank) {
        if (rank === 'Owner') return 0;
        if (rank === 'Head' || rank === 'Lead' || rank === 'Admin') return 1;
        if (rank === 'Vice Head') return 2;
        return 4;
      }

      function formatPublicRoleTitle(team, rank, roleName, existingMember) {
        if (existingMember && existingMember.role && rank === 'Member' && !team) return existingMember.role;
        const shortTeam = String(team || '').replace(/\s*Team$/i, '').trim();
        if (rank === 'Owner') return 'Co-Founder & Owner';
        if (rank === 'Head' || rank === 'Vice Head' || rank === 'Lead') {
          return shortTeam ? `${shortTeam} ${rank}` : rank;
        }
        if (rank === 'Admin') return 'Operations Admin';
        if (roleName && roleName !== 'Team Member') return roleName;
        return shortTeam ? `${shortTeam} Member` : 'Team Member';
      }

