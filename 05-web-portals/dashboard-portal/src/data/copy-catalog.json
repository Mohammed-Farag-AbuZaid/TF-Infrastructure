      {
        "key": "headline",
        "label": "Headline",
        "kind": "h1",
        "def": "Non-Profit Charter"
      },
      {
        "key": "subtitle",
        "label": "Subtitle",
        "kind": "p",
        "def": "Binding institutional rules covering free student access, data sovereignty, verifiable service records, and open finances."
      },
      {
        "key": "art_0_title",
        "label": "Article 1 Title",
        "kind": "h2",
        "def": "Independent non-profit mandate"
      },
      {
        "key": "art_0_body",
        "label": "Article 1 Body",
        "kind": "p",
        "def": "TF Unions operates strictly as a non-profit student educational foundation. Core student access to university admission data, scholarships, roadmaps, and study circles will never be paywalled or monetized with third-party advertising."
      },
      {
        "key": "art_1_title",
        "label": "Article 2 Title",
        "kind": "h2",
        "def": "Student data sovereignty & single TF Passport"
      },
      {
        "key": "art_1_body",
        "label": "Article 2 Body",
        "kind": "p",
        "def": "Student identity records reside in our self-hosted PostgreSQL database rather than commercial tracking networks. One session cookie scoped to *.tfunions.com grants access across portals and is never sold or shared."
      },
      {
        "key": "art_2_title",
        "label": "Article 3 Title",
        "kind": "h2",
        "def": "Cryptographically verifiable contributor credentials"
      },
      {
        "key": "art_2_body",
        "label": "Article 3 Body",
        "kind": "p",
        "def": "Every volunteer, research author, and officer certificate issued by TF Unions carries a permanent serial code verifiable publicly at verify.tfunions.com."
      },
      {
        "key": "art_3_title",
        "label": "Article 4 Title",
        "kind": "h2",
        "def": "Open-book treasury & infrastructure accountability"
      },
      {
        "key": "art_3_body",
        "label": "Article 4 Body",
        "kind": "p",
        "def": "Every incoming community contribution, hardware grant, and server expenditure is published with verification status and channel provenance on the public Open Financial Ledger."
      }
    ]
  },
