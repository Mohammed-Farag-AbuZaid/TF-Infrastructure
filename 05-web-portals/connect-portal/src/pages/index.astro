---
import ConnectLayout from '../layouts/ConnectLayout.astro';
import { BASELINE_CHAPTERS, GOVERNORATES } from '../data/chapters';

const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'TF Connect Governorate Chapters and Project Guilds',
  itemListElement: BASELINE_CHAPTERS.map((ch, i) => ({
    '@type': 'Organization',
    position: i + 1,
    name: ch.name,
    areaServed: ch.gov,
    description: ch.desc,
  })),
});
---
<ConnectLayout title="TF Connect — Governorate Chapters & Project Guilds">
  <Fragment slot="head-actions">
    <span id="live-sync-status" class="font-mono text-tf-accent-text text-[11.5px] font-medium mr-1">Synchronized atlas</span>
    <a href="/propose" class="h-9 px-3.5 inline-flex items-center rounded-tf-card bg-tf-surface border border-tf-border hover:border-tf-brand text-[13px] font-medium text-tf-ink transition">
      Propose a study group →
    </a>
  </Fragment>

  <main class="max-w-[1160px] mx-auto px-4 sm:px-6 mt-7 mb-16 grid grid-cols-1 lg:grid-cols-[310px_1fr] gap-6 items-start">
    <aside class="bg-tf-surface border border-tf-border rounded-tf-card p-6 lg:sticky lg:top-8 shadow-[0_1px_2px_rgb(22_26_34/0.04)]">
      <div class="pl-2.5 border-l-2 border-tf-accent text-[12.5px] text-tf-muted font-medium">
        27 Egyptian governorates
      </div>
      <h1 data-tf-copy="connect.headline" class="font-display text-[27px] leading-[1.1] mt-2.5 text-tf-ink">Chapters, unions &amp; guilds</h1>
      <p data-tf-copy="connect.subtitle" class="text-[13.5px] leading-[1.6] text-tf-muted mt-2.5">
        Locate STEM high school chapters, regional study circles, and student-led research labs operating across Egypt.
      </p>

      <div class="block text-[12px] font-medium text-tf-ink mt-4 mb-1.5">Classification</div>
      <div class="grid grid-cols-2 gap-1 p-1 bg-tf-sunken border border-tf-border-strong rounded-tf-card" id="type-tabs">
        <button type="button" class="tab-btn active px-2.5 py-1.5 rounded-[7px] text-[12.5px] font-semibold bg-tf-surface text-tf-ink border border-tf-border" data-type="All">All</button>
        <button type="button" class="tab-btn px-2.5 py-1.5 rounded-[7px] text-[12.5px] font-medium text-tf-muted hover:text-tf-ink" data-type="School Chapter">Chapters</button>
        <button type="button" class="tab-btn px-2.5 py-1.5 rounded-[7px] text-[12.5px] font-medium text-tf-muted hover:text-tf-ink" data-type="Project Guild">Guilds</button>
        <button type="button" class="tab-btn px-2.5 py-1.5 rounded-[7px] text-[12.5px] font-medium text-tf-muted hover:text-tf-ink" data-type="Research Lab">Labs</button>
      </div>

      <label for="gov-filter" class="block text-[12px] font-medium text-tf-ink mt-4 mb-1.5">Governorate</label>
      <select id="gov-filter" class="w-full h-10 px-3 rounded-tf-input bg-tf-sunken/60 border border-tf-border text-tf-ink text-[14px] focus:bg-tf-surface focus:border-tf-brand focus:outline-none">
        <option value="All">All Governorates</option>
        {GOVERNORATES.map((g) => (
          <option value={g}>{g}</option>
        ))}
      </select>

      <label for="connect-search" class="block text-[12px] font-medium text-tf-ink mt-4 mb-1.5">Search</label>
      <input
        id="connect-search"
        type="search"
        placeholder="Chapter, city, or focus..."
        class="w-full h-10 px-3 rounded-tf-input bg-tf-sunken/60 border border-tf-border text-tf-ink placeholder-tf-subtle text-[14px] focus:bg-tf-surface focus:border-tf-brand focus:outline-none"
      />
    </aside>

    <section class="bg-tf-surface border border-tf-border rounded-tf-card overflow-hidden shadow-[0_1px_2px_rgb(22_26_34/0.04)]">
      <div class="px-6 py-4 bg-tf-sunken border-b border-tf-border flex items-center justify-between gap-3">
        <strong class="font-display text-[18px] text-tf-ink">Active chapters &amp; project collectives</strong>
        <span class="font-mono text-[12px] text-tf-muted" id="connect-count">{BASELINE_CHAPTERS.length} entries</span>
      </div>

      <div id="connect-grid" class="divide-y divide-tf-sunken">
        {BASELINE_CHAPTERS.map((it) => (
          <article
            class="chapter-row p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-5 cursor-pointer hover:bg-tf-canvas/60 transition"
            data-id={it.id}
            tabindex="0"
            role="button"
          >
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="tf-serial-chip">№ {it.serial}</span>
                <span class="text-[12px] font-semibold text-tf-accent-text">{it.type}</span>
                <span class="bg-tf-sunken border border-tf-border-strong px-2 py-0.5 rounded-tf-input text-tf-muted text-[11.5px] font-medium">{it.gov}</span>
                <span class="text-[12px] text-tf-subtle">{it.focus}</span>
              </div>
              <h2 class="font-display text-[19px] font-semibold text-tf-ink mt-2">{it.name}</h2>
              <p class="text-[13.5px] leading-[1.6] text-tf-muted mt-1.5 max-w-[64ch]">{it.desc}</p>
            </div>
            <span class="px-3.5 py-2 rounded-tf-input bg-tf-canvas border border-tf-border text-tf-ink text-[12.5px] font-medium whitespace-nowrap shrink-0 self-start sm:self-center">
              Inspect →
            </span>
          </article>
        ))}
      </div>
    </section>
  </main>

  <div class="hidden fixed inset-0 bg-black/40 z-50 items-center justify-center p-4" id="chapter-modal" role="dialog" aria-modal="true" aria-labelledby="m-title">
    <div class="w-full max-w-[540px] bg-tf-surface border border-tf-border rounded-tf-card overflow-hidden shadow-xl">
      <div class="bg-tf-canvas p-5 border-b border-tf-border flex justify-between items-start gap-3">
        <div>
          <div id="m-type" class="font-mono text-[12px] font-semibold text-tf-accent-text"></div>
          <h2 id="m-title" class="font-display mt-1.5 text-[21px] text-tf-ink"></h2>
        </div>
        <button id="m-close" type="button" aria-label="Close modal" class="w-8 h-8 rounded-tf-input border border-tf-border bg-tf-surface text-tf-muted hover:text-tf-ink cursor-pointer">✕</button>
      </div>
      <div class="p-6">
        <p id="m-desc" class="text-[14px] leading-[1.65] text-tf-muted"></p>
        <div class="mt-4 p-3.5 rounded-tf-input bg-tf-canvas border border-tf-border text-[13px] flex justify-between">
          <span class="text-tf-muted">Governorate / Scope</span>
          <strong id="m-gov" class="text-tf-ink"></strong>
        </div>
        <div class="mt-5 flex justify-end">
          <a href="https://www.tfunions.com/volunteer" class="px-4 py-2 rounded-tf-input bg-tf-brand hover:bg-tf-brand-hover text-white text-[13px] font-medium transition">
            Apply via Volunteer Hub →
          </a>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={orgJsonLd}></script>

  <script is:inline define:vars={{ BASELINE_CHAPTERS }}>
    let allItems = [...BASELINE_CHAPTERS];
    let activeType = 'All';
    let activeGov = 'All';
    let searchQuery = '';

    function esc(s) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function render() {
      const grid = document.getElementById('connect-grid');
      const filtered = allItems.filter((it) => {
        const matchType = activeType === 'All' || it.type === activeType;
        const matchGov = activeGov === 'All' || it.gov === activeGov;
        const q = searchQuery.toLowerCase();
        const matchQ = !q || it.name.toLowerCase().includes(q) || it.desc.toLowerCase().includes(q) || it.gov.toLowerCase().includes(q);
        return matchType && matchGov && matchQ;
      });

      document.getElementById('connect-count').textContent = `${filtered.length} entr${filtered.length === 1 ? 'y' : 'ies'}`;

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="p-10 text-center text-tf-muted">No chapters or guilds match this filter.</div>`;
        return;
      }

      grid.innerHTML = filtered.map((it, idx) => `
        <article class="chapter-row p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-5 cursor-pointer hover:bg-tf-canvas/60 transition" data-id="${esc(it.id)}" tabindex="0" role="button">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="tf-serial-chip">№ ${esc(it.serial || ('CN-' + String(idx + 1).padStart(2, '0')))}</span>
              <span class="text-[12px] font-semibold text-tf-accent-text">${esc(it.type)}</span>
              <span class="bg-tf-sunken border border-tf-border-strong px-2 py-0.5 rounded-tf-input text-tf-muted text-[11.5px] font-medium">${esc(it.gov)}</span>
              <span class="text-[12px] text-tf-subtle">${esc(it.focus || 'Student Network')}</span>
            </div>
            <h2 class="font-display text-[19px] font-semibold text-tf-ink mt-2">${esc(it.name)}</h2>
            <p class="text-[13.5px] leading-[1.6] text-tf-muted mt-1.5 max-w-[64ch]">${esc(it.desc)}</p>
          </div>
          <span class="px-3.5 py-2 rounded-tf-input bg-tf-canvas border border-tf-border text-tf-ink text-[12.5px] font-medium whitespace-nowrap shrink-0 self-start sm:self-center">Inspect →</span>
        </article>
      `).join('');

      grid.querySelectorAll('.chapter-row').forEach((row) => {
        const id = row.getAttribute('data-id');
        row.addEventListener('click', () => openItem(id));
        row.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openItem(id);
          }
        });
      });
    }

    function openItem(id) {
      const it = allItems.find((x) => x.id === id);
      if (!it) return;
      document.getElementById('m-type').textContent = `${it.type} · ${it.focus || 'Verified'}`;
      document.getElementById('m-title').textContent = it.name;
      document.getElementById('m-desc').textContent = it.desc;
      document.getElementById('m-gov').textContent = it.gov;
      const modal = document.getElementById('chapter-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('chapter-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    document.getElementById('m-close')?.addEventListener('click', closeModal);
    document.getElementById('chapter-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'chapter-modal') closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    document.querySelectorAll('#type-tabs .tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#type-tabs .tab-btn').forEach((b) => {
          b.className = 'tab-btn px-2.5 py-1.5 rounded-[7px] text-[12.5px] font-medium text-tf-muted hover:text-tf-ink';
        });
        btn.className = 'tab-btn active px-2.5 py-1.5 rounded-[7px] text-[12.5px] font-semibold bg-tf-surface text-tf-ink border border-tf-border';
        activeType = btn.getAttribute('data-type');
        render();
      });
    });

    document.getElementById('gov-filter')?.addEventListener('change', (e) => {
      activeGov = e.target.value;
      render();
    });

    document.getElementById('connect-search')?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim();
      render();
    });

    render();

    function decodeFsVal(v) {
      if (!v || typeof v !== 'object') return undefined;
      if ('stringValue' in v) return v.stringValue;
      if ('booleanValue' in v) return v.booleanValue;
      if ('integerValue' in v) return Number(v.integerValue);
      if ('doubleValue' in v) return Number(v.doubleValue);
      return undefined;
    }

    (async () => {
      try {
        const [fsChRes, orgsRes, projRes] = await Promise.all([
          fetch('https://firestore.googleapis.com/v1/projects/tf-unions/databases/(default)/documents/chapters?pageSize=200', { cache: 'no-store' }).then((r) => r.ok ? r.json() : {}).catch(() => ({})),
          fetch('https://n8n.tfunions.com/tf-api/api/collections/orgs').then((r) => r.json()).catch(() => ({})),
          fetch('https://n8n.tfunions.com/tf-api/api/collections/allProjects').then((r) => r.json()).catch(() => ({}))
        ]);
        const extra = [];
        const byId = new Map(BASELINE_CHAPTERS.map((x) => [x.id, x]));
        (fsChRes.documents || []).forEach((doc, idx) => {
          const id = doc.name.split('/').pop();
          const f = doc.fields || {};
          const ch = {};
          Object.keys(f).forEach((k) => { ch[k] = decodeFsVal(f[k]); });
          if (ch.archived) {
            byId.delete(id);
          } else if (ch.name) {
            byId.set(id, {
              id,
              serial: ch.serial || `CH-${String(idx + 1).padStart(2, '0')}`,
              type: ch.type || 'School Chapter',
              gov: ch.gov || 'Nationwide',
              name: ch.name,
              desc: ch.desc || '',
              focus: ch.focus || 'Verified Chapter',
            });
          }
        });
        const seen = new Set(Array.from(byId.values()).map((x) => x.name.toLowerCase()));
        (orgsRes.documents || []).forEach((doc, idx) => {
          const name = doc.name || doc.title;
          if (name && !seen.has(name.toLowerCase())) {
            seen.add(name.toLowerCase());
            extra.push({
              id: 'org-' + (doc.id || idx),
              serial: `ORG-${String(idx + 1).padStart(2, '0')}`,
              type: 'School Chapter',
              gov: doc.governorate || doc.city || 'Nationwide',
              name,
              desc: doc.description || doc.bio || 'Connected student union chapter in the TF Unions ecosystem.',
              focus: doc.category || 'Verified Organization'
            });
          }
        });
        (projRes.documents || []).forEach((doc, idx) => {
          const name = doc.title || doc.name;
          if (name && !seen.has(name.toLowerCase())) {
            seen.add(name.toLowerCase());
            extra.push({
              id: 'proj-' + (doc.id || idx),
              serial: `PRJ-${String(idx + 1).padStart(2, '0')}`,
              type: 'Project Guild',
              gov: doc.governorate || 'Nationwide',
              name,
              desc: doc.description || doc.subtitle || 'Student-led scientific or software project initiative.',
              focus: doc.category || 'Open Project'
            });
          }
        });
        const combined = [...Array.from(byId.values()), ...extra];
        if (combined.length !== BASELINE_CHAPTERS.length || (fsChRes.documents || []).length > 0) {
          allItems = combined;
          document.getElementById('live-sync-status').textContent = `Live Studio Synced (${allItems.length} entries)`;
          render();
        }
      } catch {}
    })();
  </script>
</ConnectLayout>
