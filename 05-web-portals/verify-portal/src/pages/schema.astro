---
/**
 * Cryptographic Verification Schema (`https://verify.tfunions.com/schema`)
 * Dedicated page explaining how TF Unions issues, signs, and verifies credentials.
 */
import '../styles/tf-tokens.css';
import '../styles/tf-ui.css';

const faviconSvg = encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#1B365D"/><rect x="22" y="5" width="5" height="5" rx="1.5" fill="#0F766E"/><path d="M6.8 9.5h11.4v2.7h-4.2V23h-3V12.2H6.8V9.5zm10.8 0H25v2.7h-4.4v2.9h3.8v2.6h-3.8V23h-3V9.5z" fill="#FFFFFF"/></svg>`
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Schema — TF Verify</title>
    <meta name="theme-color" content="#F3F2EE" />
    <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,${faviconSvg}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; }
      .font-display { font-family: 'Bricolage Grotesque', -apple-system, BlinkMacSystemFont, sans-serif; }
      .font-code { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
    </style>
  </head>
  <body class="min-h-screen bg-[#F3F2EE] text-[#161A22] antialiased flex flex-col">
    <main class="flex-1 w-full max-w-[1040px] mx-auto px-4 sm:px-6 py-7 sm:py-10">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-[#DFDDD6]">
        <a href="/" class="inline-flex items-center gap-2 text-[13.5px] font-medium text-[#1B365D] hover:underline">
          ← Back to certificate lookup
        </a>
        <a
          href="https://docs.tfunions.com/api"
          class="text-[13.5px] font-medium text-[#525866] hover:text-[#1B365D] transition"
        >
          Live API explorer →
        </a>
      </div>

      <section class="max-w-[700px]">
        <h1 class="font-display text-[30px] sm:text-[36px] font-bold leading-[1.1] tracking-[-0.025em] text-[#161A22]">
          How credential verification works
        </h1>
        <p class="mt-3 text-[15px] leading-[1.65] text-[#525866]">
          Every TF Unions volunteer, research mentor, and leadership certificate is assigned a permanent immutable serial code backed by our self-hosted PostgreSQL database.
        </p>
      </section>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-5">
        <article class="bg-white border border-[#DFDDD6] rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
          <div class="font-code text-[12px] font-semibold text-[#0B5F58]">01 · Record Registry</div>
          <h2 class="font-display mt-2 text-[19px] font-bold text-[#161A22]">PostgreSQL source of truth</h2>
          <p class="mt-2 text-[13.5px] leading-[1.6] text-[#525866]">
            Issued credentials store recipient full name, role title, verified service hours, cohort year, and issue date in an append-only ledger table.
          </p>
        </article>

        <article class="bg-white border border-[#DFDDD6] rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
          <div class="font-code text-[12px] font-semibold text-[#0B5F58]">02 · Serial Format</div>
          <h2 class="font-display mt-2 text-[19px] font-bold text-[#161A22]">Deterministic code</h2>
          <p class="mt-2 text-[13.5px] leading-[1.6] text-[#525866]">
            Codes strictly match <span class="font-code text-[#161A22]">TFU-YYYY-XXXXXX</span>, preventing collisions and allowing direct QR code deep-linking via <span class="font-code text-[#161A22]">?code=</span>.
          </p>
        </article>

        <article class="bg-white border border-[#DFDDD6] rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
          <div class="font-code text-[12px] font-semibold text-[#0B5F58]">03 · JSON API Endpoint</div>
          <h2 class="font-display mt-2 text-[19px] font-bold text-[#161A22]">Real-time lookup</h2>
          <p class="mt-2 text-[13.5px] leading-[1.6] text-[#525866]">
            Admissions officers and employers can verify records programmatically via our public CORS-enabled REST endpoint without requiring an account.
          </p>
        </article>
      </div>

      <section class="mt-6 bg-white border border-[#DFDDD6] rounded-xl p-6 shadow-[0_1px_2px_rgba(22,26,34,0.04)]">
        <div class="font-code text-[12px] text-[#767D8C]">Public GET endpoint</div>
        <pre class="font-code mt-2 p-3.5 rounded-lg bg-[#EAE8E1]/60 border border-[#DFDDD6] text-[12.5px] text-[#161A22] overflow-x-auto">GET https://n8n.tfunions.com/tf-api/api/verify-certificate?code=TFU-2026-8F92A1</pre>
      </section>
    </main>

    <footer class="tf-eco-footer bg-white">
      <div class="max-w-[1040px] mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-between gap-3 text-[12px]">
        <span>TF Unions Credential Verification Registry</span>
        <a href="/" class="!text-[#1B365D] font-medium hover:underline">Lookup a certificate →</a>
      </div>
    </footer>

    <nav class="tf-mobile-dock" aria-label="Mobile quick navigation">
      <a href="https://www.tfunions.com">Home</a>
      <a href="https://guides.tfunions.com">Learn</a>
      <a href="https://www.tfunions.com/desk">Act</a>
      <a href="https://auth.tfunions.com/?redirect_to=https://verify.tfunions.com">Me</a>
    </nav>

    <script src="/js/tf-chrome.js" defer></script>
  </body>
</html>
