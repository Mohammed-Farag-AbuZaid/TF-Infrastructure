---
/**
 * Official Credential & Certificate Verifier (`https://verify.tfunions.com`)
 * Built with the `tf_minimal` design system: white page (#FFFFFF), 1000px frame,
 * thin top bar (#D2D2D7), #F5F5F7 borderless inputs, single #002583 accent.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Credential — TF Unions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-white text-[#1D1D1F] font-['Inter',-apple-system,BlinkMacSystemFont,sans-serif] antialiased">
    <div class="max-w-[1000px] mx-auto px-6 pb-20">
      <!-- TfTopBar -->
      <header class="h-16 border-b border-[#D2D2D7]/70 flex items-center justify-between">
        <a href="https://www.tfunions.com" class="text-[15px] font-medium text-[#002583] hover:opacity-75 transition flex items-center gap-1">
          <span>‹</span> Back to TF Unions
        </a>
        <a href="https://www.tfunions.com" class="text-[17px] font-bold tracking-[-0.2px] text-[#1D1D1F]">
          TF Unions
        </a>
      </header>

      <main class="mt-16 sm:mt-24 max-w-[560px]">
        <h1 class="text-[36px] sm:text-[48px] font-bold tracking-[-1.5px] leading-[1.08] text-[#1D1D1F]">
          Verify a certificate.
        </h1>
        <p class="mt-4 text-[17px] leading-[1.45] text-[#6E6E73]">
          Enter the serial code printed on a TF Unions credential (for example, <span class="text-[#1D1D1F] font-mono text-[15px]">TFU-2026-8F92A1</span>).
        </p>

        <form id="verify-form" class="mt-8 flex flex-col sm:flex-row gap-3">
          <input
            id="serial-input"
            type="text"
            required
            placeholder="TFU-2026-8F92A1"
            class="flex-1 px-4 py-3.5 rounded-[12px] bg-[#F5F5F7] font-mono text-[15px] uppercase text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
          />
          <button
            type="submit"
            class="h-12 px-6 rounded-[12px] bg-[#002583] hover:opacity-95 text-white font-semibold text-[15px] transition shrink-0"
          >
            Verify
          </button>
        </form>

        <div class="mt-4 flex items-center gap-4 text-[13px] text-[#6E6E73]">
          <span>Sample codes:</span>
          <button type="button" data-code="TFU-2026-8F92A1" class="sample-btn text-[#002583] font-medium hover:underline">TFU-2026-8F92A1</button>
          <button type="button" data-code="TFU-2026-000001" class="sample-btn text-[#002583] font-medium hover:underline">TFU-2026-000001</button>
        </div>

        <div id="result-box" class="hidden mt-10 rounded-[20px] bg-[#F5F5F7] p-7"></div>
      </main>
    </div>

    <script is:inline>
      const form = document.getElementById('verify-form');
      const input = document.getElementById('serial-input');
      const resultBox = document.getElementById('result-box');

      async function verifySerial(code) {
        const clean = code.trim().toUpperCase();
        resultBox.classList.remove('hidden');

        if (!/^TFU-\d{4}-[A-Z0-9]{6}$/.test(clean)) {
          resultBox.innerHTML = `<p class="text-[15px] text-[#B91C1C] font-medium">Enter a valid serial code in the format TFU-YYYY-XXXXXX.</p>`;
          return;
        }

        resultBox.innerHTML = `<p class="text-[15px] text-[#6E6E73]">Checking registry...</p>`;

        try {
          const res = await fetch(`https://n8n.tfunions.com/tf-api/api/verify-certificate?code=${encodeURIComponent(clean)}`);
          const data = await res.json();
          if (res.ok && data.valid) {
            resultBox.innerHTML = `
              <div class="flex items-center justify-between pb-4 border-b border-[#D2D2D7]/70">
                <span class="text-[13px] font-semibold text-[#15803D]">Verified credential</span>
                <span class="font-mono text-[13px] text-[#6E6E73]">${data.serialCode}</span>
              </div>
              <h2 class="mt-5 text-[24px] font-bold tracking-[-0.5px] text-[#1D1D1F]">${data.recipientName}</h2>
              <p class="mt-1 text-[15px] text-[#6E6E73]">${data.roleTitle}</p>
              <div class="mt-6 pt-4 border-t border-[#D2D2D7]/70 grid grid-cols-2 sm:grid-cols-3 gap-4 text-[13px]">
                <div>
                  <div class="text-[#6E6E73]">Type</div>
                  <div class="font-semibold text-[#1D1D1F] mt-0.5">${data.credentialType}</div>
                </div>
                <div>
                  <div class="text-[#6E6E73]">Hours</div>
                  <div class="font-semibold text-[#1D1D1F] mt-0.5">${data.hoursCredited} hrs</div>
                </div>
                <div>
                  <div class="text-[#6E6E73]">Issued</div>
                  <div class="font-semibold text-[#1D1D1F] mt-0.5">${data.issueDate}</div>
                </div>
              </div>
            `;
          } else {
            throw new Error(data.message || 'No active credential matches this serial code.');
          }
        } catch (err) {
          resultBox.innerHTML = `<p class="text-[15px] text-[#B91C1C] font-medium">${err.message || 'Certificate not found.'}</p>`;
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        verifySerial(input.value);
      });

      document.querySelectorAll('.sample-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          input.value = btn.getAttribute('data-code');
          verifySerial(input.value);
        });
      });

      const urlCode = new URLSearchParams(window.location.search).get('code');
      if (urlCode) {
        input.value = urlCode.toUpperCase();
        verifySerial(urlCode);
      }
    </script>
  </body>
</html>
