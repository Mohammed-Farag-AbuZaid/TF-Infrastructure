---
/**
 * Official Credential & Certificate Verifier (`https://verify.tfunions.org`)
 * Queries n8n Workflow #4: `GET https://auto.tfunions.org/webhook/verify-certificate?code=TFU-2026-XXXXXX`
 */
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Credential & Certificate Verifier | TF Unions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-[#070E24] text-white font-['Inter',sans-serif] flex flex-col justify-between">
    <header class="border-b border-white/10 px-6 py-4 flex items-center justify-between max-w-5xl w-full mx-auto">
      <a href="https://tfunions.org" class="flex items-center gap-3">
        <span class="w-9 h-9 rounded-lg bg-[#002583] border border-[#FFB800]/50 flex items-center justify-center font-['Exo_2'] font-extrabold text-[#FFB800]">TF</span>
        <div>
          <span class="font-['Exo_2'] font-bold text-base">TF Unions</span>
          <span class="block text-[10px] uppercase tracking-widest text-[#FFB800]">Official Credential Registry</span>
        </div>
      </a>
      <a href="https://tfunions.org" class="text-xs text-slate-300 hover:text-white">← Back to Foundation Portal</a>
    </header>

    <main class="flex-1 flex items-center justify-center p-6">
      <div class="w-full max-w-xl bg-[#0C1636] border border-white/15 rounded-2xl p-8 shadow-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#FFB800]/15 text-[#FFB800]">
          🎓 Public Verification Registry
        </span>
        <h1 class="font-['Exo_2'] font-extrabold text-3xl mt-3">Verify a TF Unions Certificate</h1>
        <p class="text-xs text-slate-300 mt-1">
          Enter the serial code printed on the certificate (format: <code class="text-[#FFB800]">TFU-2026-XXXXXX</code>) or scan the certificate QR code.
        </p>

        <form id="verify-form" class="mt-6 flex flex-col sm:flex-row gap-3">
          <input
            id="serial-input"
            type="text"
            required
            pattern="^TFU-\d{4}-[A-Za-z0-9]{6}$"
            placeholder="TFU-2026-8F92A1"
            class="flex-1 px-4 py-3 rounded-xl bg-[#070E24] border border-white/20 font-mono text-sm uppercase text-white focus:border-[#FFB800] focus:outline-none"
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-xl bg-[#FFB800] hover:bg-[#ffc633] text-[#070E24] font-['Exo_2'] font-bold text-sm transition"
          >
            Verify Credential
          </button>
        </form>

        <!-- Result Container -->
        <div id="result-box" class="hidden mt-6 rounded-2xl p-6 border"></div>
      </div>
    </main>

    <footer class="py-4 text-center text-xs text-slate-500">
      TF Unions Credential Verifier • Powered by Baserow Registry &amp; Gotenberg
    </footer>

    <script src="https://tfunions.org/widgets/tf-qa-widget.js" defer></script>
    <tf-qa-widget service="Foundation_Portal"></tf-qa-widget>

    <script is:inline>
      const form = document.getElementById('verify-form');
      const input = document.getElementById('serial-input');
      const resultBox = document.getElementById('result-box');

      async function verifySerial(code) {
        const clean = code.trim().toUpperCase();
        if (!/^TFU-\d{4}-[A-Z0-9]{6}$/.test(clean)) {
          resultBox.className = 'mt-6 rounded-2xl p-6 border bg-red-500/15 border-red-500/40 text-red-200 text-xs';
          resultBox.innerHTML = '<strong>Invalid Serial Format:</strong> Must match <code>TFU-YYYY-XXXXXX</code>.';
          resultBox.classList.remove('hidden');
          return;
        }

        resultBox.className = 'mt-6 rounded-2xl p-6 border bg-white/5 border-white/10 text-slate-300 text-xs';
        resultBox.textContent = 'Querying TF Unions Certificates Registry...';
        resultBox.classList.remove('hidden');

        try {
          const res = await fetch(`https://auto.tfunions.org/webhook/verify-certificate?code=${encodeURIComponent(clean)}`);
          const data = await res.json();
          if (res.ok && data.valid) {
            resultBox.className = 'mt-6 rounded-2xl p-6 border bg-emerald-500/15 border-emerald-500/40 text-white';
            resultBox.innerHTML = `
              <div class="flex items-center justify-between mb-3">
                <span class="px-2.5 py-1 rounded-full bg-emerald-500/30 text-emerald-200 text-[11px] font-bold">✅ AUTHENTIC & ACTIVE CREDENTIAL</span>
                <span class="font-mono text-xs text-[#FFB800]">${data.serialCode}</span>
              </div>
              <h3 class="font-['Exo_2'] font-bold text-2xl text-white">${data.recipientName}</h3>
              <p class="text-xs text-slate-200 mt-1">${data.credentialType} — <strong>${data.roleTitle}</strong></p>
              <div class="mt-4 pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-300">
                <span>Verified Hours: <strong>${data.hoursCredited} hrs</strong></span>
                <span>Issued: <strong>${data.issueDate}</strong></span>
                ${data.pdfUrl ? `<a href="${data.pdfUrl}" target="_blank" rel="noreferrer" class="text-[#FFB800] font-bold hover:underline">Download Official PDF ↗</a>` : ''}
              </div>
            `;
          } else {
            throw new Error(data.message || 'Certificate not found or revoked.');
          }
        } catch (err) {
          resultBox.className = 'mt-6 rounded-2xl p-6 border bg-red-500/15 border-red-500/40 text-red-200 text-xs';
          resultBox.innerHTML = `<strong>❌ Verification Failed:</strong> ${err.message || 'Certificate not found or revoked.'}`;
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        verifySerial(input.value);
      });

      const urlCode = new URLSearchParams(window.location.search).get('code');
      if (urlCode) {
        input.value = urlCode.toUpperCase();
        verifySerial(urlCode);
      }
    </script>
  </body>
</html>
