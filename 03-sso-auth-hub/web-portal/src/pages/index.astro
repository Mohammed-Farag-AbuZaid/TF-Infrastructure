---
/**
 * Central Unified SSO Login & Registration Hub (`https://auth.tfunions.com`)
 * Styled with TF Sovereign Editorial tokens (#F8F9FB canvas, #FFFFFF card, #E2E5EC border, #002583 cobalt, #D99B00 gold).
 */
const faviconSvg = encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#002583"/><rect x="23" y="5" width="4" height="4" rx="1" fill="#D99B00"/><path d="M7 9.5h11.5v2.7h-4.3V23h-3V12.2H7V9.5zm10.8 0H25v2.7h-4.2v2.9h3.7v2.6h-3.7V23h-3V9.5z" fill="#fff"/></svg>`
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Single Sign-On — TF Unions</title>
    <meta name="theme-color" content="#002583" />
    <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,${faviconSvg}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-[#F8F9FB] text-[#11141C] font-['Inter',-apple-system,BlinkMacSystemFont,sans-serif] antialiased flex flex-col">
    <!-- Top Ecosystem Return Bar -->
    <div class="bg-[#F3F5F8] border-b border-[#E2E5EC]">
      <div class="max-w-[960px] mx-auto px-5 h-10 flex items-center justify-between text-[12px]">
        <a id="back-link" href="https://www.tfunions.com" class="font-semibold text-[#002583] hover:underline flex items-center gap-1.5">
          <span>‹</span> Back to TF Unions
        </a>
        <div class="flex items-center gap-4 text-[#525866]">
          <a href="https://verify.tfunions.com" class="hover:text-[#11141C]">Verify</a>
          <a href="https://docs.tfunions.com" class="hover:text-[#11141C]">Docs</a>
        </div>
      </div>
    </div>

    <!-- Centered Auth Container -->
    <main class="flex-1 flex items-center justify-center px-5 py-10">
      <div class="w-full max-w-[440px]">
        <!-- Active Session Banner (hidden unless user is already logged in) -->
        <section id="active-session-card" class="hidden mb-5 bg-white border border-[#E2E5EC] rounded-2xl p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
          <div class="flex items-center justify-between gap-3 pb-4 border-b border-[#E2E5EC]">
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#15803D]">ACTIVE SSO SESSION</div>
              <h2 id="session-user-name" class="mt-1 text-[18px] font-bold text-[#11141C]">Signed in</h2>
              <div id="session-user-meta" class="text-[13px] text-[#525866] mt-0.5"></div>
            </div>
            <button
              id="btn-signout"
              type="button"
              class="h-9 px-3.5 rounded-xl bg-[#FEF2F2] border border-[#FECACA] text-[#B91C1C] text-[12px] font-semibold hover:bg-[#FEE2E2] transition"
            >
              Sign out
            </button>
          </div>
          <div class="mt-4">
            <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#7A8191] mb-2.5">Quick Launch Ecosystem</div>
            <div class="grid grid-cols-2 gap-2 text-[13px]">
              <a href="https://www.tfunions.com" class="px-3 py-2 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 font-medium text-[#11141C]">Foundation</a>
              <a href="https://news.tfunions.com" class="px-3 py-2 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 font-medium text-[#11141C]">TF News</a>
              <a href="https://guides.tfunions.com" class="px-3 py-2 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 font-medium text-[#11141C]">TF Guides</a>
              <a href="https://connect.tfunions.com" class="px-3 py-2 rounded-xl bg-[#F8F9FB] border border-[#E2E5EC] hover:border-[#002583]/40 font-medium text-[#11141C]">TF Connect</a>
            </div>
          </div>
        </section>

        <!-- Primary Elevated Auth Widget -->
        <section class="bg-white border border-[#E2E5EC] rounded-2xl p-7 sm:p-8 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
          <!-- Brand Header -->
          <div class="flex items-center justify-between gap-3">
            <a href="https://www.tfunions.com" class="flex items-center gap-2.5">
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="rounded-[7px]">
                <rect width="32" height="32" rx="7" fill="#002583" />
                <rect x="23" y="5" width="4" height="4" rx="1" fill="#D99B00" />
                <path d="M7 9.5H18.5V12.2H14.2V23H11.2V12.2H7V9.5ZM17.8 9.5H25V12.2H20.8V15.1H24.5V17.7H20.8V23H17.8V9.5Z" fill="#FFFFFF" />
              </svg>
              <span class="text-[16px] font-bold tracking-[-0.02em] text-[#11141C]">TF Unions</span>
            </a>
            <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#D99B00] bg-[#F3F5F8] border border-[#E2E5EC] px-2.5 py-1 rounded-md">
              Unified SSO
            </span>
          </div>

          <div class="mt-7">
            <h1 id="form-title" class="text-[28px] font-bold tracking-[-0.03em] leading-[1.12] text-[#11141C]">
              Welcome back
            </h1>
            <p id="form-subtitle" class="mt-2 text-[14px] leading-[1.55] text-[#525866]">
              Sign in with your TF Passport to continue to <span id="target-service-name" class="text-[#11141C] font-semibold">TF Unions</span>.
            </p>
          </div>

          <!-- Segmented Mode Switch -->
          <div class="mt-6 grid grid-cols-2 p-1 bg-[#F3F5F8] border border-[#E2E5EC] rounded-xl">
            <button
              id="tab-signin"
              type="button"
              class="py-2 px-3 text-[13px] font-semibold rounded-lg bg-white text-[#11141C] border border-[#E2E5EC] shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition"
            >
              Sign in
            </button>
            <button
              id="tab-register"
              type="button"
              class="py-2 px-3 text-[13px] font-semibold rounded-lg text-[#525866] border border-transparent hover:text-[#11141C] transition"
            >
              Create account
            </button>
          </div>

          <div id="status-alert" class="hidden mt-5 px-3.5 py-3 rounded-xl border text-[13px] font-medium"></div>

          <form id="sso-form" class="mt-5 space-y-3.5">
            <div id="register-fields" class="hidden space-y-3.5">
              <input
                id="fullName"
                type="text"
                placeholder="Full name"
                class="w-full px-3.5 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] placeholder-[#7A8191] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
              />
              <input
                id="phone"
                type="tel"
                placeholder="WhatsApp / Phone (+20)"
                class="w-full px-3.5 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] placeholder-[#7A8191] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
              />
              <div class="grid grid-cols-2 gap-3">
                <select
                  id="governorate"
                  class="w-full px-3 py-3.5 rounded-xl bg-[#F8F9FB] text-[14px] text-[#11141C] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
                >
                  <option value="Cairo">Cairo</option>
                  <option value="Giza">Giza</option>
                  <option value="Alexandria">Alexandria</option>
                  <option value="Dakahlia">Dakahlia</option>
                  <option value="Sharqia">Sharqia</option>
                  <option value="Gharbia">Gharbia</option>
                  <option value="Menofia">Menofia</option>
                  <option value="Qalyubia">Qalyubia</option>
                  <option value="Ismailia">Ismailia</option>
                  <option value="Assiut">Assiut</option>
                  <option value="Luxor">Luxor</option>
                  <option value="Red Sea">Red Sea</option>
                  <option value="Other">Other</option>
                </select>
                <select
                  id="educationSystem"
                  class="w-full px-3 py-3.5 rounded-xl bg-[#F8F9FB] text-[14px] text-[#11141C] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
                >
                  <option value="STEM">STEM School</option>
                  <option value="Thanaweya_Amma">Thanaweya Amma</option>
                  <option value="IGCSE">IGCSE</option>
                  <option value="American">American</option>
                  <option value="Azhar">Azhar</option>
                  <option value="University">University</option>
                </select>
              </div>
              <select
                id="gradeOrYear"
                class="w-full px-3.5 py-3.5 rounded-xl bg-[#F8F9FB] text-[14px] text-[#11141C] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
              >
                <option value="Prep_3">Prep 3</option>
                <option value="G10">Grade 10</option>
                <option value="G11" selected>Grade 11</option>
                <option value="G12">Grade 12</option>
                <option value="Undergrad">Undergraduate</option>
                <option value="Grad">Graduate</option>
              </select>
            </div>

            <input
              id="email"
              type="email"
              required
              autocomplete="email"
              placeholder="Email address"
              class="w-full px-3.5 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] placeholder-[#7A8191] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
            />

            <div class="relative">
              <input
                id="password"
                type="password"
                required
                minlength="6"
                autocomplete="current-password"
                placeholder="Password (min 6 characters)"
                class="w-full pl-3.5 pr-16 py-3.5 rounded-xl bg-[#F8F9FB] text-[15px] text-[#11141C] placeholder-[#7A8191] border border-[#E2E5EC] focus:border-[#002583] focus:bg-white focus:outline-none transition"
              />
              <button
                id="toggle-pw"
                type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 px-2 py-1 text-[12px] font-semibold text-[#525866] hover:text-[#002583]"
              >
                Show
              </button>
            </div>

            <div class="pt-1">
              <button
                id="btn-submit"
                type="submit"
                class="w-full h-11 rounded-xl bg-[#002583] hover:bg-[#001B61] text-white font-semibold text-[15px] transition shadow-[0_1px_2px_rgba(15,23,42,0.08)]"
              >
                Sign in
              </button>
            </div>
          </form>

          <div class="mt-6 pt-5 border-t border-[#E2E5EC] text-[12px] text-[#525866] flex items-center justify-between">
            <span>Shared across all *.tfunions.com portals</span>
            <a href="https://docs.tfunions.com#account" class="text-[#002583] font-semibold hover:underline">SSO Docs ›</a>
          </div>
        </section>
      </div>
    </main>

    <script is:inline>
      const VPS_API_BASE = 'https://n8n.tfunions.com/tf-api';

      function getValidatedRedirectUrl() {
        const params = new URLSearchParams(window.location.search);
        const raw = params.get('redirect_to') || params.get('redirect');
        if (!raw) return 'https://www.tfunions.com';
        try {
          const parsed = new URL(raw);
          if (
            parsed.protocol === 'https:' &&
            (parsed.hostname === 'tfunions.com' ||
             parsed.hostname.endsWith('.tfunions.com') ||
             parsed.hostname.endsWith('.pages.dev') ||
             parsed.hostname.endsWith('.vercel.app'))
          ) {
            return parsed.toString();
          }
        } catch {}
        return 'https://www.tfunions.com';
      }

      const redirectUrl = getValidatedRedirectUrl();
      const targetNameEl = document.getElementById('target-service-name');
      const backLink = document.getElementById('back-link');
      try {
        targetNameEl.textContent = new URL(redirectUrl).hostname;
        backLink.href = redirectUrl;
      } catch {}

      // Hydrate active session card if signed in
      try {
        const match = document.cookie.match(/(?:^|;\s*)tf_user_hint=([^;]*)/);
        const localUser = localStorage.getItem('tf_sso_user');
        let userHint = null;
        if (match) {
          userHint = JSON.parse(decodeURIComponent(match[1]));
        } else if (localUser) {
          const p = JSON.parse(localUser);
          userHint = { name: p.full_name || p.fullName || p.name, email: p.email, role: p.role };
        }
        if (userHint && userHint.name) {
          document.getElementById('active-session-card').classList.remove('hidden');
          document.getElementById('session-user-name').textContent = String(userHint.name);
          document.getElementById('session-user-meta').textContent = userHint.email
            ? `${userHint.email} · ${userHint.role || 'member'}`
            : String(userHint.role || 'member');
        }
      } catch {}

      document.getElementById('btn-signout').addEventListener('click', async () => {
        try {
          await fetch(`${VPS_API_BASE}/api/sessionLogout`, { method: 'POST', credentials: 'include' });
        } catch {}
        document.cookie = 'tf_user_hint=; Secure; SameSite=Lax; Domain=.tfunions.com; Path=/; Max-Age=0';
        localStorage.removeItem('tf_sso_token');
        localStorage.removeItem('tf_sso_user');
        window.location.reload();
      });

      const pwInput = document.getElementById('password');
      const pwToggle = document.getElementById('toggle-pw');
      pwToggle.addEventListener('click', () => {
        const show = pwInput.type === 'password';
        pwInput.type = show ? 'text' : 'password';
        pwToggle.textContent = show ? 'Hide' : 'Show';
      });

      let isRegisterMode = new URLSearchParams(window.location.search).get('mode') === 'register';
      const tabSignin = document.getElementById('tab-signin');
      const tabRegister = document.getElementById('tab-register');
      const registerFields = document.getElementById('register-fields');
      const btnSubmit = document.getElementById('btn-submit');
      const formTitle = document.getElementById('form-title');
      const statusAlert = document.getElementById('status-alert');

      const activeTabCls = 'py-2 px-3 text-[13px] font-semibold rounded-lg bg-white text-[#11141C] border border-[#E2E5EC] shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition';
      const inactiveTabCls = 'py-2 px-3 text-[13px] font-semibold rounded-lg text-[#525866] border border-transparent hover:text-[#11141C] transition';

      function applyMode() {
        if (isRegisterMode) {
          registerFields.classList.remove('hidden');
          tabRegister.className = activeTabCls;
          tabSignin.className = inactiveTabCls;
          formTitle.textContent = 'Create your TF Passport';
          btnSubmit.textContent = 'Create account';
        } else {
          registerFields.classList.add('hidden');
          tabSignin.className = activeTabCls;
          tabRegister.className = inactiveTabCls;
          formTitle.textContent = 'Welcome back';
          btnSubmit.textContent = 'Sign in';
        }
      }
      applyMode();

      function showStatus(msg, isError = false) {
        statusAlert.textContent = msg;
        statusAlert.className = `mt-5 px-3.5 py-3 rounded-xl border text-[13px] font-medium ${
          isError
            ? 'bg-[#FEF2F2] border-[#FECACA] text-[#B91C1C]'
            : 'bg-[#F0FDF4] border-[#BBF7D0] text-[#15803D]'
        }`;
        statusAlert.classList.remove('hidden');
      }

      tabSignin.addEventListener('click', () => {
        isRegisterMode = false;
        applyMode();
      });

      tabRegister.addEventListener('click', () => {
        isRegisterMode = true;
        applyMode();
      });

      document.getElementById('sso-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;

        try {
          showStatus(isRegisterMode ? 'Creating your TF Passport...' : 'Verifying credentials...');
          const endpoint = isRegisterMode ? `${VPS_API_BASE}/api/register` : `${VPS_API_BASE}/api/login`;
          const payload = isRegisterMode
            ? {
                email,
                password,
                fullName: document.getElementById('fullName').value.trim() || email.split('@')[0],
                phone: document.getElementById('phone').value.trim(),
                governorate: document.getElementById('governorate').value,
                educationSystem: document.getElementById('educationSystem').value,
                gradeOrYear: document.getElementById('gradeOrYear').value,
                interests: ['scholarships', 'research'],
              }
            : { email, password };

          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Invalid credentials');
          }

          const hint = encodeURIComponent(JSON.stringify({
            uid: data.user.uid,
            name: data.user.full_name || data.user.fullName || data.user.name,
            email: data.user.email,
            role: data.user.role || 'student',
          }));
          document.cookie = `tf_user_hint=${hint}; Secure; SameSite=Lax; Domain=.tfunions.com; Path=/; Max-Age=1209600`;
          localStorage.setItem('tf_sso_token', data.token);
          localStorage.setItem('tf_sso_user', JSON.stringify(data.user));

          showStatus('Signed in. Redirecting...');
          setTimeout(() => {
            window.location.href = redirectUrl;
          }, 300);
        } catch (err) {
          showStatus(err.message || 'Authentication failed', true);
        }
      });
    </script>
  </body>
</html>
