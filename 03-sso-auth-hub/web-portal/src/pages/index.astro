---
/**
 * Central Unified SSO Login & Registration Hub (`https://auth.tfunions.com`)
 * Built with the exact `tf_minimal` design system (`auth_kit.dart`):
 * White page (#FFFFFF), 420px centered column, #F5F5F7 borderless inputs, single #002583 accent.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — TF Unions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-white text-[#1D1D1F] font-['Inter',-apple-system,BlinkMacSystemFont,sans-serif] antialiased flex items-center justify-center px-6 py-12">
    <main class="w-full max-w-[420px]">
      <div class="flex items-center justify-between">
        <a href="https://www.tfunions.com" class="text-[17px] font-bold tracking-[-0.2px] text-[#1D1D1F] hover:opacity-75 transition">
          TF Unions
        </a>
        <a id="back-link" href="https://www.tfunions.com" class="text-[14px] font-medium text-[#002583] hover:opacity-75 transition">
          Back
        </a>
      </div>

      <div class="mt-10">
        <h1 id="form-title" class="text-[34px] font-bold tracking-[-1px] leading-[1.1] text-[#1D1D1F]">
          Welcome back
        </h1>
        <p id="form-subtitle" class="mt-3 text-[16px] leading-[1.5] text-[#6E6E73]">
          Sign in with your TF account to continue to <span id="target-service-name" class="text-[#1D1D1F] font-medium">TF Unions</span>.
        </p>
      </div>

      <!-- TfSegmented Switch -->
      <div class="mt-7 inline-flex p-[3px] bg-[#F5F5F7] rounded-[11px] w-full">
        <button
          id="tab-signin"
          type="button"
          class="flex-1 py-2.5 px-4 text-[13px] font-semibold rounded-[8px] bg-white text-[#1D1D1F] border border-[#D2D2D7]/60 transition"
        >
          Sign in
        </button>
        <button
          id="tab-register"
          type="button"
          class="flex-1 py-2.5 px-4 text-[13px] font-semibold rounded-[8px] text-[#6E6E73] border border-transparent hover:text-[#1D1D1F] transition"
        >
          Create account
        </button>
      </div>

      <div id="status-alert" class="hidden mt-5 px-3.5 py-3 rounded-[12px] text-[13px] font-medium"></div>

      <form id="sso-form" class="mt-6 space-y-3.5">
        <div id="register-fields" class="hidden space-y-3.5">
          <div>
            <input
              id="fullName"
              type="text"
              placeholder="Full name"
              class="w-full px-3.5 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
            />
          </div>
          <div>
            <input
              id="phone"
              type="tel"
              placeholder="Phone number (+20)"
              class="w-full px-3.5 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
            />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <select
              id="governorate"
              class="w-full px-3.5 py-4 rounded-[12px] bg-[#F5F5F7] text-[14px] text-[#1D1D1F] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
            >
              <option value="Cairo">Cairo</option>
              <option value="Giza">Giza</option>
              <option value="Alexandria">Alexandria</option>
              <option value="Dakahlia">Dakahlia</option>
              <option value="Sharqia">Sharqia</option>
              <option value="Gharbia">Gharbia</option>
              <option value="Menofia">Menofia</option>
              <option value="Qalyubia">Qalyubia</option>
              <option value="Ismailia">Ismailia</option>
              <option value="Assiut">Assiut</option>
              <option value="Luxor">Luxor</option>
              <option value="Red Sea">Red Sea</option>
              <option value="Other">Other</option>
            </select>
            <select
              id="educationSystem"
              class="w-full px-3.5 py-4 rounded-[12px] bg-[#F5F5F7] text-[14px] text-[#1D1D1F] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
            >
              <option value="STEM">STEM School</option>
              <option value="Thanaweya_Amma">Thanaweya Amma</option>
              <option value="IGCSE">IGCSE</option>
              <option value="American">American</option>
              <option value="Azhar">Azhar</option>
              <option value="University">University</option>
            </select>
          </div>
          <div>
            <select
              id="gradeOrYear"
              class="w-full px-3.5 py-4 rounded-[12px] bg-[#F5F5F7] text-[14px] text-[#1D1D1F] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
            >
              <option value="Prep_3">Prep 3</option>
              <option value="G10">Grade 10</option>
              <option value="G11" selected>Grade 11</option>
              <option value="G12">Grade 12</option>
              <option value="Undergrad">Undergraduate</option>
              <option value="Grad">Graduate</option>
            </select>
          </div>
        </div>

        <div>
          <input
            id="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Email"
            class="w-full px-3.5 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
          />
        </div>

        <div>
          <input
            id="password"
            type="password"
            required
            minlength="6"
            autocomplete="current-password"
            placeholder="Password"
            class="w-full px-3.5 py-4 rounded-[12px] bg-[#F5F5F7] text-[15px] text-[#1D1D1F] placeholder-[#6E6E73] border-[1.5px] border-transparent focus:border-[#002583] focus:bg-white focus:outline-none transition"
          />
        </div>

        <div class="pt-2">
          <button
            id="btn-submit"
            type="submit"
            class="w-full h-12 rounded-[12px] bg-[#002583] hover:opacity-95 text-white font-semibold text-[15px] transition"
          >
            Sign in
          </button>
        </div>
      </form>

      <div class="mt-8 pt-6 border-t border-[#D2D2D7]/60 text-[13px] text-[#6E6E73] flex items-center justify-between">
        <span>One account across all TF Unions services</span>
        <a href="https://docs.tfunions.com" class="text-[#002583] font-medium hover:underline">Help</a>
      </div>
    </main>

    <script is:inline>
      const VPS_API_BASE = 'https://n8n.tfunions.com/tf-api';

      function getValidatedRedirectUrl() {
        const params = new URLSearchParams(window.location.search);
        const raw = params.get('redirect_to');
        if (!raw) return 'https://www.tfunions.com';
        try {
          const parsed = new URL(raw);
          if (
            parsed.protocol === 'https:' &&
            (parsed.hostname === 'tfunions.com' ||
             parsed.hostname.endsWith('.tfunions.com') ||
             parsed.hostname.endsWith('.pages.dev') ||
             parsed.hostname.endsWith('.vercel.app'))
          ) {
            return parsed.toString();
          }
        } catch {}
        return 'https://www.tfunions.com';
      }

      const redirectUrl = getValidatedRedirectUrl();
      const targetNameEl = document.getElementById('target-service-name');
      const backLink = document.getElementById('back-link');
      try {
        targetNameEl.textContent = new URL(redirectUrl).hostname;
        backLink.href = redirectUrl;
      } catch {}

      let isRegisterMode = new URLSearchParams(window.location.search).get('mode') === 'register';
      const tabSignin = document.getElementById('tab-signin');
      const tabRegister = document.getElementById('tab-register');
      const registerFields = document.getElementById('register-fields');
      const btnSubmit = document.getElementById('btn-submit');
      const formTitle = document.getElementById('form-title');
      const statusAlert = document.getElementById('status-alert');

      function applyMode() {
        if (isRegisterMode) {
          registerFields.classList.remove('hidden');
          tabRegister.className = 'flex-1 py-2.5 px-4 text-[13px] font-semibold rounded-[8px] bg-white text-[#1D1D1F] border border-[#D2D2D7]/60 transition';
          tabSignin.className = 'flex-1 py-2.5 px-4 text-[13px] font-semibold rounded-[8px] text-[#6E6E73] border border-transparent hover:text-[#1D1D1F] transition';
          formTitle.textContent = 'Create account';
          btnSubmit.textContent = 'Create account';
        } else {
          registerFields.classList.add('hidden');
          tabSignin.className = 'flex-1 py-2.5 px-4 text-[13px] font-semibold rounded-[8px] bg-white text-[#1D1D1F] border border-[#D2D2D7]/60 transition';
          tabRegister.className = 'flex-1 py-2.5 px-4 text-[13px] font-semibold rounded-[8px] text-[#6E6E73] border border-transparent hover:text-[#1D1D1F] transition';
          formTitle.textContent = 'Welcome back';
          btnSubmit.textContent = 'Sign in';
        }
      }
      applyMode();

      function showStatus(msg, isError = false) {
        statusAlert.textContent = msg;
        statusAlert.className = `mt-5 px-3.5 py-3 rounded-[12px] text-[13px] font-medium ${
          isError ? 'bg-[#F5F5F7] text-[#B91C1C]' : 'bg-[#F5F5F7] text-[#15803D]'
        }`;
        statusAlert.classList.remove('hidden');
      }

      tabSignin.addEventListener('click', () => {
        isRegisterMode = false;
        applyMode();
      });

      tabRegister.addEventListener('click', () => {
        isRegisterMode = true;
        applyMode();
      });

      document.getElementById('sso-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;

        try {
          showStatus(isRegisterMode ? 'Creating your account...' : 'Signing in...');
          const endpoint = isRegisterMode ? `${VPS_API_BASE}/api/register` : `${VPS_API_BASE}/api/login`;
          const payload = isRegisterMode
            ? {
                email,
                password,
                fullName: document.getElementById('fullName').value.trim() || email.split('@')[0],
                phone: document.getElementById('phone').value.trim(),
                governorate: document.getElementById('governorate').value,
                educationSystem: document.getElementById('educationSystem').value,
                gradeOrYear: document.getElementById('gradeOrYear').value,
                interests: ['scholarships', 'research'],
              }
            : { email, password };

          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Invalid credentials');
          }

          const hint = encodeURIComponent(JSON.stringify({
            uid: data.user.uid,
            name: data.user.full_name || data.user.fullName || data.user.name,
            role: data.user.role || 'student',
          }));
          document.cookie = `tf_user_hint=${hint}; Secure; SameSite=Lax; Domain=.tfunions.com; Path=/; Max-Age=1209600`;
          localStorage.setItem('tf_sso_token', data.token);
          localStorage.setItem('tf_sso_user', JSON.stringify(data.user));

          showStatus('Signed in. Redirecting...');
          setTimeout(() => {
            window.location.href = redirectUrl;
          }, 300);
        } catch (err) {
          showStatus(err.message || 'Authentication failed', true);
        }
      });
    </script>
  </body>
</html>
